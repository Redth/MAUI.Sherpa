<Project>

  <!-- InstallNameTool processes these items in parallel and uses ReidentifiedPath for its scratch
       file. Duplicate destinations therefore race on the same file, even when their source
       identities or project metadata differ. Deduplicate the final SDK items by that destination. -->
  <Target Name="_RemoveDuplicateNativeReferences"
          AfterTargets="_ComputeDynamicLibrariesToReidentify"
          BeforeTargets="_InstallNameTool"
          Condition="'@(_DynamicLibraryToReidentify)' != ''">

    <ItemGroup>
      <_NativeLibraryDedupeCandidate Include="@(_DynamicLibraryToReidentify)">
        <_OriginalIdentityBeforeDedupe>%(Identity)</_OriginalIdentityBeforeDedupe>
      </_NativeLibraryDedupeCandidate>
      <_NativeLibraryDedupeKey Include="@(_NativeLibraryDedupeCandidate->'%(ReidentifiedPath)')" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(_NativeLibraryDedupeKey)">
      <Output TaskParameter="Filtered" ItemName="_DistinctNativeLibraryDedupeKey" />
    </RemoveDuplicates>

    <ItemGroup>
      <_DynamicLibraryToReidentify Remove="@(_DynamicLibraryToReidentify)" />
      <_DynamicLibraryToReidentify
          Include="@(_DistinctNativeLibraryDedupeKey->'%(_OriginalIdentityBeforeDedupe)')" />
      <_DynamicLibraryToReidentify Update="@(_DynamicLibraryToReidentify)">
        <_OriginalIdentityBeforeDedupe />
      </_DynamicLibraryToReidentify>
    </ItemGroup>
  </Target>

</Project>
