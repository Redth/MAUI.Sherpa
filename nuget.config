<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore only from nuget.org. <clear /> drops sources inherited from user- and machine-level
    NuGet.Config files (internal, preview or dev feeds), so every machine and CI restores the same
    published packages and a package that only exists on someone's private feed fails fast here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Every package must come from nuget.org. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Ignore machine-level fallback folders (e.g. offline SDK caches) so they can't satisfy restores. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
