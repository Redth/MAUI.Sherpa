<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet10" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10/nuget/v3/index.json" />
    <!-- Locally built Microsoft.Maui.DevFlow.* packages, for testing agent changes that have not
         shipped yet. Drop this source (and pin the DevFlow versions back to a published preview)
         once the file-storage endpoints are on a real feed. -->
    <add key="devflow-local" value="../maui-labs/artifacts/local-feed" />
  </packageSources>
</configuration>
