@page "/inspector/devflow/{AgentId}/{TabName?}"
@using MauiSherpa.Core.Models.DevFlow
@using MauiSherpa.Core.Interfaces
@layout MauiSherpa.AppInspector.Components.InspectorLayout
@inject IAppInspectorClientFactory ClientFactory
@inject NavigationManager NavManager
@implements IDisposable

<div class="devflow-inspector">
    <div class="inspector-toolbar">
        <div class="inspector-title" title="@(agentStatus?.AppName ?? QueryAppName ?? "DevFlow")">
            <span class="inspector-icon">
                <i class="fa-solid fa-wand-magic-sparkles fa-fw" aria-hidden="true"></i>
            </span>
            <span class="inspector-app-name">@(agentStatus?.AppName ?? QueryAppName ?? "DevFlow")</span>
            @if (agentStatus != null)
            {
                <span class="toolbar-platform">@agentStatus.Platform</span>
            }
        </div>
        <div class="inspector-tabs" role="tablist" aria-label="DevFlow inspector tools">
            <button role="tab" aria-selected="@(activeTab == "tree")" class="tab-btn @(activeTab == "tree" ? "active" : "")" @onclick='@(() => SwitchTab("tree"))'>
                <i class="fa-solid fa-sitemap fa-fw" aria-hidden="true"></i> Visual Tree
            </button>
            <button role="tab" aria-selected="@(activeTab == "network")" class="tab-btn @(activeTab == "network" ? "active" : "")" @onclick='@(() => SwitchTab("network"))'>
                <i class="fa-solid fa-network-wired fa-fw" aria-hidden="true"></i> Network
            </button>
            <button role="tab" aria-selected="@(activeTab == "profiling")" class="tab-btn @(activeTab == "profiling" ? "active" : "")" @onclick='@(() => SwitchTab("profiling"))'>
                <i class="fa-solid fa-chart-line fa-fw" aria-hidden="true"></i> Profiling
            </button>
            <button role="tab" aria-selected="@(activeTab == "webview")" class="tab-btn @(activeTab == "webview" ? "active" : "")" @onclick='@(() => SwitchTab("webview"))'>
                <i class="fa-solid fa-globe fa-fw" aria-hidden="true"></i> WebView
            </button>
            <button role="tab" aria-selected="@(activeTab == "logs")" class="tab-btn @(activeTab == "logs" ? "active" : "")" @onclick='@(() => SwitchTab("logs"))'>
                <i class="fa-solid fa-scroll fa-fw" aria-hidden="true"></i> Logs
            </button>
            <button role="tab" aria-selected="@(activeTab == "platform")" class="tab-btn @(activeTab == "platform" ? "active" : "")" @onclick='@(() => SwitchTab("platform"))'>
                <i class="fa-solid fa-microchip fa-fw" aria-hidden="true"></i> Platform
            </button>
        </div>
        <div class="inspector-actions">
            <span class="connection-badge @(isConnected ? "connected" : "disconnected")">
                <span class="connection-dot"></span>
                @(isConnected ? "Connected" : "Offline")
            </span>
            <button class="btn-icon reconnect-btn" @onclick="ReconnectAsync" disabled="@isReconnecting" title="Reconnect to agent" aria-label="Reconnect to agent">
                <i class="fa-solid fa-arrows-rotate fa-fw @(isReconnecting ? "fa-spin" : "")" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <div class="inspector-content">
        @if (!isConnected)
        {
            <div class="connecting-overlay">
                <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
                <p>Connecting to agent at @agentHost:@agentPort...</p>
            </div>
        }
        else
        {
            @switch (activeTab)
            {
                case "tree":
                    <DevFlowTreeTab Client="@client" />
                    break;
                case "network":
                    <DevFlowNetworkTab Client="@client" />
                    break;
                case "profiling":
                    <DevFlowProfilingTab Client="@client" AgentVersion="@agentStatus?.Version" />
                    break;
                case "webview":
                    <DevFlowWebViewTab Client="@client" Logs="@webviewLogs" OnClearLogs="ClearWebViewLogs" />
                    break;
                case "logs":
                    <DevFlowLogsTab Client="@client" Logs="@allLogs" OnClearLogs="ClearAllLogs" />
                    break;
                case "platform":
                    <DevFlowPlatformTab Client="@client" AgentVersion="@agentStatus?.Version" />
                    break;
            }
        }
    </div>
</div>

@code {
    [Parameter] public string AgentId { get; set; } = "";
    [Parameter] public string? TabName { get; set; }

    [SupplyParameterFromQuery(Name = "host")]
    public string? QueryHost { get; set; }

    [SupplyParameterFromQuery(Name = "port")]
    public int? QueryPort { get; set; }

    [SupplyParameterFromQuery(Name = "appName")]
    public string? QueryAppName { get; set; }

    private InspectorUiClient? client;
    private DevFlowAgentStatus? agentStatus;
    private string agentHost = "localhost";
    private int agentPort = 9223;
    private string activeTab = "tree";
    private static readonly HashSet<string> ValidTabs = new(StringComparer.OrdinalIgnoreCase)
    {
        "tree", "network", "profiling", "webview", "logs", "platform"
    };
    private bool isConnected;
    private bool isReconnecting;

    // Shared log state — stream lives at inspector level, survives tab switches
    private List<DevFlowLogEntry> allLogs = new();
    private DateTimeOffset _allLogsClearedAfter = DateTimeOffset.MinValue;
    private DateTimeOffset _webviewLogsClearedAfter = DateTimeOffset.MinValue;
    private CancellationTokenSource? _logStreamCts;
    private Timer? _pollTimer;

    // Batching: buffer incoming log entries and render at most every 100ms
    private readonly List<DevFlowLogEntry> _pendingLogEntries = new();
    private Timer? _logBatchTimer;
    private const int LogBatchIntervalMs = 100;

    private List<DevFlowLogEntry> webviewLogs =>
        allLogs.Where(l => l.Source?.Equals("webview", StringComparison.OrdinalIgnoreCase) == true
            && (_webviewLogsClearedAfter == DateTimeOffset.MinValue || l.Timestamp > _webviewLogsClearedAfter))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        agentHost = QueryHost ?? "localhost";
        agentPort = QueryPort ?? 9223;
        activeTab = NormalizeTab(TabName);

        client = new InspectorUiClient(await ClientFactory.CreateAsync(agentHost, agentPort));
        await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            agentStatus = await client!.GetStatusAsync(cts.Token);
            isConnected = agentStatus != null;
        }
        catch
        {
            isConnected = false;
        }
        StateHasChanged();

        if (isConnected)
            StartLogStream();
    }

    private async Task ReconnectAsync()
    {
        if (isReconnecting) return;
        isReconnecting = true;
        StateHasChanged();

        try
        {
            _logStreamCts?.Cancel();
            _pollTimer?.Dispose();
            _pollTimer = null;

            client?.Dispose();
            client = new InspectorUiClient(await ClientFactory.CreateAsync(agentHost, agentPort));
            await ConnectAsync();
        }
        finally
        {
            isReconnecting = false;
            StateHasChanged();
        }
    }

    private void StartLogStream()
    {
        _logStreamCts?.Cancel();
        _pollTimer?.Dispose();
        _pollTimer = null;
        _logStreamCts = new CancellationTokenSource();
        var ct = _logStreamCts.Token;

        _ = Task.Run(async () =>
        {
            var reconnectDelay = 1;
            var fastFailCount = 0;
            while (!ct.IsCancellationRequested)
            {
                var startTime = DateTimeOffset.UtcNow;
                try
                {
                    await client!.StreamLogsAsync(
                        onReplay: entries =>
                        {
                            InvokeAsync(() =>
                            {
                                if (_allLogsClearedAfter != DateTimeOffset.MinValue)
                                    entries = entries.Where(l => l.Timestamp > _allLogsClearedAfter).ToList();
                                allLogs = entries;
                                StateHasChanged();
                            });
                        },
                        onEntry: entry =>
                        {
                            InvokeAsync(() =>
                            {
                                if (_allLogsClearedAfter != DateTimeOffset.MinValue && entry.Timestamp <= _allLogsClearedAfter)
                                    return;
                                _pendingLogEntries.Add(entry);
                                _logBatchTimer ??= new Timer(_ =>
                                {
                                    InvokeAsync(FlushPendingLogs);
                                }, null, LogBatchIntervalMs, Timeout.Infinite);
                            });
                        },
                        source: null,
                        replay: 500,
                        ct: ct);
                }
                catch (OperationCanceledException) { return; }
                catch { }

                if (ct.IsCancellationRequested) return;

                // If stream failed very quickly (<2s), agent likely doesn't support /ws/logs
                var elapsed = DateTimeOffset.UtcNow - startTime;
                if (elapsed.TotalSeconds < 2)
                {
                    fastFailCount++;
                    if (fastFailCount >= 3)
                    {
                        // Fall back to REST polling for this agent
                        await InvokeAsync(() => StartPolling());
                        return;
                    }
                }
                else
                {
                    fastFailCount = 0;
                    reconnectDelay = 1; // reset backoff after a successful connection
                }

                // Wait and retry with backoff (1s, 2s, 4s, 8s max)
                try { await Task.Delay(TimeSpan.FromSeconds(reconnectDelay), ct); }
                catch (OperationCanceledException) { return; }
                reconnectDelay = Math.Min(reconnectDelay * 2, 8);
            }
        }, ct);
    }

    private void StartPolling()
    {
        _pollTimer?.Dispose();
        // Initial fetch
        _ = InvokeAsync(FetchLogsViaRest);
        _pollTimer = new Timer(async _ =>
        {
            try { await InvokeAsync(FetchLogsViaRest); }
            catch { }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task FetchLogsViaRest()
    {
        try
        {
            var freshLogs = await client!.GetLogsAsync(limit: 500);
            if (_allLogsClearedAfter != DateTimeOffset.MinValue)
                freshLogs = freshLogs.Where(l => l.Timestamp > _allLogsClearedAfter).ToList();
            if (freshLogs.Count != allLogs.Count)
            {
                allLogs = freshLogs;
                StateHasChanged();
            }
        }
        catch { }
    }

    private void ClearAllLogs()
    {
        if (allLogs.Count > 0)
            _allLogsClearedAfter = allLogs.Max(l => l.Timestamp);
        else
            _allLogsClearedAfter = DateTimeOffset.UtcNow;
        allLogs.Clear();
        _pendingLogEntries.Clear();
        StateHasChanged();
    }

    private void ClearWebViewLogs()
    {
        var wvLogs = webviewLogs;
        if (wvLogs.Count > 0)
            _webviewLogsClearedAfter = wvLogs.Max(l => l.Timestamp);
        else
            _webviewLogsClearedAfter = DateTimeOffset.UtcNow;
        StateHasChanged();
    }

    private void SwitchTab(string tab)
    {
        var normalized = NormalizeTab(tab);
        if (activeTab == normalized) return;
        activeTab = normalized;
        StateHasChanged();
    }

    private static string NormalizeTab(string? tab)
    {
        if (string.IsNullOrWhiteSpace(tab))
            return "tree";

        return ValidTabs.Contains(tab)
            ? tab.ToLowerInvariant()
            : "tree";
    }

    private void FlushPendingLogs()
    {
        _logBatchTimer?.Dispose();
        _logBatchTimer = null;
        if (_pendingLogEntries.Count == 0)
            return;
        allLogs.AddRange(_pendingLogEntries);
        _pendingLogEntries.Clear();
        StateHasChanged();
    }

    public void Dispose()
    {
        _logStreamCts?.Cancel();
        _logBatchTimer?.Dispose();
        _pollTimer?.Dispose();
        client?.Dispose();
    }
}

<style>
    .devflow-inspector {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--surface-canvas);
        color: var(--text-primary);
        overflow: hidden;
    }

    .inspector-toolbar {
        display: flex;
        align-items: center;
        min-height: 42px;
        padding: 0;
        background: var(--surface-card);
        border: 0;
        border-bottom: 1px solid var(--border-subtle);
        border-radius: 0;
        flex-shrink: 0;
    }

    .inspector-title {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 180px;
        max-width: 280px;
        height: 41px;
        padding: 0 12px;
        border-right: 1px solid var(--border-hairline);
        font-weight: 600;
        font-size: var(--font-size-md);
    }

    .inspector-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        color: var(--accent);
        background: var(--accent-soft);
        border: 1px solid var(--accent-border);
        border-radius: var(--radius-sm);
        font-size: 11px;
    }

    .inspector-app-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .toolbar-platform {
        min-height: 18px;
        padding: 1px 6px;
        background: var(--surface-well);
        color: var(--text-secondary);
        font-size: 0.68rem;
    }

    .inspector-tabs {
        display: flex;
        align-self: stretch;
        flex: 1 1 auto;
        gap: 0;
        min-width: 0;
        overflow-x: auto;
        overflow-y: hidden;
    }

    .tab-btn {
        position: relative;
        display: flex;
        align-items: center;
        gap: 6px;
        height: 41px;
        padding: 0 11px;
        flex: 0 0 auto;
        color: var(--text-secondary);
        background: transparent;
        border: 0;
        border-bottom: 2px solid transparent;
        border-radius: 0;
        cursor: pointer;
        font-size: var(--font-size-sm);
        font-weight: 550;
        box-shadow: none;
        transition: color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);
    }

    .tab-btn:hover {
        color: var(--text-primary);
        background: var(--surface-card-hover);
    }

    .tab-btn.active {
        color: var(--accent);
        background: transparent;
        border-bottom-color: var(--accent);
    }

    .inspector-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        height: 41px;
        padding: 0 10px;
        border-left: 1px solid var(--border-hairline);
    }

    .connection-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        min-height: 20px;
        padding: 2px 7px;
        color: var(--text-secondary);
        background: var(--surface-well);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-pill);
        font-size: 0.68rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .connection-badge.connected {
        color: var(--status-success-fg);
        background: var(--status-success-bg);
        border-color: var(--status-success-border);
    }

    .connection-badge.disconnected {
        color: var(--text-muted);
    }

    .connection-dot {
        width: 7px;
        height: 7px;
        flex: 0 0 7px;
        background: var(--text-muted);
        border-radius: var(--radius-pill);
    }

    .connection-badge.connected .connection-dot {
        background: var(--status-success-dot);
    }

    .reconnect-btn {
        width: var(--control-height-sm);
        height: var(--control-height-sm);
        min-height: var(--control-height-sm);
    }

    .inspector-content {
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .connecting-overlay {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        gap: var(--space-3);
        color: var(--text-secondary);
        background: var(--surface-canvas);
    }

    .connecting-overlay i {
        color: var(--accent);
        font-size: 20px;
    }

    .connecting-overlay p {
        margin: 0;
        color: var(--text-muted);
        font-size: var(--font-size-sm);
    }

    @@media (max-width: 900px) {
        .inspector-title {
            min-width: 150px;
            max-width: 210px;
        }

        .tab-btn {
            padding-inline: 9px;
        }
    }
</style>
