<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <!-- NuGet Package Metadata -->
    <PackageId>MauiSherpa.Core</PackageId>
    <Description>Core library for MauiSherpa - ViewModels, services, and interfaces for managing Android SDK, Apple Developer tools, and development environment dependencies.</Description>
    <Authors>MauiSherpa Contributors</Authors>
    <PackageTags>dotnet;maui;android;ios;sdk;development</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/redth/MAUI.Sherpa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MauiSherpa.Core.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AndroidSdk" />
    <PackageReference Include="AndroidSdk.Adbd" />
    <PackageReference Include="AppStoreConnectClient" />
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" />
    <PackageReference Include="Infisical.Sdk" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="Microsoft.TeamFoundation.DistributedTask.WebApi" />
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" />
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" />
    <PackageReference Include="NGitLab" />
    <PackageReference Include="Octokit" />
    <PackageReference Include="SharpKml.Core" />
    <PackageReference Include="Shiny.DocumentDb.Sqlite.SqlCipher" />
    <PackageReference Include="Shiny.Mediator" />
    <PackageReference Include="Shiny.Mediator.AppSupport" />
    <PackageReference Include="Sodium.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MauiSherpa.Workloads\MauiSherpa.Workloads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\**\*.md" />
  </ItemGroup>

</Project>
