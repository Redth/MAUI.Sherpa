<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MauiSherpa.Cli</RootNamespace>
    <AssemblyName>maui-sherpa</AssemblyName>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>maui-sherpa</ToolCommandName>
    <PackageId>MauiSherpa.Cli</PackageId>
    <PackageDescription>CLI for MAUI Sherpa — manage mobile toolchains and execute encrypted Expedition Packs in CI.</PackageDescription>
    <PackageTags>maui;android;ios;sdk;cli;dotnet;workloads;ci;build;deploy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>expedition-packs.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Redth/MAUI.Sherpa/blob/main/docs/expedition-packs.md</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Redth/MAUI.Sherpa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>$(AppVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AppStoreConnectClient" Version="0.2.28" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/expedition-packs.md" Pack="true" PackagePath="expedition-packs.md" />
    <ProjectReference Include="..\MauiSherpa.Bundles\MauiSherpa.Bundles.csproj" />
    <ProjectReference Include="..\MauiSherpa.Workloads\MauiSherpa.Workloads.csproj" />
  </ItemGroup>

</Project>
