@page "/bundle-ids"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Requests.Apple
@using MauiSherpa.Services
@using Shiny.Mediator
@inject IMediator Mediator
@inject IAppleConnectService AppleService
@inject IAppleIdentityStateService IdentityState
@inject IAlertService AlertService
@inject IDialogService DialogService
@inject OperationModalService OperationModal
@inject BlazorToastService ToastService
@inject IEncryptedSettingsService SettingsService
@implements IDisposable
@inject IToolbarService ToolbarService
@inject IPlatformService PlatformInfo
@inject IFormModalService FormModalService
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject MauiSherpa.Pages.Forms.HybridFormBridgeHolder BridgeHolder
@inject ILocalVaultAccessService LocalVaultAccess

<h1><i class="fa-solid fa-fingerprint"></i> Bundle IDs</h1>

<AppleIdentityPicker />

@if (IdentityState.SelectedIdentity != null && !RequiresLocalVaultAccess)
{
    @if (!PlatformInfo.HasNativeToolbar)
    {
    <div class="toolbar">
        <button class="btn btn-primary" @onclick="@(() => RefreshData(forceRefresh: true))" disabled="@isRefreshing">
            <i class="fa-solid @(isRefreshing ? "fa-spinner fa-spin" : "fa-sync-alt")"></i> Refresh
        </button>
        <button data-screenshot-external class="btn btn-success" @onclick="ShowCreateDialog" disabled="@isRefreshing">
            <i class="fa-solid fa-plus"></i> Register Bundle ID
        </button>
        <MauiSherpa.Components.BackgroundRefreshIndicator IsRefreshing="@isBackgroundRefreshing" />
        </div>
    }

        <!-- Filter Section -->
        @if (!PlatformInfo.HasNativeToolbar)
        {
        <div class="filter-section">
            <div class="search-box">
                <span class="search-icon"><i class="fa-solid fa-search"></i></span>
                <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search bundle IDs..." />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button class="clear-btn" @onclick="@(() => searchQuery = "")" aria-label="Clear bundle ID search">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                }
            </div>
            <div class="filter-chips">
                <SherpaSelect TValue="string"
                              Value="@filterPlatform"
                              ValueChanged="@(value => filterPlatform = value ?? "")"
                              Options="PlatformFilterOptions"
                              LeadingIcon="fa-brands fa-apple"
                              AriaLabel="Filter by platform"
                              Compact="true"
                              Class="filter-select" />
            </div>
            @if (HasActiveFilters)
            {
                <button class="clear-filters-btn" @onclick="ClearFilters">Clear Filters</button>
            }
        </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-bar">@errorMessage</div>
        }

        <div class="results-info">
            Showing @FilteredBundleIds.Count() of @bundleIds.Count bundle IDs
        </div>

        <div class="bundle-list sherpa-list">
        
        @if (bundleIds.Count == 0 && isRefreshing)
        {
            <div class="loading-state">
                <div class="loading-spinner">
                    <i class="fa-solid fa-fingerprint"></i>
                </div>
                <div class="loading-title">Loading Bundle IDs</div>
                <div class="loading-description">Fetching bundle identifiers from App Store Connect...</div>
            </div>
        }
        else if (!FilteredBundleIds.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid @(bundleIds.Count == 0 ? "fa-cube" : "fa-search")"></i></div>
                <div class="empty-title">@(bundleIds.Count == 0 ? "No Bundle IDs found" : "No matching bundle IDs")</div>
                <div class="empty-description">@(bundleIds.Count == 0 ? "Register a new bundle ID to get started" : "No bundle IDs match your search or filters. Try adjusting your criteria.")</div>
            </div>
        }
        else
        {
            @foreach (var bundle in FilteredBundleIds)
            {
                var capabilities = GetCapabilities(bundle.Id);
                <div class="bundle-card sherpa-list-row">
                    <div class="bundle-icon sherpa-icon-well sherpa-icon-well-apple">
                        <i class="fa-solid fa-fingerprint"></i>
                        <span class="sherpa-brand-badge"><i class="fa-brands fa-apple"></i></span>
                    </div>
                    <div class="bundle-details sherpa-row-stack">
                        <div class="bundle-name sherpa-row-title">
                            <span>@bundle.Name</span>
                            <span class="sherpa-badge sherpa-badge-neutral">@FormatPlatform(bundle.Platform)</span>
                            @if (!string.IsNullOrEmpty(bundle.SeedId))
                            {
                                <span class="sherpa-badge sherpa-badge-neutral">
                                    <span class="badge-seed-value @(demoMode ? "demo-blur" : "")">@bundle.SeedId</span>
                                </span>
                            }
                        </div>
                        <div class="bundle-identifier sherpa-row-sub mono">
                            <span>Bundle ID: @bundle.Identifier</span>
                            <button class="btn btn-ghost btn-icon btn-sm btn-copy" @onclick="@(() => CopyToClipboard(bundle.Identifier))" title="Copy Bundle ID" aria-label="@($"Copy bundle identifier for {bundle.Name}")">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                        @if (capabilities.Any())
                        {
                            <div class="bundle-capabilities">
                                @foreach (var cap in capabilities.Take(5))
                                {
                                    <span class="capability-badge" title="@CapabilityCategories.GetDisplayName(cap.CapabilityType)">
                                        <i class="fa-solid @CapabilityCategories.GetIcon(cap.CapabilityType)"></i>
                                    </span>
                                }
                                @if (capabilities.Count > 5)
                                {
                                    <span class="capability-more">+@(capabilities.Count - 5)</span>
                                }
                            </div>
                        }
                        </div>
                    </div>
                    <div class="bundle-actions sherpa-row-actions">
                        <button data-screenshot-external class="btn btn-secondary btn-icon btn-sm" @onclick="@(() => ShowEditCapabilitiesDialog(bundle))" disabled="@isRefreshing" title="Capabilities">
                            <i class="fa-solid fa-puzzle-piece"></i>
                        </button>
                        <button data-screenshot-external class="btn btn-ghost-danger btn-icon btn-sm" @onclick="@(() => DeleteBundle(bundle))" disabled="@isRefreshing" title="Delete">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
}



<style>
    .toolbar { margin-bottom: 1rem; display: flex; gap: 0.75rem; }
    .error-bar { background: var(--status-error-bg); color: var(--status-error-text); padding: 0.75rem 1rem; border: 1px solid var(--status-error-border); border-radius: var(--radius-lg); margin-bottom: 1rem; }

    /* Filter Section Styles */
    .filter-section {
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 10px 14px;
        margin-bottom: 1rem;
        box-shadow: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }

    .search-box {
        flex: 1;
        min-width: 200px;
    }

    .search-box input {
        width: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        box-sizing: border-box;
    }

    .search-box input:focus {
        outline: none;
        box-shadow: none;
    }

    .search-icon {
        font-size: 0.875rem;
        opacity: 0.5;
    }

    .clear-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        padding: 0;
        background: transparent;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        cursor: pointer;
        color: var(--text-muted);
    }

    .clear-btn:hover { background: var(--surface-card-hover); }

    .filter-chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }

    .filter-select { min-width: 120px; }

    .clear-filters-btn {
        padding: 0.5rem 0.75rem;
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        color: var(--text-muted);
        cursor: pointer;
    }

    .clear-filters-btn:hover { background: var(--bg-tertiary); color: var(--text-secondary); }

    .results-info { font-size: var(--font-size-xs); color: var(--text-muted); margin: 0 0 8px; }

    .bundle-list { margin-bottom: 1.25rem; }

    .bundle-card {
        align-items: center;
        background: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .bundle-details { min-width: 0; }
    .bundle-name { display: flex; align-items: center; gap: 6px; }
    .bundle-identifier { display: flex; align-items: center; gap: 6px; }

    .btn-copy {
        width: 20px;
        min-width: 20px;
        height: 20px;
        min-height: 20px;
        flex-shrink: 0;
    }

    .badge { padding: 2px 0.625rem; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 500; }
    .badge-platform { background: var(--status-info-bg); color: var(--status-info-text); }
    .badge-seed { background: var(--bg-hover); color: var(--text-secondary); }
    .badge-seed-value { display: inline-block; }
    .badge-seed-value.demo-blur {
        text-shadow: 0 0 12px var(--text-primary), 0 0 18px var(--text-primary);
        filter: blur(2px);
    }

    .empty-state { background: var(--card-bg); border-radius: var(--card-radius); padding: 3.75rem 2.5rem; text-align: center; }
    .empty-icon { font-size: 48px; margin-bottom: 1rem; color: var(--text-muted); }
    .empty-icon i { font-size: 48px; }
    .empty-title { font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
    .empty-description { color: var(--text-muted); font-size: 0.875rem; }

    /* Capability badges in bundle cards */
    .bundle-capabilities {
        display: inline-flex;
        gap: 0.375rem;
        flex-wrap: wrap;
        align-items: center;
    }
    .capability-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        color: var(--text-muted);
        font-size: 0.6875rem;
    }
    .capability-more {
        font-size: 0.75rem;
        color: var(--text-muted);
        padding: 0.25rem 0.5rem;
        background: var(--bg-hover);
        border-radius: 0.25rem;
    }

</style>

@code {
    private List<AppleBundleId> bundleIds = new();
    private bool isRefreshing = true;
    private bool isBackgroundRefreshing = false;
    private bool demoMode = false;
    private string errorMessage = "";

    // Filter state
    private string searchQuery = "";
    private string filterPlatform = "";
    private static readonly IReadOnlyList<SherpaSelectOption<string>> PlatformFilterOptions =
    [
        new("", "All Platforms"),
        new("UNIVERSAL", "Universal", Icon: "fa-solid fa-globe"),
        new("IOS", "iOS", Icon: "fa-brands fa-apple"),
        new("MAC_OS", "macOS", Icon: "fa-brands fa-apple")
    ];

    // Capabilities cache per bundle ID
    private Dictionary<string, List<AppleBundleIdCapability>> capabilitiesCache = new();

    private bool HasActiveFilters => !string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(filterPlatform);
    private bool RequiresLocalVaultAccess => LocalVaultAccess.GetState().RequiresUserAction;

    private IEnumerable<AppleBundleId> FilteredBundleIds => bundleIds
        .Where(b => string.IsNullOrEmpty(searchQuery) || 
                    b.Identifier.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    b.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(filterPlatform) || (b.Platform?.Equals(filterPlatform, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(b => b.Identifier);

    private void ClearFilters()
    {
        searchQuery = "";
        filterPlatform = "";
    }

    protected override async Task OnInitializedAsync()
    {
        ToolbarService.SetItems(
            new ToolbarAction("refresh", "Refresh", "arrow.clockwise"),
            new ToolbarAction("create", "Register Bundle ID", "plus")
        );
        UpdateToolbarItemStates();
        ToolbarService.SetSearch("Search bundle IDs...");
        ToolbarService.SetFilters(
            new ToolbarFilter("platform", "Platform", ["All Platforms", "Universal", "iOS", "macOS"])
        );
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        ToolbarService.SearchTextChanged += OnSearchTextChanged;
        ToolbarService.FilterChanged += OnFilterChanged;

        try { var settings = await SettingsService.GetSettingsAsync(); demoMode = settings.Preferences.DemoMode; } catch { }
        IdentityState.OnSelectionChanged += OnIdentityChanged;
        LocalVaultAccess.StateChanged += OnLocalVaultStateChanged;
        if (IdentityState.SelectedIdentity != null)
            await RefreshData(forceRefresh: false); // Use cache on initial load
    }

    private void OnIdentityChanged()
    {
        InvokeAsync(async () =>
        {
            UpdateToolbarItemStates();
            if (RequiresLocalVaultAccess)
            {
                StateHasChanged();
                return;
            }

            await RefreshData(forceRefresh: false); // Use cache when identity changes (different identity = different cache key)
            StateHasChanged();
        });
    }

    private void OnLocalVaultStateChanged() => OnIdentityChanged();

    private void OnSearchTextChanged(string text)
    {
        InvokeAsync(() => { searchQuery = text; StateHasChanged(); });
    }

    private void OnFilterChanged(string filterId, int selectedIndex)
    {
        InvokeAsync(() =>
        {
            switch (filterId)
            {
                case "platform":
                    filterPlatform = selectedIndex switch { 1 => "UNIVERSAL", 2 => "IOS", 3 => "MAC_OS", _ => "" };
                    break;
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        ToolbarService.SearchTextChanged -= OnSearchTextChanged;
        ToolbarService.FilterChanged -= OnFilterChanged;
        IdentityState.OnSelectionChanged -= OnIdentityChanged;
        LocalVaultAccess.StateChanged -= OnLocalVaultStateChanged;
    }

    private void OnToolbarItemClicked(string actionId)
    {
        InvokeAsync(async () =>
        {
            switch (actionId)
            {
                case "refresh": await RefreshData(forceRefresh: true); break;
                case "create": await ShowCreateDialog(); break;
            }
            StateHasChanged();
        });
    }

    private async Task RefreshData(bool forceRefresh = false)
    {
        if (IdentityState.SelectedIdentity == null || RequiresLocalVaultAccess)
        {
            UpdateToolbarItemStates();
            return;
        }

        // Set loading states
        isRefreshing = true;
        UpdateToolbarItemStates();
        if (!forceRefresh && bundleIds.Count > 0)
        {
            // Only show background indicator if we already have data
            isBackgroundRefreshing = true;
        }
        
        // Show toast for force refresh
        ToastMessage? toast = null;
        if (forceRefresh)
        {
            toast = ToastService.Show("Refreshing bundle IDs...", ToastType.Info);
        }
        
        errorMessage = "";
        StateHasChanged();
        
        try
        {
            // If force refresh, invalidate the cache first
            if (forceRefresh)
            {
                await Mediator.FlushStores($"apple:bundleids:{IdentityState.SelectedIdentity.Id}");
            }
            
            var request = new GetBundleIdsRequest(IdentityState.SelectedIdentity.Id);
            var (_, result) = await Mediator.Request(request);
            bundleIds = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load bundle IDs: {ex.Message}";
        }
        finally
        {
            isRefreshing = false;
            isBackgroundRefreshing = false;
            UpdateToolbarItemStates();
            if (toast != null) ToastService.Dismiss(toast);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateToolbarItemStates()
    {
        var ready = IdentityState.SelectedIdentity != null &&
            !LocalVaultAccess.GetState().RequiresUserAction &&
            !isRefreshing;
        ToolbarService.SetItemEnabled("refresh", ready);
        ToolbarService.SetItemEnabled("create", ready);
    }

    private async Task ShowCreateDialog()
    {
        if (RequiresLocalVaultAccess)
            return;

        var page = new MauiSherpa.Pages.Forms.CreateBundleIdPage(BridgeHolder, AppleService);
        var result = await FormModalService.ShowAsync<AppleBundleId>(page);
        if (result != null)
        {
            await RefreshData(forceRefresh: true);
        }
    }

    private async Task DeleteBundle(AppleBundleId bundle)
    {
        var confirm = await AlertService.ShowConfirmAsync(
            "Delete Bundle ID",
            $"Are you sure you want to delete '{bundle.Identifier}'?");

        if (!confirm) return;

        var result = await OperationModal.RunAsync(
            "Delete Bundle ID",
            $"Deleting '{bundle.Identifier}'...",
            async ctx =>
            {
                ctx.SetStatus("Deleting bundle ID...");
                ctx.LogInfo($"Identifier: {bundle.Identifier}");
                
                await AppleService.DeleteBundleIdAsync(bundle.Id);
                ctx.LogSuccess("Bundle ID deleted");
                return true;
            },
            canCancel: false);

        if (result.Success)
        {
            // Immediately remove from list for responsive UI
            bundleIds.Remove(bundle);
            StateHasChanged();
            
            await RefreshData(forceRefresh: true);
        }
    }

    private async Task CopyToClipboard(string text)
    {
        await DialogService.CopyToClipboardAsync(text);
        await AlertService.ShowToastAsync("Copied to clipboard");
    }

    // Capability-related methods
    private List<AppleBundleIdCapability> GetCapabilities(string bundleId)
    {
        return capabilitiesCache.TryGetValue(bundleId, out var caps) ? caps : new();
    }

    private async Task ShowEditCapabilitiesDialog(AppleBundleId bundle)
    {
        var page = new MauiSherpa.Pages.Modals.ManageCapabilitiesPage(ModalParams, bundle);
        await FormModalService.ShowViewAsync(page, page.WaitForCloseAsync);
        // Refresh capabilities cache after modal closes
        try
        {
            var caps = await AppleService.GetBundleIdCapabilitiesAsync(bundle.Id);
            capabilitiesCache[bundle.Id] = caps.ToList();
            StateHasChanged();
        }
        catch { }
    }

    private static string FormatPlatform(string? platform)
    {
        if (string.IsNullOrEmpty(platform)) return "Universal";
        return platform.ToUpperInvariant() switch
        {
            "IOS" => "iOS",
            "MAC_OS" or "MACOS" => "macOS",
            "UNIVERSAL" => "Universal",
            _ => platform
        };
    }

}
