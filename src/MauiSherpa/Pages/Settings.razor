@page "/settings"
@page "/modal/settings"
@using MauiSherpa.Core.ViewModels
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@using Shiny.Mediator
@inject SettingsViewModel ViewModel
@inject IMediator Mediator
@inject IAppleIdentityService AppleIdentityService
@inject IAppleIdentityStateService IdentityState
@inject IGoogleIdentityService GoogleIdentityService
@inject IAlertService AlertService
@inject IDialogService DialogService
@inject IFileSystemService FileSystem
@inject IThemeService ThemeService
@inject ICloudSecretsService CloudSecretsService
@inject ICloudSecretsProviderFactory CloudSecretsProviderFactory
@inject ISecretsPublisherService SecretsPublisherService
@inject IPushProjectService PushProjectService
@inject IPublishProfileService PublishProfileService
@inject IBackupService BackupService
@inject IEncryptedSettingsService EncryptedSettings
@inject IUpdateService UpdateService
@implements IDisposable
@inject ILauncher AppLauncher
@inject IToolbarService ToolbarService
@inject IPlatformService PlatformInfo
@inject ILoggingService Logger
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject MauiSherpa.Pages.Forms.HybridFormBridgeHolder BridgeHolder
@inject IXcodeService XcodeService
@inject ILocalVaultAccessService LocalVaultAccess

@if (!PlatformInfo.HasNativeToolbar)
{
<h1><i class="fa-solid fa-gear fa-fw"></i> @ViewModel.Title</h1>
}

<div class="settings-section">
    <h2>General</h2>
    <div class="settings-container">
        <div class="setting-group">
            <div class="setting-item">
                <label class="setting-label">Theme</label>
                <div class="setting-control setting-control-end">
                    <SherpaSegmentedControl TValue="string"
                                            Value="@ViewModel.Theme"
                                            ValueChanged="OnThemeSelectedAsync"
                                            Options="@ThemeSegmentOptions"
                                            AriaLabel="Theme" />
                </div>
            </div>
            <div class="setting-item">
                <label class="setting-label">Demo Mode</label>
                <div class="setting-control">
                    <div class="setting-toggle-row">
                        <label class="toggle-switch">
                            <input type="checkbox" checked="@demoMode" @onchange="OnDemoModeChanged" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span class="setting-description">Blur sensitive values (IDs, UDIDs, serials) for presentations</span>
                    </div>
                </div>
            </div>
            <div class="setting-item">
                <label class="setting-label">Font Size</label>
                <div class="setting-control setting-control-end">
                    <div class="font-scale-control">
                        <button class="btn-scale" @onclick="DecreaseFontScale" disabled="@(ViewModel.FontScale <= 0.8)" title="Decrease font size">
                            <i class="fa-solid fa-minus fa-fw"></i>
                        </button>
                        <input type="range" min="0.8" max="1.5" step="0.05"
                               value="@ViewModel.FontScale"
                               @oninput="OnFontScaleInput"
                               class="font-scale-slider" />
                        <button class="btn-scale" @onclick="IncreaseFontScale" disabled="@(ViewModel.FontScale >= 1.5)" title="Increase font size">
                            <i class="fa-solid fa-plus fa-fw"></i>
                        </button>
                        <span class="font-scale-label">@($"{ViewModel.FontScale * 100:F0}%")</span>
                    </div>
                </div>
            </div>
            <div class="setting-item setting-item-start">
                <label class="setting-label">Xcode XIP Extractor</label>
                <div class="setting-control setting-control-stack">
                    <SherpaSelect TValue="string"
                                  Value="@xcodeArchiveExtractor"
                                  ValueChanged="OnXcodeArchiveExtractorChanged"
                                  Options="@XcodeArchiveExtractorSelectOptions"
                                  LeadingIcon="fa-solid fa-file-zipper"
                                  AriaLabel="Xcode XIP extractor"
                                  Class="setting-select-wide" />
                    <div class="setting-description setting-description-block">
                        Use the system <code>xip</code> extractor for the safest default, or the bundled <code>unxip</code> helper for faster extraction.
                        <code>unxip</code> does not perform signature verification. If the bundled helper is unavailable, MauiSherpa falls back to <code>xip</code>.
                        Apple Encrypted Archives (<code>.aea</code>) always use the system <code>archiveutil</code> tool.
                    </div>
                </div>
            </div>
            <div class="setting-item setting-item-start">
                <label class="setting-label">Xcode Bundle Naming</label>
                <div class="setting-control setting-control-stack">
                    <SherpaSelect TValue="string"
                                  Value="@xcodeBundleSeparator"
                                  ValueChanged="OnXcodeBundleSeparatorChanged"
                                  Options="@XcodeBundleSeparatorSelectOptions"
                                  LeadingIcon="fa-solid fa-tag"
                                  AriaLabel="Xcode bundle naming"
                                  Disabled="@isNormalizingBundles"
                                  Class="setting-select-wide" />
                    <div class="setting-description setting-description-block">
                        Separator used when Sherpa renames managed Xcode installs in <code>/Applications</code>.
                        Changing this will scan for existing bundles using the other format and offer to rename them.
                        The build number is only appended when two installs share the same version.
                    </div>
                </div>
            </div>
            <div class="setting-item setting-item-start">
                <label class="setting-label">Xcode Selection</label>
                <div class="setting-control setting-control-stack">
                    <SherpaSelect TValue="string"
                                  Value="@xcodeSelectionAction"
                                  ValueChanged="OnXcodeSelectionActionChanged"
                                  Options="@XcodeSelectionActionSelectOptions"
                                  LeadingIcon="fa-solid fa-code-branch"
                                  AriaLabel="Xcode selection behavior"
                                  Class="setting-select-wide" />
                    <div class="setting-description setting-description-block">
                        Matches Xcodes.app's Active/Select behavior. Rename mode makes the selected bundle the real <code>/Applications/Xcode.app</code>.
                        Do nothing mode leaves installed bundles in place and selects their full path.
                    </div>
                    <div class="setting-toggle-row">
                        <label class="toggle-switch">
                            <input type="checkbox" checked="@xcodeCreateSymlinkOnSelect" @onchange="OnXcodeCreateSymlinkOnSelectChanged" disabled="@IsXcodeCreateSymlinkDisabled" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span class="setting-description">When not renaming, create <code>/Applications/Xcode.app</code> as a symbolic link to the selected bundle if possible.</span>
                    </div>
                </div>
            </div>
            @if (PlatformInfo.IsMacOS || PlatformInfo.IsMacCatalyst)
            {
                <div class="setting-item setting-item-start">
                    <label class="setting-label">Provisioning Profiles Folder</label>
                    <div class="setting-control setting-control-stack">
                        <SherpaSelect TValue="string"
                                      Value="@provisioningProfilesDirectory"
                                      ValueChanged="OnProvisioningProfilesDirectoryChanged"
                                      Options="@ProvisioningProfilesDirectorySelectOptions"
                                      LeadingIcon="fa-solid fa-folder-tree"
                                      AriaLabel="Provisioning profiles folder"
                                      Class="setting-select-wide" />
                        <div class="setting-description setting-description-block">
                            Auto uses <code>~/Library/Developer/Xcode/UserData/Provisioning Profiles</code> for Xcode 16+
                            and the legacy <code>~/Library/MobileDevice/Provisioning Profiles</code> folder for older Xcode versions.
                            Both installs each profile in both locations for compatibility with mixed tooling.
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="actions">
            @if (!PlatformInfo.HasNativeToolbar)
            {
            <button class="btn btn-primary" @onclick="SaveSettings">
                <i class="fa-solid fa-floppy-disk fa-fw"></i> Save Settings
            </button>
            <button class="btn btn-secondary" @onclick="ResetSettings">
                <i class="fa-solid fa-rotate-left fa-fw"></i> Reset to Defaults
            </button>
            }
        </div>
        
        <div class="setting-group" style="margin-top: 1.5rem;">
            <div class="setting-item">
                <label class="setting-label">Version</label>
                <div class="setting-control setting-control-end">
                    <div class="setting-value-row">
                        <span class="mono text-selectable">@appVersion</span>
                        @if (updateResult?.UpdateAvailable == true && updateResult.LatestRelease != null)
                        {
                            <button class="btn btn-sm btn-update-available" @onclick="ShowUpdateDialog">
                                <i class="fa-solid fa-circle-up fa-fw"></i>
                                Upgrade to @(updateResult.LatestRelease.TagName)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="settings-section" id="settings-apple-identities">
    <h2><i class="fa-brands fa-apple fa-fw"></i> Apple Identities</h2>
    <p class="section-description">
        Configure App Store Connect API credentials for managing Apple Developer resources.
        <a href="https://appstoreconnect.apple.com/access/integrations/api" target="_blank" @onclick='() => OpenUrl("https://appstoreconnect.apple.com/access/integrations/api")' @onclick:preventDefault>Get API keys</a>
    </p>
    
    @if (appleIdentities.Count == 0)
    {
        <div class="settings-container">
            <div class="empty-identities">
                <p>No Apple identities configured</p>
            </div>
        </div>
    }
    else
    {
        <div class="connected-list">
            @foreach (var identity in appleIdentities)
            {
                <div class="connected-list-item">
                    <div class="identity-header">
                        <div class="identity-info">
                            <i class="fa-regular fa-id-badge fa-fw identity-icon"></i>
                            <span class="identity-name"><span class="@(demoMode ? "demo-blur" : "")">@identity.Name</span></span>
                        </div>
                        <div class="identity-actions">
                            <button class="btn btn-sm btn-secondary" @onclick="@(() => TestIdentity(identity))" title="Test Connection">
                                <i class="fa-solid fa-plug fa-fw"></i> Test
                            </button>
                            <button class="btn btn-sm btn-secondary" @onclick="@(() => EditIdentity(identity))" title="Edit">
                                <i class="fa-solid fa-pen fa-fw"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger-soft" @onclick="@(() => DeleteIdentity(identity))" title="Delete">
                                <i class="fa-solid fa-trash fa-fw"></i> Delete
                            </button>
                        </div>
                    </div>
                    <div class="identity-details">
                        <div class="detail-item">
                            <span class="detail-label">KEY ID</span>
                            <span class="detail-value mono copyable">
                                <span class="@(demoMode ? "demo-blur" : "")">@identity.KeyId</span>
                                <button class="btn-copy" @onclick="@(() => CopyToClipboard(identity.KeyId))" title="Copy to clipboard">
                                    <i class="fa-solid fa-copy fa-fw"></i>
                                </button>
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">ISSUER ID</span>
                            <span class="detail-value mono copyable">
                                <span class="@(demoMode ? "demo-blur" : "")">@identity.IssuerId</span>
                                <button class="btn-copy" @onclick="@(() => CopyToClipboard(identity.IssuerId))" title="Copy to clipboard">
                                    <i class="fa-solid fa-copy fa-fw"></i>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    <div class="section-add-action">
        <button class="btn btn-success" @onclick="ShowAddIdentityDialog">
            <i class="fa-solid fa-plus fa-fw"></i> Add Apple Identity
        </button>
    </div>
</div>

<div class="settings-section" id="settings-google-identities">
    <h2><i class="fa-brands fa-google fa-fw"></i> Google Identities</h2>
    <p class="section-description">
        Configure Google Cloud / Firebase service account credentials for push notifications and project management.
        <a href="https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk" target="_blank" @onclick='() => OpenUrl("https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk")' @onclick:preventDefault>Get service account JSON</a>
    </p>
    
    @if (googleIdentities.Count == 0)
    {
        <div class="settings-container">
            <div class="empty-identities">
                <p>No Google identities configured</p>
            </div>
        </div>
    }
    else
    {
        <div class="connected-list">
            @foreach (var identity in googleIdentities)
            {
                <div class="connected-list-item">
                    <div class="identity-header">
                        <div class="identity-info">
                            <i class="fa-brands fa-google fa-fw identity-icon"></i>
                            <span class="identity-name"><span class="@(demoMode ? "demo-blur" : "")">@identity.Name</span></span>
                        </div>
                        <div class="identity-actions">
                            <button class="btn btn-sm btn-secondary" @onclick="@(() => TestGoogleIdentity(identity))" title="Test Connection">
                                <i class="fa-solid fa-plug fa-fw"></i> Test
                            </button>
                            <button class="btn btn-sm btn-secondary" @onclick="@(() => EditGoogleIdentity(identity))" title="Edit">
                                <i class="fa-solid fa-pen fa-fw"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger-soft" @onclick="@(() => DeleteGoogleIdentity(identity))" title="Delete">
                                <i class="fa-solid fa-trash fa-fw"></i> Delete
                            </button>
                        </div>
                    </div>
                    <div class="identity-details">
                        <div class="detail-item">
                            <span class="detail-label">PROJECT</span>
                            <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@identity.ProjectId</span></span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">SERVICE ACCOUNT</span>
                            <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@identity.ClientEmail</span></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    <div class="section-add-action">
        <button class="btn btn-success" @onclick="ShowAddGoogleIdentityDialog">
            <i class="fa-solid fa-plus fa-fw"></i> Add Google Identity
        </button>
    </div>
</div>

<div class="settings-section">
    <h2><i class="fa-solid fa-vault fa-fw"></i> Secrets Storage</h2>
    <p class="section-description">
        Store app secrets, signing certificates, and publish profiles securely.
        Local Vault keeps encrypted copies on this machine; cloud providers can sync across machines and CI/CD pipelines.
    </p>
    <div class="provider-defaults-notice" role="note">
        <i class="fa-solid fa-circle-info fa-fw"></i>
        <span><strong>Defaults apply only to new items.</strong> Changing them does not move, copy, or remove anything already stored.</span>
    </div>

    @if (ShouldShowLocalVaultNotice)
    {
        <div class="vault-access-card">
            <div class="vault-access-content">
                <i class="fa-solid fa-key fa-fw"></i>
                <div>
                    <strong>Local Vault access is disabled</strong>
                    <p>MAUI Sherpa cannot access the Local Vault key in OS secure storage. Grant access to use Local secrets on this Mac.</p>
                </div>
            </div>
            <button class="btn btn-primary" @onclick="GrantLocalVaultAccessAsync" disabled="@isGrantingLocalVaultAccess">
                <i class="fa-solid fa-fw @(isGrantingLocalVaultAccess ? "fa-spinner fa-spin" : "fa-unlock")"></i> Grant Access
            </button>
        </div>
    }
    
    @if (cloudProviders.Count == 0)
    {
        <div class="settings-container">
            <div class="empty-providers">
                <p>No secrets providers configured</p>
            </div>
        </div>
    }
    else
    {
        <div class="connected-list">
            @foreach (var provider in cloudProviders)
            {
                var providerUrl = GetProviderUrl(provider);
                <div class="connected-list-item">
                    <div class="provider-header">
                        <div class="provider-info">
                            <i class="@GetProviderIcon(provider.ProviderType) provider-icon"></i>
                            <span class="provider-name">@provider.Name</span>
                            @if (!string.IsNullOrEmpty(providerUrl))
                            {
                                <a href="@providerUrl" target="_blank" class="provider-link" title="Open in browser" @onclick="() => OpenUrl(providerUrl)" @onclick:preventDefault>
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-fw"></i>
                                </a>
                            }
                        </div>
                        <div class="provider-actions">
                            <button class="btn btn-sm btn-secondary" @onclick="@(() => TestProvider(provider))" title="Test Connection">
                                <i class="fa-solid fa-plug fa-fw"></i> Test
                            </button>
                            @if (!IsBuiltInLocalProvider(provider))
                            {
                                <button class="btn btn-sm btn-secondary" @onclick="@(() => EditProvider(provider))" title="Edit">
                                    <i class="fa-solid fa-pen fa-fw"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-danger-soft" @onclick="@(() => DeleteProvider(provider))" title="Delete">
                                    <i class="fa-solid fa-trash fa-fw"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                    <div class="provider-details">
                        <div class="detail-item">
                            <span class="detail-label">TYPE</span>
                            <span class="detail-value">@CloudSecretsProviderFactory.GetProviderDisplayName(provider.ProviderType)</span>
                        </div>
                        @if (IsBuiltInLocalProvider(provider))
                        {
                            <div class="detail-item">
                                <span class="detail-label">SCOPE</span>
                                <span class="detail-value">Built-in encrypted local vault</span>
                            </div>
                        }
                        @if (provider.ProviderType == CloudSecretsProviderType.Infisical)
                        {
                            <div class="detail-item">
                                <span class="detail-label">SITE</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("SiteUrl", "https://app.infisical.com")</span></span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">PROJECT</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("ProjectId", "")</span></span>
                            </div>
                        }
                        @if (provider.ProviderType == CloudSecretsProviderType.AzureKeyVault)
                        {
                            <div class="detail-item">
                                <span class="detail-label">VAULT</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("VaultUrl", "")</span></span>
                            </div>
                        }
                        @if (provider.ProviderType == CloudSecretsProviderType.AwsSecretsManager)
                        {
                            <div class="detail-item">
                                <span class="detail-label">REGION</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("Region", "us-east-1")</span></span>
                            </div>
                        }
                        @if (provider.ProviderType == CloudSecretsProviderType.GoogleSecretManager)
                        {
                            <div class="detail-item">
                                <span class="detail-label">PROJECT</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("ProjectId", "")</span></span>
                            </div>
                        }
                        @if (provider.ProviderType == CloudSecretsProviderType.OnePassword)
                        {
                            <div class="detail-item">
                                <span class="detail-label">VAULT</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("Vault", "")</span></span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">ITEM</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("ItemTitle", "MAUI.Sherpa")</span></span>
                            </div>
                        }
                        @if (provider.ProviderType == CloudSecretsProviderType.Vaultwarden)
                        {
                            <div class="detail-item">
                                <span class="detail-label">SERVER</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@GetVaultwardenServerDisplay(provider)</span></span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">EMAIL</span>
                                <span class="detail-value mono"><span class="@(demoMode ? "demo-blur" : "")">@provider.Settings.GetValueOrDefault("Email", "")</span></span>
                            </div>
                        }
                    </div>
                    <fieldset class="provider-defaults">
                        <legend>Store new items here by default</legend>
                        <div class="provider-default-options">
                            @foreach (var itemKind in SecretItemKinds.All)
                            {
                                var optionId = $"provider-{provider.Id}-{itemKind}";
                                <label class="provider-default-option" for="@optionId">
                                    <input id="@optionId"
                                           type="checkbox"
                                           checked="@provider.StoresByDefault(itemKind)"
                                           @onchange="eventArgs => SetProviderDefaultAsync(provider, itemKind, eventArgs)" />
                                    <span>@GetItemKindLabel(itemKind)</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                </div>
            }
        </div>
    }
    
    <div class="section-add-action">
        <button class="btn btn-success" @onclick="ShowAddProviderDialog">
            <i class="fa-solid fa-plus fa-fw"></i> Add Secrets Provider
        </button>
    </div>
</div>

<!-- CI/CD Secret Publishers Section -->
<div class="settings-section">
    <h2><i class="fa-solid fa-rocket fa-fw"></i> CI/CD Secret Publishers</h2>
    <p class="section-description">
        Publish signing secrets directly to your CI/CD platforms for automated builds.
        Secrets will be encrypted and stored as repository secrets.
    </p>
    
    @if (secretsPublishers.Count == 0)
    {
        <div class="settings-container">
            <div class="empty-providers">
                <p>No CI/CD publishers configured</p>
            </div>
        </div>
    }
    else
    {
        <div class="connected-list">
            @foreach (var publisher in secretsPublishers)
            {
                <div class="connected-list-item">
                    <div class="provider-header">
                        <div class="provider-info">
                            <i class="@GetPublisherIcon(publisher.ProviderId) provider-icon"></i>
                            <span class="provider-name">@publisher.Name</span>
                        </div>
                        <div class="provider-actions">
                            <button class="btn btn-sm btn-secondary" @onclick="@(() => TestPublisher(publisher))" title="Test Connection">
                                <i class="fa-solid fa-plug fa-fw"></i> Test
                            </button>
                            <button class="btn btn-sm btn-secondary" @onclick="@(() => EditPublisher(publisher))" title="Edit">
                                <i class="fa-solid fa-pen fa-fw"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger-soft" @onclick="@(() => DeletePublisher(publisher))" title="Delete">
                                <i class="fa-solid fa-trash fa-fw"></i> Delete
                            </button>
                        </div>
                    </div>
                    <div class="provider-details">
                        <div class="detail-item">
                            <span class="detail-label">TYPE</span>
                            <span class="detail-value">@GetPublisherDisplayName(publisher.ProviderId)</span>
                        </div>
                        @if (publisher.ProviderId == "github")
                        {
                            var owner = publisher.Settings.GetValueOrDefault("Owner", "");
                            @if (!string.IsNullOrEmpty(owner))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">OWNER</span>
                                    <span class="detail-value mono">@owner</span>
                                </div>
                            }
                        }
                        @if (publisher.ProviderId == "gitea" || publisher.ProviderId == "gitlab")
                        {
                            <div class="detail-item">
                                <span class="detail-label">SERVER</span>
                                <span class="detail-value mono">@publisher.Settings.GetValueOrDefault("ServerUrl", "")</span>
                            </div>
                        }
                        @if (publisher.ProviderId == "azuredevops")
                        {
                            <div class="detail-item">
                                <span class="detail-label">ORG</span>
                                <span class="detail-value mono">@publisher.Settings.GetValueOrDefault("OrganizationUrl", "")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    
    <div class="section-add-action">
        <button class="btn btn-success" @onclick="ShowAddPublisherDialog">
            <i class="fa-solid fa-plus fa-fw"></i> Add CI/CD Publisher
        </button>
    </div>
</div>

<!-- Backup & Restore Section -->
<div class="settings-section">
    <h2><i class="fa-solid fa-shield-halved fa-fw"></i> Backup & Restore</h2>
    <p class="section-description">
        Export your settings to a password-protected file for backup or transfer to another machine.
        All sensitive data (API keys, tokens) are encrypted using AES-256-GCM.
    </p>
    
    <div class="backup-actions">
        <div class="backup-action-card">
                <div class="backup-icon export">
                    <i class="fa-solid fa-download fa-fw"></i>
                </div>
                <div class="backup-info">
                    <h3>Export Settings</h3>
                    <p>Create a password-protected backup and choose exactly which settings, identities, providers, and CI/CD publishers to include.</p>
                </div>
                <button class="btn btn-primary" @onclick="ShowExportDialog" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <i class="fa-solid fa-spinner fa-spin fa-fw"></i>
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-file-export fa-fw"></i>
                        <span>Export</span>
                    }
                </button>
            </div>
            
            <div class="backup-action-card">
                <div class="backup-icon import">
                    <i class="fa-solid fa-upload fa-fw"></i>
                </div>
                <div class="backup-info">
                    <h3>Import Settings</h3>
                    <p>Restore settings from a backup file. This will merge with or replace your existing settings.</p>
                </div>
                <button class="btn btn-secondary" @onclick="ShowImportDialog" disabled="@isImporting">
                    @if (isImporting)
                    {
                        <i class="fa-solid fa-spinner fa-spin fa-fw"></i>
                        <span>Importing...</span>
                    }
                    else
                    {
