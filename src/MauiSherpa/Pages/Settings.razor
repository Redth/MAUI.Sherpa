@code {
    private List<AppleIdentity> appleIdentities = new();

    private async Task OpenUrl(string url)
    {
        await AppLauncher.OpenAsync(new Uri(url));
    }
    
    private bool demoMode = false;
    private static readonly IReadOnlyList<SherpaSegmentOption<string>> ThemeSegmentOptions =
    [
        new("System", "System", "fa-solid fa-circle-half-stroke", "Follow the operating system appearance"),
        new("Light", "Light", "fa-solid fa-sun", "Use the light appearance"),
        new("Dark", "Dark", "fa-solid fa-moon", "Use the dark appearance")
    ];
    private static readonly IReadOnlyList<SherpaSelectOption<string>> XcodeArchiveExtractorSelectOptions =
    [
        new(XcodeArchiveExtractorOptions.SystemXip, "System xip", "Safest default with Apple signature verification", "fa-solid fa-shield-halved"),
        new(XcodeArchiveExtractorOptions.Unxip, "unxip", "Faster bundled extractor without signature verification", "fa-solid fa-gauge-high")
    ];
    private static readonly IReadOnlyList<SherpaSelectOption<string>> XcodeBundleSeparatorSelectOptions =
    [
        new(XcodeBundleSeparatorOptions.Underscore, "Xcode_26.3.app", "Underscore · GitHub runner-images style", "fa-solid fa-underscore"),
        new(XcodeBundleSeparatorOptions.Hyphen, "Xcode-26.3.app", "Hyphen · xcodes and Xcodes.app style", "fa-solid fa-minus")
    ];
    private static readonly IReadOnlyList<SherpaSelectOption<string>> XcodeSelectionActionSelectOptions =
    [
        new(XcodeSelectionActionOptions.None, "Only update xcode-select", "Keep installed bundle names unchanged", "fa-solid fa-location-arrow"),
        new(XcodeSelectionActionOptions.Rename, "Rename selected bundle", "Use /Applications/Xcode.app for the active bundle", "fa-solid fa-pen-to-square")
    ];
    private static readonly IReadOnlyList<SherpaSelectOption<string>> ProvisioningProfilesDirectorySelectOptions =
    [
        new(ProvisioningProfilesDirectoryOptions.Auto, "Auto", "Choose the folder for the selected Xcode version", "fa-solid fa-wand-magic-sparkles"),
        new(ProvisioningProfilesDirectoryOptions.Xcode16AndLater, "Xcode 16+ folder", "Use Xcode's UserData provisioning profiles folder", "fa-solid fa-folder"),
        new(ProvisioningProfilesDirectoryOptions.Xcode15AndEarlier, "Xcode 15 and earlier folder", "Use the legacy MobileDevice folder", "fa-solid fa-folder"),
        new(ProvisioningProfilesDirectoryOptions.Both, "Both folders", "Install profiles in both locations for compatibility", "fa-solid fa-copy")
    ];
    private string xcodeArchiveExtractor = XcodeArchiveExtractorOptions.SystemXip;
    private string xcodeBundleSeparator = XcodeBundleSeparatorOptions.Underscore;
    private string xcodeSelectionAction = XcodeSelectionActionOptions.Rename;
    private bool xcodeCreateSymlinkOnSelect = false;
    private string provisioningProfilesDirectory = ProvisioningProfilesDirectoryOptions.Auto;
    private bool isNormalizingBundles = false;
    private string appVersion = "";
    private UpdateCheckResult? updateResult;

    // Google identity state
    private List<GoogleIdentity> googleIdentities = new();
    

    private bool IsXcodeCreateSymlinkDisabled => xcodeSelectionAction == XcodeSelectionActionOptions.Rename;
    
    // Cloud provider state
    private List<CloudSecretsProviderConfig> cloudProviders = new();
    private bool isGrantingLocalVaultAccess;

    // CI/CD Publisher state
    private List<SecretsPublisherConfig> secretsPublishers = new();

    // Backup/Restore state
    private bool isExporting = false;
    private bool isImporting = false;

    protected override async Task OnInitializedAsync()
    {
        if (!PlatformInfo.HasNativeToolbar)
        {
            ToolbarService.SetItems(
                new ToolbarAction("save", "Save", "checkmark"),
                new ToolbarAction("reset", "Reset to Defaults", "trash")
            );
            ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        }
        else if (BridgeHolder.Current is { } bridge)
        {
            bridge.ActionRequested += OnBridgeActionRequested;
        }

        // Sync ViewModel with current theme service state
        ViewModel.Theme = ThemeService.CurrentTheme;
        ViewModel.FontScale = ThemeService.FontScale;
        
        // Subscribe to cloud provider changes
        CloudSecretsService.OnActiveProviderChanged += OnCloudProviderChanged;
        LocalVaultAccess.StateChanged += OnLocalVaultStateChanged;
        
        // Subscribe to secrets publisher changes
        SecretsPublisherService.OnPublishersChanged += OnPublishersChanged;
        
        await LoadAppleIdentities();
        await LoadGoogleIdentities();
        await LoadCloudProviders();
        await LoadSecretsPublishers();
        await LoadGeneralPreferences();
        
        appVersion = TruncateVersion(UpdateService.GetCurrentVersion());
        updateResult = await UpdateService.CheckForUpdateAsync();
    }

    private static string TruncateVersion(string version)
    {
        var plusIndex = version.IndexOf('+');
        if (plusIndex >= 0 && version.Length > plusIndex + 8)
            return version[..(plusIndex + 9)];
        return version;
    }

    private async Task LoadGeneralPreferences()
    {
        try
        {
            var settings = await EncryptedSettings.GetSettingsAsync();
            demoMode = settings.Preferences.DemoMode;
            xcodeArchiveExtractor = NormalizeXcodeArchiveExtractor(settings.Preferences.XcodeArchiveExtractor);
            xcodeBundleSeparator = NormalizeXcodeBundleSeparator(settings.Preferences.XcodeBundleSeparator);
            xcodeSelectionAction = NormalizeXcodeSelectionAction(settings.Preferences.XcodeSelectionAction);
            xcodeCreateSymlinkOnSelect = xcodeSelectionAction == XcodeSelectionActionOptions.None &&
                settings.Preferences.XcodeCreateSymlinkOnSelect;
            provisioningProfilesDirectory = NormalizeProvisioningProfilesDirectory(
                settings.Preferences.ProvisioningProfilesDirectory);
        }
        catch { }
    }

    private void OnCloudProviderChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        if (BridgeHolder.Current is { } bridge)
            bridge.ActionRequested -= OnBridgeActionRequested;
        CloudSecretsService.OnActiveProviderChanged -= OnCloudProviderChanged;
        LocalVaultAccess.StateChanged -= OnLocalVaultStateChanged;
        SecretsPublisherService.OnPublishersChanged -= OnPublishersChanged;
    }

    private bool ShouldShowLocalVaultNotice =>
        LocalVaultAccess.GetState().RequiresUserAction &&
        cloudProviders.Any(p => p.ProviderType == CloudSecretsProviderType.Local);

    private void OnLocalVaultStateChanged()
    {
