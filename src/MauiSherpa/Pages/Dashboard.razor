@page "/"
@using MauiSherpa.Core.ViewModels
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@using MauiSherpa.Pages.Modals
@implements IDisposable
@inject DashboardViewModel ViewModel
@inject IToolbarService ToolbarService
@inject IFormModalService FormModalService
@inject IPlatformService PlatformInfo
@inject IDeviceMonitorService DeviceMonitor
@inject IDoctorService DoctorService
@inject ILoggingService Logger
@inject DeviceInspectorService DeviceInspector
@inject SimInspectorService SimInspector

<div class="dashboard-header">
    <div>
        <h1><i class="fa-solid fa-house fa-fw"></i> @ViewModel.Title</h1>
        <p class="welcome">@ViewModel.WelcomeMessage</p>
    </div>
</div>

<div class="environment-section">
    <div class="section-heading">
        <h2><i class="fa-solid fa-gauge-high fa-fw"></i> Development Environment</h2>
        <div class="section-actions">
            <button class="icon-action" @onclick="RunDoctorAsync" disabled="@isDoctorLoading" title="Refresh environment">
                <i class="fa-solid fa-rotate fa-fw @(isDoctorLoading ? "fa-spin" : null)"></i>
            </button>
            <a class="text-action" href="doctor">View Doctor</a>
        </div>
    </div>

    <div class="environment-grid" aria-busy="@isDoctorLoading">
        @EnvironmentCard("fa-brands fa-microsoft", ".NET", GetDotNetVersion(), GetDotNetDetail(), GetCategoryStatus(DependencyCategory.DotNetSdk))
        @if (PlatformInfo.IsMacCatalyst || PlatformInfo.IsMacOS)
        {
            @EnvironmentCard("fa-brands fa-apple", "Xcode", GetDependencyVersion(DependencyCategory.Xcode, "Xcode"), GetDependencyMessage(DependencyCategory.Xcode, "Xcode"), GetCategoryStatus(DependencyCategory.Xcode))
        }
        @EnvironmentCard("fa-brands fa-java", "JDK", GetDependencyVersion(DependencyCategory.Jdk, "JDK"), GetDependencyMessage(DependencyCategory.Jdk, "JDK"), GetCategoryStatus(DependencyCategory.Jdk))
        @EnvironmentCard("fa-brands fa-android", "Android SDK", GetAndroidVersion(), GetAndroidDetail(), GetCategoryStatus(DependencyCategory.AndroidSdk))
    </div>

    @if (!string.IsNullOrEmpty(doctorError))
    {
        <div class="sherpa-banner sherpa-banner-danger environment-banner" role="status">
            <i class="fa-solid fa-circle-exclamation fa-fw"></i>
            <div class="environment-banner-copy">
                <strong>Environment check failed</strong>
                <span>@doctorError</span>
            </div>
            <button class="btn btn-ghost btn-sm" @onclick="RunDoctorAsync">Retry</button>
        </div>
    }
    else if (doctorReport is not null && (doctorReport.HasErrors || doctorReport.HasWarnings))
    {
        <div class="sherpa-banner @(doctorReport.HasErrors ? "sherpa-banner-danger" : "sherpa-banner-warning") environment-banner">
            <i class="fa-solid fa-triangle-exclamation fa-fw"></i>
            <div class="environment-banner-copy">
                <strong>@GetHealthSummary()</strong>
                <span>@string.Join(" · ", GetAttentionItems().Select(item => item.Name))</span>
            </div>
            <a class="btn btn-ghost btn-sm" href="doctor">Review issues</a>
        </div>
    }
</div>

@* Connected Devices & Simulators *@
<div class="devices-section">
    <h2><i class="fa-solid fa-plug fa-fw"></i> Connected Devices</h2>
    <div class="devices-grid">
        @{
            var snapshot = DeviceMonitor.Current;
            var hasAny = snapshot.AndroidDevices.Count > 0 || snapshot.AndroidEmulators.Count > 0
                || snapshot.BootedSimulators.Count > 0 || snapshot.ApplePhysicalDevices.Count > 0;
        }

        @if (!hasDeviceSnapshot)
        {
            <div class="devices-loading">
                <SherpaListSkeleton Rows="2" Label="Scanning connected devices..." ShowTrailingPill="false" />
            </div>
        }

        @foreach (var device in snapshot.AndroidDevices)
        {
            <div class="device-card">
                <div class="sherpa-icon-well sherpa-icon-well-android">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    <span class="sherpa-brand-badge"><i class="fa-brands fa-android"></i></span>
                </div>
                <div class="device-card-info">
                    <div class="device-card-name">@(device.Model ?? device.Serial)</div>
                    <div class="device-card-detail">Android Device</div>
                </div>
                <button class="btn btn-ghost btn-icon btn-sm" @onclick='() => DeviceInspector.OpenAsync(device.Serial, device.Model ?? device.Serial)' title="Inspect" aria-label="Inspect @(device.Model ?? device.Serial)">
                    <i class="fa-solid fa-magnifying-glass fa-fw"></i>
                </button>
            </div>
        }

        @foreach (var emu in snapshot.AndroidEmulators)
        {
            <div class="device-card">
                <div class="sherpa-icon-well sherpa-icon-well-android">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    <span class="sherpa-brand-badge"><i class="fa-brands fa-android"></i></span>
                </div>
                <div class="device-card-info">
                    <div class="device-card-name">@(emu.Model ?? emu.Serial)</div>
                    <div class="device-card-detail">Android Emulator</div>
                </div>
                <button class="btn btn-ghost btn-icon btn-sm" @onclick='() => DeviceInspector.OpenAsync(emu.Serial, emu.Model ?? emu.Serial)' title="Inspect" aria-label="Inspect @(emu.Model ?? emu.Serial)">
                    <i class="fa-solid fa-magnifying-glass fa-fw"></i>
                </button>
            </div>
        }

        @foreach (var device in snapshot.ApplePhysicalDevices)
        {
            <div class="device-card">
                <div class="sherpa-icon-well sherpa-icon-well-apple">
                    <i class="fa-solid @GetAppleFormFactorIcon(device.Platform, device.Name)"></i>
                    <span class="sherpa-brand-badge"><i class="fa-brands fa-apple"></i></span>
                </div>
                <div class="device-card-info">
                    <div class="device-card-name">@device.Name</div>
                    <div class="device-card-detail">@device.ModelName — @FriendlyPlatform(device.Platform) @device.OsVersion</div>
                </div>
                <button class="btn btn-ghost btn-icon btn-sm" @onclick='() => SimInspector.OpenAsync(device.Identifier, device.Name, SimInspectorTab.Apps, isPhysicalDevice: true)' title="Inspect" aria-label="Inspect @device.Name">
                    <i class="fa-solid fa-magnifying-glass fa-fw"></i>
                </button>
            </div>
        }

        @foreach (var sim in snapshot.BootedSimulators)
        {
            <div class="device-card">
                <div class="sherpa-icon-well sherpa-icon-well-apple">
                    <i class="fa-solid @GetAppleFormFactorIcon(sim.Platform, sim.Name)"></i>
                    <span class="sherpa-brand-badge"><i class="fa-brands fa-apple"></i></span>
                </div>
                <div class="device-card-info">
                    <div class="device-card-name">@sim.Name</div>
                    <div class="device-card-detail">@FriendlyPlatform(sim.Platform) @sim.OsVersion</div>
                </div>
                <button class="btn btn-ghost btn-icon btn-sm" @onclick='() => SimInspector.OpenAsync(sim.Identifier, sim.Name)' title="Inspect" aria-label="Inspect @sim.Name">
                    <i class="fa-solid fa-magnifying-glass fa-fw"></i>
                </button>
            </div>
        }

        @if (hasDeviceSnapshot && !hasAny)
        {
            <div class="devices-empty sherpa-empty-inline">
                <div class="sherpa-empty-inline-lead">
                    <span class="sherpa-icon-well sherpa-icon-well-sm sherpa-icon-well-neutral">
                        <i class="fa-solid fa-plug fa-fw" aria-hidden="true"></i>
                    </span>
                    <div class="sherpa-row-stack">
                        <span class="sherpa-empty-inline-title">No devices connected</span>
                        <span class="sherpa-row-sub">Connect a device or boot a simulator</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .dashboard-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    p.welcome {
        margin: 2px 0 18px;
        font-size: var(--font-size-sm);
        color: var(--text-secondary);
    }

    .environment-section { margin-bottom: var(--space-6); }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        margin-bottom: var(--space-2);
    }

    .section-heading h2 {
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--space-1);
        color: var(--text-primary);
        font-size: var(--font-size-h2);
        font-weight: 650;
    }

    .section-heading h2 i { color: var(--text-muted); font-size: var(--font-size-md); }
    .section-actions { display: flex; align-items: center; gap: var(--space-1); }

    .icon-action, .text-action {
        border: none;
        background: transparent;
        color: var(--accent-primary);
        cursor: pointer;
        font: inherit;
        text-decoration: none;
    }

    .icon-action {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-md);
    }

    .icon-action:hover, .text-action:hover { background: var(--bg-hover); }
    .icon-action:disabled { cursor: default; opacity: 0.55; }
    .text-action { padding: 0.35rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 600; }

    .environment-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: var(--space-2);
    }

    .environment-card {
        min-width: 0;
        padding: 14px;
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .environment-card-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }
    .environment-label {
        flex: 1;
        color: var(--text-secondary);
        font-size: var(--font-size-sm);
        font-weight: 600;
    }
    .environment-card-value {
        margin-top: 10px;
        color: var(--text-primary);
        font-size: 16px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.015em;
    }
    .environment-card-detail {
        margin-top: 2px;
        overflow: hidden;
        color: var(--text-muted);
        font-size: var(--font-size-xs);
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .environment-value-skeleton {
        display: block;
        width: 58%;
        height: 16px;
    }
    .environment-detail-skeleton {
        display: block;
        width: 76%;
        height: 10px;
    }

    .environment-banner {
        display: flex;
        align-items: center;
        margin-top: var(--space-2);
    }

    .environment-banner-copy {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
        gap: 1px;
    }
    .environment-banner-copy strong { font-size: var(--font-size-sm); }
    .environment-banner-copy span {
        overflow: hidden;
        font-size: var(--font-size-xs);
        opacity: 0.86;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Connected Devices */
    .devices-section { margin-bottom: var(--space-6); }

    .devices-section h2 {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        margin: 0 0 var(--space-2);
        color: var(--text-primary);
        font-size: var(--font-size-h2);
        font-weight: 650;
    }

    .devices-section h2 i {
        color: var(--text-muted);
        font-size: var(--font-size-md);
    }

    .devices-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: var(--space-2);
    }
    .devices-loading { grid-column: 1 / -1; }

    .device-card {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        min-width: 0;
        padding: 10px 14px;
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
    }

    .device-card-info {
        flex: 1;
        min-width: 0;
    }

    .device-card-name {
        font-size: var(--font-size-md);
        font-weight: 600;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .device-card-detail {
        overflow: hidden;
        color: var(--text-muted);
        font-size: var(--font-size-xs);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .devices-empty {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: 14px;
        color: var(--text-muted);
        font-size: var(--font-size-sm);
        background: var(--surface-well);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-lg);
    }

    .devices-empty i {
        font-size: 1rem;
        opacity: 0.5;
    }
</style>

@code {
    private DoctorReport? doctorReport;
    private bool isDoctorLoading;
    private bool hasDeviceSnapshot;
    private bool isReleaseNotesOpen;
    private string doctorError = "";
    private bool isDisposed;
    protected override void OnInitialized()
    {
        ToolbarService.SetItems(
            new ToolbarAction("release-notes", "Release Notes", "mountain.2")
        );
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        DeviceMonitor.Changed += OnDevicesChanged;
        hasDeviceSnapshot = HasConnectedDevices(DeviceMonitor.Current);
    }

    protected override Task OnInitializedAsync()
    {
        _ = RunDoctorAsync();
        _ = CompleteInitialDeviceLoadAsync();
        return Task.CompletedTask;
    }

    private async Task CompleteInitialDeviceLoadAsync()
    {
        if (hasDeviceSnapshot)
            return;

        await Task.Delay(500);
        if (!isDisposed)
        {
            hasDeviceSnapshot = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunDoctorAsync()
    {
        if (isDoctorLoading)
            return;

        isDoctorLoading = true;
        doctorError = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            var report = await Task.Run(() => DoctorService.RunDoctorAsync());
            if (!isDisposed)
                doctorReport = report;
        }
        catch (Exception ex)
        {
            Logger.LogError("Dashboard environment check failed", ex);
            if (!isDisposed)
                doctorError = ex.Message;
        }
        finally
        {
            if (!isDisposed)
            {
                isDoctorLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private RenderFragment EnvironmentCard(string icon, string label, string value, string detail, DependencyStatusType? status) => @<div class="environment-card" title="@detail">
            <div class="environment-card-header">
                <span class="sherpa-icon-well sherpa-icon-well-sm @GetIconWellClass(label)"><i class="@($"{icon} fa-fw")"></i></span>
                <span class="environment-label">@label</span>
                <span class="sherpa-badge @GetStatusBadgeClass(status)">
                    <span class="sherpa-dot @GetStatusDotClass(status)" aria-hidden="true"></span>
                    <span>@GetStatusLabel(status)</span>
                </span>
            </div>
            @if (isDoctorLoading && doctorReport is null)
            {
                <div class="environment-card-value"><span class="sherpa-skeleton environment-value-skeleton"></span></div>
                <div class="environment-card-detail"><span class="sherpa-skeleton environment-detail-skeleton"></span></div>
            }
            else
            {
                <div class="environment-card-value">@value</div>
                <div class="environment-card-detail">@detail</div>
            }
        </div>;

    private DependencyStatus? GetDependency(DependencyCategory category, string name) =>
        doctorReport?.Dependencies.FirstOrDefault(dependency => dependency.Category == category && dependency.Name == name);

    private string GetDependencyVersion(DependencyCategory category, string name) =>
        isDoctorLoading && doctorReport is null ? "Checking..." : GetDependency(category, name)?.InstalledVersion ?? "Not found";

    private string GetDependencyMessage(DependencyCategory category, string name) =>
        GetDependency(category, name)?.Message ?? (doctorReport is null ? "Inspecting environment" : "Not installed");

    private string GetDotNetVersion() => doctorReport?.Context.ResolvedSdkVersion
        ?? doctorReport?.Context.ActiveSdkVersion
        ?? GetDependency(DependencyCategory.DotNetSdk, ".NET SDK")?.InstalledVersion
        ?? (isDoctorLoading ? "Checking..." : "Not found");

    private string GetDotNetDetail() => doctorReport?.InstalledWorkloadSetVersion is { Length: > 0 } workload
        ? $"Workload set {workload}"
        : GetDependencyMessage(DependencyCategory.DotNetSdk, ".NET SDK");

    private string GetAndroidVersion() => GetDependency(DependencyCategory.AndroidSdk, "Android Platform")?.InstalledVersion
        ?? (isDoctorLoading ? "Checking..." : "No platform");

    private string GetAndroidDetail()
    {
        var buildTools = GetDependency(DependencyCategory.AndroidSdk, "Build Tools")?.InstalledVersion;
        var sdkPath = GetDependency(DependencyCategory.AndroidSdk, "Android SDK")?.InstalledVersion;
        if (buildTools is not null && sdkPath is not null)
            return $"Build Tools {buildTools} · {sdkPath}";
        return sdkPath ?? GetDependencyMessage(DependencyCategory.AndroidSdk, "Android SDK");
    }

    private DependencyStatusType? GetCategoryStatus(DependencyCategory category)
    {
        var statuses = doctorReport?.Dependencies.Where(dependency => dependency.Category == category).Select(dependency => dependency.Status).ToList();
        if (statuses is null || statuses.Count == 0)
            return null;
        if (statuses.Contains(DependencyStatusType.Error)) return DependencyStatusType.Error;
        if (statuses.Contains(DependencyStatusType.Warning)) return DependencyStatusType.Warning;
        return DependencyStatusType.Ok;
    }

    private static string GetIconWellClass(string label) => label switch
    {
        ".NET" => "sherpa-icon-well-accent",
        "Xcode" => "sherpa-icon-well-apple",
        "JDK" => "sherpa-icon-well-java",
        "Android SDK" => "sherpa-icon-well-android",
        _ => "sherpa-icon-well-neutral"
    };

    private string GetStatusBadgeClass(DependencyStatusType? status) => status switch
    {
        DependencyStatusType.Error => "sherpa-badge-danger",
        DependencyStatusType.Warning => "sherpa-badge-warning",
        DependencyStatusType.Ok or DependencyStatusType.Info => "sherpa-badge-success",
        _ => "sherpa-badge-neutral"
    };

    private string GetStatusDotClass(DependencyStatusType? status) => status switch
    {
        DependencyStatusType.Error => "sherpa-dot-danger",
        DependencyStatusType.Warning => "sherpa-dot-warning",
        DependencyStatusType.Ok or DependencyStatusType.Info => "sherpa-dot-success",
        _ => "sherpa-dot-muted"
    };

    private string GetStatusLabel(DependencyStatusType? status) => status switch
    {
        DependencyStatusType.Error => "Error",
        DependencyStatusType.Warning => "Warning",
        DependencyStatusType.Ok or DependencyStatusType.Info => "Healthy",
        _ => "Checking"
    };

    private string GetHealthSummary() => doctorReport is null
        ? "Environment status unavailable"
        : $"{doctorReport.ErrorCount} errors and {doctorReport.WarningCount} warnings need attention";

    private IReadOnlyList<DependencyStatus> GetAttentionItems() => doctorReport?.Dependencies
        .Where(dependency => dependency.Status is DependencyStatusType.Error or DependencyStatusType.Warning)
        .OrderBy(dependency => dependency.Status == DependencyStatusType.Error ? 0 : 1)
        .Take(3)
        .ToList() ?? [];

    private void OnDevicesChanged(ConnectedDevicesSnapshot _)
    {
        hasDeviceSnapshot = true;
        InvokeAsync(StateHasChanged);
    }

    private static bool HasConnectedDevices(ConnectedDevicesSnapshot snapshot) =>
        snapshot.AndroidDevices.Count > 0
        || snapshot.AndroidEmulators.Count > 0
        || snapshot.BootedSimulators.Count > 0
        || snapshot.ApplePhysicalDevices.Count > 0;

    private async void OnToolbarItemClicked(string actionId)
    {
        if (actionId != "release-notes")
            return;

        await InvokeAsync(async () =>
        {
            if (isReleaseNotesOpen)
                return;

            isReleaseNotesOpen = true;
            try
            {
                var page = new ReleaseNotesPage();
                await FormModalService.ShowViewAsync(page, page.WaitForCloseAsync);
            }
            finally
            {
                isReleaseNotesOpen = false;
            }
        });
    }

    public void Dispose()
    {
        isDisposed = true;
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        DeviceMonitor.Changed -= OnDevicesChanged;
    }

    private static string FriendlyPlatform(string platform) => platform switch
    {
        "com.apple.platform.iphonesimulator" => "iOS",
        "com.apple.platform.iphoneos" => "iOS",
        "com.apple.platform.watchos" or "com.apple.platform.watchsimulator" => "watchOS",
        "com.apple.platform.tvos" or "com.apple.platform.tvsimulator" => "tvOS",
        "com.apple.platform.xros" or "com.apple.platform.xrsimulator" => "visionOS",
        "com.apple.platform.macosx" => "macOS",
        _ => platform
    };

    private static string GetAppleFormFactorIcon(string platform, string name)
    {
        var p = platform.ToLowerInvariant();
        if (p.Contains("watch")) return "fa-clock";
        if (p.Contains("tv")) return "fa-tv";
        if (p.Contains("xr")) return "fa-vr-cardboard";
        if (p.Contains("macos")) return "fa-laptop";
        var n = name.ToLowerInvariant();
        if (n.Contains("ipad") || n.Contains("tablet")) return "fa-tablet-screen-button";
        return "fa-mobile-screen";
    }
}
