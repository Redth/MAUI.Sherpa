@page "/apple-devices"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Requests.Apple
@using MauiSherpa.Services
@using MauiSherpa.Pages.Forms
@using Shiny.Mediator
@inject IMediator Mediator
@inject IAppleConnectService AppleService
@inject IAppleIdentityStateService IdentityState
@inject IAlertService AlertService
@inject BlazorToastService ToastService
@inject IEncryptedSettingsService SettingsService
@inject IFormModalService FormModalService
@implements IDisposable
@inject IToolbarService ToolbarService
@inject IPlatformService PlatformInfo
@inject ILocalVaultAccessService LocalVaultAccess
@inject ILoggingService Logger
@inject MultiOperationModalService MultiOpModal
@inject IProfileDeviceService ProfileDeviceService
@inject IPublishProfileService PublishProfileService
@inject IPublishProfileHealthService PublishProfileHealth
@inject ICloudSecretsService CloudSecretsService
@inject ISecretSyncCoordinator SecretSyncCoordinator

<h1><i class="fas fa-mobile-alt"></i> Registered Devices</h1>

<AppleIdentityPicker />

@if (IdentityState.SelectedIdentity != null && !LocalVaultAccess.GetState().RequiresUserAction)
{
    @if (!PlatformInfo.HasNativeToolbar)
    {
    <div class="toolbar">
        <button class="btn btn-primary" @onclick="@(() => RefreshData(forceRefresh: true))" disabled="@isLoading">
            <i class="fas @(isLoading ? "fa-spinner fa-spin" : "fa-sync-alt")"></i> Refresh
        </button>
        <button class="btn btn-success" @onclick="ShowRegisterDialog" disabled="@isLoading">
            <i class="fas fa-plus"></i> Register Device
        </button>
    </div>
    }

    <!-- Filter Section -->
    @if (!PlatformInfo.HasNativeToolbar)
    {
    <div class="filter-section">
        <div class="search-box">
            <span class="search-icon"><i class="fas fa-search"></i></span>
            <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search devices..." />
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <button class="clear-btn" @onclick="@(() => searchQuery = "")">×</button>
            }
        </div>
        <div class="filter-chips">
            <select @bind="filterPlatform" class="filter-select">
                <option value="">All Platforms</option>
                <option value="IOS">iOS</option>
                <option value="MAC_OS">macOS</option>
            </select>
            <select @bind="filterStatus" class="filter-select">
                <option value="">All Status</option>
                <option value="ENABLED">Enabled</option>
                <option value="DISABLED">Disabled</option>
            </select>
        </div>
        @if (HasActiveFilters)
        {
            <button class="clear-filters-btn" @onclick="ClearFilters">Clear Filters</button>
        }
    </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-bar">@errorMessage</div>
    }

    <div class="results-info">
        Showing @FilteredDevices.Count() of @devices.Count devices
    </div>

    <div class="device-list">
        @if (isLoading && devices.Count == 0)
        {
            <div class="loading-state">
                <div class="loading-spinner">
                    <i class="fab fa-apple"></i>
                </div>
                <div class="loading-title">Loading Devices</div>
                <div class="loading-description">Fetching registered devices from App Store Connect...</div>
            </div>
        }
        else if (!FilteredDevices.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fas @(devices.Count == 0 ? "fa-mobile-alt" : "fa-search")"></i></div>
                <div class="empty-title">@(devices.Count == 0 ? "No devices registered" : "No matching devices")</div>
                <div class="empty-description">@(devices.Count == 0 ? "Register a device UDID to use it for development" : "No devices match your search or filters. Try adjusting your criteria.")</div>
            </div>
        }
        else
        {
            @foreach (var device in FilteredDevices)
            {
                var isEnabled = device.Status == "ENABLED";
                <div class="device-card @(isEnabled ? "" : "disabled")">
                    <div class="device-icon">
                        <i class="fas @GetDeviceIcon(device.DeviceClass)"></i>
                        <i class="fab fa-apple brand-overlay"></i>
                    </div>
                    <div class="device-details">
                        <div class="device-name"><span>@device.Name</span></div>
                        <div class="device-udid"><span class="@(demoMode ? "demo-blur" : "")">@device.Udid</span></div>
                        <div class="device-badges">
                            <span class="badge badge-platform">@device.Platform</span>
                            <span class="badge badge-class">@device.DeviceClass</span>
                            <span class="badge @(isEnabled ? "badge-enabled" : "badge-disabled")">@device.Status</span>
                            @if (!string.IsNullOrEmpty(device.Model))
                            {
                                <span class="badge badge-model">@device.Model</span>
                            }
                        </div>
                    </div>
                    <div class="device-actions">
                        @if (isEnabled)
                        {
                            <button class="btn btn-secondary btn-icon" @onclick="@(() => AddDeviceToProfilesAsync(device))" disabled="@isLoading" title="Add to Provisioning Profiles">
                                <i class="fas fa-id-card"></i>
                            </button>
                            <button class="btn btn-warning btn-icon" @onclick="@(() => ToggleDevice(device, false))" disabled="@isLoading" title="Disable">
                                <i class="fas fa-ban"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success btn-icon" @onclick="@(() => ToggleDevice(device, true))" disabled="@isLoading" title="Enable">
                                <i class="fas fa-check"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>
}

<style>
    h1 { margin-bottom: 1.25rem; font-size: 1.75rem; color: var(--text-primary); }

    .toolbar { margin-bottom: 1rem; display: flex; gap: 0.75rem; }
    .error-bar { background: var(--status-error-bg); color: var(--status-error-text); padding: 0.75rem 1rem; border-radius: 0.75rem; margin-bottom: 1rem; }

    /* Filter Section Styles */
    .filter-section {
        background: var(--card-bg);
        border-radius: var(--card-radius);
        padding: 1rem;
        margin-bottom: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 200px;
    }

    .search-box input {
        width: 100%;
        padding: 0.625rem 36px 0.625rem 36px;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        box-sizing: border-box;
    }

    .search-box input:focus {
        outline: none;
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15);
    }

    .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.875rem;
        opacity: 0.5;
    }

    .clear-btn {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        background: var(--border-color);
        border: none;
        border-radius: 50%;
        width: 1.25rem;
        height: 1.25rem;
        font-size: 0.875rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
    }

    .clear-btn:hover { background: var(--bg-hover); }

    .filter-chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }

    .filter-select {
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        background: var(--card-bg);
        cursor: pointer;
        min-width: 120px;
    }

    .filter-select:focus { outline: none; border-color: var(--accent-primary); }

    .clear-filters-btn {
        padding: 0.5rem 0.75rem;
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        color: var(--text-muted);
        cursor: pointer;
    }

    .clear-filters-btn:hover { background: var(--bg-tertiary); color: var(--text-secondary); }

    .results-info { font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.75rem; }
    .btn i { font-size: 0.75rem; }
    .btn-icon {
        width: 2rem;
        height: 2rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
    }
    .btn-icon i { font-size: 0.8125rem; margin: 0; }

    .device-list { display: flex; flex-direction: column; gap: 0.75rem; }

    .device-card {
        background: var(--card-bg);
        border-radius: var(--card-radius);
        padding: 0.875rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .device-card.disabled { opacity: 0.6; }

    .device-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        background: rgba(147, 51, 234, 0.12);
        color: #9333ea;
        position: relative;
        flex-shrink: 0;
    }

    :global(.theme-dark) .device-icon {
        color: #c084fc;
    }

    .device-icon .brand-overlay {
        position: absolute;
        bottom: 3px;
        right: 3px;
        font-size: 0.7rem;
        color: #999;
        line-height: 1;
    }

    :global(.theme-dark) .device-icon .brand-overlay {
        color: #888;
    }
    .device-details { flex: 1; }
    .device-actions { display: flex; gap: 0.5rem; }
    .device-name { font-weight: 600; font-size: 1rem; color: var(--text-primary); }
    .device-udid { font-family: monospace; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem; }
    .device-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }

    .badge { padding: 2px 0.625rem; border-radius: 0.75rem; font-size: 0.75rem; font-weight: 500; }
    .badge-platform { background: #bee3f8; color: #2c5282; }
    .badge-class { background: var(--bg-hover); color: var(--text-secondary); }
    .badge-model { background: #faf5ff; color: #6b46c1; }
    .badge-enabled { background: var(--status-success-bg); color: var(--status-success-text); }
    .badge-disabled { background: var(--status-error-bg); color: var(--status-error-text); }

    .empty-state { background: var(--card-bg); border-radius: var(--card-radius); padding: 3.75rem 2.5rem; text-align: center; }
    .empty-icon { font-size: 48px; margin-bottom: 1rem; color: #a0aec0; }
    .empty-icon i { font-size: 48px; }
    .empty-title { font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
    .empty-description { color: var(--text-muted); font-size: 0.875rem; }

</style>

@code {
    private List<AppleDevice> devices = new();
    private bool isLoading = false;
    private bool demoMode = false;
    private string errorMessage = "";

    // Filter state
    private string searchQuery = "";
    private string filterPlatform = "";
    private string filterStatus = "";

    private bool HasActiveFilters => !string.IsNullOrEmpty(searchQuery) || 
                                      !string.IsNullOrEmpty(filterPlatform) ||
                                      !string.IsNullOrEmpty(filterStatus);

    private IEnumerable<AppleDevice> FilteredDevices => devices
        .Where(d => string.IsNullOrEmpty(searchQuery) || 
                    d.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    d.Udid.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (d.Model?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(d => string.IsNullOrEmpty(filterPlatform) || (d.Platform?.Equals(filterPlatform, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(d => string.IsNullOrEmpty(filterStatus) || (d.Status?.Equals(filterStatus, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderByDescending(d => d.Status == "ENABLED") // Enabled first
        .ThenBy(d => d.Name);

    private void ClearFilters()
    {
        searchQuery = "";
        filterPlatform = "";
        filterStatus = "";
    }

    protected override async Task OnInitializedAsync()
    {
        ToolbarService.SetItems(
            new ToolbarAction("refresh", "Refresh", "arrow.clockwise"),
            new ToolbarAction("create", "Register Device", "plus")
        );
        ToolbarService.SetSearch("Search devices...");
        ToolbarService.SetFilters(
            new ToolbarFilter("platform", "Platform", ["All Platforms", "iOS", "macOS"]),
            new ToolbarFilter("status", "Status", ["All Statuses", "Enabled", "Disabled"])
        );
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        ToolbarService.SearchTextChanged += OnSearchTextChanged;
        ToolbarService.FilterChanged += OnFilterChanged;

        try { var settings = await SettingsService.GetSettingsAsync(); demoMode = settings.Preferences.DemoMode; } catch { }
        IdentityState.OnSelectionChanged += OnIdentityChanged;
        if (IdentityState.SelectedIdentity != null)
            await RefreshData(forceRefresh: false); // Use cache on initial load
    }

    private void OnIdentityChanged()
    {
        InvokeAsync(async () =>
        {
            await RefreshData(forceRefresh: false); // Use cache when identity changes (different identity = different cache key)
            StateHasChanged();
        });
    }

    private void OnSearchTextChanged(string text)
    {
        InvokeAsync(() => { searchQuery = text; StateHasChanged(); });
    }

    private void OnFilterChanged(string filterId, int selectedIndex)
    {
        InvokeAsync(() =>
        {
            switch (filterId)
            {
                case "platform":
                    filterPlatform = selectedIndex switch { 1 => "IOS", 2 => "MAC_OS", _ => "" };
                    break;
                case "status":
                    filterStatus = selectedIndex switch { 1 => "ENABLED", 2 => "DISABLED", _ => "" };
                    break;
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        ToolbarService.SearchTextChanged -= OnSearchTextChanged;
        ToolbarService.FilterChanged -= OnFilterChanged;
        IdentityState.OnSelectionChanged -= OnIdentityChanged;
    }

    private void OnToolbarItemClicked(string actionId)
    {
        InvokeAsync(async () =>
        {
            switch (actionId)
            {
                case "refresh":
                    ToolbarService.SetItemEnabled("refresh", false);
                    try { await RefreshData(forceRefresh: true); } finally { ToolbarService.SetItemEnabled("refresh", true); }
                    break;
                case "create": await ShowRegisterDialog(); break;
            }
            StateHasChanged();
        });
    }

    private string GetDeviceIcon(string deviceClass) => deviceClass.ToUpperInvariant() switch
    {
        "IPHONE" => "fa-mobile-alt",
        "IPAD" => "fa-tablet-alt",
        "APPLE_WATCH" => "fa-clock",
        "APPLE_TV" => "fa-tv",
        "MAC" => "fa-laptop",
        _ => "fa-mobile-alt"
    };

    private async Task RefreshData(bool forceRefresh = false)
    {
        if (IdentityState.SelectedIdentity == null || LocalVaultAccess.GetState().RequiresUserAction)
            return;

        if (IdentityState.SelectedIdentity == null) return;

        isLoading = true;
        errorMessage = "";
        
        ToastMessage? toast = null;
        if (forceRefresh)
        {
            toast = ToastService.Show("Refreshing devices...", ToastType.Info);
        }
        
        try
        {
            // If force refresh, invalidate the cache first
            if (forceRefresh)
            {
                await Mediator.FlushStores($"apple:devices:{IdentityState.SelectedIdentity.Id}");
            }
            
            var request = new GetAppleDevicesRequest(IdentityState.SelectedIdentity.Id);
            var (_, result) = await Mediator.Request(request);
            devices = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load devices: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            if (toast != null) ToastService.Dismiss(toast);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ShowRegisterDialog()
    {
        var result = await FormModalService.ShowAsync<RegisterDeviceFormResult>(new RegisterDevicePage(AppleService));
        if (result == null) return;

        await AlertService.ShowToastAsync($"Device '{result.Device.Name}' registered!");
        await RefreshData(forceRefresh: true);

        if (result.AddToProfiles)
            await AddDeviceToProfilesAsync(result.Device);
    }

    // ------------------------------------------------------------------
    // Adding a device to provisioning profiles
    // ------------------------------------------------------------------

    private const string RemoveOldCopyOptionId = "remove-old-installed-copy";

    private async Task AddDeviceToProfilesAsync(AppleDevice device)
    {
        var identity = IdentityState.SelectedIdentity;
        if (identity == null)
            return;

        // Profiles are deleted and recreated from this list, so never work from a stale cache.
        List<AppleProfile> profiles;
        var loadingToast = ToastService.Show("Finding provisioning profiles for this device...", ToastType.Info);
        try
        {
            await Mediator.FlushStores($"apple:profiles:{identity.Id}");
            var (_, result) = await Mediator.Request(new GetProfilesRequest(identity.Id));
            profiles = result.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to load provisioning profiles for device '{device.Name}': {ex.Message}", ex);
            await AlertService.ShowAlertAsync("Add to Provisioning Profiles", $"Provisioning profiles couldn't be loaded: {ex.Message}");
            return;
        }
        finally
        {
            ToastService.Dismiss(loadingToast);
        }

        var candidates = ProfileDeviceService.FindProfilesForDevice(profiles, device);
        if (candidates.Count == 0)
        {
            await AlertService.ShowAlertAsync(
                "Add to Provisioning Profiles",
                $"There are no active development or ad hoc provisioning profiles that '{device.Name}' can be added to.");
            return;
        }

        var results = new List<ProfileDeviceResult>();
        var operations = candidates.Select(profile => new OperationItem(
            Id: profile.Id,
            Name: profile.Name,
            Description: string.Join(" · ", new[]
            {
                FormatProfileType(profile.ProfileType),
                profile.BundleId,
                $"expires {profile.ExpirationDate:MMM d, yyyy}"
            }.Where(part => !string.IsNullOrWhiteSpace(part))),
            Execute: async ctx =>
            {
                var result = await ProfileDeviceService.AddDeviceToProfileAsync(
                    profile,
                    device,
                    ctx.IsSecondaryOptionEnabled(RemoveOldCopyOptionId),
                    new ActionProgress(ctx.LogInfo),
                    ctx.CancellationToken);
                lock (results)
                    results.Add(result);

                if (result.RegeneratedProfile is not { } regenerated)
                {
                    ctx.LogSuccess($"Already includes '{device.Name}', left unchanged");
                    return true;
                }

                ctx.LogSuccess($"Recreated '{regenerated.Name}' with '{device.Name}' (UUID {regenerated.Uuid})");
                foreach (var dropped in result.DroppedDevices)
                    ctx.LogWarning($"Left out disabled device '{dropped.Name}'");

                if (!result.Installed)
                {
                    ctx.LogError($"The profile was recreated in Apple Developer but couldn't be installed: {result.InstallError}. Install it from Provisioning Profiles.");
                    return false;
                }

                ctx.LogSuccess($"Installed {Path.GetFileName(result.InstalledPath)}");
                if (result.RemovedInstalledPaths.Count > 0)
                    ctx.LogInfo($"Removed {result.RemovedInstalledPaths.Count} old installed copy(ies)");
                return true;
            },
            IsEnabled: true,
            CanDisable: true,
            SecondaryOptions: string.IsNullOrWhiteSpace(profile.Uuid)
                ? null
                : [new OperationSecondaryOption(RemoveOldCopyOptionId, "Remove the old installed copy from this machine", DefaultEnabled: true)]
        )).ToList();

        var description =
            $"Each selected profile is deleted in Apple Developer and recreated with the same name, type, bundle ID, certificates " +
            $"and devices, plus '{device.Name}'. Disabled devices are left out and profiles that already include the device are " +
            "left unchanged. Each recreated profile gets a new UUID and is installed on this machine. " +
            "Deselect any profile you want to leave unchanged.";
        if (profiles.Count >= IAppleConnectService.ProfileListLimit)
        {
            description += $" This team has at least {IAppleConnectService.ProfileListLimit} provisioning profiles, " +
                "more than Sherpa can read in one request, so some profiles may be missing from this list.";
        }

        var outcome = await MultiOpModal.RunAsync("Add Device to Provisioning Profiles", description, operations);

        var regeneratedResults = results.Where(result => !result.AlreadyIncluded).ToList();
        foreach (var result in regeneratedResults)
            PublishProfileHealth.RecordProvisioningProfileReplacement(result.OriginalProfile.Id, result.RegeneratedProfile!.Id);
        if (regeneratedResults.Count > 0)
            await Mediator.FlushStores($"apple:profiles:{identity.Id}");

        if (outcome.Failed > 0)
        {
            await AlertService.ShowAlertAsync(
                "Some Profiles Need Attention",
                $"{outcome.Completed} profile(s) updated; {outcome.Failed} failed. " +
                "A profile that failed before it was deleted is unchanged. Check the progress log of each failed profile for details.");
        }

        await OfferPublishProfileUpdatesAsync(regeneratedResults, profiles);
    }

    private async Task OfferPublishProfileUpdatesAsync(
        IReadOnlyList<ProfileDeviceResult> regenerated,
        IReadOnlyList<AppleProfile> profilesBefore)
    {
        PublishProfileHealth.Invalidate();
        if (regenerated.Count == 0 || CloudSecretsService.ActiveProvider is null)
            return;

        IReadOnlyList<PublishProfile> publishProfiles;
        try
        {
            publishProfiles = await PublishProfileService.GetProfilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Could not load publish profiles after adding a device: {ex.Message}");
            return;
        }

        var profileMap = regenerated
            .GroupBy(result => result.OriginalProfile.Id)
            .ToDictionary(group => group.Key, group => group.Last().RegeneratedProfile!);

        var updates = publishProfiles
            .Select(profile => (Original: profile, Updated: PublishProfileHealth.Repoint(
                profile, new Dictionary<string, AppleCertificate>(), profileMap, profilesBefore, [])))
            .Where(pair => !ReferenceEquals(pair.Original, pair.Updated))
            .ToList();
        if (updates.Count == 0)
            return;

        var names = string.Join(", ", updates.Take(5).Select(pair => $"'{pair.Original.Name}'"));
        if (updates.Count > 5)
            names += $" and {updates.Count - 5} more";

        var confirmed = await AlertService.ShowConfirmAsync(
            "Update Publish Profiles",
            $"{updates.Count} publish profile(s) use a recreated provisioning profile: {names}.\n\n" +
            "Update them to use the recreated provisioning profiles? " +
            "If you skip this, they show an \"updated\" badge on the Publish Profiles page with a one-click fix.",
            "Update",
            "Not Now");
        if (!confirmed)
            return;

        var saved = 0;
        var failures = new List<string>();
        foreach (var (original, updated) in updates)
        {
            try
            {
                await PublishProfileService.SaveProfileAsync(updated);
                if (CloudSecretsService.ActiveProvider is { } provider)
                {
                    await SecretSyncCoordinator.ResolveConflictAsync(
                        new SecretItemRef(SecretItemKind.PublishProfile, updated.Id, updated.Name),
                        provider.Id);
                }
                saved++;
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to update publish profile '{original.Name}': {ex.Message}", ex);
                failures.Add($"'{original.Name}': {ex.Message}");
            }
        }

        if (failures.Count > 0)
        {
            await AlertService.ShowAlertAsync(
                "Publish Profiles",
                $"Updated {saved} publish profile(s). These couldn't be saved:\n{string.Join("\n", failures)}");
        }
        else
        {
            await AlertService.ShowToastAsync($"Updated {saved} publish profile(s)");
        }
    }

    private static string FormatProfileType(string profileType) => profileType switch
    {
        "IOS_APP_DEVELOPMENT" => "iOS Development",
        "IOS_APP_ADHOC" => "iOS Ad Hoc",
        "MAC_APP_DEVELOPMENT" => "macOS Development",
        "MAC_CATALYST_APP_DEVELOPMENT" => "Mac Catalyst Development",
        "TVOS_APP_DEVELOPMENT" => "tvOS Development",
        "TVOS_APP_ADHOC" => "tvOS Ad Hoc",
        _ => profileType.Replace("_", " ")
    };

    /// <summary>Reports progress synchronously so log lines stay in order.</summary>
    private sealed class ActionProgress(Action<string> report) : IProgress<string>
    {
        public void Report(string value) => report(value);
    }

    private async Task ToggleDevice(AppleDevice device, bool enable)
    {
        isLoading = true;
        try
        {
            await AppleService.UpdateDeviceStatusAsync(device.Id, enable);
            await AlertService.ShowToastAsync($"Device {(enable ? "enabled" : "disabled")}");
            await RefreshData(forceRefresh: true);
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to update device: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

}
