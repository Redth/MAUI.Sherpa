@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using Shiny.Blazor.Controls.Agents
@using Shiny.Controls.AgentUI
@inject ICopilotService CopilotService
@inject ICopilotAgentService AgentService
@inject IAlertService AlertService
@inject ICopilotToolsService ToolsService
@inject ICopilotContextService ContextService
@inject IJSRuntime JSRuntime
@inject ILoggingService _logger
@inject ILauncher AppLauncher
@inject IClipboard AppClipboard
@implements IDisposable

<div class="copilot-page @(IsEmbedded ? "embedded" : "")">

@if (ShowHeader)
{
    <div class="copilot-header">
        <div class="copilot-header__left">
            <img src="_content/MauiSherpa/ghcp_icon_white.png" alt="" class="copilot-header__icon" onerror="this.style.display='none'" />
            <span class="copilot-header__title">Copilot</span>
            <span class="copilot-header__dot @(CopilotService.IsConnected ? "connected" : "")"></span>
            <span class="copilot-header__status">@(CopilotService.IsConnected ? "Connected" : "Disconnected")</span>
            @if (availability?.Login != null)
            {
                <span class="copilot-header__badge">@@@(availability.Login)</span>
            }
            @if (availability?.Version != null)
            {
                <span class="copilot-header__version">v@(availability.Version)</span>
            }
        </div>
        <div class="copilot-header__right">
            @if (isConnecting)
            {
                <span class="copilot-header__connecting"><i class="fas fa-spinner fa-spin"></i></span>
            }
            else if (!CopilotService.IsConnected)
            {
                <button class="copilot-header__btn copilot-header__btn--connect" @onclick="Connect">Connect</button>
            }
            else
            {
                <button class="copilot-header__btn copilot-header__btn--disconnect" @onclick="Disconnect">Disconnect</button>
            }
            <button class="copilot-header__btn copilot-header__btn--close" @onclick="OnClose">✕</button>
        </div>
    </div>
}

@if (!IsEmbedded)
{
    <h1><i class="fas fa-robot"></i> GitHub Copilot</h1>
}

@if (isCheckingAvailability)
{
    <div class="checking-status">
        <div class="loading-spinner"><i class="fas fa-spinner fa-spin"></i></div>
        <div class="loading-text">Checking Copilot availability...</div>
    </div>
}
else if (availability != null && !availability.IsInstalled)
{
    <!-- Copilot Not Installed -->
    <div class="setup-required">
        <div class="setup-icon error"><i class="fas fa-exclamation-triangle"></i></div>
        <h2>GitHub Copilot CLI Not Found</h2>
        <p>The GitHub Copilot CLI needs to be installed to use this feature.</p>
        
        <div class="setup-steps">
            <div class="step">
                <div class="step-number">1</div>
                <div class="step-content">
                    <strong>Install GitHub Copilot CLI</strong>
                    <p>Visit the GitHub Copilot website to download and install the CLI tool.</p>
                    <a href="#" @onclick:preventDefault 
                       @onclick='() => OpenUrl("https://docs.github.com/en/copilot/managing-copilot/configure-personal-settings/installing-the-github-copilot-extension-in-your-environment")'
                       class="btn btn-primary">
                        <i class="fas fa-external-link-alt"></i> Get GitHub Copilot CLI
                    </a>
                </div>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <div class="step-content">
                    <strong>Verify Installation</strong>
                    <p>After installation, run <code>copilot --version</code> in your terminal to verify.</p>
                </div>
            </div>
        </div>

        <button class="btn btn-secondary" @onclick="@(() => CheckAvailability(forceRefresh: true))">
            <i class="fas fa-sync-alt"></i> Check Again
        </button>
    </div>
}
else if (availability != null && !availability.IsAuthenticated)
{
    <!-- Copilot Not Authenticated -->
    <div class="setup-required">
        <div class="setup-icon warning"><i class="fas fa-sign-in-alt"></i></div>
        <h2>Authentication Required</h2>
        <p>You need to log in to GitHub Copilot before you can use it.</p>
        @if (!string.IsNullOrEmpty(availability.Version))
        {
            <p class="version-info"><i class="fas fa-check-circle"></i> Copilot CLI installed (v@(availability.Version))</p>
        }
        
        <div class="setup-steps">
            <div class="step">
                <div class="step-number">1</div>
                <div class="step-content">
                    <strong>Open Terminal</strong>
                    <p>Open your terminal or command prompt.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <div class="step-content">
                    <strong>Run Login Command</strong>
                    <p>Run the following command to authenticate:</p>
                    <div class="code-block">
                        <code>copilot auth login</code>
                        <button class="btn-copy-code" @onclick="@(() => CopyToClipboard("copilot auth login"))" title="Copy">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-content">
                    <strong>Follow Browser Prompts</strong>
                    <p>Complete the authentication in your browser when prompted.</p>
                </div>
            </div>
        </div>

        <button class="btn btn-secondary" @onclick="@(() => CheckAvailability(forceRefresh: true))">
            <i class="fas fa-sync-alt"></i> Check Again
        </button>
    </div>
}
else
{
    <!-- Copilot Available -->
    @if (!IsEmbedded)
    {
    <div class="connection-status @(CopilotService.IsConnected ? "connected" : "disconnected")">
        <span class="status-indicator"></span>
        <span class="status-text">
            @(CopilotService.IsConnected ? "Connected" : "Disconnected")
            @if (availability?.Login != null)
            {
                <span class="login-badge">@@@(availability.Login)</span>
            }
            @if (availability?.Version != null)
            {
                <span class="version-badge">v@(availability.Version)</span>
            }
        </span>
        @if (!CopilotService.IsConnected)
        {
            <button class="btn btn-sm btn-primary" @onclick="Connect" disabled="@isConnecting">
                <i class="fas @(isConnecting ? "fa-spinner fa-spin" : "fa-plug")"></i>
                @(isConnecting ? "Connecting..." : "Connect")
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-secondary" @onclick="Disconnect">
                <i class="fas fa-unlink"></i> Disconnect
            </button>
        }
    </div>
    }

    @if (!CopilotService.IsConnected && !isConnecting)
    {
        <div class="welcome-section">
            <div class="welcome-icon"><i class="fas fa-robot"></i></div>
            <h2>Welcome to Copilot</h2>
            <p>Connect to GitHub Copilot to get AI-powered assistance with your development environment.</p>
            <button class="btn btn-primary btn-lg" @onclick="Connect">
                <i class="fas fa-plug"></i> Connect to Copilot
            </button>
        </div>
    }
    else
    {
        <div class="chat-layout">
            <div class="chat-container">
                <div class="model-selector">
                    <label for="copilot-model"><i class="fas fa-robot"></i> Model</label>
                    <select id="copilot-model" value="@selectedModel" @onchange="SelectModelAsync" disabled="@(isBusy || isConnecting)">
                        @foreach (var model in availableModels)
                        {
                            <option value="@model.Id">@model.Name</option>
                        }
                    </select>
                    <button class="model-selector__new-chat" @onclick="NewChatAsync" disabled="@(isBusy || isConnecting)" title="Start a new conversation">
                        <i class="fas fa-plus"></i> New chat
                    </button>
                </div>

                <div class="copilot-agent-host">
                    <AgentView @ref="agentView"
                               Runner="AgentService.Runner"
                               Prompts="AgentService.Prompts"
                               Catalogs="AgentService.Catalogs"
                               Suggestions="suggestions"
                               PlaceholderText="Ask Copilot something..."
                               ShowSteps="true"
                               ToolCallTemplates="toolTemplates"
                               CssClass="copilot-agent-view" />
                </div>

                @if (currentUsageInfo != null || CopilotService.IsConnected)
                {
                    <div class="usage-info @(currentUsageInfo == null ? "subtle" : "")">
                        <span class="usage-item"><i class="fas fa-robot"></i> @(currentUsageInfo?.Model ?? SelectedModelDisplayName)</span>
                        @if (currentUsageInfo?.InputTokens.HasValue == true || currentUsageInfo?.OutputTokens.HasValue == true)
                        {
                            <span class="usage-item">
                                <i class="fas fa-arrow-right"></i> @(currentUsageInfo.InputTokens ?? 0)
                                <i class="fas fa-arrow-left"></i> @(currentUsageInfo.OutputTokens ?? 0)
                            </span>
                        }
                        @if (currentUsageInfo?.CurrentTokens.HasValue == true && currentUsageInfo.TokenLimit.HasValue)
                        {
                            <span class="usage-item"><i class="fas fa-database"></i> @currentUsageInfo.CurrentTokens / @currentUsageInfo.TokenLimit</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@* Debug Overlay *@
@if (showDebugOverlay)
{
    <div class="debug-overlay @(debugOverlayExpanded ? "expanded" : "")">
        <div class="debug-header">
            <span class="debug-title"><i class="fas fa-bug"></i> Debug Logs</span>
            <div class="debug-controls">
                <input type="text" class="debug-filter" placeholder="Filter logs..." 
                       @bind="debugFilter" @bind:event="oninput" />
                <button class="debug-btn" @onclick="CopyFilteredLogs" title="Copy filtered logs">
                    <i class="fas fa-copy"></i>
                </button>
                <button class="debug-btn" @onclick="ClearDebugLogs" title="Clear logs">
                    <i class="fas fa-trash"></i>
                </button>
                <button class="debug-btn" @onclick="ToggleDebugExpanded" title="@(debugOverlayExpanded ? "Collapse" : "Expand")">
                    <i class="fas @(debugOverlayExpanded ? "fa-compress-alt" : "fa-expand-alt")"></i>
                </button>
                <button class="debug-btn" @onclick="() => showDebugOverlay = false" title="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        <div class="debug-content" @ref="debugContentRef">
            @foreach (var log in GetFilteredLogs())
            {
                <div class="debug-log @GetLogLevelClass(log.Level)">
                    <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="log-level">[@log.Level]</span>
                    <span class="log-message">@log.Message</span>
                </div>
            }
        </div>
    </div>
}

@* Debug Toggle Button *@
@if (!IsEmbedded)
{
<button class="debug-toggle-btn" @onclick="() => showDebugOverlay = !showDebugOverlay" title="Toggle Debug Overlay">
    <i class="fas fa-bug"></i>
</button>
}

</div> @* Close copilot-page *@
<style>
    .copilot-page {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    
    .copilot-page.embedded {
        height: 100%;
        overflow: hidden;
    }
    
    .copilot-page.embedded .chat-layout {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    
    .copilot-page.embedded .chat-container {
        flex: 1;
        height: auto !important;
        min-height: 0 !important;
        background: transparent;
        border-radius: 0;
    }

    h1 {
        margin-bottom: 1.25rem;
        font-size: 1.75rem;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    h1 i { color: #6366f1; }

    /* Checking/Loading State */
    .checking-status {
        background: var(--card-bg);
        border-radius: 0.75rem;
        padding: 3.75rem 2.5rem;
        text-align: center;
    }

    .checking-status .loading-spinner {
        font-size: 48px;
        color: #6366f1;
        margin-bottom: 1rem;
    }

    .checking-status .loading-text {
        color: var(--text-muted);
        font-size: 1rem;
    }

    /* Setup Required States */
    .setup-required {
        background: var(--card-bg);
        border-radius: 0.75rem;
        padding: 2.5rem;
    }

    .setup-icon {
        font-size: 48px;
        margin-bottom: 1.25rem;
    }

    .setup-icon.error { color: var(--accent-danger); }
    .setup-icon.warning { color: var(--accent-warning); }

    .setup-required h2 {
        font-size: 1.5rem;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
    }

    .setup-required > p {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        max-width: 600px;
    }

    .version-info {
        color: var(--accent-success);
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
    }

    .version-info i { margin-right: 0.375rem; }

    .setup-steps {
        background: var(--bg-tertiary);
        border-radius: 0.5rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .step {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .step:last-child { margin-bottom: 0; }

    .step-number {
        width: 2rem;
        height: 2rem;
        background: #6366f1;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .step-content {
        flex: 1;
    }

    .step-content strong {
        display: block;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .step-content p {
        color: var(--text-muted);
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
    }

    .step-content code {
        background: #1E1E1E;
        color: #68d391;
        padding: 2px 0.5rem;
        border-radius: 0.25rem;
        font-family: 'SF Mono', Menlo, Monaco, monospace;
        font-size: 0.8125rem;
    }

    .code-block {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #1E1E1E;
        padding: 0.75rem 1rem;
        border-radius: 0.375rem;
    }

    .code-block code {
        background: transparent;
        padding: 0;
        flex: 1;
    }

    .btn-copy-code {
        background: transparent;
        border: none;
        color: #a0aec0;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
    }

    .btn-copy-code:hover {
        color: white;
        background: rgba(255,255,255,0.1);
    }

    .connection-status {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: var(--card-bg);
        border-radius: var(--card-radius);
        margin-bottom: 1.25rem;
    }

    .status-indicator {
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 50%;
    }

    .connection-status.connected .status-indicator { background: var(--accent-success); }
    .connection-status.disconnected .status-indicator { background: var(--accent-danger); }

    .status-text {
        font-weight: 600;
        color: var(--text-secondary);
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .version-badge {
        font-size: 0.75rem;
        font-weight: normal;
        color: var(--text-muted);
        background: var(--bg-hover);
        padding: 2px 0.5rem;
        border-radius: 0.25rem;
    }

    .login-badge {
        font-size: 0.75rem;
        font-weight: 500;
        color: #6366f1;
        background: #eef2ff;
        padding: 2px 0.5rem;
        border-radius: 0.25rem;
    }

    .welcome-section {
        background: var(--card-bg);
        border-radius: 0.75rem;
        padding: 3.75rem 2.5rem;
        text-align: center;
    }

    .welcome-icon {
        font-size: 64px;
        color: #6366f1;
        margin-bottom: 1.25rem;
    }

    .welcome-section h2 {
        font-size: 1.5rem;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
    }

    .welcome-section p {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
    }

    .chat-layout {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .model-selector {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-secondary);
        font-size: 0.8rem;
    }

    .model-selector label {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 600;
    }

    .model-selector select {
        min-width: 10rem;
        max-width: 16rem;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: var(--bg-tertiary);
        color: var(--text-primary);
        font: inherit;
    }

    .chat-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 280px);
        min-height: 400px;
        background: var(--card-bg);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .usage-info {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.375rem 0.75rem;
        margin-bottom: 0.5rem;
        font-size: 0.6875rem;
        color: #6366f1;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(139, 92, 246, 0.08) 100%);
        border-radius: 0.5rem;
        border: 1px solid rgba(99, 102, 241, 0.15);
        flex-shrink: 0;
        min-height: 1.5rem;
    }
    
    .usage-item {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    
    .usage-item i {
        font-size: 0.625rem;
        opacity: 0.7;
    }
    
    .usage-info.subtle {
        opacity: 0.7;
    }
    
    .usage-item.muted {
        font-style: italic;
        opacity: 0.6;
    }

    /* Debug Overlay Styles */
    .debug-toggle-btn {
        position: fixed;
        bottom: 1.25rem;
        right: 1.25rem;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
        box-shadow: 0 2px 0.5rem rgba(0, 0, 0, 0.15);
        transition: all 0.2s ease;
    }

    .debug-toggle-btn:hover {
        background: #6366f1;
        color: white;
        border-color: #6366f1;
    }

    .debug-overlay {
        position: fixed;
        bottom: 80px;
        right: 1.25rem;
        width: 500px;
        height: 300px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
        box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.2);
        z-index: 1000;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: all 0.2s ease;
    }

    .debug-overlay.expanded {
        width: 1000px;
        height: 700px;
        bottom: 2.5rem;
        right: 2.5rem;
    }

    .debug-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        background: rgba(99, 102, 241, 0.1);
        border-bottom: 1px solid var(--border-color);
    }

    .debug-title {
        font-weight: 600;
        color: #6366f1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .debug-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .debug-filter {
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        background: var(--input-bg, var(--card-bg));
        color: var(--text-primary);
        font-size: 0.8125rem;
        width: 150px;
    }

    .debug-filter:focus {
        outline: none;
        border-color: #6366f1;
    }

    .debug-btn {
        width: 2rem;
        height: 2rem;
        border: none;
        border-radius: 0.375rem;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .debug-btn:hover {
        background: rgba(99, 102, 241, 0.15);
        color: #6366f1;
    }

    .debug-content {
        flex: 1;
        overflow-y: auto;
        font-family: 'SF Mono', Consolas, monospace;
        font-size: 0.75rem;
        padding: 0.5rem;
        background: #f8fafc;
    }
    
    .theme-dark .debug-content {
        background: #1e1e2e;
    }

    .debug-log {
        display: flex;
        gap: 0.5rem;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .debug-log:hover {
        background: rgba(99, 102, 241, 0.1);
    }

    .log-time {
        color: #64748b;
        flex-shrink: 0;
    }

    .log-level {
        flex-shrink: 0;
        font-weight: 600;
    }

    .log-message {
        color: #1e293b;
    }
    
    .theme-dark .log-time {
        color: #94a3b8;
    }
    
    .theme-dark .log-message {
        color: #e2e8f0;
    }

    .debug-log.log-dbg .log-level { color: #64748b; }
    .debug-log.log-inf .log-level { color: #2563eb; }
    .debug-log.log-wrn .log-level { color: #d97706; }
    .debug-log.log-err .log-level { color: #dc2626; }
    .debug-log.log-err { background: rgba(239, 68, 68, 0.15); }
    
    .theme-dark .debug-log.log-dbg .log-level { color: #94a3b8; }
    .theme-dark .debug-log.log-inf .log-level { color: #60a5fa; }
    .theme-dark .debug-log.log-wrn .log-level { color: #fbbf24; }
    .theme-dark .debug-log.log-err .log-level { color: #f87171; }

    .theme-dark .chat-container {
        background: var(--card-bg);
    }

    .theme-dark .login-badge {
        background: rgba(99, 102, 241, 0.2);
        color: #a78bfa;
    }

    /* ─── Blazor Header Bar ─── */
    .copilot-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        padding: 0.625rem 1rem;
        flex-shrink: 0;
        min-height: 44px;
        box-sizing: border-box;
    }

    .copilot-header__left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .copilot-header__icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .copilot-header__title {
        font-size: 0.9375rem;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
    }

    .copilot-header__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #f56565;
        flex-shrink: 0;
    }

    .copilot-header__dot.connected {
        background: #48bb78;
    }

    .copilot-header__status {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.7);
        white-space: nowrap;
    }

    .copilot-header__badge {
        font-size: 0.6875rem;
        color: #fff;
        background: rgba(255, 255, 255, 0.15);
        padding: 0.125rem 0.5rem;
        border-radius: 0.75rem;
        white-space: nowrap;
    }

    .copilot-header__version {
        font-size: 0.6875rem;
        color: rgba(255, 255, 255, 0.5);
        white-space: nowrap;
    }

    .copilot-header__right {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        flex-shrink: 0;
    }

    .copilot-header__connecting {
        color: #fff;
        font-size: 0.875rem;
    }

    .copilot-header__btn {
        border: none;
        border-radius: 0.25rem;
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s;
        line-height: 1.4;
    }

    .copilot-header__btn:hover {
        opacity: 0.85;
    }

    .copilot-header__btn--connect {
        background: #fff;
        color: #6366f1;
    }

    .copilot-header__btn--disconnect {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
    }

    .copilot-header__btn--close {
        background: transparent;
        color: rgba(255, 255, 255, 0.7);
        font-size: 1rem;
        padding: 0.125rem 0.375rem;
        line-height: 1;
    }

    .copilot-header__btn--close:hover {
        color: #fff;
        opacity: 1;
    }
    .model-selector__new-chat {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.6rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: var(--bg-tertiary);
        color: var(--text-primary);
        font: inherit;
        cursor: pointer;
    }

    .model-selector__new-chat:hover:not(:disabled) {
        background: var(--bg-hover);
    }

    .model-selector__new-chat:disabled {
        opacity: 0.5;
        cursor: default;
    }

    /* AgentView fills the space between the model bar and the usage bar and owns its own scroll */
    .copilot-agent-host {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .copilot-agent-host .copilot-agent-view {
        flex: 1;
        min-height: 0;
        height: 100%;
    }

    /* The global user-select: none would stop the user copying replies and tool output */
    .copilot-agent-view .agent-items *,
    .copilot-agent-view textarea {
        user-select: text;
        -webkit-user-select: text;
    }

    .chat-container > .usage-info {
        margin: 0.5rem 0.75rem;
    }

    /* Tool result tables (CopilotToolResultCard) */
    .copilot-result-card {
        margin: 0.25rem 0;
        border: 1px solid var(--border-color-light);
        border-radius: 0.5rem;
        background: var(--bg-primary);
        overflow: hidden;
        font-size: 0.8125rem;
    }

    .copilot-result-head {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.45rem 0.75rem;
        border: none;
        background: var(--bg-secondary);
        color: var(--text-primary);
        font: inherit;
        cursor: pointer;
    }

    .copilot-result-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
    }

    .copilot-result-title > i {
        color: var(--accent-primary);
    }

    .copilot-result-count {
        padding: 0 0.45rem;
        border-radius: 999px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 0.7rem;
        font-weight: 600;
    }

    .copilot-result-status {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--text-muted);
    }

    .copilot-result-card.completed .copilot-result-status > i:first-child { color: var(--accent-success); }
    .copilot-result-card.failed .copilot-result-status > i:first-child { color: var(--accent-danger); }
    .copilot-result-card.running .copilot-result-status > i:first-child { color: var(--accent-primary); }

    .copilot-result-chevron {
        font-size: 0.7rem;
    }

    .copilot-result-body {
        max-height: 20rem;
        overflow: auto;
    }

    .copilot-result-table {
        width: 100%;
        border-collapse: collapse;
    }

    .copilot-result-table th {
        position: sticky;
        top: 0;
        padding: 0.4rem 0.75rem;
        background: var(--bg-primary);
        border-bottom: 1px solid var(--border-color-light);
        color: var(--text-secondary);
        font-size: 0.7rem;
        font-weight: 600;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
    }

    .copilot-result-table td {
        padding: 0.4rem 0.75rem;
        border-bottom: 1px solid var(--border-color-light);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .copilot-result-table tr:last-child td {
        border-bottom: none;
    }

    .copilot-result-table .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.75rem;
        color: var(--text-secondary);
        word-break: break-all;
    }

    .copilot-result-action-cell {
        text-align: right;
        white-space: nowrap;
    }

    .copilot-result-action {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--border-color-light);
        border-radius: 4px;
        background: var(--bg-secondary);
        color: var(--accent-primary);
        font: inherit;
        font-size: 0.75rem;
        cursor: pointer;
    }

    .copilot-result-action:hover:not(:disabled) {
        background: var(--bg-hover);
    }

    .copilot-result-action:disabled {
        opacity: 0.5;
        cursor: default;
    }

    .copilot-result-message {
        padding: 0.6rem 0.75rem;
        color: var(--text-secondary);
        white-space: pre-wrap;
    }

    .copilot-pill {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .copilot-pill--success { background: var(--status-success-bg); color: var(--status-success-text); }
    .copilot-pill--warning { background: var(--status-warning-bg); color: var(--status-warning-text); }
    .copilot-pill--error { background: var(--status-error-bg); color: var(--status-error-text); }
    .copilot-pill--info { background: var(--status-info-bg); color: var(--status-info-text); }
    .copilot-pill--neutral { background: var(--bg-tertiary); color: var(--text-secondary); }
</style>

<script suppress-error="BL9992">
    window.copilotChat = {
        scrollDebugToBottom: function(element) {
            if (element) {
                element.scrollTop = element.scrollHeight;
            }
        },
        copyToClipboard: async function(text) {
            try {
                await navigator.clipboard.writeText(text);
                return true;
            } catch (e) {
                console.error('Failed to copy:', e);
                return false;
            }
        }
    };
</script>

@code {
    // Parameters for embedded mode (overlay)
    [Parameter] public bool IsEmbedded { get; set; } = false;
    [Parameter] public bool ShowHeader { get; set; } = false;
    [Parameter] public string? PendingMessage { get; set; }
    [Parameter] public CopilotContext? PendingContext { get; set; }
    [Parameter] public EventCallback OnPendingHandled { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnReady { get; set; }

    private async Task OpenUrl(string url)
    {
        await AppLauncher.OpenAsync(new Uri(url));
    }
    
    private bool isCheckingAvailability = true;
    private CopilotAvailability? availability;
    private bool isConnecting = false;
    private bool isBusy = false;
    private string selectedModel = "auto";
    private List<CopilotModelOption> availableModels = [new("auto", "Auto")];
    private string SelectedModelDisplayName => availableModels
        .FirstOrDefault(model => string.Equals(model.Id, selectedModel, StringComparison.OrdinalIgnoreCase))
        ?.Name ?? selectedModel;
    private AgentView? agentView;
    
    // Debug overlay state
    private bool showDebugOverlay = false;
    private bool debugOverlayExpanded = false;
    private string debugFilter = "";
    private ElementReference debugContentRef;
    
    // Usage info state
    private CopilotUsageInfo? currentUsageInfo;
    
    // System prompt loaded from bundled file
    private string? _systemPrompt;
    
    // Track if pending was already processed
    private string? _lastProcessedMessage;
    private CopilotContext? _lastProcessedContext;
    private bool _disposed;

    // Shown as chips while the conversation is empty
    private readonly string[] suggestions =
    [
        "Check my .NET MAUI development environment and help me fix any issues",
        "Show my Apple certificates and provisioning profiles, and which expire soon, as a dashboard",
        "Help me create a new Android emulator for testing .NET MAUI apps",
        "What Android SDK packages am I missing for .NET MAUI development?",
        "Help me register a new iPhone for iOS development",
        "Help me set up code signing for my iOS app"
    ];

    // Sherpa list tools draw their results as tables instead of the default JSON tool card
    private Dictionary<string, RenderFragment<AgentToolCallItem>> toolTemplates = new();

    protected override async Task OnInitializedAsync()
    {
        toolTemplates = CopilotToolResultSpecs.All.ToDictionary(
            entry => entry.Key,
            entry => (RenderFragment<AgentToolCallItem>)(call =>
                @<CopilotToolResultCard Call="call" Spec="entry.Value" IsBusy="isBusy" OnAction="SendPromptAsync" />));

        isBusy = AgentService.Runner.IsBusy;
        AgentService.Runner.BusyChanged += OnRunnerBusyChanged;
        CopilotService.OnUsageInfoChanged += OnUsageInfoChanged;
        _logger.OnLogAdded += OnLogAdded;
        
        // Listen for messages submitted from native UI
        ContextService.OnMessageSubmitted += OnNativeMessageSubmitted;
        
        // Load system prompt from bundled file
        await LoadSystemPromptAsync();

        await CheckAvailability();
        
        // Notify ready
        await OnReady.InvokeAsync();
    }
    
    protected override async Task OnParametersSetAsync()
    {
        // Handle pending message when overlay opens with context
        await ProcessPendingAsync();
    }
    
    private async Task ProcessPendingAsync()
    {
        if (!string.IsNullOrEmpty(PendingMessage) && PendingMessage != _lastProcessedMessage)
        {
            _lastProcessedMessage = PendingMessage;
            _ = SendPromptAsync(PendingMessage);
            await OnPendingHandled.InvokeAsync();
        }
        
        if (PendingContext != null && PendingContext != _lastProcessedContext)
        {
            _lastProcessedContext = PendingContext;
            _ = SendPromptAsync(PendingContext.Message);
            await OnPendingHandled.InvokeAsync();
        }
    }

    /// <summary>
    /// Sends a prompt into the conversation from outside the composer (a pending context, a row action),
    /// connecting first when needed.
    /// </summary>
    private async Task SendPromptAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message) || AgentService.Runner.IsBusy)
            return;

        try
        {
            if (!CopilotService.IsConnected || CopilotService.CurrentSessionId == null)
            {
                if (availability?.IsAuthenticated != true)
                    return;
                await Connect();
                if (CopilotService.CurrentSessionId == null)
                    return;
            }

            if (agentView != null)
                await agentView.SendAsync(message.Trim());
            else
                await AgentService.Runner.SendAsync(message.Trim());
        }
        catch (Exception ex)
        {
            _logger.LogError($"Failed to send Copilot prompt: {ex.Message}", ex);
        }
    }
    
    private async Task LoadSystemPromptAsync()
    {
        try
        {
            using var stream = await FileSystem.OpenAppPackageFileAsync("SystemPrompt.md");
            using var reader = new StreamReader(stream);
            _systemPrompt = await reader.ReadToEndAsync();
            _logger.LogInformation($"Loaded system prompt ({_systemPrompt.Length} chars)");
        }
        catch (Exception ex)
        {
            _logger.LogWarning($"Could not load system prompt file, using default: {ex.Message}");
            _systemPrompt = null; // Will use default
        }
    }

    public void Dispose()
    {
        _disposed = true;
        AgentService.Runner.BusyChanged -= OnRunnerBusyChanged;
        CopilotService.OnUsageInfoChanged -= OnUsageInfoChanged;
        _logger.OnLogAdded -= OnLogAdded;
        ContextService.OnMessageSubmitted -= OnNativeMessageSubmitted;
    }

    private void OnRunnerBusyChanged(object? sender, EventArgs e)
    {
        if (_disposed) return;
        isBusy = AgentService.Runner.IsBusy;
        ContextService.NotifyBusyStateChanged(isBusy);
        InvokeAsync(StateHasChanged);
    }

    private async Task CheckAvailability(bool forceRefresh = false)
    {
        // Use cached availability if available for instant display
        if (!forceRefresh && CopilotService.CachedAvailability != null)
        {
            availability = CopilotService.CachedAvailability;
            isCheckingAvailability = false;
            
            // Auto-connect if Copilot is available and authenticated
            if (availability.IsInstalled && availability.IsAuthenticated)
            {
                try
                {
                    await Connect();
                }
                catch (Exception ex)
                {
                    _logger.LogError($"Auto-connect failed: {ex.Message}", ex);
                }
            }
            StateHasChanged();
            return;
        }

        isCheckingAvailability = true;
        StateHasChanged();

        try
        {
            availability = await CopilotService.CheckAvailabilityAsync(forceRefresh);
            
            // Auto-connect if Copilot is available and authenticated
            if (availability.IsInstalled && availability.IsAuthenticated)
            {
                try
                {
                    await Connect();
                }
                catch (Exception ex)
                {
                    _logger.LogError($"Auto-connect failed: {ex.Message}", ex);
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError($"Copilot availability check failed: {ex.Message}", ex);
            availability = new CopilotAvailability(false, false, null, null, ex.Message);
        }
        finally
        {
            isCheckingAvailability = false;
            StateHasChanged();
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await AppClipboard.SetTextAsync(text);
            await AlertService.ShowToastAsync("Copied to clipboard");
        }
        catch { }
    }

    private async Task Connect()
    {
        if (isConnecting)
            return;

        isConnecting = true;
        StateHasChanged();

        try
        {
            await CopilotService.ConnectAsync();
            await LoadModelsAsync();

            if (CopilotService.CurrentSessionId == null)
            {
                await CopilotService.StartSessionAsync(selectedModel, _systemPrompt);
            }

            availability = availability is null
                ? new CopilotAvailability(true, true, null, null, null)
                : availability with { IsInstalled = true, IsAuthenticated = true, ErrorMessage = null };
        }
        catch (Exception ex)
        {
            _logger.LogError($"Connection failed: {ex.Message}", ex);
            availability = await CopilotService.CheckAvailabilityAsync(forceRefresh: true);
            try
            {
                await AlertService.ShowAlertAsync("Connection Failed", ex.Message);
            }
            catch (Exception alertEx)
            {
                _logger.LogError($"Failed to show alert: {alertEx.Message}", alertEx);
            }
        }
        finally
        {
            isConnecting = false;
            StateHasChanged();
            ContextService.NotifyConnectionStateChanged();
        }
    }

    private async Task Disconnect()
    {
        try
        {
            await CopilotService.DisconnectAsync();
            AgentService.Reset();
            currentUsageInfo = null;
        }
        catch (Exception ex)
        {
            _logger.LogError($"Disconnect failed: {ex.Message}", ex);
            try
            {
                await AlertService.ShowAlertAsync("Error", ex.Message);
            }
            catch { }
        }
        StateHasChanged();
        ContextService.NotifyConnectionStateChanged();
    }

    private async Task NewChatAsync()
    {
        try
        {
            // Copilot keeps its own history, so start a fresh session along with the cleared view
            AgentService.Reset();
            currentUsageInfo = null;
            if (CopilotService.IsConnected)
                await CopilotService.StartSessionAsync(selectedModel, _systemPrompt);
        }
        catch (Exception ex)
        {
            _logger.LogError($"Unable to start a new Copilot chat: {ex.Message}", ex);
            await AlertService.ShowAlertAsync("New Chat Failed", ex.Message);
        }
    }

    private async Task LoadModelsAsync()
    {
        try
        {
            var models = await CopilotService.ListModelsAsync();
            availableModels = [
                new CopilotModelOption("auto", "Auto"),
                .. models
                    .Where(model =>
                        !string.IsNullOrWhiteSpace(model.Id) &&
                        !string.Equals(model.Id, "auto", StringComparison.OrdinalIgnoreCase))
                    .DistinctBy(model => model.Id, StringComparer.OrdinalIgnoreCase)
            ];

            var selectedModelIsAvailable = availableModels.Any(model =>
                string.Equals(model.Id, selectedModel, StringComparison.OrdinalIgnoreCase));
            if (!selectedModelIsAvailable ||
                (CopilotService.CurrentSessionId == null &&
                 string.Equals(selectedModel, CopilotModelSelector.AutomaticModelId, StringComparison.OrdinalIgnoreCase)))
            {
                selectedModel = CopilotModelSelector.SelectPreferred(availableModels);
            }

            _logger.LogInformation($"Loaded {availableModels.Count - 1} selectable Copilot models");
        }
        catch (Exception ex)
        {
            availableModels = [new CopilotModelOption("auto", "Auto")];
            selectedModel = "auto";
            _logger.LogWarning($"Unable to load Copilot models: {ex.Message}");
        }
    }

    private async Task SelectModelAsync(ChangeEventArgs args)
    {
        var model = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(model) || string.Equals(model, selectedModel, StringComparison.Ordinal))
            return;

        var previousModel = selectedModel;
        selectedModel = model;

        try
        {
            await CopilotService.SetModelAsync(selectedModel);
            currentUsageInfo = null;
        }
        catch (Exception ex)
        {
            selectedModel = previousModel;
            _logger.LogError($"Unable to change Copilot model: {ex.Message}", ex);
            await AlertService.ShowAlertAsync("Model Change Failed", ex.Message);
        }
    }

    private void OnNativeMessageSubmitted(string message)
    {
        InvokeAsync(() => SendPromptAsync(message));
    }
    
    private void OnUsageInfoChanged(CopilotUsageInfo usageInfo)
    {
        _logger.LogDebug($"UI: UsageInfo received - Model={usageInfo.Model}, Tokens={usageInfo.CurrentTokens}/{usageInfo.TokenLimit}, In={usageInfo.InputTokens}, Out={usageInfo.OutputTokens}");
        
        // Merge with existing info (some events only have partial data)
        if (currentUsageInfo == null)
        {
            currentUsageInfo = usageInfo;
        }
        else
        {
            currentUsageInfo = new CopilotUsageInfo(
                usageInfo.Model ?? currentUsageInfo.Model,
                usageInfo.CurrentTokens ?? currentUsageInfo.CurrentTokens,
                usageInfo.TokenLimit ?? currentUsageInfo.TokenLimit,
                usageInfo.InputTokens ?? currentUsageInfo.InputTokens,
                usageInfo.OutputTokens ?? currentUsageInfo.OutputTokens
            );
        }
        
        _logger.LogDebug($"UI: UsageInfo merged - Model={currentUsageInfo.Model}, Tokens={currentUsageInfo.CurrentTokens}/{currentUsageInfo.TokenLimit}");
        InvokeAsync(StateHasChanged);
    }
    
    // Debug overlay methods
    private void OnLogAdded()
    {
        if (_disposed) return;
        InvokeAsync(async () =>
        {
            StateHasChanged();
            if (showDebugOverlay)
            {
                await Task.Delay(10);
                try
                {
                    await JSRuntime.InvokeVoidAsync("copilotChat.scrollDebugToBottom", debugContentRef);
                }
                catch { }
            }
        });
    }
    
    private IEnumerable<LogEntry> GetFilteredLogs()
    {
        var logs = _logger.GetRecentLogs();
        if (string.IsNullOrWhiteSpace(debugFilter))
            return logs;
        
        var filter = debugFilter.Trim();
        return logs.Where(l => 
            l.Message.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
            l.Level.Contains(filter, StringComparison.OrdinalIgnoreCase));
    }
    
    private string GetLogLevelClass(string level) => level switch
    {
        "DBG" => "log-dbg",
        "INF" => "log-inf",
        "WRN" => "log-wrn",
        "ERR" => "log-err",
        _ => ""
    };
    
    private void ToggleDebugExpanded()
    {
        debugOverlayExpanded = !debugOverlayExpanded;
    }
    
    private void ClearDebugLogs()
    {
        _logger.ClearLogs();
        StateHasChanged();
    }
    
    private async Task CopyFilteredLogs()
    {
        var logs = GetFilteredLogs();
        var text = string.Join("\n", logs.Select(l => $"[{l.Timestamp:HH:mm:ss.fff}] [{l.Level}] {l.Message}"));
        
        try
        {
            var success = await JSRuntime.InvokeAsync<bool>("copilotChat.copyToClipboard", text);
            if (success)
            {
                await AlertService.ShowToastAsync("Logs copied to clipboard");
            }
        }
        catch (Exception ex)
        {
            _logger.LogError("Failed to copy logs", ex);
        }
    }

}
