@page "/inspector/android/{Serial}/{TabName?}"
@layout MauiSherpa.Components.InspectorLayout
@using MauiSherpa.Services
@using MauiSherpa.Core.Interfaces
@inject DeviceInspectorService InspectorService
@inject IAdbDeviceWatcherService DeviceWatcher
@inject IAndroidSdkService Sdk
@inject IAndroidSdkSettingsService SdkSettings
@implements IDisposable

<div class="inspector-page">
    <div class="inspector-sdk-context">Active SDK: <span class="mono text-selectable">@(Sdk.SdkPath ?? "No SDK selected")</span></div>
    <SherpaTabs Items="InspectorTabs"
                ActiveKey="@ActiveTab.ToString()"
                ActiveKeyChanged="OnTabChanged"
                Variant="SherpaTabVariant.Inspector"
                AriaLabel="Android inspector tools">
        <TrailingContent>
            <SherpaSelect TValue="string"
                          Value="@Serial"
                          ValueChanged="OnDeviceChanged"
                          Options="DeviceOptions"
                          LeadingIcon="fa-brands fa-android"
                          AriaLabel="Connected Android device"
                          Compact="true"
                          AlignEnd="true" />
        </TrailingContent>
    </SherpaTabs>

    <div class="inspector-body" @key="sdkRevision">
        @switch (ActiveTab)
        {
            case InspectorTab.Logcat:
                <LogcatContent Serial="@Serial" />
                break;
            case InspectorTab.Files:
                <FileExplorerTab Serial="@Serial" />
                break;
            case InspectorTab.Shell:
                <ShellTab Serial="@Serial" />
                break;
            case InspectorTab.Capture:
                <ScreenCaptureTab Serial="@Serial" />
                break;
            case InspectorTab.Tools:
                <DeviceToolsTab Serial="@Serial" />
                break;
            case InspectorTab.Apps:
                <AndroidAppsTab Serial="@Serial" />
                break;
        }
    </div>
</div>

<style>
    .inspector-sdk-context { padding: 8px 16px; font-size: 12px; color: var(--text-secondary); overflow-wrap: anywhere; border-bottom: 1px solid var(--border-color); }
    .inspector-page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--bg-primary);
        overflow: hidden;
    }

    .inspector-body {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .inspector-body .logcat-page {
        height: 100% !important;
    }
</style>

@code {
    [Parameter] public string Serial { get; set; } = "";
    [Parameter] public string? TabName { get; set; }

    private InspectorTab ActiveTab = InspectorTab.Logcat;
    private List<DeviceInfo> connectedDevices = new();
    private static readonly IReadOnlyList<SherpaTabItem> InspectorTabs =
    [
        new(nameof(InspectorTab.Logcat), "Logcat", "fa-solid fa-scroll"),
        new(nameof(InspectorTab.Files), "Files", "fa-solid fa-folder-open"),
        new(nameof(InspectorTab.Shell), "Shell", "fa-solid fa-terminal"),
        new(nameof(InspectorTab.Capture), "Capture", "fa-solid fa-camera"),
        new(nameof(InspectorTab.Tools), "Tools", "fa-solid fa-wrench"),
        new(nameof(InspectorTab.Apps), "Apps", "fa-solid fa-table-cells-large")
    ];
    private IReadOnlyList<SherpaSelectOption<string>> DeviceOptions =>
        connectedDevices
            .Select(device => new SherpaSelectOption<string>(
                device.Serial,
                device.Model ?? device.Serial,
                device.Serial,
                "fa-brands fa-android"))
            .ToArray();

    protected override void OnInitialized()
    {
        SdkSettings.SdkPathChanged += OnSdkChanged;
        ActiveTab = ParseTab(TabName);
        InspectorService.ActiveSerial = Serial;
        InspectorService.ActiveTab = ActiveTab;
        InspectorService.IsOpen = true;
        DeviceWatcher.DevicesChanged += OnDevicesChanged;
        InspectorService.StateChanged += OnServiceStateChanged;
        connectedDevices = DeviceWatcher.Devices.ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        var newTab = ParseTab(TabName);
        if (newTab != ActiveTab)
        {
            ActiveTab = newTab;
            InspectorService.ActiveTab = ActiveTab;
        }
        if (InspectorService.ActiveSerial != Serial)
        {
            await InspectorService.SwitchDeviceAsync(Serial);
        }
    }

    private void SetTab(InspectorTab tab)
    {
        ActiveTab = tab;
        InspectorService.SetTab(tab);
    }

    private void OnTabChanged(string key)
    {
        if (Enum.TryParse<InspectorTab>(key, out var tab))
            SetTab(tab);
    }

    private async Task OnDeviceChanged(string? newSerial)
    {
        if (string.IsNullOrEmpty(newSerial) || newSerial == Serial) return;
        Serial = newSerial;
        var device = connectedDevices.FirstOrDefault(d => d.Serial == newSerial);
        await InspectorService.SwitchDeviceAsync(newSerial, device?.Model);
    }

    private void OnDevicesChanged(IReadOnlyList<DeviceInfo> devices)
    {
        InvokeAsync(() =>
        {
            connectedDevices = devices.ToList();
            StateHasChanged();
        });
    }

    private void OnServiceStateChanged()
    {
        InvokeAsync(() =>
        {
            // Sync local tab state from service (e.g. when Apps tab requests Files)
            if (InspectorService.ActiveTab != ActiveTab)
                ActiveTab = InspectorService.ActiveTab;
            StateHasChanged();
        });
    }

    private static InspectorTab ParseTab(string? tabName) => tabName?.ToLowerInvariant() switch
    {
        "files" => InspectorTab.Files,
        "shell" => InspectorTab.Shell,
        "capture" => InspectorTab.Capture,
        "tools" => InspectorTab.Tools,
        "apps" => InspectorTab.Apps,
        _ => InspectorTab.Logcat,
    };

    public void Dispose()
    {
        SdkSettings.SdkPathChanged -= OnSdkChanged;
        DeviceWatcher.DevicesChanged -= OnDevicesChanged;
        InspectorService.StateChanged -= OnServiceStateChanged;
    }
    private int sdkRevision;
    private void OnSdkChanged() => _ = InvokeAsync(() => { sdkRevision++; StateHasChanged(); });
}
