@page "/push-testing"
@using System.Text.Json
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@inject IAppleIdentityService IdentityService
@inject IManagedSecretsService SecretsService
@inject IApnsPushService PushService
@inject IPushProjectService ProjectService
@inject BlazorToastService ToastService
@inject ILoggingService Logger
@inject IToolbarService ToolbarService
@inject ILocalVaultAccessService LocalVaultAccess
@inject ILocalVaultStore LocalVault
@inject IFileSystemService FileSystem
@implements IDisposable

<SherpaPageHeader Title="Push Testing" Icon="fa-solid fa-paper-plane"
                  Description="Send test notifications to Apple devices through APNs, signed with a token-based (.p8) authentication key.">
    <Actions>
        @if (activeProject != null)
        {
            <span class="sherpa-badge @(useSandbox ? "sherpa-badge-info" : "sherpa-badge-warning")">
                <i class="fa-solid fa-fw @(useSandbox ? "fa-flask" : "fa-bolt")" aria-hidden="true"></i> @(useSandbox ? "Sandbox" : "Production")
            </span>
        }
    </Actions>
</SherpaPageHeader>

<PushProjectBar
    Platform="PushProjectPlatform.Apns"
    ActiveProject="activeProject"
    ActiveProjectChanged="OnActiveProjectChanged"
    OnSaveRequested="SaveProject"
    GetCurrentProject="GetCurrentProject"
    IsDirty="isDirty"
    IsBusy="isSending" />

@if (activeProject != null)
{
<div class="push-workspace-container">
    <div class="push-workspace">
        <div class="push-main">
            <section>
                <SherpaSectionHeader Title="Delivery" Icon="fa-solid fa-sliders"
                                     Caption="Choose the APNs environment and how the notification is routed, prioritized, and expired." />
                <div class="sherpa-card sherpa-card-pad">
                    <div class="sherpa-form-grid-2">
                        <div class="sherpa-field">
                            <span class="sherpa-field-label">Environment</span>
                            <SherpaSegmentedControl TValue="bool" Value="@useSandbox" ValueChanged="SetSandbox"
                                                    Options="EnvironmentOptions" AriaLabel="APNs environment" Class="sherpa-segmented-full" />
                            <span class="sherpa-field-help">@(useSandbox ? "For development builds signed with a development profile." : "Delivers to App Store, TestFlight, and ad hoc builds.")</span>
                        </div>
                        <div class="sherpa-field">
                            <span class="sherpa-field-label">Priority</span>
                            <SherpaSegmentedControl TValue="int" Value="@priority" ValueChanged="SetPriority"
                                                    Options="PriorityOptions" AriaLabel="APNs priority" Class="sherpa-segmented-full" />
                            @if (pushType == "background" && priority == 10)
                            {
                                <span class="sherpa-field-error"><i class="fa-solid fa-fw fa-triangle-exclamation" aria-hidden="true"></i> Background pushes must use priority 5.</span>
                            }
                            else
                            {
                                <span class="sherpa-field-help">@(priority == 10 ? "Deliver now; requires a visible alert, sound, or badge." : "Deliver when power conditions allow.")</span>
                            }
                        </div>
                        <div class="sherpa-field">
                            <span class="sherpa-field-label">Push type</span>
                            <SherpaSelect TValue="string" Value="@pushType" ValueChanged="OnPushTypeSelected" Options="PushTypeOptions"
                                          LeadingIcon="fa-solid fa-layer-group" AriaLabel="Push type" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="apns-expiration">Expiration <span class="sherpa-field-opt">seconds</span></label>
                            <input id="apns-expiration" type="number" min="0" class="sherpa-input" @bind="expirationSeconds" @bind:after="MarkDirty" placeholder="0 = deliver once, don't store" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="apns-collapse">Collapse ID <span class="sherpa-field-opt">(optional)</span></label>
                            <input id="apns-collapse" type="text" class="sherpa-input" @bind="collapseId" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Groups repeat notifications" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="apns-notification-id">Notification ID <span class="sherpa-field-opt">(optional)</span></label>
                            <input id="apns-notification-id" type="text" class="sherpa-input mono" @bind="notificationId" @bind:event="oninput" @bind:after="MarkDirty" placeholder="UUID" />
                        </div>
                    </div>
                </div>
            </section>

            <section>
                <SherpaSectionHeader Title="Target" Icon="fa-solid fa-mobile-screen"
                                     Caption="The app and device that receive the notification." />
                <div class="sherpa-card sherpa-card-pad">
                    <div class="sherpa-form-grid-2">
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="apns-bundle-id">Bundle ID</label>
                            <input id="apns-bundle-id" type="text" class="sherpa-input mono" @bind="bundleId" @bind:event="oninput" @bind:after="MarkDirty" placeholder="com.example.myapp" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="apns-device-token">Device token</label>
                            <input id="apns-device-token" type="text" class="sherpa-input mono" @bind="deviceToken" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Hex device token" />
                        </div>
                    </div>
                </div>
            </section>

            <section>
                <SherpaSectionHeader Title="Payload" Icon="fa-solid fa-code"
                                     Caption="The JSON body APNs delivers to your app." />
                <PushJsonEditor Schema="apns" @bind-Value="jsonPayload" @bind-Value:after="MarkDirty"
                                FileName="payload.json"
                                MaxBytes="@(pushType == "voip" ? 5120 : 4096)"
                                Rows="14" />
            </section>

            @if (activeProject?.History.Count > 0)
            {
                <PushHistoryList History="activeProject.History" OnClear="ClearHistory" />
            }
        </div>

        <aside class="push-aside">
            @{ var preview = BuildPreview(); }
            <PushNotificationPreview Variant="ios"
                                     AppName="@PreviewAppName"
                                     Title="@preview.Title"
                                     Subtitle="@preview.Subtitle"
                                     Body="@preview.Body"
                                     Badge="@preview.Badge"
                                     Silent="@preview.Silent"
                                     SilentMessage="@preview.SilentMessage" />

            <div class="sherpa-card push-send-card">
                <div class="push-send-head">
                    <h2 class="sherpa-section-title">@(IsValid ? "Ready to send" : "Before you send")</h2>
                    <span class="sherpa-badge @(IsValid ? "sherpa-badge-success" : "sherpa-badge-neutral")">@ReadyCount / 5</span>
                </div>
                <dl class="push-summary">
                    <div class="push-summary-row"><dt>Environment</dt><dd>@(useSandbox ? "Sandbox" : "Production")</dd></div>
                    <div class="push-summary-row"><dt>Type</dt><dd>@PushTypeLabel</dd></div>
                    <div class="push-summary-row"><dt>Priority</dt><dd>@(priority == 10 ? "Immediate" : "Normal")</dd></div>
                    <div class="push-summary-row"><dt>Device</dt><dd class="mono">@(string.IsNullOrWhiteSpace(deviceToken) ? "—" : TruncateToken(deviceToken))</dd></div>
                </dl>
                <ul class="push-checklist" aria-label="Requirements">
                    <li class="@(HasSigningKey ? "done" : "")"><i class="@CheckIcon(HasSigningKey)" aria-hidden="true"></i> Signing key</li>
                    <li class="@(HasTeamId ? "done" : "")"><i class="@CheckIcon(HasTeamId)" aria-hidden="true"></i> Team ID</li>
                    <li class="@(HasBundleId ? "done" : "")"><i class="@CheckIcon(HasBundleId)" aria-hidden="true"></i> Bundle ID</li>
                    <li class="@(HasDeviceToken ? "done" : "")"><i class="@CheckIcon(HasDeviceToken)" aria-hidden="true"></i> Device token</li>
                    <li class="@(HasPayload ? "done" : "")"><i class="@CheckIcon(HasPayload)" aria-hidden="true"></i> Payload</li>
                </ul>
                <button data-screenshot-external class="btn btn-primary push-send-btn" @onclick="SendPush" disabled="@(isSending || !IsValid)">
                    <i class="fa-solid fa-fw @(isSending ? "fa-spinner fa-spin" : "fa-paper-plane")" aria-hidden="true"></i>
                    @(isSending ? "Sending…" : "Send Notification")
                </button>
            </div>
        </aside>
    </div>
</div>
}

@code {
    static readonly (string Value, string Label)[] PushTypes =
    [
        ("alert", "Alert"),
        ("background", "Background"),
        ("voip", "VoIP"),
        ("complication", "Complication"),
        ("fileprovider", "File Provider"),
        ("mdm", "MDM"),
        ("liveactivity", "Live Activity"),
        ("pushtotalk", "Push to Talk"),
        ("location", "Location")
    ];

    bool RequiresLocalVaultAccess => LocalVaultAccess.GetState().RequiresUserAction;
    List<AppleIdentity> identities = new();
    PushProject? activeProject;

    // Auth
    string authMode = "identity";
    string selectedIdentityId = "";
    string p8FilePath = "";
    string p8KeyId = "";
    string p8SecretKey = "";
    string p8VaultKey = "", keyIdSecretKey = "", teamIdSecretKey = "";
    string teamId = "";

    // Config
    string pushType = "alert";
    int priority = 5;
    string collapseId = "";
    string notificationId = "";
    int? expirationSeconds;
    bool useSandbox = true;

    // Payload
    string bundleId = "";
    string deviceToken = "";
    string jsonPayload = "{\n  \"aps\": {\n    \"alert\": {\n      \"title\": \"Test\",\n      \"body\": \"Hello from MauiSherpa!\"\n    },\n    \"sound\": \"default\"\n  }\n}";

    // State
    bool isSending;
    bool isDirty;

    bool HasSigningKey => authMode switch
    {
        "identity" => !RequiresLocalVaultAccess && identities.Any(i => i.Id == selectedIdentityId),
        "secret" => !string.IsNullOrWhiteSpace(p8SecretKey) && HasKeyId,
        "paste" => !RequiresLocalVaultAccess && !string.IsNullOrWhiteSpace(p8VaultKey) && HasKeyId,
        "p8file" => !string.IsNullOrWhiteSpace(p8FilePath) && HasKeyId,
        _ => false
    };
    bool HasKeyId => !string.IsNullOrWhiteSpace(p8KeyId) || !string.IsNullOrWhiteSpace(keyIdSecretKey);
    bool HasTeamId => !string.IsNullOrWhiteSpace(teamId) || !string.IsNullOrWhiteSpace(teamIdSecretKey);
    bool HasBundleId => !string.IsNullOrWhiteSpace(bundleId);
    bool HasDeviceToken => !string.IsNullOrWhiteSpace(deviceToken);
    bool HasPayload => !string.IsNullOrWhiteSpace(jsonPayload);

    bool IsValid => HasSigningKey && HasTeamId && HasBundleId && HasDeviceToken && HasPayload;

    static readonly IReadOnlyList<SherpaSelectOption<string>> PushTypeOptions =
        PushTypes.Select(type => new SherpaSelectOption<string>(type.Value, type.Label)).ToArray();

    static readonly IReadOnlyList<SherpaSegmentOption<bool>> EnvironmentOptions =
    [
        new(true, "Sandbox", "fa-solid fa-flask"),
        new(false, "Production", "fa-solid fa-bolt")
    ];

    static readonly IReadOnlyList<SherpaSegmentOption<int>> PriorityOptions =
    [
        new(5, "Normal · 5"),
        new(10, "Immediate · 10")
    ];

    int ReadyCount => new[] { HasSigningKey, HasTeamId, HasBundleId, HasDeviceToken, HasPayload }.Count(done => done);

    void OnPushTypeSelected(string? value) { pushType = value ?? "alert"; MarkDirty(); }

    string PushTypeLabel => PushTypes.FirstOrDefault(t => t.Value == pushType).Label ?? pushType;

    string PreviewAppName
    {
        get
        {
            var name = bundleId.Trim().Split('.', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
            return string.IsNullOrEmpty(name) ? "Your App" : name;
        }
    }

    static string CheckIcon(bool done) => done ? "fa-solid fa-fw fa-circle-check" : "fa-regular fa-fw fa-circle";

    ApnsPreview BuildPreview()
    {
        if (pushType != "alert")
            return new(null, null, null, null, true, $"{PushTypeLabel} pushes are handled by your app without showing an alert.");

        try
        {
            using var doc = JsonDocument.Parse(jsonPayload);
            if (doc.RootElement.ValueKind != JsonValueKind.Object
                || !doc.RootElement.TryGetProperty("aps", out var aps)
                || aps.ValueKind != JsonValueKind.Object)
                return new(null, null, null, null, true, "The payload has no \"aps\" dictionary, so nothing is displayed.");

            string? title = null, subtitle = null, body = null;
            if (aps.TryGetProperty("alert", out var alert))
            {
                if (alert.ValueKind == JsonValueKind.String)
                {
                    body = alert.GetString();
                }
                else if (alert.ValueKind == JsonValueKind.Object)
                {
                    title = GetString(alert, "title");
                    subtitle = GetString(alert, "subtitle");
                    body = GetString(alert, "body");
                }
            }

            int? badge = aps.TryGetProperty("badge", out var b) && b.ValueKind == JsonValueKind.Number && b.TryGetInt32(out var count)
                ? count
                : null;

            if (string.IsNullOrWhiteSpace(title) && string.IsNullOrWhiteSpace(subtitle) && string.IsNullOrWhiteSpace(body))
                return new(null, null, null, badge, true, "The payload has no alert text, so it arrives silently.");

            return new(title, subtitle, body, badge, false, "");
        }
        catch (JsonException)
        {
            return new(null, null, null, null, true, "Fix the payload JSON to see a preview.");
        }
    }

    static string? GetString(JsonElement element, string name) =>
        element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;

    protected override async Task OnInitializedAsync()
    {
        ToolbarService.ClearItems();
        LocalVaultAccess.StateChanged += OnLocalVaultStateChanged;
        if (!RequiresLocalVaultAccess)
            identities = (await IdentityService.GetIdentitiesAsync()).ToList();

        // Migrate legacy settings if needed
        var migrated = await ProjectService.MigrateFromLegacyAsync();

        if (migrated != null)
            LoadFromProject(migrated);
    }

    void OnLocalVaultStateChanged() => InvokeAsync(async () =>
    {
        identities = RequiresLocalVaultAccess ? [] : (await IdentityService.GetIdentitiesAsync()).ToList();
        StateHasChanged();
    });

    void LoadFromProject(PushProject project)
    {
        activeProject = project;
        var config = project.ApnsConfig ?? new ApnsPushProjectConfig();

        authMode = config.AuthMode ?? "identity";
        selectedIdentityId = config.SelectedIdentityId ?? "";
        p8FilePath = config.P8FilePath ?? "";
        p8KeyId = config.P8KeyId ?? "";
        p8SecretKey = config.P8SecretKey ?? "";
        p8VaultKey = config.P8VaultKey ?? "";
        keyIdSecretKey = config.KeyIdSecretKey ?? "";
        teamIdSecretKey = config.TeamIdSecretKey ?? "";
        teamId = config.TeamId ?? "";
        pushType = config.PushType;
        priority = config.Priority;
        collapseId = config.CollapseId ?? "";
        notificationId = config.NotificationId ?? "";
        expirationSeconds = config.ExpirationSeconds;
        bundleId = config.BundleId ?? "";
        deviceToken = config.DeviceToken ?? "";
        jsonPayload = config.JsonPayload;
        useSandbox = config.UseSandbox;
        isDirty = false;
    }

    void ResetToBlank()
    {
        activeProject = null;
        var defaults = new ApnsPushProjectConfig();
        authMode = defaults.AuthMode ?? "identity";
        selectedIdentityId = "";
        p8FilePath = "";
        p8KeyId = "";
        p8SecretKey = "";
        p8VaultKey = keyIdSecretKey = teamIdSecretKey = "";
        teamId = "";
        pushType = defaults.PushType;
        priority = defaults.Priority;
        collapseId = "";
        notificationId = "";
        expirationSeconds = null;
        bundleId = "";
        deviceToken = "";
        jsonPayload = defaults.JsonPayload;
        useSandbox = defaults.UseSandbox;
        isDirty = false;
    }

    async Task OnActiveProjectChanged(PushProject? project)
    {
        if (project != null)
        {
            identities = RequiresLocalVaultAccess ? [] : (await IdentityService.GetIdentitiesAsync()).ToList();
            LoadFromProject(project);
        }
        else
            ResetToBlank();

        await Task.CompletedTask;
        StateHasChanged();
    }

    void MarkDirty() => isDirty = true;

    void SetSandbox(bool sandbox)
    {
        if (useSandbox == sandbox) return;
        useSandbox = sandbox;
        MarkDirty();
    }

    void SetPriority(int value)
    {
        if (priority == value) return;
        priority = value;
        MarkDirty();
    }

    ApnsPushProjectConfig BuildConfig() => new()
    {
        AuthMode = authMode,
        SelectedIdentityId = string.IsNullOrEmpty(selectedIdentityId) ? null : selectedIdentityId,
        P8FilePath = string.IsNullOrEmpty(p8FilePath) ? null : p8FilePath,
        P8KeyId = string.IsNullOrEmpty(p8KeyId) ? null : p8KeyId,
        P8SecretKey = string.IsNullOrEmpty(p8SecretKey) ? null : p8SecretKey,
        P8VaultKey = string.IsNullOrEmpty(p8VaultKey) ? null : p8VaultKey,
        KeyIdSecretKey = string.IsNullOrEmpty(keyIdSecretKey) ? null : keyIdSecretKey,
        TeamIdSecretKey = string.IsNullOrEmpty(teamIdSecretKey) ? null : teamIdSecretKey,
        TeamId = string.IsNullOrEmpty(teamId) ? null : teamId,
        PushType = pushType,
        Priority = priority,
        CollapseId = string.IsNullOrEmpty(collapseId) ? null : collapseId,
        NotificationId = string.IsNullOrEmpty(notificationId) ? null : notificationId,
        ExpirationSeconds = expirationSeconds,
        BundleId = string.IsNullOrEmpty(bundleId) ? null : bundleId,
        DeviceToken = string.IsNullOrEmpty(deviceToken) ? null : deviceToken,
        JsonPayload = jsonPayload,
        UseSandbox = useSandbox
    };

    PushProject GetCurrentProject() => (activeProject ?? throw new InvalidOperationException("Select a project first.")) with { ApnsConfig = BuildConfig() };

    async Task SaveProject()
    {
        try
        {
            if (activeProject != null)
            {
                var updated = GetCurrentProject();
                await ProjectService.SaveProjectAsync(updated);
                activeProject = await ProjectService.GetProjectAsync(updated.Id);
            }

            isDirty = false;
            ToastService.Show("Project saved.", ToastType.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to save push project: {ex.Message}", ex);
            ToastService.Show($"Save failed: {ex.Message}", ToastType.Error);
        }
    }

    async Task SendPush()
    {
        ScreenshotMode.BlockExternalAction("sending an APNs notification");
        if (!IsValid) return;

        isSending = true;
        StateHasChanged();

        try
        {
            var credentials = await PushProjectCredentials.ReadApnsAsync(
                BuildConfig(), IdentityService, SecretsService, LocalVault, FileSystem);

            var request = new ApnsPushRequest(
                P8Key: credentials.Key,
                KeyId: credentials.KeyId,
                TeamId: credentials.TeamId,
                BundleId: bundleId,
                DeviceToken: deviceToken,
                JsonPayload: jsonPayload,
                PushType: pushType,
                Priority: priority,
                CollapseId: string.IsNullOrWhiteSpace(collapseId) ? null : collapseId,
                NotificationId: string.IsNullOrWhiteSpace(notificationId) ? null : notificationId,
                ExpirationSeconds: expirationSeconds,
                UseSandbox: useSandbox
            );

            var result = await PushService.SendPushAsync(request);

            // Record history
            if (activeProject != null)
            {
                var historyEntry = new PushSendHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Success = result.Success,
                    StatusCode = result.StatusCode,
                    MessageId = result.ApnsId,
                    ErrorReason = result.ErrorReason,
                    ErrorDescription = result.ErrorDescription,
                    Target = TruncateToken(deviceToken)
                };
                await ProjectService.AddHistoryEntryAsync(activeProject.Id, historyEntry);
                activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
            }

            if (result.Success)
                ToastService.Show("Push notification sent successfully!", ToastType.Success);
            else
                ToastService.Show($"Push failed: {result.ErrorReason ?? "Unknown error"}", ToastType.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError($"Push send error: {ex.Message}", ex);
            ToastService.Show($"Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    async Task ClearHistory()
    {
        if (activeProject == null) return;
        await ProjectService.ClearHistoryAsync(activeProject.Id);
        activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
        StateHasChanged();
    }

    static string TruncateToken(string token) =>
        token.Length > 24 ? $"{token[..12]}...{token[^8..]}" : token;

    record ApnsPreview(string? Title, string? Subtitle, string? Body, int? Badge, bool Silent, string SilentMessage);

    public void Dispose()
    {
        LocalVaultAccess.StateChanged -= OnLocalVaultStateChanged;
    }
}
