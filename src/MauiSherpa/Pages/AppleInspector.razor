@page "/inspector/apple/{Udid}/{TabName?}"
@layout MauiSherpa.Components.InspectorLayout
@using MauiSherpa.Services
@using MauiSherpa.Core.Interfaces
@inject SimInspectorService InspectorService
@inject ISimulatorService SimulatorService
@inject IDeviceMonitorService DeviceMonitor
@inject IPhysicalDeviceLogService PhysicalLogService
@implements IDisposable

<div class="inspector-page">
    <SherpaTabs Items="InspectorTabs"
                ActiveKey="@ActiveTab.ToString()"
                ActiveKeyChanged="OnTabChanged"
                Variant="SherpaTabVariant.Inspector"
                AriaLabel="Apple inspector tools">
        <TrailingContent>
            <SherpaSelect TValue="string"
                          Value="@Udid"
                          ValueChanged="OnDeviceChanged"
                          Options="DeviceOptions"
                          LeadingIcon="fa-brands fa-apple"
                          AriaLabel="Connected Apple device or simulator"
                          Compact="true"
                          AlignEnd="true" />
        </TrailingContent>
    </SherpaTabs>

    <div class="inspector-body">
        @switch (ActiveTab)
        {
            case SimInspectorTab.Logs:
                @if (InspectorService.IsPhysicalDevice)
                {
                    <SimLogContent Udid="@Udid" LogServiceOverride="@PhysicalLogService" />
                }
                else
                {
                    <SimLogContent Udid="@Udid" />
                }
                break;
            case SimInspectorTab.Apps:
                <AppleAppsTab Identifier="@Udid" IsSimulator="@(!InspectorService.IsPhysicalDevice)" />
                break;
            case SimInspectorTab.Capture:
                @if (!InspectorService.IsPhysicalDevice)
                {
                    <SimCaptureTab Udid="@Udid" />
                }
                break;
            case SimInspectorTab.Tools:
                @if (!InspectorService.IsPhysicalDevice)
                {
                    <SimToolsTab Udid="@Udid" />
                }
                break;
            case SimInspectorTab.Permissions:
                @if (!InspectorService.IsPhysicalDevice)
                {
                    <SimPermissionsTab Udid="@Udid" />
                }
                break;
        }
    </div>
</div>

<style>
    .inspector-page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--surface-canvas);
        overflow: hidden;
    }

    .inspector-body {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
</style>

@code {
    [Parameter] public string Udid { get; set; } = "";
    [Parameter] public string? TabName { get; set; }

    private SimInspectorTab ActiveTab = SimInspectorTab.Logs;
    private List<SimulatorDevice> bootedSimulators = new();
    private List<AppleDeviceInfo> physicalDevices = new();
    private IReadOnlyList<SherpaTabItem> InspectorTabs =>
        InspectorService.IsPhysicalDevice
            ?
            [
                new(nameof(SimInspectorTab.Logs), "Logs", "fa-solid fa-scroll"),
                new(nameof(SimInspectorTab.Apps), "Apps", "fa-solid fa-table-cells-large")
            ]
            :
            [
                new(nameof(SimInspectorTab.Logs), "Logs", "fa-solid fa-scroll"),
                new(nameof(SimInspectorTab.Apps), "Apps", "fa-solid fa-table-cells-large"),
                new(nameof(SimInspectorTab.Capture), "Capture", "fa-solid fa-camera"),
                new(nameof(SimInspectorTab.Tools), "Tools", "fa-solid fa-wrench"),
                new(nameof(SimInspectorTab.Permissions), "Permissions", "fa-solid fa-shield-halved")
            ];
    private IReadOnlyList<SherpaSelectOption<string>> DeviceOptions =>
        bootedSimulators
            .Select(simulator => new SherpaSelectOption<string>(
                simulator.Udid,
                $"{simulator.Name} (Sim)",
                simulator.Udid,
                "fa-brands fa-apple"))
            .Concat(physicalDevices.Select(device => new SherpaSelectOption<string>(
                device.Identifier,
                device.Name,
                device.Identifier,
                "fa-brands fa-apple")))
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        ActiveTab = ParseTab(TabName);
        InspectorService.ActiveUdid = Udid;
        InspectorService.ActiveTab = ActiveTab;
        InspectorService.IsOpen = true;
        InspectorService.StateChanged += OnServiceStateChanged;

        // Always load both so the device selector is complete
        await LoadBootedSimulatorsAsync();
        LoadPhysicalDevices();

        // If physical device landed on a sim-only tab, redirect to Apps
        if (InspectorService.IsPhysicalDevice && (ActiveTab == SimInspectorTab.Capture || ActiveTab == SimInspectorTab.Tools))
        {
            ActiveTab = SimInspectorTab.Apps;
            InspectorService.ActiveTab = ActiveTab;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var newTab = ParseTab(TabName);
        if (newTab != ActiveTab)
        {
            ActiveTab = newTab;
            InspectorService.ActiveTab = ActiveTab;
        }
        if (InspectorService.ActiveUdid != Udid)
        {
            await InspectorService.SwitchDeviceAsync(Udid);
        }
    }

    private void SetTab(SimInspectorTab tab)
    {
        ActiveTab = tab;
        InspectorService.SetTab(tab);
    }

    private void OnTabChanged(string key)
    {
        if (Enum.TryParse<SimInspectorTab>(key, out var tab))
            SetTab(tab);
    }

    private async Task OnDeviceChanged(string? newUdid)
    {
        if (string.IsNullOrEmpty(newUdid) || newUdid == Udid) return;
        Udid = newUdid;

        var physical = physicalDevices.FirstOrDefault(d => d.Identifier == newUdid);
        var sim = bootedSimulators.FirstOrDefault(s => s.Udid == newUdid);
        InspectorService.IsPhysicalDevice = physical != null;
        var name = physical?.Name ?? sim?.Name;
        await InspectorService.SwitchDeviceAsync(newUdid, name);

        // If switched to physical and on sim-only tab, redirect
        if (InspectorService.IsPhysicalDevice && (ActiveTab == SimInspectorTab.Capture || ActiveTab == SimInspectorTab.Tools))
        {
            ActiveTab = SimInspectorTab.Apps;
            InspectorService.ActiveTab = ActiveTab;
        }
    }

    private async Task LoadBootedSimulatorsAsync()
    {
        try
        {
            var all = await SimulatorService.GetSimulatorsAsync();
            bootedSimulators = all.Where(s => s.State?.Equals("Booted", StringComparison.OrdinalIgnoreCase) == true).ToList();
        }
        catch { }
    }

    private void LoadPhysicalDevices()
    {
        var snapshot = DeviceMonitor.Current;
        physicalDevices = snapshot.ApplePhysicalDevices.ToList();
    }

    private void OnServiceStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private static SimInspectorTab ParseTab(string? tabName) => tabName?.ToLowerInvariant() switch
    {
        "apps" => SimInspectorTab.Apps,
        "capture" => SimInspectorTab.Capture,
        "tools" => SimInspectorTab.Tools,
        "permissions" => SimInspectorTab.Permissions,
        _ => SimInspectorTab.Logs,
    };

    public void Dispose()
    {
        InspectorService.StateChanged -= OnServiceStateChanged;
    }
}
