@page "/firebase-push"
@using System.Text.Json
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@inject IFirebasePushService PushService
@inject IGoogleIdentityService GoogleIdentityService
@inject IPushProjectService ProjectService
@inject IAlertService AlertService
@inject IDialogService DialogService
@inject IFileSystemService FileSystem
@inject BlazorToastService ToastService
@inject IToolbarService ToolbarService
@inject ILocalVaultAccessService LocalVaultAccess
@inject ILocalVaultStore LocalVault
@inject IManagedSecretsService SecretsService
@inject ILoggingService Logger
@implements IDisposable

<SherpaPageHeader Title="Firebase Push Testing" Icon="fa-solid fa-paper-plane"
                  Description="Send test notifications to Android devices through Firebase Cloud Messaging (FCM v1).">
    <Actions>
        @if (activeProject != null)
        {
            @if (hasCredentials)
            {
                <span class="sherpa-badge sherpa-badge-success" title="Firebase project">
                    <i class="fa-solid fa-fw fa-fire" aria-hidden="true"></i> @(string.IsNullOrEmpty(projectId) ? "Service account ready" : projectId)
                </span>
            }
            else
            {
                <span class="sherpa-badge sherpa-badge-warning"><i class="fa-solid fa-fw fa-triangle-exclamation" aria-hidden="true"></i> No service account</span>
            }
        }
    </Actions>
</SherpaPageHeader>

<PushProjectBar
    Platform="PushProjectPlatform.Fcm"
    ActiveProject="activeProject"
    ActiveProjectChanged="OnActiveProjectChanged"
    OnSaveRequested="SaveProject"
    GetCurrentProject="GetCurrentProject"
    IsDirty="isDirty"
    IsBusy="isSending" />

@if (activeProject != null)
{
<div class="push-workspace-container">
    <div class="push-workspace">
        <div class="push-main">
            @if (rawJsonMode)
            {
                <section>
                    <SherpaSectionHeader Title="Message" Icon="fa-solid fa-code"
                                         Caption="Paste a raw FCM v1 message for full control over platform options.">
                        <Actions>
                            <SherpaSegmentedControl TValue="bool" Value="@rawJsonMode" ValueChanged="SetRawJsonMode"
                                                    Options="ModeOptions" AriaLabel="Message editor" />
                        </Actions>
                    </SherpaSectionHeader>
                    <PushJsonEditor Schema="fcm" @bind-Value="rawJson" @bind-Value:after="MarkDirty"
                                    FileName="message.json"
                                    Placeholder="@jsonPlaceholder"
                                    Rows="18" />
                    <p class="sherpa-field-help push-after-help">Enter the FCM v1 <code>message</code> object. The <code>{"{"}"message": …{"}"}</code> wrapper is added automatically if omitted.</p>
                </section>
            }
            else
            {
                <section>
                    <SherpaSectionHeader Title="Target" Icon="fa-solid fa-bullseye"
                                         Caption="Send to a single device or to every device subscribed to a topic.">
                        <Actions>
                            <SherpaSegmentedControl TValue="bool" Value="@rawJsonMode" ValueChanged="SetRawJsonMode"
                                                    Options="ModeOptions" AriaLabel="Message editor" />
                        </Actions>
                    </SherpaSectionHeader>
                    <div class="sherpa-card sherpa-card-pad">
                        <div class="sherpa-form-grid-2">
                            <div class="sherpa-field">
                                <span class="sherpa-field-label">Send to</span>
                                <SherpaSegmentedControl TValue="bool" Value="@useToken" ValueChanged="SetUseToken"
                                                        Options="TargetOptions" AriaLabel="Target type" Class="sherpa-segmented-full" />
                            </div>
                            @if (useToken)
                            {
                                <div class="sherpa-field">
                                    <label class="sherpa-field-label" for="fcm-device-token">Registration token</label>
                                    <input id="fcm-device-token" type="text" class="sherpa-input mono" placeholder="FCM registration token"
                                           @bind="deviceToken" @bind:event="oninput" @bind:after="MarkDirty" />
                                </div>
                            }
                            else
                            {
                                <div class="sherpa-field">
                                    <label class="sherpa-field-label" for="fcm-topic">Topic</label>
                                    <input id="fcm-topic" type="text" class="sherpa-input" placeholder="e.g. news, updates"
                                           @bind="topic" @bind:event="oninput" @bind:after="MarkDirty" />
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section>
                    <SherpaSectionHeader Title="Notification" Icon="fa-solid fa-message"
                                         Caption="The visible content shown in the Android notification shade." />
                    <div class="sherpa-card sherpa-card-pad">
                        <div class="sherpa-form-section">
                            <div class="sherpa-field">
                                <label class="sherpa-field-label" for="fcm-title">Title</label>
                                <input id="fcm-title" type="text" class="sherpa-input" placeholder="Notification title"
                                       @bind="title" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                            <div class="sherpa-field">
                                <label class="sherpa-field-label" for="fcm-body">Body</label>
                                <textarea id="fcm-body" class="sherpa-textarea" rows="3" placeholder="Notification body text"
                                          @bind="body" @bind:event="oninput" @bind:after="MarkDirty"></textarea>
                            </div>
                            <div class="sherpa-field">
                                <label class="sherpa-field-label" for="fcm-image">Image URL <span class="sherpa-field-opt">(optional)</span></label>
                                <input id="fcm-image" type="url" class="sherpa-input" placeholder="https://example.com/image.png"
                                       @bind="imageUrl" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>
                    </div>
                </section>

                <section>
                    <SherpaSectionHeader Title="Data payload" Icon="fa-solid fa-table-list"
                                         Count="@(dataEntries.Count > 0 ? dataEntries.Count : null)"
                                         Caption="Optional key/value pairs your app reads from RemoteMessage.data.">
                        <Actions>
                            @if (dataEntries.Count > 0)
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="AddDataEntry">
                                    <i class="fa-solid fa-fw fa-plus" aria-hidden="true"></i> Add field
                                </button>
                            }
                        </Actions>
                    </SherpaSectionHeader>
                    @if (dataEntries.Count == 0)
                    {
                        <div class="sherpa-empty-inline">
                            <div class="sherpa-empty-inline-lead">
                                <span class="sherpa-icon-well sherpa-icon-well-sm sherpa-icon-well-neutral">
                                    <i class="fa-solid fa-fw fa-table-list" aria-hidden="true"></i>
                                </span>
                                <div class="sherpa-row-stack">
                                    <span class="sherpa-empty-inline-title">No custom data</span>
                                    <span class="sherpa-row-sub">Data-only messages are delivered silently to your app.</span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="AddDataEntry">
                                <i class="fa-solid fa-fw fa-plus" aria-hidden="true"></i> Add field
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="sherpa-card sherpa-card-pad">
                            <div class="sherpa-form-section">
                                @for (var i = 0; i < dataEntries.Count; i++)
                                {
                                    var index = i;
                                    <div class="sherpa-kv-row">
                                        <input type="text" class="sherpa-input mono" placeholder="key" aria-label="Data key"
                                               value="@dataEntries[index].Key"
                                               @oninput="e => { UpdateDataKey(index, e.Value?.ToString()); MarkDirty(); }" />
                                        <input type="text" class="sherpa-input" placeholder="value" aria-label="Data value"
                                               value="@dataEntries[index].Value"
                                               @oninput="e => { UpdateDataValue(index, e.Value?.ToString()); MarkDirty(); }" />
                                        <button type="button" class="btn btn-ghost-danger btn-icon btn-sm" title="Remove field" aria-label="Remove field"
                                                @onclick="() => { RemoveDataEntry(index); MarkDirty(); }">
                                            <i class="fa-solid fa-fw fa-xmark" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>
            }

            @if (activeProject?.History.Count > 0)
            {
                <PushHistoryList History="activeProject.History" OnClear="ClearHistory" />
            }
        </div>

        <aside class="push-aside">
            @{ var preview = BuildPreview(); }
            <PushNotificationPreview Variant="android"
                                     AppName="@(string.IsNullOrEmpty(projectId) ? "Your App" : projectId)"
                                     Title="@preview.Title"
                                     Body="@preview.Body"
                                     ImageUrl="@preview.ImageUrl"
                                     Silent="@preview.Silent"
                                     SilentMessage="@preview.SilentMessage" />

            <div class="sherpa-card push-send-card">
                <div class="push-send-head">
                    <h2 class="sherpa-section-title">@(CanSendCurrent ? "Ready to send" : "Before you send")</h2>
                    <span class="sherpa-badge @(CanSendCurrent ? "sherpa-badge-success" : "sherpa-badge-neutral")">@ReadyCount / @(rawJsonMode ? 2 : 3)</span>
                </div>
                <dl class="push-summary">
                    <div class="push-summary-row"><dt>Project</dt><dd>@(string.IsNullOrEmpty(projectId) ? "—" : projectId)</dd></div>
                    <div class="push-summary-row"><dt>Mode</dt><dd>@(rawJsonMode ? "Raw JSON" : "Form")</dd></div>
                    <div class="push-summary-row"><dt>Target</dt><dd class="mono">@(preview.Target ?? "—")</dd></div>
                    @if (!rawJsonMode)
                    {
                        <div class="push-summary-row"><dt>Data fields</dt><dd>@dataEntries.Count(d => !string.IsNullOrWhiteSpace(d.Key))</dd></div>
                    }
                </dl>
                <ul class="push-checklist" aria-label="Requirements">
                    <li class="@(hasCredentials ? "done" : "")"><i class="@CheckIcon(hasCredentials)" aria-hidden="true"></i> Service account</li>
                    @if (rawJsonMode)
                    {
                        <li class="@(HasRawJson ? "done" : "")"><i class="@CheckIcon(HasRawJson)" aria-hidden="true"></i> Message JSON</li>
                    }
                    else
                    {
                        <li class="@(HasTarget ? "done" : "")"><i class="@CheckIcon(HasTarget)" aria-hidden="true"></i> @(useToken ? "Device token" : "Topic")</li>
                        <li class="@(HasContent ? "done" : "")"><i class="@CheckIcon(HasContent)" aria-hidden="true"></i> Title, body, or data</li>
                    }
                </ul>
                <button data-screenshot-external class="btn btn-primary push-send-btn" @onclick="SendCurrent" disabled="@(!CanSendCurrent || isSending)">
                    <i class="fa-solid fa-fw @(isSending ? "fa-spinner fa-spin" : "fa-paper-plane")" aria-hidden="true"></i>
                    @(isSending ? "Sending…" : "Send Push")
                </button>
            </div>
        </aside>
    </div>
</div>
}

@code {
    PushProject? activeProject;
    bool hasCredentials;
    string? projectId;

    // Compose - Form mode
    bool useToken = true;
    string deviceToken = "";
    string topic = "";
    string title = "";
    string body = "";
    string imageUrl = "";
    List<DataEntry> dataEntries = new();
    bool isSending;
    bool isDirty;

    // Compose - JSON mode
    bool rawJsonMode;
    string rawJson = "";
    const string jsonPlaceholder = "{\n  \"token\": \"DEVICE_TOKEN\",\n  \"notification\": {\n    \"title\": \"Test\",\n    \"body\": \"Hello from Sherpa!\"\n  },\n  \"android\": {\n    \"priority\": \"high\",\n    \"notification\": {\n      \"channel_id\": \"default\"\n    }\n  },\n  \"data\": {\n    \"key\": \"value\"\n  }\n}";

    bool HasTarget => useToken ? !string.IsNullOrWhiteSpace(deviceToken) : !string.IsNullOrWhiteSpace(topic);
    bool HasContent => !string.IsNullOrWhiteSpace(title) || !string.IsNullOrWhiteSpace(body) || dataEntries.Any(d => !string.IsNullOrWhiteSpace(d.Key));
    bool HasRawJson => !string.IsNullOrWhiteSpace(rawJson);

    bool CanSend => hasCredentials && HasTarget && HasContent;
    bool CanSendCurrent => rawJsonMode ? hasCredentials && HasRawJson : CanSend;

    static string CheckIcon(bool done) => done ? "fa-solid fa-fw fa-circle-check" : "fa-regular fa-fw fa-circle";

    Task SendCurrent() => rawJsonMode ? SendRawJson() : SendPush();

    FcmPreview BuildPreview()
    {
        if (!rawJsonMode)
        {
            var target = useToken
                ? (string.IsNullOrWhiteSpace(deviceToken) ? null : TruncateToken(deviceToken.Trim()))
                : (string.IsNullOrWhiteSpace(topic) ? null : $"#{topic.Trim()}");
            var dataOnly = string.IsNullOrWhiteSpace(title) && string.IsNullOrWhiteSpace(body)
                && dataEntries.Any(d => !string.IsNullOrWhiteSpace(d.Key));
            return new(title, body, imageUrl, target, dataOnly,
                "Data-only messages are delivered to your app without showing a notification.");
        }

        if (string.IsNullOrWhiteSpace(rawJson))
            return new(null, null, null, null, false, "");

        try
        {
            using var doc = JsonDocument.Parse(rawJson);
            var message = doc.RootElement;
            if (message.ValueKind != JsonValueKind.Object)
                return new(null, null, null, null, true, "The message must be a JSON object.");
            if (message.TryGetProperty("message", out var inner) && inner.ValueKind == JsonValueKind.Object)
                message = inner;

            string? t = null, b = null, image = null;
            if (message.TryGetProperty("notification", out var notification) && notification.ValueKind == JsonValueKind.Object)
            {
                t = GetString(notification, "title");
                b = GetString(notification, "body");
                image = GetString(notification, "image");
            }
            if (message.TryGetProperty("android", out var android) && android.ValueKind == JsonValueKind.Object
                && android.TryGetProperty("notification", out var androidNotification) && androidNotification.ValueKind == JsonValueKind.Object)
            {
                t = GetString(androidNotification, "title") ?? t;
                b = GetString(androidNotification, "body") ?? b;
                image = GetString(androidNotification, "image") ?? image;
            }

            var target = GetString(message, "token") is { Length: > 0 } token
                ? TruncateToken(token)
                : GetString(message, "topic") is { Length: > 0 } jsonTopic
                    ? $"#{jsonTopic}"
                    : GetString(message, "condition");

            var silent = string.IsNullOrWhiteSpace(t) && string.IsNullOrWhiteSpace(b);
            return new(t, b, image, target, silent,
                "This message has no notification block, so it is delivered to your app silently.");
        }
        catch (JsonException)
        {
            return new(null, null, null, null, true, "Fix the message JSON to see a preview.");
        }
    }

    static string? GetString(JsonElement element, string name) =>
        element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;

    protected override async Task OnInitializedAsync()
    {
        ToolbarService.ClearItems();
        LocalVaultAccess.StateChanged += OnIdentityChanged;
        await SyncProjectCredentials();
    }

    private void OnIdentityChanged()
    {
        InvokeAsync(async () =>
        {
            await SyncProjectCredentials();
            StateHasChanged();
        });
    }

    private async Task SyncProjectCredentials()
    {
        hasCredentials = false;
        projectId = null;
        if (activeProject == null)
            return;

        try
        {
            var config = activeProject.FcmConfig ?? new();
            var content = await PushProjectCredentials.ReadFcmAsync(config, GoogleIdentityService, SecretsService, LocalVault, FileSystem);
            await PushService.SaveServiceAccountAsync(content);
            using var document = JsonDocument.Parse(content);
            projectId = document.RootElement.GetProperty("project_id").GetString();
            hasCredentials = true;
        }
        catch (LocalVaultUnavailableException)
        {
            hasCredentials = false;
            projectId = null;
        }
        catch (Exception ex)
        {
            Logger.LogError("Failed to load Firebase project credentials.", ex);
            ToastService.Show($"Could not load this project's service account: {ex.Message}", ToastType.Error);
        }
    }

    async Task LoadFromProject(PushProject project)
    {
        activeProject = project;
        var config = project.FcmConfig ?? new FcmPushProjectConfig();

        useToken = config.UseToken;
        deviceToken = config.DeviceToken ?? "";
        topic = config.Topic ?? "";
        title = config.Title ?? "";
        body = config.Body ?? "";
        imageUrl = config.ImageUrl ?? "";
        dataEntries = config.DataEntries.Select(e => new DataEntry { Key = e.Key, Value = e.Value }).ToList();
        rawJsonMode = config.RawJsonMode;
        rawJson = config.RawJson ?? "";

        await SyncProjectCredentials();
        isDirty = false;
    }

    void ResetToBlank()
    {
        activeProject = null;
        hasCredentials = false;
        projectId = null;
        useToken = true;
        deviceToken = "";
        topic = "";
        title = "";
        body = "";
        imageUrl = "";
        dataEntries = new();
        rawJsonMode = false;
        rawJson = "";
        isDirty = false;
    }

    async Task OnActiveProjectChanged(PushProject? project)
    {
        if (project != null)
            await LoadFromProject(project);
        else
            ResetToBlank();

        StateHasChanged();
    }

    void MarkDirty() => isDirty = true;

    static readonly IReadOnlyList<SherpaSegmentOption<bool>> ModeOptions =
    [
        new(false, "Form", "fa-solid fa-list"),
        new(true, "JSON", "fa-solid fa-code")
    ];

    static readonly IReadOnlyList<SherpaSegmentOption<bool>> TargetOptions =
    [
        new(true, "Device token", "fa-solid fa-mobile-screen"),
        new(false, "Topic", "fa-solid fa-hashtag")
    ];

    int ReadyCount => rawJsonMode
        ? new[] { hasCredentials, HasRawJson }.Count(done => done)
        : new[] { hasCredentials, HasTarget, HasContent }.Count(done => done);

    void SetRawJsonMode(bool value)
    {
        if (rawJsonMode == value) return;
        rawJsonMode = value;
        MarkDirty();
    }

    void SetUseToken(bool value)
    {
        if (useToken == value) return;
        useToken = value;
        MarkDirty();
    }

    FcmPushProjectConfig BuildConfig() => new()
    {
        SelectedGoogleIdentityId = activeProject?.FcmConfig?.SelectedGoogleIdentityId,
        AuthMode = activeProject?.FcmConfig?.AuthMode ?? "identity",
        ServiceAccountFilePath = activeProject?.FcmConfig?.ServiceAccountFilePath,
        ServiceAccountSecretKey = activeProject?.FcmConfig?.ServiceAccountSecretKey,
        ServiceAccountVaultKey = activeProject?.FcmConfig?.ServiceAccountVaultKey,
        UseToken = useToken,
        DeviceToken = string.IsNullOrEmpty(deviceToken) ? null : deviceToken,
        Topic = string.IsNullOrEmpty(topic) ? null : topic,
        Title = string.IsNullOrEmpty(title) ? null : title,
        Body = string.IsNullOrEmpty(body) ? null : body,
        ImageUrl = string.IsNullOrEmpty(imageUrl) ? null : imageUrl,
        DataEntries = dataEntries
            .Where(d => !string.IsNullOrWhiteSpace(d.Key))
            .Select(d => new FcmDataEntry(d.Key, d.Value ?? ""))
            .ToList(),
        RawJsonMode = rawJsonMode,
        RawJson = string.IsNullOrEmpty(rawJson) ? null : rawJson
    };

    PushProject GetCurrentProject() => (activeProject ?? throw new InvalidOperationException("Select a project first.")) with { FcmConfig = BuildConfig() };

    async Task SaveProject()
    {
        try
        {
            if (activeProject != null)
            {
                var updated = GetCurrentProject();
                await ProjectService.SaveProjectAsync(updated);
                activeProject = await ProjectService.GetProjectAsync(updated.Id);
            }

            isDirty = false;
            ToastService.Show("Project saved.", ToastType.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Save failed: {ex.Message}", ToastType.Error);
        }
    }

    async Task SendPush()
    {
        if (!CanSend) return;
        isSending = true;

        try
        {
            await SyncProjectCredentials();
            if (!hasCredentials) return;
            var data = dataEntries
                .Where(d => !string.IsNullOrWhiteSpace(d.Key))
                .ToDictionary(d => d.Key, d => d.Value ?? "");

            var request = new FcmPushRequest(
                DeviceToken: useToken ? deviceToken.Trim() : "",
                Title: string.IsNullOrWhiteSpace(title) ? null : title,
                Body: string.IsNullOrWhiteSpace(body) ? null : body,
                Data: data.Count > 0 ? data : null,
                Topic: !useToken ? topic.Trim() : null,
                ImageUrl: string.IsNullOrWhiteSpace(imageUrl) ? null : imageUrl.Trim()
            );

            var response = await PushService.SendPushAsync(request);

            // Record history
            if (activeProject != null)
            {
                var target = !string.IsNullOrEmpty(request.Topic)
                    ? $"#{request.Topic}"
                    : TruncateToken(request.DeviceToken);
                var historyEntry = new PushSendHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Success = response.Success,
                    StatusCode = response.StatusCode,
                    MessageId = response.MessageId,
                    ErrorReason = response.Error,
                    Target = target
                };
                await ProjectService.AddHistoryEntryAsync(activeProject.Id, historyEntry);
                activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
            }

            if (response.Success)
                ToastService.Show("Push sent successfully!", ToastType.Success);
            else
                ToastService.Show($"Push failed: {response.Error}", ToastType.Error);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSending = false;
        }
    }

    async Task SendRawJson()
    {
        if (!hasCredentials || string.IsNullOrWhiteSpace(rawJson)) return;
        isSending = true;

        try
        {
            await SyncProjectCredentials();
            if (!hasCredentials) return;
            var response = await PushService.SendRawJsonAsync(rawJson);

            // Record history
            if (activeProject != null)
            {
                var historyEntry = new PushSendHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Success = response.Success,
                    StatusCode = response.StatusCode,
                    MessageId = response.MessageId,
                    ErrorReason = response.Error,
                    Target = "raw-json"
                };
                await ProjectService.AddHistoryEntryAsync(activeProject.Id, historyEntry);
                activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
            }

            if (response.Success)
                ToastService.Show("Push sent successfully!", ToastType.Success);
            else
                ToastService.Show($"Push failed: {response.Error}", ToastType.Error);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSending = false;
        }
    }

    async Task ClearHistory()
    {
        if (activeProject == null) return;
        await ProjectService.ClearHistoryAsync(activeProject.Id);
        activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
        StateHasChanged();
    }

    void AddDataEntry() { dataEntries.Add(new DataEntry()); MarkDirty(); }
    void RemoveDataEntry(int index) => dataEntries.RemoveAt(index);
    void UpdateDataKey(int index, string? value) => dataEntries[index].Key = value ?? "";
    void UpdateDataValue(int index, string? value) => dataEntries[index].Value = value ?? "";

    static string TruncateToken(string token) =>
        token.Length > 24 ? $"{token[..12]}...{token[^8..]}" : token;

    record FcmPreview(string? Title, string? Body, string? ImageUrl, string? Target, bool Silent, string SilentMessage);

    class DataEntry
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    public void Dispose()
    {
        LocalVaultAccess.StateChanged -= OnIdentityChanged;
    }
}
