@page "/firebase-push"
@using System.Text.Json
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@inject IFirebasePushService PushService
@inject IGoogleIdentityService GoogleIdentityService
@inject IGoogleIdentityStateService GoogleIdentityState
@inject IPushProjectService ProjectService
@inject IAlertService AlertService
@inject IDialogService DialogService
@inject IFileSystemService FileSystem
@inject BlazorToastService ToastService
@inject IToolbarService ToolbarService
@inject ILocalVaultAccessService LocalVaultAccess
@implements IDisposable

<div class="push-page-header">
    <div class="push-page-heading">
        <h1><i class="fas fa-paper-plane"></i> Firebase Push Testing</h1>
        <p>Send test notifications to Android devices through Firebase Cloud Messaging (FCM v1).</p>
    </div>
    <div class="push-page-status">
        @if (hasCredentials)
        {
            <span class="push-pill success" title="Firebase project">
                <i class="fas fa-fire"></i> @(string.IsNullOrEmpty(projectId) ? "Service account ready" : projectId)
            </span>
        }
        else
        {
            <span class="push-pill warning"><i class="fas fa-triangle-exclamation"></i> No service account</span>
        }
    </div>
</div>

<PushProjectBar @ref="projectBar"
    Platform="PushProjectPlatform.Fcm"
    ActiveProject="activeProject"
    ActiveProjectChanged="OnActiveProjectChanged"
    OnSaveRequested="SaveProject"
    IsDirty="isDirty" />

<GoogleIdentityPicker />

<div class="push-workspace-container">
    <div class="push-workspace">
        <div class="push-main">
            <section>
                <div class="push-section-head">
                    <div class="push-section-head-main">
                        <h2><span class="push-section-icon"><i class="fas fa-pen-to-square"></i></span> Message</h2>
                        <p class="push-section-desc">
                            @(rawJsonMode ? "Paste a raw FCM v1 message for full control over platform options." : "Compose a notification and pick who receives it.")
                        </p>
                    </div>
                    <div class="push-section-actions">
                        <div class="push-segmented">
                            <button type="button" class="@(!rawJsonMode ? "active" : "")" @onclick="@(() => SetRawJsonMode(false))">
                                <i class="fas fa-list"></i> Form
                            </button>
                            <button type="button" class="@(rawJsonMode ? "active" : "")" @onclick="@(() => SetRawJsonMode(true))">
                                <i class="fas fa-code"></i> JSON
                            </button>
                        </div>
                    </div>
                </div>

                <div class="push-card">
                    @if (rawJsonMode)
                    {
                        <div class="push-field">
                            <PushJsonEditor @bind-Value="rawJson" @bind-Value:after="MarkDirty"
                                            FileName="message.json"
                                            Placeholder="@jsonPlaceholder"
                                            Rows="18" />
                            <p class="push-hint">Enter the FCM v1 <code>message</code> object. The <code>{"{"}"message": …{"}"}</code> wrapper is added automatically if omitted.</p>
                        </div>
                    }
                    else
                    {
                        <div class="push-subheading">Target</div>
                        <div class="push-fields">
                            <div class="push-segmented">
                                <button type="button" class="@(useToken ? "active" : "")" @onclick="@(() => SetUseToken(true))">
                                    <i class="fas fa-mobile-screen"></i> Device token
                                </button>
                                <button type="button" class="@(!useToken ? "active" : "")" @onclick="@(() => SetUseToken(false))">
                                    <i class="fas fa-hashtag"></i> Topic
                                </button>
                            </div>
                            @if (useToken)
                            {
                                <div class="push-field">
                                    <input type="text" class="push-input mono" placeholder="FCM registration token" aria-label="Device token"
                                           @bind="deviceToken" @bind:event="oninput" @bind:after="MarkDirty" />
                                </div>
                            }
                            else
                            {
                                <div class="push-field">
                                    <input type="text" class="push-input" placeholder="e.g. news, updates" aria-label="Topic"
                                           @bind="topic" @bind:event="oninput" @bind:after="MarkDirty" />
                                </div>
                            }
                        </div>

                        <div class="push-card-divider"></div>

                        <div class="push-subheading">Notification</div>
                        <div class="push-fields">
                            <div class="push-field">
                                <label>Title</label>
                                <input type="text" class="push-input" placeholder="Notification title"
                                       @bind="title" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                            <div class="push-field">
                                <label>Body</label>
                                <textarea class="push-input" rows="3" placeholder="Notification body text"
                                          @bind="body" @bind:event="oninput" @bind:after="MarkDirty"></textarea>
                            </div>
                            <div class="push-field">
                                <label>Image URL <span class="push-optional">optional</span></label>
                                <input type="text" class="push-input" placeholder="https://example.com/image.png"
                                       @bind="imageUrl" @bind:event="oninput" @bind:after="MarkDirty" />
                            </div>
                        </div>

                        <div class="push-card-divider"></div>

                        <div class="push-subheading">
                            <span>Data payload <span class="push-optional">optional</span></span>
                            <button type="button" class="push-link-btn" @onclick="AddDataEntry">
                                <i class="fas fa-plus"></i> Add field
                            </button>
                        </div>
                        @if (dataEntries.Count == 0)
                        {
                            <div class="push-kv-empty">No custom data. Add key/value pairs your app reads from <code>RemoteMessage.data</code>.</div>
                        }
                        else
                        {
                            <div class="push-kv-list">
                                @for (var i = 0; i < dataEntries.Count; i++)
                                {
                                    var index = i;
                                    <div class="push-kv-row">
                                        <input type="text" class="push-input mono" placeholder="key" aria-label="Data key"
                                               value="@dataEntries[index].Key"
                                               @oninput="e => { UpdateDataKey(index, e.Value?.ToString()); MarkDirty(); }" />
                                        <input type="text" class="push-input" placeholder="value" aria-label="Data value"
                                               value="@dataEntries[index].Value"
                                               @oninput="e => { UpdateDataValue(index, e.Value?.ToString()); MarkDirty(); }" />
                                        <button type="button" class="push-icon-btn danger" title="Remove field" @onclick="() => { RemoveDataEntry(index); MarkDirty(); }">
                                            <i class="fas fa-xmark"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </section>

            @if (activeProject?.History.Count > 0)
            {
                <PushHistoryList History="activeProject.History" OnClear="ClearHistory" />
            }
        </div>

        <aside class="push-aside">
            @{ var preview = BuildPreview(); }
            <PushNotificationPreview Variant="android"
                                     AppName="@(string.IsNullOrEmpty(projectId) ? "Your App" : projectId)"
                                     Title="@preview.Title"
                                     Body="@preview.Body"
                                     ImageUrl="@preview.ImageUrl"
                                     Silent="@preview.Silent"
                                     SilentMessage="@preview.SilentMessage" />

            <div class="push-panel">
                <div class="push-panel-title">@(CanSendCurrent ? "Ready to send" : "Before you send")</div>
                <dl class="push-summary">
                    <div class="push-summary-row"><dt>Project</dt><dd>@(string.IsNullOrEmpty(projectId) ? "—" : projectId)</dd></div>
                    <div class="push-summary-row"><dt>Mode</dt><dd>@(rawJsonMode ? "Raw JSON" : "Form")</dd></div>
                    <div class="push-summary-row"><dt>Target</dt><dd class="push-mono">@(preview.Target ?? "—")</dd></div>
                    @if (!rawJsonMode)
                    {
                        <div class="push-summary-row"><dt>Data fields</dt><dd>@dataEntries.Count(d => !string.IsNullOrWhiteSpace(d.Key))</dd></div>
                    }
                </dl>
                <ul class="push-checklist">
                    <li class="@(hasCredentials ? "done" : "")"><i class="@CheckIcon(hasCredentials)"></i> Service account</li>
                    @if (rawJsonMode)
                    {
                        <li class="@(HasRawJson ? "done" : "")"><i class="@CheckIcon(HasRawJson)"></i> Message JSON</li>
                    }
                    else
                    {
                        <li class="@(HasTarget ? "done" : "")"><i class="@CheckIcon(HasTarget)"></i> @(useToken ? "Device token" : "Topic")</li>
                        <li class="@(HasContent ? "done" : "")"><i class="@CheckIcon(HasContent)"></i> Title, body, or data</li>
                    }
                </ul>
                <button class="btn btn-primary push-send-btn" @onclick="SendCurrent" disabled="@(!CanSendCurrent || isSending)">
                    <i class="fas @(isSending ? "fa-spinner fa-spin" : "fa-paper-plane")"></i>
                    @(isSending ? "Sending…" : "Send Push")
                </button>
                @if (activeProject == null)
                {
                    <p class="push-send-note">Save this project to keep a send history.</p>
                }
            </div>
        </aside>
    </div>
</div>

@code {
    PushProjectBar? projectBar;
    PushProject? activeProject;
    bool hasCredentials;
    string? projectId;

    // Compose - Form mode
    bool useToken = true;
    string deviceToken = "";
    string topic = "";
    string title = "";
    string body = "";
    string imageUrl = "";
    List<DataEntry> dataEntries = new();
    bool isSending;
    bool isDirty;

    // Compose - JSON mode
    bool rawJsonMode;
    string rawJson = "";
    const string jsonPlaceholder = "{\n  \"token\": \"DEVICE_TOKEN\",\n  \"notification\": {\n    \"title\": \"Test\",\n    \"body\": \"Hello from Sherpa!\"\n  },\n  \"android\": {\n    \"priority\": \"high\",\n    \"notification\": {\n      \"channel_id\": \"default\"\n    }\n  },\n  \"data\": {\n    \"key\": \"value\"\n  }\n}";

    bool HasTarget => useToken ? !string.IsNullOrWhiteSpace(deviceToken) : !string.IsNullOrWhiteSpace(topic);
    bool HasContent => !string.IsNullOrWhiteSpace(title) || !string.IsNullOrWhiteSpace(body) || dataEntries.Any(d => !string.IsNullOrWhiteSpace(d.Key));
    bool HasRawJson => !string.IsNullOrWhiteSpace(rawJson);

    bool CanSend => hasCredentials && HasTarget && HasContent;
    bool CanSendCurrent => rawJsonMode ? hasCredentials && HasRawJson : CanSend;

    static string CheckIcon(bool done) => done ? "fas fa-circle-check" : "fa-regular fa-circle";

    Task SendCurrent() => rawJsonMode ? SendRawJson() : SendPush();

    FcmPreview BuildPreview()
    {
        if (!rawJsonMode)
        {
            var target = useToken
                ? (string.IsNullOrWhiteSpace(deviceToken) ? null : TruncateToken(deviceToken.Trim()))
                : (string.IsNullOrWhiteSpace(topic) ? null : $"#{topic.Trim()}");
            var dataOnly = string.IsNullOrWhiteSpace(title) && string.IsNullOrWhiteSpace(body)
                && dataEntries.Any(d => !string.IsNullOrWhiteSpace(d.Key));
            return new(title, body, imageUrl, target, dataOnly,
                "Data-only messages are delivered to your app without showing a notification.");
        }

        if (string.IsNullOrWhiteSpace(rawJson))
            return new(null, null, null, null, false, "");

        try
        {
            using var doc = JsonDocument.Parse(rawJson);
            var message = doc.RootElement;
            if (message.ValueKind != JsonValueKind.Object)
                return new(null, null, null, null, true, "The message must be a JSON object.");
            if (message.TryGetProperty("message", out var inner) && inner.ValueKind == JsonValueKind.Object)
                message = inner;

            string? t = null, b = null, image = null;
            if (message.TryGetProperty("notification", out var notification) && notification.ValueKind == JsonValueKind.Object)
            {
                t = GetString(notification, "title");
                b = GetString(notification, "body");
                image = GetString(notification, "image");
            }
            if (message.TryGetProperty("android", out var android) && android.ValueKind == JsonValueKind.Object
                && android.TryGetProperty("notification", out var androidNotification) && androidNotification.ValueKind == JsonValueKind.Object)
            {
                t = GetString(androidNotification, "title") ?? t;
                b = GetString(androidNotification, "body") ?? b;
                image = GetString(androidNotification, "image") ?? image;
            }

            var target = GetString(message, "token") is { Length: > 0 } token
                ? TruncateToken(token)
                : GetString(message, "topic") is { Length: > 0 } jsonTopic
                    ? $"#{jsonTopic}"
                    : GetString(message, "condition");

            var silent = string.IsNullOrWhiteSpace(t) && string.IsNullOrWhiteSpace(b);
            return new(t, b, image, target, silent,
                "This message has no notification block, so it is delivered to your app silently.");
        }
        catch (JsonException)
        {
            return new(null, null, null, null, true, "Fix the message JSON to see a preview.");
        }
    }

    static string? GetString(JsonElement element, string name) =>
        element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;

    protected override async Task OnInitializedAsync()
    {
        ToolbarService.ClearItems();
        GoogleIdentityState.OnSelectionChanged += OnIdentityChanged;

        // Load projects and select most recent (or create blank)
        var projects = await ProjectService.GetProjectsAsync(PushProjectPlatform.Fcm);
        if (projects.Count > 0)
            await LoadFromProject(projects[0]);

        await SyncCredentialsFromIdentity();
    }

    private void OnIdentityChanged()
    {
        InvokeAsync(async () =>
        {
            await SyncCredentialsFromIdentity();
            StateHasChanged();
        });
    }

    private async Task SyncCredentialsFromIdentity()
    {
        if (LocalVaultAccess.GetState().RequiresUserAction)
        {
            hasCredentials = false;
            projectId = null;
            return;
        }

        try
        {
            var identity = GoogleIdentityState.SelectedIdentity;
            if (identity != null && !string.IsNullOrEmpty(identity.ServiceAccountJson))
            {
                await PushService.SaveServiceAccountAsync(identity.ServiceAccountJson);
                hasCredentials = true;
                projectId = identity.ProjectId;
            }
            else
            {
                hasCredentials = await PushService.HasCredentialsAsync();
                projectId = hasCredentials ? await PushService.GetProjectIdAsync() : null;
            }
        }
        catch (LocalVaultUnavailableException)
        {
            hasCredentials = false;
            projectId = null;
        }
    }

    async Task LoadFromProject(PushProject project)
    {
        activeProject = project;
        var config = project.FcmConfig ?? new FcmPushProjectConfig();

        useToken = config.UseToken;
        deviceToken = config.DeviceToken ?? "";
        topic = config.Topic ?? "";
        title = config.Title ?? "";
        body = config.Body ?? "";
        imageUrl = config.ImageUrl ?? "";
        dataEntries = config.DataEntries.Select(e => new DataEntry { Key = e.Key, Value = e.Value }).ToList();
        rawJsonMode = config.RawJsonMode;
        rawJson = config.RawJson ?? "";

        // Restore Google identity selection
        if (!string.IsNullOrEmpty(config.SelectedGoogleIdentityId))
        {
            var identity = await GoogleIdentityService.GetIdentityAsync(config.SelectedGoogleIdentityId);
            if (identity != null)
                GoogleIdentityState.SetSelectedIdentity(identity);
        }

        isDirty = false;
    }

    void ResetToBlank()
    {
        activeProject = null;
        useToken = true;
        deviceToken = "";
        topic = "";
        title = "";
        body = "";
        imageUrl = "";
        dataEntries = new();
        rawJsonMode = false;
        rawJson = "";
        isDirty = false;
    }

    async Task OnActiveProjectChanged(PushProject? project)
    {
        if (project != null)
            await LoadFromProject(project);
        else
            ResetToBlank();

        StateHasChanged();
    }

    void MarkDirty() => isDirty = true;

    void SetRawJsonMode(bool value)
    {
        if (rawJsonMode == value) return;
        rawJsonMode = value;
        MarkDirty();
    }

    void SetUseToken(bool value)
    {
        if (useToken == value) return;
        useToken = value;
        MarkDirty();
    }

    FcmPushProjectConfig BuildConfig() => new()
    {
        SelectedGoogleIdentityId = GoogleIdentityState.SelectedIdentity?.Id,
        UseToken = useToken,
        DeviceToken = string.IsNullOrEmpty(deviceToken) ? null : deviceToken,
        Topic = string.IsNullOrEmpty(topic) ? null : topic,
        Title = string.IsNullOrEmpty(title) ? null : title,
        Body = string.IsNullOrEmpty(body) ? null : body,
        ImageUrl = string.IsNullOrEmpty(imageUrl) ? null : imageUrl,
        DataEntries = dataEntries
            .Where(d => !string.IsNullOrWhiteSpace(d.Key))
            .Select(d => new FcmDataEntry(d.Key, d.Value ?? ""))
            .ToList(),
        RawJsonMode = rawJsonMode,
        RawJson = string.IsNullOrEmpty(rawJson) ? null : rawJson
    };

    async Task SaveProject()
    {
        try
        {
            var name = projectBar?.GetProjectName() ?? "Untitled";
            var description = projectBar?.GetProjectDescription();

            if (activeProject != null)
            {
                var updated = activeProject with
                {
                    Name = name,
                    Description = description,
                    FcmConfig = BuildConfig()
                };
                await ProjectService.SaveProjectAsync(updated);
                activeProject = await ProjectService.GetProjectAsync(updated.Id);
            }
            else
            {
                var project = new PushProject
                {
                    Name = name,
                    Description = description,
                    Platform = PushProjectPlatform.Fcm,
                    FcmConfig = BuildConfig()
                };
                await ProjectService.SaveProjectAsync(project);
                activeProject = await ProjectService.GetProjectAsync(project.Id);
            }

            isDirty = false;
            ToastService.Show("Project saved.", ToastType.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Save failed: {ex.Message}", ToastType.Error);
        }
    }

    async Task SendPush()
    {
        if (!CanSend) return;
        isSending = true;

        try
        {
            var data = dataEntries
                .Where(d => !string.IsNullOrWhiteSpace(d.Key))
                .ToDictionary(d => d.Key, d => d.Value ?? "");

            var request = new FcmPushRequest(
                DeviceToken: useToken ? deviceToken.Trim() : "",
                Title: string.IsNullOrWhiteSpace(title) ? null : title,
                Body: string.IsNullOrWhiteSpace(body) ? null : body,
                Data: data.Count > 0 ? data : null,
                Topic: !useToken ? topic.Trim() : null,
                ImageUrl: string.IsNullOrWhiteSpace(imageUrl) ? null : imageUrl.Trim()
            );

            var response = await PushService.SendPushAsync(request);

            // Record history
            if (activeProject != null)
            {
                var target = !string.IsNullOrEmpty(request.Topic)
                    ? $"#{request.Topic}"
                    : TruncateToken(request.DeviceToken);
                var historyEntry = new PushSendHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Success = response.Success,
                    StatusCode = response.StatusCode,
                    MessageId = response.MessageId,
                    ErrorReason = response.Error,
                    Target = target
                };
                await ProjectService.AddHistoryEntryAsync(activeProject.Id, historyEntry);
                activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
            }

            if (response.Success)
                ToastService.Show("Push sent successfully!", ToastType.Success);
            else
                ToastService.Show($"Push failed: {response.Error}", ToastType.Error);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSending = false;
        }
    }

    async Task SendRawJson()
    {
        if (!hasCredentials || string.IsNullOrWhiteSpace(rawJson)) return;
        isSending = true;

        try
        {
            var response = await PushService.SendRawJsonAsync(rawJson);

            // Record history
            if (activeProject != null)
            {
                var historyEntry = new PushSendHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Success = response.Success,
                    StatusCode = response.StatusCode,
                    MessageId = response.MessageId,
                    ErrorReason = response.Error,
                    Target = "raw-json"
                };
                await ProjectService.AddHistoryEntryAsync(activeProject.Id, historyEntry);
                activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
            }

            if (response.Success)
                ToastService.Show("Push sent successfully!", ToastType.Success);
            else
                ToastService.Show($"Push failed: {response.Error}", ToastType.Error);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSending = false;
        }
    }

    async Task ClearHistory()
    {
        if (activeProject == null) return;
        await ProjectService.ClearHistoryAsync(activeProject.Id);
        activeProject = await ProjectService.GetProjectAsync(activeProject.Id);
        StateHasChanged();
    }

    void AddDataEntry() { dataEntries.Add(new DataEntry()); MarkDirty(); }
    void RemoveDataEntry(int index) => dataEntries.RemoveAt(index);
    void UpdateDataKey(int index, string? value) => dataEntries[index].Key = value ?? "";
    void UpdateDataValue(int index, string? value) => dataEntries[index].Value = value ?? "";

    static string TruncateToken(string token) =>
        token.Length > 24 ? $"{token[..12]}...{token[^8..]}" : token;

    record FcmPreview(string? Title, string? Body, string? ImageUrl, string? Target, bool Silent, string SilentMessage);

    class DataEntry
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    public void Dispose()
    {
        GoogleIdentityState.OnSelectionChanged -= OnIdentityChanged;
    }
}
