@page "/secrets/publish"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Pages.Forms
@inject IPublishProfileService ProfileService
@inject ISecretsPublisherService PublisherService
@inject IAlertService AlertService
@inject ILoggingService Logger
@inject IToolbarService ToolbarService
@inject IFormModalService FormModalService
@inject HybridFormBridgeHolder BridgeHolder
@inject ICloudSecretsService CloudSecretsService
@inject ISecretSyncCoordinator SecretSyncCoordinator
@implements IDisposable

<h1><i class="fas fa-upload"></i> Publish Profiles</h1>

@if (CloudSecretsService.ActiveProvider is null)
{
    <div class="info-message">
        <i class="fas fa-info-circle"></i>
        Configure a secrets provider in <a href="settings">Settings</a> to create and manage publish profiles.
    </div>
}
else if (isLoading && profiles.Count == 0)
{
    <div class="loading-inline"><i class="fas fa-spinner fa-spin"></i> Loading profiles...</div>
}
else if (profiles.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-upload"></i></div>
        <h2>No Publish Profiles</h2>
        <p>Create a publish profile to bundle Apple certificates, Android keystores, and secrets together for one-click CI/CD publishing.</p>
        <button class="btn btn-primary" @onclick="CreateProfile">
            <i class="fas fa-plus"></i> Create Profile
        </button>
    </div>
}
else
{
    @if (isSelectionMode)
    {
        <div class="selection-bar">
            <label class="select-all-checkbox">
                <input type="checkbox"
                       checked="@AllProfilesSelected"
                       @onchange="@(e => ToggleAllProfiles(e.Value is bool on && on))" />
                <span>Select all profiles</span>
            </label>
            <div class="selection-actions">
                <span class="selection-count">@selectedProfileIds.Count selected</span>
                <button class="btn btn-primary btn-sm"
                        disabled="@(selectedProfileIds.Count == 0)"
                        @onclick="PublishSelectedProfiles">
                    <i class="fa-solid fa-upload"></i>
                    <span>Publish @selectedProfileIds.Count</span>
                </button>
            </div>
        </div>
    }
    else if (isRefreshing)
    {
        <div class="loading-inline"><i class="fas fa-spinner fa-spin"></i> Refreshing profiles...</div>
    }

    <div class="profile-grid">
        @foreach (var profile in profiles)
        {
            <div class="profile-card @(isSelectionMode && selectedProfileIds.Contains(profile.Id) ? "selected" : "")">
                <div class="profile-header">
                    @if (isSelectionMode)
                    {
                        <label class="profile-select" title="Include in a sequential publish">
                            <input type="checkbox"
                                   checked="@selectedProfileIds.Contains(profile.Id)"
                                   @onchange="@(e => ToggleProfileSelection(profile.Id, e.Value is bool on && on))" />
                        </label>
                    }
                    <div class="profile-title">@profile.Name</div>
                    @if (!isSelectionMode)
                    {
                        <div class="profile-actions">
                            <MauiSherpa.Components.SecretProviderPickerHost
                                @key="@($"publish-profile-sync-{profile.Id}")"
                                Item="@(new SecretItemRef(SecretItemKind.PublishProfile, profile.Id, profile.Name))"
                                EmptySelectionRequiresConfirmation="true" />
                            <button class="btn-icon" @onclick="@(() => EditProfile(profile))" title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="btn-icon danger" @onclick="@(() => DeleteProfile(profile))" title="Delete">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(profile.Description))
                {
                    <div class="profile-description">@profile.Description</div>
                }

                <div class="profile-summary">
                    @if (profile.AppleConfigs.Any())
                    {
                        <span class="summary-badge apple">
                            <i class="fa-brands fa-apple"></i> @profile.AppleConfigs.Count Apple
                        </span>
                    }
                    @if (profile.AppleIdentities.Any())
                    {
                        <span class="summary-badge apple">
                            <i class="fa-solid fa-id-badge"></i> @profile.AppleIdentities.Count Apple @(profile.AppleIdentities.Count == 1 ? "Identity" : "Identities")
                        </span>
                    }
                    @if (profile.AndroidConfigs.Any())
                    {
                        <span class="summary-badge android">
                            <i class="fa-brands fa-android"></i> @profile.AndroidConfigs.Count Android
                        </span>
                    }
                    @if (profile.GoogleIdentities.Any())
                    {
                        <span class="summary-badge android">
                            <i class="fa-brands fa-google"></i> @profile.GoogleIdentities.Count Google @(profile.GoogleIdentities.Count == 1 ? "Identity" : "Identities")
                        </span>
                    }
                    @if (profile.SecretMappings.Any())
                    {
                        <span class="summary-badge secrets">
                            <i class="fa-solid fa-key"></i> @profile.SecretMappings.Count Secrets
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(profile.RepositoryFullName))
                {
                    <div class="profile-target">
                        <i class="fa-solid fa-arrow-right"></i> @profile.RepositoryFullName
                    </div>
                }

                @if (!isSelectionMode)
                {
                    <div class="profile-footer">
                        <button class="btn btn-primary btn-sm" @onclick="@(() => PublishProfile(profile))"
                                disabled="@(publishingProfileId == profile.Id)">
                            @if (publishingProfileId == profile.Id)
                            {
                                <i class="fa-solid fa-spinner fa-spin"></i> <span>Publishing...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-upload"></i> <span>Publish</span>
                            }
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    const int RefreshDebounceMilliseconds = 250;

    List<PublishProfile> profiles = new();
    readonly HashSet<string> selectedProfileIds = new(StringComparer.Ordinal);
    bool isLoading = true;
    bool isRefreshing;
    bool isSelectionMode;
    string? publishingProfileId;
    CancellationTokenSource? refreshDebounceCts;
    int loadSequence;

    bool AllProfilesSelected => profiles.Count > 0 &&
        profiles.All(profile => selectedProfileIds.Contains(profile.Id));

    protected override async Task OnInitializedAsync()
    {
        UpdateToolbarItems();
        ToolbarService.SetSearch(null);
        ToolbarService.SetFilters();
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        ProfileService.OnProfilesChanged += OnProfilesChanged;

        await CloudSecretsService.InitializeAsync();
        await LoadProfilesAsync();
    }

    // SetItems resets search/filters and prompts a native toolbar rebuild, so only call it
    // when the item set actually changes — enabled state has its own cheaper path.
    void UpdateToolbarItems()
    {
        if (isSelectionMode)
        {
            ToolbarService.SetItems(
                new ToolbarAction("publish-selected", "Publish Selected", "square.and.arrow.up"),
                new ToolbarAction("cancel-selection", "Cancel", "xmark", IsPrimary: false));
        }
        else
        {
            ToolbarService.SetItems(
                new ToolbarAction("create", "New Profile", "plus"),
                new ToolbarAction("select", "Select", "checkmark.circle"),
                new ToolbarAction("refresh", "Refresh", "arrow.clockwise"));
        }

        UpdateToolbarEnabledState();
    }

    void UpdateToolbarEnabledState()
    {
        if (isSelectionMode)
            ToolbarService.SetItemEnabled("publish-selected", selectedProfileIds.Count > 0);
        else
            ToolbarService.SetItemEnabled("select", profiles.Count > 0);
    }

    void OnToolbarItemClicked(string actionId)
    {
        switch (actionId)
        {
            case "create":
                InvokeAsync(CreateProfile);
                break;
            case "select":
                InvokeAsync(() => { EnterSelectionMode(); return Task.CompletedTask; });
                break;
            case "publish-selected":
                InvokeAsync(PublishSelectedProfiles);
                break;
            case "cancel-selection":
                InvokeAsync(() => { ExitSelectionMode(); return Task.CompletedTask; });
                break;
            case "refresh":
                ToolbarService.SetItemEnabled("refresh", false);
                InvokeAsync(async () =>
                {
                    try { await LoadProfilesAsync(refreshFromProviders: true); }
                    finally { ToolbarService.SetItemEnabled("refresh", true); }
                });
                break;
        }
    }

    // Syncing an item raises one change per provider placement, so collapse the burst
    // into a single background reload instead of thrashing the whole grid.
    void OnProfilesChanged()
    {
        var debounce = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref refreshDebounceCts, debounce);
        previous?.Cancel();
        previous?.Dispose();

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(RefreshDebounceMilliseconds, debounce.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            await LoadProfilesAsync(background: true);
        });
    }

    async Task LoadProfilesAsync(bool background = false, bool refreshFromProviders = false)
    {
        var sequence = ++loadSequence;
        if (background && profiles.Count > 0)
            isRefreshing = true;
        else
            isLoading = true;
        StateHasChanged();

        try
        {
            // Providers report in as they finish, so the local vault's profiles paint
            // immediately instead of waiting on a remote vault's round trips.
            var progress = new Progress<IReadOnlyList<PublishProfile>>(partial =>
                _ = InvokeAsync(() =>
                {
                    if (sequence != loadSequence)
                        return;

                    ApplyLoadedProfiles(partial);
                    isLoading = false;
                    isRefreshing = true;
                    StateHasChanged();
                }));

            var loaded = refreshFromProviders
                ? await ProfileService.RefreshProfilesAsync(progress)
                : await ProfileService.GetProfilesAsync(progress);

            // A newer load started while this one was in flight — let it win.
            if (sequence != loadSequence)
                return;

            ApplyLoadedProfiles(loaded);
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to load publish profiles: {ex}");
        }
        finally
        {
            if (sequence == loadSequence)
            {
                isLoading = false;
                isRefreshing = false;
            }
            StateHasChanged();
        }
    }

    void ApplyLoadedProfiles(IReadOnlyList<PublishProfile> loaded)
    {
        profiles = loaded.ToList();
        selectedProfileIds.IntersectWith(profiles.Select(profile => profile.Id));
        if (isSelectionMode && profiles.Count == 0)
        {
            isSelectionMode = false;
            UpdateToolbarItems();
            return;
        }

        UpdateToolbarEnabledState();
    }

    void EnterSelectionMode()
    {
        isSelectionMode = true;
        selectedProfileIds.Clear();
        UpdateToolbarItems();
        StateHasChanged();
    }

    void ExitSelectionMode()
    {
        isSelectionMode = false;
        selectedProfileIds.Clear();
        UpdateToolbarItems();
        StateHasChanged();
    }

    void ToggleProfileSelection(string profileId, bool selected)
    {
        if (selected)
            selectedProfileIds.Add(profileId);
        else
            selectedProfileIds.Remove(profileId);
        UpdateToolbarEnabledState();
    }

    void ToggleAllProfiles(bool selected)
    {
        selectedProfileIds.Clear();
        if (selected)
        {
            foreach (var profile in profiles)
                selectedProfileIds.Add(profile.Id);
        }
        UpdateToolbarEnabledState();
    }

    async Task CreateProfile()
    {
        var page = new Modals.PublishProfileEditorPage(BridgeHolder);
        var result = await FormModalService.ShowAsync<PublishProfile?>(page);

        if (result is not null)
        {
            await SecretSyncCoordinator.SetDefaultProvidersAsync(
                new SecretItemRef(
                    SecretItemKind.PublishProfile,
                    result.Id,
                    result.Name));
            await LoadProfilesAsync(background: true);
            await AlertService.ShowToastAsync($"Profile '{result.Name}' created.");
        }
    }

    async Task EditProfile(PublishProfile profile)
    {
        var item = new SecretItemRef(
            SecretItemKind.PublishProfile,
            profile.Id,
            profile.Name);
        var page = new Modals.PublishProfileEditorPage(BridgeHolder, profile);
        var result = await FormModalService.ShowAsync<PublishProfile?>(page);

        if (result is not null)
        {
            if (CloudSecretsService.ActiveProvider is not null)
            {
                await SecretSyncCoordinator.ResolveConflictAsync(
                    item with { DisplayName = result.Name },
                    CloudSecretsService.ActiveProvider.Id);
            }
            await LoadProfilesAsync(background: true);
            await AlertService.ShowToastAsync($"Profile '{result.Name}' updated.");
        }
    }

    async Task DeleteProfile(PublishProfile profile)
    {
        var confirmed = await AlertService.ShowConfirmAsync(
            "Delete Profile",
            $"Are you sure you want to delete '{profile.Name}'? This cannot be undone.");

        if (confirmed)
        {
            await SecretSyncCoordinator.SetDesiredProvidersAsync(
                new SecretItemRef(
                    SecretItemKind.PublishProfile,
                    profile.Id,
                    profile.Name),
                Array.Empty<string>());
            await AlertService.ShowToastAsync($"Deletion of '{profile.Name}' was queued.");
        }
    }

    async Task PublishProfile(PublishProfile profile)
    {
        publishingProfileId = profile.Id;
        StateHasChanged();

        try
        {
            // Open publish review dialog — it handles secret resolution internally
            var page = new Modals.PublishReviewPage(BridgeHolder, profile);
            var result = await FormModalService.ShowAsync<bool>(page);

            if (result == true)
                await AlertService.ShowToastAsync($"Published secrets successfully.");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to publish profile: {ex}");
            await AlertService.ShowAlertAsync("Error", $"Failed to publish: {ex.Message}");
        }
        finally
        {
            publishingProfileId = null;
            StateHasChanged();
        }
    }

    async Task PublishSelectedProfiles()
    {
        var selected = profiles
            .Where(profile => selectedProfileIds.Contains(profile.Id))
            .ToList();
        if (selected.Count == 0)
            return;

        try
        {
            var page = new Modals.BatchPublishPage(BridgeHolder, selected);
            var result = await FormModalService.ShowAsync<bool>(page);

            if (result == true)
            {
                ExitSelectionMode();
                await AlertService.ShowToastAsync(
                    $"Finished publishing {selected.Count} profile(s).");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to publish selected profiles: {ex}");
            await AlertService.ShowAlertAsync("Error", $"Failed to publish: {ex.Message}");
        }
    }

    public void Dispose()
    {
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        ProfileService.OnProfilesChanged -= OnProfilesChanged;
        var debounce = Interlocked.Exchange(ref refreshDebounceCts, null);
        debounce?.Cancel();
        debounce?.Dispose();
    }
}

<style>
    h1 { margin-bottom: 1.25rem; font-size: 1.75rem; color: var(--text-primary); }

    .info-message {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: linear-gradient(135deg, rgba(66, 153, 225, 0.1), rgba(66, 153, 225, 0.05));
        border: none;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }
    .info-message i { color: var(--accent-primary); margin-top: 2px; }
    .info-message a { color: var(--accent-primary); text-decoration: none; }
    .info-message a:hover { text-decoration: underline; }

    .loading-inline {
        font-size: 0.875rem;
        color: var(--text-muted);
        padding: 0.5rem 0;
    }

    /* Empty state */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        font-size: 3rem;
        color: var(--text-muted);
        opacity: 0.3;
        margin-bottom: 1rem;
    }

    .empty-state h2 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        color: var(--text-primary);
    }

    .empty-state p {
        margin: 0 0 1.5rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        max-width: 400px;
    }

    /* Profile grid */
    .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1rem;
    }

    .profile-card {
        background: var(--card-bg);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .profile-card.selected {
        outline: 2px solid var(--accent-primary, #3b82f6);
        outline-offset: -2px;
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .profile-select {
        display: flex;
        align-items: center;
        cursor: pointer;
    }

    .profile-select input {
        width: 18px;
        height: 18px;
        accent-color: var(--accent-primary);
    }

    .profile-title {
        flex: 1;
        min-width: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    /* Selection bar */
    .selection-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1rem;
        margin-bottom: 0.75rem;
        background: var(--card-bg);
        border-radius: 0.75rem;
    }

    .select-all-checkbox {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        cursor: pointer;
    }

    .select-all-checkbox input {
        width: 18px;
        height: 18px;
        accent-color: var(--accent-primary);
    }

    .selection-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .selection-count {
        font-size: 0.8125rem;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .profile-actions {
        display: flex;
        gap: 2px;
    }

    .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 0.25rem;
        color: var(--text-muted);
        font-size: 0.8125rem;
        transition: all 0.15s;
    }

    .btn-icon:hover {
        background: var(--bg-hover);
        color: var(--text-primary);
    }

    .btn-icon.danger:hover {
        color: var(--danger-color, #ef4444);
    }

    .profile-description {
        font-size: 0.8125rem;
        color: var(--text-muted);
    }

    .profile-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .summary-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 0.75rem;
        font-size: 0.6875rem;
        font-weight: 500;
    }

    .summary-badge.apple {
        background: var(--status-info-bg, rgba(66, 153, 225, 0.1));
        color: var(--status-info-text, #2b6cb0);
    }

    .summary-badge.android {
        background: rgba(52, 168, 83, 0.1);
        color: #2d7d46;
    }

    .summary-badge.secrets {
        background: rgba(107, 70, 193, 0.1);
        color: #6b46c1;
    }

    .profile-target {
        font-size: 0.75rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .profile-footer {
        margin-top: 4px;
        display: flex;
        justify-content: flex-end;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border: none;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s;
    }

    .btn-primary {
        background: var(--accent-primary, #3b82f6);
        color: white;
    }

    .btn-primary:hover { opacity: 0.9; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-sm {
        padding: 5px 12px;
        font-size: 0.75rem;
    }

    .btn i { font-size: 0.75rem; }

    /* Dark mode */
    :global(.theme-dark) .summary-badge.android { background: rgba(52, 168, 83, 0.15); color: #6fcf97; }
    :global(.theme-dark) .summary-badge.secrets { background: rgba(107, 70, 193, 0.15); color: #d6bcfa; }
</style>
