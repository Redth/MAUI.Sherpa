@page "/secrets/publish"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Pages.Forms
@inject IPublishProfileService ProfileService
@inject ISecretsPublisherService PublisherService
@inject IAlertService AlertService
@inject ILoggingService Logger
@inject IToolbarService ToolbarService
@inject IFormModalService FormModalService
@inject HybridFormBridgeHolder BridgeHolder
@inject ICloudSecretsService CloudSecretsService
@inject ISecretSyncCoordinator SecretSyncCoordinator
@inject IPublishProfileHealthService HealthService
@implements IDisposable

<h1 class="sherpa-page-title"><i class="fa-solid fa-fw fa-upload"></i> Publish Profiles</h1>

@if (CloudSecretsService.ActiveProvider is null)
{
    <div class="info-message sherpa-banner sherpa-banner-info">
        <i class="fa-solid fa-fw fa-circle-info"></i>
        Configure a secrets provider in <a href="settings">Settings</a> to create and manage publish profiles.
    </div>
}
else if (isLoading && profiles.Count == 0)
{
    <div class="loading-inline"><i class="fa-solid fa-fw fa-spinner fa-spin"></i> Loading profiles...</div>
}
else if (profiles.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fa-solid fa-fw fa-upload"></i></div>
        <h2>No Publish Profiles</h2>
        <p>Create a publish profile to bundle Apple certificates, Android keystores, and secrets together for one-click CI/CD publishing.</p>
        <button data-screenshot-external class="btn btn-primary" @onclick="CreateProfile">
            <i class="fa-solid fa-fw fa-plus"></i> Create Profile
        </button>
    </div>
}
else
{
    @if (isSelectionMode)
    {
        <div class="selection-bar sherpa-selection-bar">
            <label class="select-all-checkbox">
                <input type="checkbox"
                       checked="@AllProfilesSelected"
                       @onchange="@(e => ToggleAllProfiles(e.Value is bool on && on))" />
                <span>Select all profiles</span>
            </label>
            <div class="selection-actions">
                <span class="selection-count sherpa-badge sherpa-badge-accent">@selectedProfileIds.Count selected</span>
                <button data-screenshot-external class="btn btn-primary btn-sm"
                        disabled="@(selectedProfileIds.Count == 0)"
                        @onclick="PublishSelectedProfiles">
                    <i class="fa-solid fa-upload"></i>
                    <span>Publish @selectedProfileIds.Count</span>
                </button>
            </div>
        </div>
    }
    else if (isRefreshing)
    {
        <div class="loading-inline"><i class="fa-solid fa-fw fa-spinner fa-spin"></i> Refreshing profiles...</div>
    }

    <div class="profile-grid">
        @foreach (var profile in profiles)
        {
            <div class="profile-card @(isSelectionMode && selectedProfileIds.Contains(profile.Id) ? "selected" : "") @(isSelectionMode ? "selectable" : "")"
                 @onclick="@(() => { if (isSelectionMode) ToggleProfileSelection(profile.Id, !selectedProfileIds.Contains(profile.Id)); })">
                <div class="profile-header">
                    @if (isSelectionMode)
                    {
                        <label class="profile-select" title="Include in a sequential publish" @onclick:stopPropagation="true">
                            <input type="checkbox"
                                   checked="@selectedProfileIds.Contains(profile.Id)"
                                   @onchange="@(e => ToggleProfileSelection(profile.Id, e.Value is bool on && on))" />
                        </label>
                    }
                    <span class="sherpa-icon-well sherpa-icon-well-accent"><i class="fa-solid fa-upload"></i></span>
                    <div class="profile-heading-copy">
                        <div class="profile-title">@profile.Name</div>
                        @if (!string.IsNullOrEmpty(profile.Description))
                        {
                            <div class="profile-description">@profile.Description</div>
                        }
                    </div>
                    @if (!isSelectionMode)
                    {
                        <div class="profile-actions">
                            <MauiSherpa.Components.SecretProviderPickerHost
                                @key="@($"publish-profile-sync-{profile.Id}")"
                                Item="@(new SecretItemRef(SecretItemKind.PublishProfile, profile.Id, profile.Name))"
                                EmptySelectionRequiresConfirmation="true" />
                            <button data-screenshot-external class="btn btn-ghost btn-icon btn-sm" @onclick="@(() => EditProfile(profile))" title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button data-screenshot-external class="btn btn-ghost-danger btn-icon btn-sm" @onclick="@(() => DeleteProfile(profile))" title="Delete">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    }
                </div>

                <div class="profile-summary">
                    @if (profile.AppleConfigs.Any())
                    {
                        <span class="summary-badge apple sherpa-badge sherpa-badge-info">
                            <i class="fa-brands fa-apple"></i> @profile.AppleConfigs.Count Apple
                        </span>
                    }
                    @if (profile.AppleIdentities.Any())
                    {
                        <span class="summary-badge apple sherpa-badge sherpa-badge-info">
                            <i class="fa-solid fa-id-badge"></i> @profile.AppleIdentities.Count Apple @(profile.AppleIdentities.Count == 1 ? "Identity" : "Identities")
                        </span>
                    }
                    @if (profile.AndroidConfigs.Any())
                    {
                        <span class="summary-badge android sherpa-badge sherpa-badge-success">
                            <i class="fa-brands fa-android"></i> @profile.AndroidConfigs.Count Android
                        </span>
                    }
                    @if (profile.GoogleIdentities.Any())
                    {
                        <span class="summary-badge android sherpa-badge sherpa-badge-success">
                            <i class="fa-brands fa-google"></i> @profile.GoogleIdentities.Count Google @(profile.GoogleIdentities.Count == 1 ? "Identity" : "Identities")
                        </span>
                    }
                    @if (profile.SecretMappings.Any())
                    {
                        <span class="summary-badge secrets sherpa-badge sherpa-badge-accent">
                            <i class="fa-solid fa-key"></i> @profile.SecretMappings.Count Secrets
                        </span>
                    }
                </div>

                @if (healthReports.TryGetValue(profile.Id, out var health) && !health.IsHealthy)
                {
                    var expanded = expandedHealthIds.Contains(profile.Id);
                    var isError = health.Severity == PublishProfileHealthSeverity.Error;
                    var fixCount = health.Issues.Count(issue => issue.CanFix);
                    <div class="health @(isError ? "health-error" : "health-warning")">
                        <div class="health-row">
                            <button class="health-badge"
                                    @onclick="@(() => ToggleHealth(profile.Id))"
                                    aria-expanded="@(expanded ? "true" : "false")"
                                    title="@HealthTooltip(health)">
                                <i class="fa-solid @(isError ? "fa-circle-exclamation" : "fa-triangle-exclamation")"></i>
                                <span class="health-summary">@health.Summary</span>
                                <i class="fa-solid @(expanded ? "fa-chevron-up" : "fa-chevron-down") health-chevron"></i>
                            </button>
                            @if (health.HasFixes && !isSelectionMode)
                            {
                                <button data-screenshot-external class="btn btn-secondary btn-sm health-fix"
                                        disabled="@(fixingProfileId == profile.Id)"
                                        title="@($"Re-point {fixCount} outdated reference(s) and save the profile")"
                                        @onclick="@(() => FixProfile(profile, health))">
                                    @if (fixingProfileId == profile.Id)
                                    {
                                        <i class="fa-solid fa-spinner fa-spin"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-arrows-rotate"></i>
                                    }
                                    <span>Update profile</span>
                                </button>
                            }
                        </div>
                        @if (expanded)
                        {
                            <ul class="health-details">
                                @foreach (var issue in health.Issues)
                                {
                                    <li class="@(issue.Severity == PublishProfileHealthSeverity.Error ? "issue-error" : "issue-warning")">
                                        <i class="fa-solid @IssueIcon(issue.Kind)"></i>
                                        <div>
                                            <div class="health-issue-label">@issue.Label</div>
                                            <div class="health-issue-meta">
                                                @IssueContext(issue)@(issue.CanFix ? " · fixable" : "")
                                            </div>
                                        </div>
                                    </li>
                                }
                                @foreach (var source in health.UncheckedSources)
                                {
                                    <li class="issue-unchecked">
                                        <i class="fa-solid fa-circle-question"></i>
                                        <div class="health-issue-label">@source</div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(profile.RepositoryFullName))
                {
                    <div class="profile-target">
                        <i class="fa-solid fa-arrow-right"></i> @profile.RepositoryFullName
                    </div>
                }

                @if (!isSelectionMode)
                {
                    <div class="profile-footer">
                        <button data-screenshot-external class="btn btn-primary btn-sm" @onclick="@(() => PublishProfile(profile))"
                                disabled="@(publishingProfileId == profile.Id)">
                            @if (publishingProfileId == profile.Id)
                            {
                                <i class="fa-solid fa-spinner fa-spin"></i> <span>Publishing...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-upload"></i> <span>Publish</span>
                            }
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    const int RefreshDebounceMilliseconds = 250;

    List<PublishProfile> profiles = new();
    readonly HashSet<string> selectedProfileIds = new(StringComparer.Ordinal);
    bool isLoading = true;
    bool isRefreshing;
    bool isSelectionMode;
    string? publishingProfileId;
    CancellationTokenSource? refreshDebounceCts;
    int loadSequence;
    Dictionary<string, PublishProfileHealthReport> healthReports = new(StringComparer.Ordinal);
    readonly HashSet<string> expandedHealthIds = new(StringComparer.Ordinal);
    string? fixingProfileId;
    int healthSequence;
    bool disposed;

    bool AllProfilesSelected => profiles.Count > 0 &&
        profiles.All(profile => selectedProfileIds.Contains(profile.Id));

    protected override async Task OnInitializedAsync()
    {
        UpdateToolbarItems();
        ToolbarService.SetSearch(null);
        ToolbarService.SetFilters();
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        ProfileService.OnProfilesChanged += OnProfilesChanged;
        CloudSecretsService.OnActiveProviderChanged += OnActiveProviderChanged;

        await CloudSecretsService.InitializeAsync();
        await LoadProfilesAsync();
    }

    // SetItems resets search/filters and prompts a native toolbar rebuild, so only call it
    // when the item set actually changes — enabled state has its own cheaper path.
    void UpdateToolbarItems()
    {
        if (isSelectionMode)
        {
            ToolbarService.SetItems(
                new ToolbarAction("publish-selected", "Publish Selected", "square.and.arrow.up"),
                new ToolbarAction("cancel-selection", "Cancel", "xmark", IsPrimary: false));
        }
        else
        {
            ToolbarService.SetItems(
                new ToolbarAction("create", "New Profile", "plus"),
                new ToolbarAction("select", "Select", "checkmark.circle"),
                new ToolbarAction("refresh", "Refresh", "arrow.clockwise"));
        }

        UpdateToolbarItemStates();
    }

    void UpdateToolbarItemStates()
    {
        var providerUnavailable = CloudSecretsService.ActiveProvider is null;
        var unavailable = isLoading || isRefreshing || providerUnavailable;
        if (isSelectionMode)
        {
            ToolbarService.SetItemEnabled("publish-selected",
                selectedProfileIds.Count > 0 && !isLoading);
        }
        else
        {
            ToolbarService.SetItemEnabled("refresh", !unavailable);
            ToolbarService.SetItemEnabled("create", !unavailable);
            ToolbarService.SetItemEnabled("select", !unavailable && profiles.Count > 0);
        }
    }

    void OnActiveProviderChanged()
    {
        _ = InvokeAsync(() =>
        {
            UpdateToolbarItemStates();
            StateHasChanged();
        });
    }

    void OnToolbarItemClicked(string actionId)
    {
        switch (actionId)
        {
            case "create":
                InvokeAsync(CreateProfile);
                break;
            case "select":
                InvokeAsync(() => { EnterSelectionMode(); return Task.CompletedTask; });
                break;
            case "publish-selected":
                InvokeAsync(PublishSelectedProfiles);
                break;
            case "cancel-selection":
                InvokeAsync(() => { ExitSelectionMode(); return Task.CompletedTask; });
                break;
            case "refresh":
                InvokeAsync(() => LoadProfilesAsync(refreshFromProviders: true));
                break;
        }
    }

    // Syncing an item raises one change per provider placement, so collapse the burst
    // into a single background reload instead of thrashing the whole grid.
    void OnProfilesChanged()
    {
        var debounce = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref refreshDebounceCts, debounce);
        previous?.Cancel();
        previous?.Dispose();

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(RefreshDebounceMilliseconds, debounce.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            await LoadProfilesAsync(background: true);
        });
    }

    async Task LoadProfilesAsync(bool background = false, bool refreshFromProviders = false)
    {
        var sequence = ++loadSequence;
        if (background && profiles.Count > 0)
            isRefreshing = true;
        else
            isLoading = true;
        UpdateToolbarItemStates();
        StateHasChanged();

        try
        {
            // Providers report in as they finish, so the local vault's profiles paint
            // immediately instead of waiting on a remote vault's round trips.
            var progress = new Progress<IReadOnlyList<PublishProfile>>(partial =>
                _ = InvokeAsync(() =>
                {
                    if (sequence != loadSequence)
                        return;

                    ApplyLoadedProfiles(partial);
                    isLoading = false;
                    isRefreshing = true;
                    UpdateToolbarItemStates();
                    StateHasChanged();
                }));

            if (refreshFromProviders)
                await HealthService.RefreshAsync();

            var loaded = refreshFromProviders
                ? await ProfileService.RefreshProfilesAsync(progress)
                : await ProfileService.GetProfilesAsync(progress);

            // A newer load started while this one was in flight — let it win.
            if (sequence != loadSequence)
                return;

            ApplyLoadedProfiles(loaded);
            _ = RefreshHealthAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to load publish profiles: {ex}");
        }
        finally
        {
            if (sequence == loadSequence)
            {
                isLoading = false;
                isRefreshing = false;
            }
            UpdateToolbarItemStates();
            StateHasChanged();
        }
    }

    void ApplyLoadedProfiles(IReadOnlyList<PublishProfile> loaded)
    {
        profiles = loaded.ToList();
        selectedProfileIds.IntersectWith(profiles.Select(profile => profile.Id));
        if (isSelectionMode && profiles.Count == 0)
        {
            isSelectionMode = false;
            UpdateToolbarItems();
            return;
        }

        UpdateToolbarItemStates();
    }

    void EnterSelectionMode()
    {
        isSelectionMode = true;
        selectedProfileIds.Clear();
        UpdateToolbarItems();
        StateHasChanged();
    }

    void ExitSelectionMode()
    {
        isSelectionMode = false;
        selectedProfileIds.Clear();
        UpdateToolbarItems();
        StateHasChanged();
    }

    void ToggleProfileSelection(string profileId, bool selected)
    {
        if (selected)
            selectedProfileIds.Add(profileId);
        else
            selectedProfileIds.Remove(profileId);
        UpdateToolbarItemStates();
    }

    void ToggleAllProfiles(bool selected)
    {
        selectedProfileIds.Clear();
        if (selected)
        {
            foreach (var profile in profiles)
                selectedProfileIds.Add(profile.Id);
        }
        UpdateToolbarItemStates();
    }

    async Task CreateProfile()
    {
        var page = new Modals.PublishProfileEditorPage(BridgeHolder);
        var result = await FormModalService.ShowAsync<PublishProfile?>(page);

        if (result is not null)
        {
            await SecretSyncCoordinator.SetDefaultProvidersAsync(
                new SecretItemRef(
                    SecretItemKind.PublishProfile,
                    result.Id,
                    result.Name));
            await LoadProfilesAsync(background: true);
            await AlertService.ShowToastAsync($"Profile '{result.Name}' created.");
        }
    }

    async Task EditProfile(PublishProfile profile)
    {
        var item = new SecretItemRef(
            SecretItemKind.PublishProfile,
            profile.Id,
            profile.Name);
        var page = new Modals.PublishProfileEditorPage(BridgeHolder, profile);
        var result = await FormModalService.ShowAsync<PublishProfile?>(page);

        if (result is not null)
        {
            if (CloudSecretsService.ActiveProvider is not null)
            {
                await SecretSyncCoordinator.ResolveConflictAsync(
                    item with { DisplayName = result.Name },
                    CloudSecretsService.ActiveProvider.Id);
            }
            await LoadProfilesAsync(background: true);
            await AlertService.ShowToastAsync($"Profile '{result.Name}' updated.");
        }
    }

    async Task DeleteProfile(PublishProfile profile)
    {
        var confirmed = await AlertService.ShowConfirmAsync(
            "Delete Profile",
            $"Are you sure you want to delete '{profile.Name}'? This cannot be undone.");

        if (confirmed)
        {
            await SecretSyncCoordinator.SetDesiredProvidersAsync(
                new SecretItemRef(
                    SecretItemKind.PublishProfile,
                    profile.Id,
                    profile.Name),
                Array.Empty<string>());
            await AlertService.ShowToastAsync($"Deletion of '{profile.Name}' was queued.");
        }
    }

    async Task PublishProfile(PublishProfile profile)
    {
        publishingProfileId = profile.Id;
        StateHasChanged();

        try
        {
            // Open publish review dialog — it handles secret resolution internally
            var page = new Modals.PublishReviewPage(BridgeHolder, profile);
            var result = await FormModalService.ShowAsync<bool>(page);

            if (result == true)
                await AlertService.ShowToastAsync($"Published secrets successfully.");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to publish profile: {ex}");
            await AlertService.ShowAlertAsync("Error", $"Failed to publish: {ex.Message}");
        }
        finally
        {
            publishingProfileId = null;
            StateHasChanged();
        }
    }

    async Task PublishSelectedProfiles()
    {
        var selected = profiles
            .Where(profile => selectedProfileIds.Contains(profile.Id))
            .ToList();
        if (selected.Count == 0)
            return;

        try
        {
            var page = new Modals.BatchPublishPage(BridgeHolder, selected);
            var result = await FormModalService.ShowAsync<bool>(page);

            if (result == true)
            {
                ExitSelectionMode();
                await AlertService.ShowToastAsync(
                    $"Finished publishing {selected.Count} profile(s).");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to publish selected profiles: {ex}");
            await AlertService.ShowAlertAsync("Error", $"Failed to publish: {ex.Message}");
        }
    }

    // Health checks read cached certificate, profile, keystore, secret and identity
    // lists, so they run after the profiles paint and never block the grid.
    async Task RefreshHealthAsync()
    {
        var sequence = ++healthSequence;
        var snapshot = profiles.ToList();
        try
        {
            var reports = await HealthService.EvaluateAsync(snapshot);
            if (disposed || sequence != healthSequence)
                return;

            healthReports = new Dictionary<string, PublishProfileHealthReport>(reports, StringComparer.Ordinal);
            expandedHealthIds.RemoveWhere(id => !healthReports.TryGetValue(id, out var report) || report.IsHealthy);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning($"Failed to check publish profile health: {ex.Message}");
        }
    }

    void ToggleHealth(string profileId)
    {
        if (!expandedHealthIds.Remove(profileId))
            expandedHealthIds.Add(profileId);
    }

    async Task FixProfile(PublishProfile profile, PublishProfileHealthReport health)
    {
        fixingProfileId = profile.Id;
        StateHasChanged();

        try
        {
            var fixCount = health.Issues.Count(issue => issue.CanFix);
            var saved = await HealthService.ApplyFixesAsync(profile, health.Issues);
            if (saved is null)
            {
                await AlertService.ShowToastAsync($"'{profile.Name}' is already up to date.");
                return;
            }

            if (CloudSecretsService.ActiveProvider is { } provider)
            {
                await SecretSyncCoordinator.ResolveConflictAsync(
                    new SecretItemRef(SecretItemKind.PublishProfile, saved.Id, saved.Name),
                    provider.Id);
            }

            await AlertService.ShowToastAsync(
                $"Updated '{saved.Name}': re-pointed {fixCount} reference(s).");
            // SaveProfileAsync raises OnProfilesChanged, which reloads the grid and re-checks health.
        }
        catch (Exception ex)
        {
            Logger.LogError($"Failed to update publish profile '{profile.Name}': {ex}");
            await AlertService.ShowAlertAsync("Update Failed", $"'{profile.Name}' couldn't be updated: {ex.Message}");
        }
        finally
        {
            fixingProfileId = null;
            StateHasChanged();
        }
    }

    static string HealthTooltip(PublishProfileHealthReport health) =>
        string.Join("\n", health.Issues.Select(issue => issue.Label));

    static string IssueContext(PublishProfileHealthIssue issue) => issue.ConfigKind switch
    {
        PublishProfileConfigKind.Apple => $"Apple · {issue.ConfigLabel}",
        PublishProfileConfigKind.AppleIdentity => $"Apple identity · {issue.ConfigLabel}",
        PublishProfileConfigKind.Android => $"Android · {issue.ConfigLabel}",
        PublishProfileConfigKind.GoogleIdentity => $"Google identity · {issue.ConfigLabel}",
        _ => "Secrets",
    };

    static string IssueIcon(PublishProfileHealthIssueKind kind) => kind switch
    {
        PublishProfileHealthIssueKind.MissingCertificate or
        PublishProfileHealthIssueKind.ExpiredCertificate or
        PublishProfileHealthIssueKind.CertificateReplaced => "fa-certificate",
        PublishProfileHealthIssueKind.MissingProvisioningProfile or
        PublishProfileHealthIssueKind.ExpiredProvisioningProfile or
        PublishProfileHealthIssueKind.ProvisioningProfileUpdated => "fa-file-shield",
        PublishProfileHealthIssueKind.MissingKeystore => "fa-key",
        PublishProfileHealthIssueKind.MissingSecret => "fa-lock",
        PublishProfileHealthIssueKind.MissingIdentity => "fa-id-badge",
        _ => "fa-circle-exclamation",
    };

    public void Dispose()
    {
        disposed = true;
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        ProfileService.OnProfilesChanged -= OnProfilesChanged;
        CloudSecretsService.OnActiveProviderChanged -= OnActiveProviderChanged;
        var debounce = Interlocked.Exchange(ref refreshDebounceCts, null);
        debounce?.Cancel();
        debounce?.Dispose();
    }
}

<style>
    .info-message {
        font-size: 0.875rem;
        color: var(--status-info-fg);
    }
    .info-message i { color: var(--status-info-fg); margin-top: 2px; }
    .info-message a { color: var(--accent); text-decoration: none; }
    .info-message a:hover { text-decoration: underline; }

    .loading-inline {
        font-size: 0.875rem;
        color: var(--text-muted);
        padding: 0.5rem 0;
    }

    /* Empty state */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        font-size: 3rem;
        color: var(--text-muted);
        opacity: 0.3;
        margin-bottom: 1rem;
    }

    .empty-state h2 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        color: var(--text-primary);
    }

    .empty-state p {
        margin: 0 0 1.5rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        max-width: 400px;
    }

    /* Profile grid */
    .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1rem;
    }

    .profile-card {
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .profile-card.selectable { cursor: pointer; }
    .profile-card.selectable:hover { background: var(--surface-card-hover); }
    .profile-card.selected {
        background: var(--accent-soft);
        border-color: var(--accent);
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: var(--space-3);
    }

    .profile-select {
        display: flex;
        align-items: center;
        cursor: pointer;
    }

    .profile-select input {
        width: 18px;
        height: 18px;
        accent-color: var(--accent);
    }

    .profile-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .profile-heading-copy {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .selection-bar {
        margin-bottom: 0.75rem;
    }

    .select-all-checkbox {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        cursor: pointer;
    }

    .select-all-checkbox input {
        width: 18px;
        height: 18px;
        accent-color: var(--accent);
    }

    .selection-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .selection-count {
        white-space: nowrap;
