@page "/xcode-management"
@using System.ComponentModel
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.ViewModels
@using MauiSherpa.Pages.Forms
@using MauiSherpa.Pages.Modals
@using Shiny.Mediator
@inject XcodeManagementViewModel ViewModel
@inject IPlatformService Platform
@inject IAlertService AlertService
@inject IFormModalService FormModalService
@inject HybridFormBridgeHolder BridgeHolder
@inject IXcodeService XcodeService
@inject ISimulatorService SimulatorService
@inject IToolbarService ToolbarService
@inject IMediator Mediator
@inject IProcessModalService ProcessModal
@inject IOperationModalService OperationModal
@inject IAppleDownloadAuthService DownloadAuthService
@implements IDisposable

<h1><i class="fa-brands fa-apple"></i> @ViewModel.Title</h1>

@if (!Platform.IsMacCatalyst && !Platform.IsMacOS)
{
    <div class="not-supported">
        <div class="warning-icon"><i class="fa-solid fa-exclamation-triangle"></i></div>
        <h2>macOS Only</h2>
        <p>Apple development tools management requires macOS with Xcode installed.</p>
    </div>
}
else
{
    @if (!Platform.HasNativeToolbar)
    {
        <div class="toolbar">
            <button class="btn btn-primary" @onclick="RefreshAll" disabled="@IsActiveTabLoading">
                <i class="fa-solid fa-sync-alt"></i> @(IsActiveTabLoading ? "Loading..." : "Refresh")
            </button>
            <div class="toolbar-spacer"></div>
            @if (ViewModel.IsAuthenticated)
            {
                <button data-screenshot-external class="btn btn-outline" @onclick="SignOut">
                    <i class="fa-solid fa-lock"></i> Sign Out
                </button>
            }
            else
            {
                <button data-screenshot-external class="btn btn-outline" @onclick="OpenAuthModal">
                    <i class="fa-solid fa-lock-open"></i> Sign In
                </button>
            }
        </div>
    }

    <div class="auth-banner sherpa-banner @(DownloadAuthService.SessionValidationMessage != null ? "sherpa-banner-danger" : ViewModel.IsAuthenticated ? "sherpa-banner-success" : "sherpa-banner-warning")" data-testid="apple-account-card">
        <div class="auth-banner-icon">
            <i class="fa-solid @(DownloadAuthService.SessionValidationMessage != null ? "fa-triangle-exclamation" : ViewModel.IsAuthenticated ? "fa-user-check" : "fa-user-lock")"></i>
        </div>
        <div class="auth-banner-content">
            @if (DownloadAuthService.SessionValidationMessage is { } validationMessage)
            {
                <strong>Apple download session needs attention</strong>
                <p>@validationMessage</p>
            }
            else if (ViewModel.IsAuthenticated)
            {
                <strong>Signed in with Apple ID</strong>
                <p class="text-selectable">@ViewModel.AuthenticatedAppleId</p>
            }
            else
            {
                <strong>Sign in with your Apple ID to download Xcode and simulator runtimes</strong>
                <p>Some Xcode Management tasks require an Apple Developer sign-in, including downloading Xcode and installing simulator runtimes from Apple.</p>
            }
        </div>
        <div class="auth-banner-actions">
            @if (ViewModel.IsAuthenticated)
            {
                <button data-screenshot-external class="btn btn-outline" data-testid="apple-sign-out" @onclick="SignOut">
                    <i class="fa-solid fa-lock"></i> Sign Out
                </button>
            }
            else
            {
                <button data-screenshot-external class="btn btn-primary" data-testid="apple-sign-in" @onclick="OpenAuthModal">
                    <i class="fa-solid fa-lock-open"></i> Sign In
                </button>
            }
        </div>
    </div>

    <SherpaTabs Items="XcodeTabs"
                ActiveKey="@activeTab"
                ActiveKeyChanged="SwitchTab"
                Variant="SherpaTabVariant.Standard"
                AriaLabel="Xcode management views" />

    @* ====== INSTALLED TAB ====== *@
    @if (activeTab == "installed")
    {
        @if (ViewModel.IsLoading && ViewModel.InstalledXcodes.Count == 0)
        {
            <div class="loading-state">
                <div class="loading-spinner"><i class="fa-solid fa-spinner fa-spin"></i></div>
                <div class="loading-title">Discovering Xcode Installations</div>
                <div class="loading-description">Scanning /Applications for Xcode bundles...</div>
            </div>
        }
        else if (ViewModel.InstalledXcodes.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid fa-box-open"></i></div>
                <h3>No Xcode Installations Found</h3>
                <p>Install Xcode from the Mac App Store or download from the Available tab.</p>
            </div>
        }
        else if (filteredInstalledXcodes.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid fa-search"></i></div>
                <h3>No Matching Xcode Installations</h3>
                <p>Try a different search to find an installed Xcode version.</p>
            </div>
        }
        else
        {
                <div class="xcode-list sherpa-list">
                    @foreach (var xcode in filteredInstalledXcodes)
                    {
                    <div class="xcode-card sherpa-list-row @((xcode.IsSelected || xcode.IsDefault) ? "selected" : "")">
                        <div class="xcode-card-icon sherpa-icon-well sherpa-icon-well-apple">
                            <i class="fa-solid fa-hammer"></i>
                            <span class="sherpa-brand-badge"><i class="fa-brands fa-apple"></i></span>
                        </div>
                        <div class="xcode-card-info sherpa-row-stack">
                            <div class="xcode-card-title sherpa-row-title">
                                <span>Xcode @xcode.Version</span>
                                @if (xcode.IsDefault)
                                {
                                    <span class="sherpa-badge sherpa-badge-success"><span class="sherpa-dot sherpa-dot-success"></span> Default</span>
                                }
                                @if (xcode.IsSelected)
                                {
                                    <span class="sherpa-badge sherpa-badge-accent"><i class="fa-solid fa-check"></i> Selected</span>
                                }
                            </div>
                            <div class="xcode-card-details sherpa-row-sub mono">
                                <span>Build @xcode.BuildNumber</span>
                                <span>· @Path.GetFileName(xcode.Path)</span>
                                <span>· @xcode.Path</span>
                            </div>
                        </div>
                        <div class="xcode-card-actions sherpa-row-actions">
                            @if (!xcode.IsSelected)
                            {
                                <button data-screenshot-external class="btn btn-sm btn-secondary" @onclick="() => SelectXcode(xcode)">
                                    <i class="fa-solid fa-check-circle"></i> Select
                                </button>
                            }
                            @if (!xcode.IsSelected && !xcode.IsDefault)
                            {
                                <button data-screenshot-external class="btn btn-sm btn-icon btn-ghost-danger" @onclick="() => UninstallXcode(xcode)" title="Uninstall Xcode" aria-label="@($"Uninstall Xcode {xcode.Version}")">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* ====== AVAILABLE TAB ====== *@
    @if (activeTab == "available")
    {
        @if (!ViewModel.IsAuthenticated || ViewModel.IsLoadingAvailable)
        {
            <div class="available-controls">
                @if (!ViewModel.IsAuthenticated)
                {
                    <span class="auth-hint">
                        <i class="fa-solid fa-info-circle"></i> Sign in with Apple ID to download Xcode
                    </span>
                }
                @if (ViewModel.IsLoadingAvailable)
                {
                    <span class="loading-indicator"><i class="fa-solid fa-spinner fa-spin"></i> Fetching releases...</span>
                }
            </div>
        }

        @if (!(ViewModel.IsLoadingAvailable && filteredReleases.Count == 0))
        {
            <div class="results-info available-results-info">
                <span>Showing @filteredReleases.Count releases</span>
                <label class="toggle-label available-toggle-label">
                    <input type="checkbox" @bind="showBetas" @bind:event="oninput" />
                    <span>Show Betas &amp; RCs</span>
                </label>
            </div>
        }

        @if (ViewModel.IsLoadingAvailable && filteredReleases.Count == 0)
        {
            <div class="loading-state">
                <div class="loading-spinner"><i class="fa-solid fa-spinner fa-spin"></i></div>
                <div class="loading-title">Fetching Available Releases</div>
                <div class="loading-description">Fetching releases and checking Apple archive availability...</div>
            </div>
        }
        else if (filteredReleases.Count > 0)
        {
            <div class="xcode-list sherpa-list">
                @foreach (var release in filteredReleases)
                {
                    var installed = ViewModel.IsInstalled(release);
                    var isDownloading = downloadingRelease?.BuildNumber == release.BuildNumber;
                    <div class="xcode-card sherpa-list-row @(installed ? "installed" : "") @(isDownloading ? "downloading" : "")">
                        <div class="xcode-card-icon sherpa-icon-well sherpa-icon-well-apple">
                            @if (release.IsBeta)
                            {
                                <i class="fa-solid fa-flask"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-hammer"></i>
                            }
                            <span class="sherpa-brand-badge"><i class="fa-brands fa-apple"></i></span>
                        </div>
                        <div class="xcode-card-info sherpa-row-stack">
                            <div class="xcode-card-title sherpa-row-title">
                                <span>Xcode @release.Version</span>
                                @if (release.IsBeta)
                                {
                                    <span class="sherpa-badge sherpa-badge-warning">@release.PrereleaseLabel</span>
                                }
                                @if (installed)
                                {
                                    <span class="sherpa-badge sherpa-badge-success"><span class="sherpa-dot sherpa-dot-success"></span> Installed</span>
                                }
                            </div>
                            <div class="xcode-card-details sherpa-row-sub mono">
                                <span>Build @release.BuildNumber</span>
                                <span>· @release.ReleaseDate.ToString("MMM d, yyyy")</span>
                                @if (!string.IsNullOrEmpty(release.ArchiveExtension))
                                {
                                    <span>· @release.ArchiveExtension.TrimStart('.').ToUpperInvariant()</span>
                                }
                                @if (!string.IsNullOrEmpty(release.MinimumMacOSVersion))
                                {
                                    <span>· macOS @release.MinimumMacOSVersion+</span>
                                }
                                @if (release.FileSizeBytes > 0)
                                {
                                    <span>· @FormatBytes(release.FileSizeBytes.Value)</span>
                                }
                            </div>
                            @if (release.Sdks.Count > 0 || release.Compilers.Count > 0)
                            {
                                <div class="xcode-card-extras sherpa-row-sub">
                                    @if (release.Sdks.Count > 0)
                                    {
                                        @foreach (var sdk in release.Sdks.Take(5))
                                        {
                                            <span class="sdk-tag">@sdk.Name @sdk.Version</span>
                                        }
                                        @if (release.Sdks.Count > 5)
                                        {
                                            <span class="sdk-tag more">+@(release.Sdks.Count - 5) more</span>
                                        }
                                    }
                                    @foreach (var compiler in release.Compilers)
                                    {
                                        <span class="compiler-tag">@compiler.Name @compiler.Version</span>
                                    }
                                </div>
                            }
                            @if (isDownloading && downloadProgress != null)
                            {
                                <div class="download-progress">
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: @(downloadProgressPercent)%"></div>
                                    </div>
                                    <div class="progress-details">
                                        <span>@FormatBytes(downloadProgress.BytesReceived) / @(downloadProgress.TotalBytes.HasValue ? FormatBytes(downloadProgress.TotalBytes.Value) : "?")</span>
                                        <span>@FormatSpeed(downloadProgress.BytesPerSecond)</span>
                                        @if (downloadProgress.EstimatedTimeRemaining.HasValue)
                                        {
                                            <span>ETA: @FormatTimeSpan(downloadProgress.EstimatedTimeRemaining.Value)</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="xcode-card-actions sherpa-row-actions">
                            @if (!string.IsNullOrEmpty(release.ReleaseNotesUrl))
                            {
                                <button class="btn btn-sm btn-icon btn-ghost" @onclick="() => OpenUrl(release.ReleaseNotesUrl)" title="Release Notes" aria-label="@($"Open release notes for Xcode {release.Version}")">
                                    <i class="fa-solid fa-file-alt"></i>
                                </button>
                            }
                            @if (!installed && !string.IsNullOrEmpty(release.DownloadUrl))
                            {
                                @if (isDownloading)
                                {
                                    <button class="btn btn-sm btn-danger-soft" @onclick="CancelDownload">
                                        <i class="fa-solid fa-times"></i> Cancel
                                    </button>
                                }
                                else if (ViewModel.IsAuthenticated)
                                {
                                    <button data-screenshot-external class="btn btn-sm btn-primary" @onclick="() => DownloadAndInstall(release)" disabled="@(downloadingRelease != null)">
                                        <i class="fa-solid fa-download"></i> Install
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-icon btn-outline" @onclick="() => OpenUrl(release.DownloadUrl)" title="Open in browser" aria-label="@($"Open Xcode {release.Version} download in browser")">
                                        <i class="fa-solid fa-external-link-alt"></i>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid @(ViewModel.AvailableReleases.Count == 0 ? "fa-cloud-download-alt" : "fa-search")"></i></div>
                <h3>@(ViewModel.AvailableReleases.Count == 0 ? "No Xcode Releases Found" : "No Matching Xcode Releases")</h3>
                <p>@(ViewModel.AvailableReleases.Count == 0
                    ? "Try refreshing to load the latest releases."
                    : "Try a different search to find an Xcode release.")</p>
            </div>
        }
    }

    @* ====== RUNTIMES TAB ====== *@
    @if (activeTab == "runtimes")
    {
        @if ((ViewModel.IsLoadingRuntimes || ViewModel.IsLoadingDownloadableRuntimes) &&
             ViewModel.RuntimeStorage.Count == 0 &&
             ViewModel.DownloadableRuntimes.Count == 0)
        {
            <div class="loading-state">
                <div class="loading-spinner"><i class="fa-solid fa-spinner fa-spin"></i></div>
                <div class="loading-title">Loading Simulator Runtimes</div>
                <div class="loading-description">Querying installed and downloadable simulator runtimes...</div>
            </div>
        }
        else
        {
            <div class="results-info runtime-results-info">
                <div class="runtime-results-summary">
                    <span>Showing @filteredRuntimeStorage.Count of @ViewModel.RuntimeStorage.Count runtime(s)</span>
                    <span>&bull;</span>
                    <span>@FormatBytes(filteredRuntimeStorageBytes) in view</span>
                    @if (filteredRuntimeStorageBytes != ViewModel.TotalRuntimeStorageBytes)
                    {
                        <span>&bull;</span>
                        <span>@FormatBytes(ViewModel.TotalRuntimeStorageBytes) total</span>
                    }
                </div>
                <button data-screenshot-external class="btn btn-sm btn-primary" @onclick="OpenRuntimePicker">
                    @if (ViewModel.IsLoadingDownloadableRuntimes && ViewModel.DownloadableRuntimes.Count == 0)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Loading...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-plus"></i>
                        <span>Add Runtime...</span>
                    }
                </button>
            </div>

            @if (ViewModel.RuntimeStorage.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fa-solid fa-layer-group"></i></div>
                    <h3>No Simulator Runtimes Found</h3>
                    <p>No simulator runtimes were reported by `xcrun simctl` yet. Use <strong>Add Runtime...</strong> to install one.</p>
                </div>
            }
            else if (filteredRuntimeStorage.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fa-solid fa-search"></i></div>
                    <h3>No Matching Runtimes</h3>
                    <p>Try a different search to find a simulator runtime.</p>
                </div>
            }
            else
            {
                <div class="xcode-list sherpa-list">
                    @foreach (var runtime in filteredRuntimeStorage)
                    {
                        <div class="xcode-card sherpa-list-row">
                            <div class="xcode-card-icon sherpa-icon-well sherpa-icon-well-apple">
                                <i class="@GetRuntimeIcon(runtime.PlatformIdentifier)"></i>
                                <span class="sherpa-brand-badge"><i class="fa-brands fa-apple"></i></span>
                            </div>
                            <div class="xcode-card-info sherpa-row-stack">
                                <div class="xcode-card-title sherpa-row-title">
                                    <span>@FormatRuntimeName(runtime)</span>
                                    <span class="sherpa-badge @GetRuntimeStateBadgeClass(runtime.State)">@runtime.State</span>
                                    @if (!runtime.Deletable)
                                    {
                                        <span class="sherpa-badge sherpa-badge-neutral">Protected</span>
                                    }
                                </div>
                                <div class="xcode-card-details sherpa-row-sub mono">
                                    <span>@runtime.Identifier</span>
                                    @if (!string.IsNullOrWhiteSpace(runtime.Build))
                                    {
                                        <span>· Build @runtime.Build</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(runtime.PlatformIdentifier))
                                    {
                                        <span>· @FriendlyPlatform(runtime.PlatformIdentifier)</span>
                                    }
                                    @if (runtime.SizeBytes.HasValue)
                                    {
                                        <span>· @FormatBytes(runtime.SizeBytes.Value)</span>
                                    }
                                    @if (runtime.LastUsedAt.HasValue)
                                    {
                                        <span>· Last used @FormatLastUsed(runtime.LastUsedAt.Value)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(runtime.MountPath))
                                    {
                                        <span>· @runtime.MountPath</span>
                                    }
                                </div>
                            </div>
                            <div class="xcode-card-actions sherpa-row-actions">
                                @if (runtime.Deletable)
                                {
                                    <button data-screenshot-external class="btn btn-sm btn-icon btn-ghost-danger" @onclick="() => DeleteRuntime(runtime)" title="Delete runtime" aria-label="@($"Delete {FormatRuntimeName(runtime)}")">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }

}

<style>
    .not-supported {
        text-align: center;
        padding: 3.75rem 1.25rem;
        background: var(--status-error-bg);
        border-radius: var(--radius-lg);
        border: 1px solid var(--accent-danger);
    }
    .not-supported .warning-icon { font-size: 48px; margin-bottom: 1rem; color: var(--accent-warning); }
    .not-supported .warning-icon i { font-size: 48px; }
    .not-supported h2 { color: var(--accent-danger); margin-bottom: 0.5rem; }
    .not-supported p { color: var(--text-muted); }

    .auth-hint {
        font-size: 0.75rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .auth-banner {
        margin-bottom: 1rem;
    }

    .auth-banner-icon {
        font-size: 1.5rem;
        color: inherit;
        flex-shrink: 0;
    }

    .auth-banner-content {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
    }

    .auth-banner-content p {
        margin: 0;
        font-size: 0.875rem;
        color: inherit;
    }

    .auth-banner-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    .toolbar {
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .toolbar-spacer {
        flex: 1;
    }

    @@media (max-width: 800px) {
        .auth-banner {
            flex-direction: column;
            align-items: flex-start;
        }

        .auth-banner-actions {
            margin-left: 0;
        }
    }

    /* Loading & Empty States */
    .loading-state, .empty-state {
        text-align: center;
        padding: 3rem 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
    }
    .loading-spinner { font-size: 2rem; color: var(--accent-primary); margin-bottom: 1rem; }
    .loading-title, .empty-state h3 { font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
    .loading-description, .empty-state p { color: var(--text-muted); font-size: 0.875rem; }
    .empty-icon { font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem; opacity: 0.5; }

    /* Xcode Cards */
    .xcode-list { margin-bottom: 1rem; }

    .xcode-card {
        align-items: center;
    }
    .xcode-card.selected { background: color-mix(in srgb, var(--accent-soft) 55%, var(--surface-card)); }
    .xcode-card.downloading { background: color-mix(in srgb, var(--status-info-bg) 55%, var(--surface-card)); }

    .xcode-card-icon {
        padding: 0;
    }

    .xcode-card-info { min-width: 0; }

    .xcode-card-title {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .xcode-card-details {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .xcode-card-extras {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .sdk-tag {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        font-size: 0.6875rem;
        border-radius: 0.25rem;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
    }
    .sdk-tag.more { font-style: italic; opacity: 0.7; }

    .compiler-tag {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        font-size: 0.6875rem;
        border-radius: 0.25rem;
        background: rgba(66, 153, 225, 0.1);
        color: var(--accent-primary);
        border: 1px solid rgba(66, 153, 225, 0.2);
    }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.125rem 0.5rem;
        font-size: 0.6875rem;
        font-weight: 600;
        border-radius: 1rem;
    }
    .badge-active {
        background: var(--accent-success);
        color: white;
    }
    .badge-beta {
        background: rgba(237, 137, 54, 0.15);
        color: var(--accent-warning);
        border: 1px solid rgba(237, 137, 54, 0.3);
    }
    .badge-installed {
        background: rgba(72, 187, 120, 0.15);
        color: var(--accent-success);
        border: 1px solid rgba(72, 187, 120, 0.3);
    }
    .badge-ready {
        background: rgba(72, 187, 120, 0.15);
        color: var(--accent-success);
        border: 1px solid rgba(72, 187, 120, 0.3);
    }
    .badge-booted {
        background: rgba(66, 153, 225, 0.15);
        color: var(--accent-primary);
        border: 1px solid rgba(66, 153, 225, 0.3);
    }
    .badge-unknown {
        background: var(--bg-tertiary);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
    }

    /* Available Controls */
    .available-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .toggle-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        cursor: pointer;
    }
    .toggle-label input[type="checkbox"] { accent-color: var(--accent-primary); }

    .loading-indicator {
        font-size: 0.8125rem;
        color: var(--text-muted);
    }

    .results-info {
        font-size: var(--font-size-xs);
        color: var(--text-muted);
        margin: 0 0 8px;
    }

    .available-results-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .available-toggle-label {
        margin-left: auto;
        flex-shrink: 0;
    }

    .runtime-results-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0 0 8px;
