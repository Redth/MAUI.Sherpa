@page "/devflow"
@using MauiSherpa.Core.Models.DevFlow
@using MauiSherpa.Core.Services
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Services
@inject DevFlowInspectorService InspectorService
@inject IAlertService AlertService
@inject ILauncher AppLauncher
@inject IToolbarService ToolbarService
@inject IDevFlowDiscoveryService Discovery
@implements IDisposable

<SherpaPageHeader Title="App Inspector"
                  Description="Discover running DevFlow agents and inspect their visual tree, network traffic, profiling data, logs, and platform services."
                  Icon="fa-solid fa-wand-magic-sparkles">
    <Actions>
        <span class="sherpa-badge @(brokerConnected == true ? "sherpa-badge-success" : "sherpa-badge-neutral")">
            <span class="sherpa-dot @(brokerConnected == true ? "sherpa-dot-success" : "sherpa-dot-muted")"></span>
            @(brokerConnected == true ? "Broker connected" : brokerConnected == false ? "Broker offline" : "Checking broker")
        </span>
    </Actions>
</SherpaPageHeader>

<div class="broker-toolbar sherpa-card">
    <div class="broker-toolbar-main">
        <label class="broker-label" for="broker-host">Broker</label>
        <div class="broker-address">
            <input id="broker-host" type="text" @bind="brokerHost" placeholder="localhost" class="sherpa-input broker-host" aria-label="Broker host" />
            <span class="port-sep" aria-hidden="true">:</span>
            <input type="number" @bind="brokerPort" placeholder="19223" class="sherpa-input broker-port" aria-label="Broker port" />
        </div>
        <button class="btn btn-primary btn-sm" @onclick="RefreshAgents" disabled="@isLoading">
            <i class="fa-solid fa-fw @(isLoading ? "fa-spinner fa-spin" : "fa-plug")" aria-hidden="true"></i>
            @(isLoading ? "Connecting..." : "Connect")
        </button>
        <label class="auto-refresh-control">
            <span>Auto-refresh</span>
            <span class="sherpa-switch">
                <input type="checkbox" @bind="autoRefresh" @bind:after="OnAutoRefreshChanged" />
                <span class="sherpa-switch-track"></span>
            </span>
        </label>
    </div>
    @if (brokerConnected == false)
    {
        <div class="broker-status-note" role="status">
            <span class="sherpa-dot sherpa-dot-muted"></span>
            No broker reachable at @brokerHost. Tried ports @brokerPort, 19223, and 19323.
        </div>
    }
</div>

<SherpaSectionHeader Title="Connected Agents" Icon="fa-solid fa-satellite-dish" Count="@agents.Count" />

@if (!hasLoaded || (isLoading && agents.Count == 0))
{
    <SherpaListSkeleton Rows="3" Label="Discovering DevFlow agents..." />
}
else if (hasLoaded && !isLoading && agents.Count == 0)
{
    <div class="sherpa-empty-inline">
        <div class="sherpa-empty-inline-lead">
            <span class="sherpa-icon-well sherpa-icon-well-sm sherpa-icon-well-accent">
                <i class="fa-solid fa-wand-magic-sparkles fa-fw" aria-hidden="true"></i>
            </span>
            <div class="sherpa-row-stack">
                <span class="sherpa-empty-inline-title">No agents connected</span>
                <span class="sherpa-row-sub">Add builder.AddMauiDevFlowAgent() to MauiProgram.cs and run your app</span>
            </div>
        </div>
        <button class="btn btn-secondary btn-sm" @onclick="OpenQuickStartGuide">
            <i class="fa-solid fa-book-open fa-fw" aria-hidden="true"></i> Quick Start
        </button>
    </div>
}
else
{
    <div class="sherpa-list">
        @foreach (var agent in agents)
        {
            var supported = IsAgentSupported(agent);
            var outdated = IsAgentOutdated(agent);
            var brandIcon = GetBrandIcon(agent.Platform);
            <div data-screenshot-external
                 class="sherpa-list-row @(supported ? "sherpa-list-row-interactive" : "agent-unsupported")"
                 @onclick="@(() => { if (supported) OpenInspector(agent); })"
                 title="@(outdated ? $"Agent version {agent.Version} is below minimum {MinSupportedAgentVersion}. Update MAUI DevFlow packages." : !supported ? $"Agent version {agent.Version} is not supported." : "")">
                <span class="sherpa-icon-well @GetPlatformIconWellClass(agent.Platform)">
                    <i class="fa-solid fa-fw @GetPlatformIcon(agent.Platform)" aria-hidden="true"></i>
                    @if (!string.IsNullOrEmpty(brandIcon))
                    {
                        <span class="sherpa-brand-badge"><i class="fa-brands fa-fw @brandIcon" aria-hidden="true"></i></span>
                    }
                </span>
                <div class="sherpa-row-stack">
                    <div class="agent-title sherpa-row-title">
                        <span>@(agent.AppName ?? "Unknown App")</span>
                        <span class="sherpa-badge @GetPlatformBadgeClass(agent.Platform)">@(agent.Platform ?? "Unknown")</span>
                        @if (!supported)
                        {
                            <span class="sherpa-badge sherpa-badge-danger">
                                <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i> Update required
                            </span>
                        }
                        else if (outdated)
                        {
                            <span class="sherpa-badge sherpa-badge-warning">
                                <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i> Outdated
                            </span>
                        }
                    </div>
                    <div class="sherpa-row-sub mono">
                        @if (!string.IsNullOrEmpty(agent.Project))
                        {
                            <span>@GetProjectName(agent.Project)</span><span class="meta-separator">·</span>
                        }
                        <span>Port @agent.Port</span>
                        @if (agent.ConnectedAt != null)
                        {
                            <span class="meta-separator">·</span><span>@FormatTimeAgo(agent.ConnectedAt.Value)</span>
                        }
                        @if (!string.IsNullOrEmpty(agent.Version))
                        {
                            <span class="meta-separator">·</span><span>@DevFlowVersionSupport.FormatVersionLabel(agent.Version)</span>
                        }
                    </div>
                </div>
                <div class="sherpa-row-actions">
                    <button data-screenshot-external
                            class="btn btn-secondary btn-sm"
                            disabled="@(!supported)"
                            @onclick="() => OpenInspector(agent)"
                            @onclick:stopPropagation="true">
                        <i class="fa-solid @(supported ? "fa-magnifying-glass" : "fa-ban") fa-fw" aria-hidden="true"></i>
                        Inspect
                    </button>
                    <i class="fa-solid fa-chevron-right fa-fw agent-chevron" aria-hidden="true"></i>
                </div>
            </div>
        }
    </div>
}

<SherpaSectionHeader Title="Direct Connect" Icon="fa-solid fa-plug" />

<div class="direct-connect sherpa-card">
    <span class="sherpa-icon-well sherpa-icon-well-neutral">
        <i class="fa-solid fa-plug fa-fw" aria-hidden="true"></i>
    </span>
    <div class="direct-connect-copy sherpa-row-stack">
        <span class="sherpa-row-title">Connect to a known agent</span>
        <span class="sherpa-row-sub">Use the host and DevFlow agent port when broker discovery is unavailable.</span>
    </div>
    <div class="direct-connect-actions">
        <div class="direct-address">
            <input type="text" @bind="manualHost" placeholder="localhost" class="sherpa-input direct-host" aria-label="Agent host" />
            <span class="port-sep" aria-hidden="true">:</span>
            <input type="number" @bind="manualPort" placeholder="9223" class="sherpa-input direct-port" aria-label="Agent port" />
        </div>
        <button data-screenshot-external class="btn btn-secondary btn-sm" @onclick="ManualConnect">
            <i class="fa-solid fa-arrow-right fa-fw" aria-hidden="true"></i> Connect
        </button>
    </div>
</div>

@code {
    private string brokerHost = "localhost";
    private int brokerPort = 19223;
    private string manualHost = "localhost";
    private int manualPort = 9223;
    private bool isLoading;
    private bool hasLoaded;
    private bool? brokerConnected;
    private bool autoRefresh;
    private List<BrokerAgent> agents = new();
    private Timer? _refreshTimer;

    private static readonly Version MinSupportedAgentVersion = DevFlowVersionSupport.MinimumSupportedVersion;

    protected override async Task OnInitializedAsync()
    {
        ToolbarService.SetItems(
            new ToolbarAction("refresh", "Refresh", "arrow.clockwise")
        );
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        await RefreshAgents();
    }

    private void OnToolbarItemClicked(string actionId)
    {
        InvokeAsync(async () =>
        {
            if (actionId == "refresh")
                await RefreshAgents();
        });
    }

    private async Task RefreshAgents()
    {
        isLoading = true;
        ToolbarService.SetItemEnabled("refresh", false);
        StateHasChanged();

        try
        {
            var result = await Discovery.DiscoverAsync(brokerHost, brokerPort);
            brokerConnected = result.BrokerConnected;
            agents = result.Agents.ToList();
        }
        catch
        {
            brokerConnected = false;
            agents.Clear();
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
            ToolbarService.SetItemEnabled("refresh", true);
            StateHasChanged();
        }
    }

    private bool IsAgentSupported(BrokerAgent agent)
    {
        if (string.IsNullOrEmpty(agent.Version)) return true; // unknown version = allow
#if DEBUG
        return true; // allow connecting to any version in debug builds
#else
        return DevFlowVersionSupport.TryParseComparableVersion(agent.Version, out var v) && v >= MinSupportedAgentVersion;
#endif
    }

    private bool IsAgentOutdated(BrokerAgent agent)
    {
        if (string.IsNullOrEmpty(agent.Version)) return false;
        return DevFlowVersionSupport.TryParseComparableVersion(agent.Version, out var v) && v < MinSupportedAgentVersion;
    }

    private Task OpenInspector(BrokerAgent agent)
    {
        return InspectorService.OpenAsync(agent.Id, brokerHost, agent.Port, agent.AppName);
    }

    private async Task ManualConnect()
    {
        try
        {
            var status = await Discovery.GetStatusAsync(manualHost, manualPort);
            if (status != null)
            {
                var id = $"manual-{manualHost}-{manualPort}";
                await InspectorService.OpenAsync(id, manualHost, manualPort, status.AppName ?? $"{manualHost}:{manualPort}");
            }
            else
            {
                await AlertService.ShowToastAsync($"Could not reach agent at {manualHost}:{manualPort}");
            }
        }
        catch
        {
            await AlertService.ShowToastAsync($"Connection failed: {manualHost}:{manualPort}");
        }
    }

    private void OnAutoRefreshChanged()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;

        if (autoRefresh)
        {
            _refreshTimer = new Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAgents();
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private static string GetPlatformIcon(string? platform) => platform?.ToLowerInvariant() switch
    {
        "ios" => "fa-mobile-screen-button",
        "android" => "fa-mobile-screen-button",
        "maccatalyst" => "fa-laptop",
        "macos" => "fa-laptop",
        "winui" or "windows" => "fa-display",
        "linux" or "gtk" => "fa-display",
        _ => "fa-microchip"
    };

    private static string GetPlatformIconWellClass(string? platform) => platform?.ToLowerInvariant() switch
    {
        "ios" or "maccatalyst" or "macos" => "sherpa-icon-well-apple",
        "android" => "sherpa-icon-well-android",
        "winui" or "windows" => "sherpa-icon-well-accent",
        _ => "sherpa-icon-well-neutral"
    };

    private static string GetPlatformBadgeClass(string? platform) => platform?.ToLowerInvariant() switch
    {
        "android" => "sherpa-badge-success",
        "ios" or "maccatalyst" or "macos" => "sherpa-badge-accent",
        "winui" or "windows" => "sherpa-badge-info",
        _ => "sherpa-badge-neutral"
    };

    private static string GetBrandIcon(string? platform) => platform?.ToLowerInvariant() switch
    {
        "ios" or "maccatalyst" or "macos" => "fa-apple",
        "android" => "fa-android",
        "winui" or "windows" => "fa-windows",
        "linux" or "gtk" => "fa-linux",
        _ => ""
    };

    private static string GetProjectName(string projectPath)
    {
        var name = System.IO.Path.GetFileNameWithoutExtension(projectPath);
        return name ?? projectPath;
    }

    private static string FormatTimeAgo(DateTimeOffset time)
    {
        var elapsed = new DateTimeOffset(AppClock.UtcNow) - time;
        if (elapsed.TotalSeconds < 60) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    private async Task OpenQuickStartGuide()
    {
        try { await AppLauncher.OpenAsync(new Uri("https://redth.github.io/MAUI.Sherpa/devflow")); }
        catch { }
    }

    public void Dispose()
    {
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        _refreshTimer?.Dispose();
    }
}

<style>
    .broker-toolbar {
        padding: 10px 14px;
    }

    .broker-toolbar-main {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        flex-wrap: wrap;
    }

    .broker-label {
        margin-inline-end: var(--space-1);
        color: var(--text-secondary);
        font-size: var(--font-size-sm);
        font-weight: 600;
    }

    .broker-address,
    .direct-address {
        display: flex;
        align-items: center;
        gap: 0;
        overflow: hidden;
        background: var(--surface-control);
        border: 1px solid var(--border-control);
        border-bottom-color: var(--border-control-bottom);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-control);
        transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
    }

    .broker-address:focus-within,
    .direct-address:focus-within {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-ring);
    }

    .broker-address .sherpa-input,
    .direct-address .sherpa-input {
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .broker-address .sherpa-input:focus,
    .broker-address .sherpa-input:focus-visible,
    .direct-address .sherpa-input:focus,
    .direct-address .sherpa-input:focus-visible {
        box-shadow: none;
    }

    .broker-host {
        width: 160px;
    }

    .broker-port {
        width: 82px;
    }

    .broker-port,
    .direct-port {
        -moz-appearance: textfield;
    }

    .broker-port::-webkit-inner-spin-button,
    .broker-port::-webkit-outer-spin-button,
    .direct-port::-webkit-inner-spin-button,
    .direct-port::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .port-sep {
        align-self: stretch;
        display: inline-flex;
        align-items: center;
        padding-inline: 1px;
        background: var(--surface-control);
        color: var(--text-muted);
        font-weight: 600;
        font-size: var(--font-size-sm);
    }

    .auto-refresh-control {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-inline-start: auto;
        color: var(--text-secondary);
        cursor: pointer;
        font-size: var(--font-size-sm);
        font-weight: 500;
    }

    .broker-status-note {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: var(--space-2);
        padding-top: var(--space-2);
        border-top: 1px solid var(--border-hairline);
        color: var(--text-muted);
        font-size: var(--font-size-xs);
    }

    .agent-unsupported {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .agent-title {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        white-space: normal;
    }

    .agent-chevron {
        color: var(--text-muted);
        font-size: var(--font-size-xs);
    }

    .meta-separator {
        margin-inline: 5px;
        color: var(--border-strong);
    }

    .direct-connect {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: 10px 14px;
    }

    .direct-connect-copy {
        flex: 1 1 260px;
    }

    .direct-connect-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-2);
        flex-wrap: wrap;
    }

    .direct-host {
        width: 130px;
    }

    .direct-port {
        width: 74px;
    }

    @@media (max-width: 680px) {
        .auto-refresh-control {
            width: 100%;
            justify-content: flex-end;
        }

        .direct-connect {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .direct-connect-actions {
            width: 100%;
            justify-content: flex-start;
            padding-inline-start: 46px;
        }
    }
</style>
