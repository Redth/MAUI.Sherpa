@page "/modal/xcode-download-auth"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.ViewModels
@using MauiSherpa.Pages.Forms
@inject HybridFormBridgeHolder BridgeHolder
@inject XcodeManagementViewModel ViewModel
@inject IAppleDownloadAuthService AuthService
@inject ILauncher AppLauncher
@implements IDisposable

@{
    var bridge = BridgeHolder.Current;
}

@if (bridge != null)
{
    <div class="form-content">
        @if (currentStep != AuthStep.AccountLocked)
        {
            <div class="step-indicator">
                <div class="step @(currentStep >= AuthStep.Credentials ? "active" : "") @(currentStep > AuthStep.Credentials ? "completed" : "")">
                    <div class="step-number">@(currentStep > AuthStep.Credentials ? "✓" : "1")</div>
                    <div class="step-label">Credentials</div>
                </div>
                <div class="step-line @(currentStep > AuthStep.Credentials ? "active" : "")"></div>
                <div class="step @(currentStep >= AuthStep.TwoFactor ? "active" : "")">
                    <div class="step-number">2</div>
                    <div class="step-label">Verification</div>
                </div>
            </div>
        }

        <form class="wizard-body" @onsubmit="OnFormSubmitted" @onsubmit:preventDefault>
            <button type="submit" tabindex="-1" class="visually-hidden-submit"></button>
            @if (currentStep == AuthStep.Credentials)
            {
                <div class="step-content">
                    <h3>Sign in with your Apple ID</h3>
                    <p class="step-description">Authenticate with Apple Developer to download Xcode directly from Apple.</p>

                    <div class="form-group">
                        <label>Apple ID</label>
                        <input type="email"
                               @bind="authAppleId"
                               @bind:event="oninput"
                               @bind:after="OnFieldChanged"
                               placeholder="you@example.com"
                               disabled="@isAuthenticating" />
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password"
                               @bind="authPassword"
                               @bind:event="oninput"
                               @bind:after="OnFieldChanged"
                               @onkeydown="OnPasswordKeyDown"
                               placeholder="Password"
                               disabled="@isAuthenticating" />
                    </div>

                    @if (fastlaneSessions.Count > 0)
                    {
                        <div class="fastlane-import">
                            <p class="fastlane-import-hint">
                                Found an existing fastlane session on disk. Importing it avoids a fresh sign-in,
                                which can help if repeated sign-ins have triggered Apple's account lock.
                            </p>
                            @foreach (var session in fastlaneSessions)
                            {
                                <button type="button"
                                        class="btn-secondary fastlane-import-button"
                                        disabled="@isAuthenticating"
                                        @onclick="() => ImportFastlaneSession(session)">
                                    <i class="fas fa-file-import"></i>
                                    Import fastlane session for @session.AppleId
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentStep == AuthStep.TwoFactor)
            {
                <div class="step-content">
                    <h3>Enter your verification code</h3>
                    <p class="step-description">
                        @if (twoFactorOptions?.CanUseTrustedDevice == true && selectedPhoneIndex < 0)
                        {
                            <span>Enter the verification code shown on your trusted device.</span>
                        }
                        else
                        {
                            <span>Enter the verification code sent to your phone.</span>
                        }
                    </p>

                    @if (twoFactorOptions?.TrustedPhoneNumbers.Count > 0)
                    {
                        <div class="form-group">
                            <label>Verification method</label>
                            <select @bind="selectedPhoneIndex" @bind:after="OnPhoneSelectionChanged" disabled="@isAuthenticating">
                                @if (twoFactorOptions.CanUseTrustedDevice)
                                {
                                    <option value="-1">Trusted Device</option>
                                }
                                @for (var i = 0; i < twoFactorOptions.TrustedPhoneNumbers.Count; i++)
                                {
                                    <option value="@i">SMS: @twoFactorOptions.TrustedPhoneNumbers[i].PhoneNumber</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="form-group otp-group">
                        <label>Verification Code</label>
                        <div class="otp-digits">
                            @for (var i = 0; i < OtpLength; i++)
                            {
                                var index = i;
                                <input @ref="otpInputRefs[index]"
                                       type="text"
                                       inputmode="numeric"
                                       pattern="[0-9]*"
                                       autocomplete="one-time-code"
                                       maxlength="1"
                                       class="otp-digit"
                                       value="@otpDigits[index]"
                                       @oninput="e => OnOtpDigitInput(index, e)"
                                       @onkeydown="e => OnOtpDigitKeyDown(index, e)"
                                       disabled="@isAuthenticating" />
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="step-content account-locked">
                    <div class="locked-icon" aria-hidden="true"><i class="fas fa-lock"></i></div>
                    <h3>Your Apple Account sign-in is locked</h3>
                    <p class="step-description">
                        Apple locked in-app sign-in for <strong>@lockedAppleId</strong> as a security precaution.
                        This usually isn't a full account lock &mdash; you can often clear it yourself in a couple of minutes
                        by signing in through Apple's own web pages first.
                    </p>

                    @if (!string.IsNullOrEmpty(authError))
                    {
                        <div class="apple-said">
                            <i class="fas fa-quote-left" aria-hidden="true"></i>
                            <span>@authError</span>
                        </div>
                    }

                    <ol class="unlock-steps">
                        <li>
                            <div class="unlock-step-text">
                                <strong>Sign in at Apple ID</strong>
                                <span>Open <code>appleid.apple.com</code> and sign in with the same Apple ID and password.</span>
                            </div>
                            <button type="button" class="btn-secondary unlock-link" @onclick="() => OpenAppleIdSite()">
                                <i class="fas fa-arrow-up-right-from-square"></i> appleid.apple.com
                            </button>
                        </li>
                        <li>
                            <div class="unlock-step-text">
                                <strong>Complete any prompt you see</strong>
                                <span>
                                    If Apple shows a "Verify your identity" screen or asks for a two-factor code or trusted-device
                                    approval, complete it there. That step is usually what clears the lock &mdash; a full password
                                    reset is only needed if Apple offers no other option.
                                </span>
                            </div>
                        </li>
                        <li>
                            <div class="unlock-step-text">
                                <strong>Confirm the developer portal too</strong>
                                <span>Also sign in at <code>developer.apple.com</code> to make sure that surface is unlocked as well.</span>
                            </div>
                            <button type="button" class="btn-secondary unlock-link" @onclick="() => OpenDeveloperSite()">
                                <i class="fas fa-arrow-up-right-from-square"></i> developer.apple.com
                            </button>
                        </li>
                        <li>
                            <div class="unlock-step-text">
                                <strong>Come back and sign in here again</strong>
                                <span>Once both sites let you sign in normally, return to this dialog and try again.</span>
                            </div>
                        </li>
                    </ol>

                    <div class="unlock-note">
                        <i class="fas fa-circle-info" aria-hidden="true"></i>
                        <span>
                            Only use <code>iforgot.apple.com</code> / a full password reset as a last resort &mdash; it's not always
                            required, and it will require you to sign back in everywhere with the new password.
                        </span>
                    </div>
                </div>
            }

            @if (currentStep != AuthStep.AccountLocked && !string.IsNullOrEmpty(authError))
            {
                <div class="auth-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@authError</span>
                </div>
            }
        </form>
    </div>
}

@code {
    private const int OtpLength = 6;

    private AuthStep currentStep = AuthStep.Credentials;
    private string authAppleId = string.Empty;
    private string authPassword = string.Empty;
    private string authTwoFactorCode = string.Empty;
    private string? authError;
    private bool isAuthenticating;
    private AppleAuthOptions? twoFactorOptions;
    private int selectedPhoneIndex = -1;
    private List<FastlaneSessionInfo> fastlaneSessions = new();
    private string lockedAppleId = string.Empty;
    private readonly string[] otpDigits = new string[OtpLength];
    private readonly ElementReference[] otpInputRefs = new ElementReference[OtpLength];
    private bool otpAutoSubmitted;
    private bool shouldFocusFirstOtpDigit;

    private enum AuthStep
    {
        Credentials,
        TwoFactor,
        AccountLocked
    }

    protected override void OnInitialized()
    {
        var bridge = BridgeHolder.Current;
        if (bridge == null)
            return;

        bridge.SubmitRequested += OnSubmitRequested;
        bridge.BackRequested += OnBackRequested;
        bridge.PreventSubmitClose = true;

        UpdateWizardState();
    }

    protected override async Task OnInitializedAsync()
    {
        var sessions = await ViewModel.DetectFastlaneSessionsAsync();
        fastlaneSessions = sessions.ToList();
    }

    private async Task ImportFastlaneSession(FastlaneSessionInfo session)
    {
        if (isAuthenticating)
            return;

        isAuthenticating = true;
        authError = null;
        UpdateWizardState();
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await ViewModel.ImportFastlaneSessionAsync(session.AppleId, session.CookieFilePath);
            if (result.Success)
            {
                CompleteSuccess();
                return;
            }

            authError = result.ErrorMessage ?? "Failed to import fastlane session";
        }
        finally
        {
            isAuthenticating = false;
            UpdateWizardState();
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool CanSubmitCurrentStep => currentStep switch
    {
        AuthStep.Credentials =>
            !string.IsNullOrWhiteSpace(authAppleId) &&
            !string.IsNullOrWhiteSpace(authPassword),
        AuthStep.TwoFactor => !string.IsNullOrWhiteSpace(authTwoFactorCode),
        AuthStep.AccountLocked => true,
        _ => false
    };

    private void OnFieldChanged() => UpdateWizardState();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusFirstOtpDigit && currentStep == AuthStep.TwoFactor)
        {
            shouldFocusFirstOtpDigit = false;
            await FocusOtpDigitAsync(0);
        }
    }

    private async Task OnFormSubmitted() => await SubmitCurrentStepAsync();

    private async Task SubmitCurrentStepAsync()
    {
        var bridge = BridgeHolder.Current;
        if (bridge != null && CanSubmitCurrentStep && !isAuthenticating)
            await bridge.RequestSubmitAsync();
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitCurrentStepAsync();
    }

    private async Task OnOtpDigitInput(int index, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;

        // Handle a full code pasted/autofilled into a single box (e.g. SMS autofill).
        if (text.Length > 1)
        {
            DistributeOtpText(text);
            await FocusOtpDigitAsync(Math.Min(OtpLength - 1, text.Count(char.IsDigit)));
            await AfterOtpChangedAsync();
            return;
        }

        var digit = text.Length == 1 && char.IsDigit(text[0]) ? text : string.Empty;
        otpDigits[index] = digit;

        if (!string.IsNullOrEmpty(digit) && index < OtpLength - 1)
            await FocusOtpDigitAsync(index + 1);

        await AfterOtpChangedAsync();
    }

    private async Task OnOtpDigitKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(otpDigits[index]) && index > 0)
        {
            otpDigits[index - 1] = string.Empty;
            await FocusOtpDigitAsync(index - 1);
            await AfterOtpChangedAsync();
        }
        else if (e.Key == "ArrowLeft" && index > 0)
        {
            await FocusOtpDigitAsync(index - 1);
        }
        else if (e.Key == "ArrowRight" && index < OtpLength - 1)
        {
            await FocusOtpDigitAsync(index + 1);
        }
    }

    private void DistributeOtpText(string text)
    {
        var digitsOnly = new string(text.Where(char.IsDigit).ToArray());
        for (var i = 0; i < OtpLength; i++)
            otpDigits[i] = i < digitsOnly.Length ? digitsOnly[i].ToString() : string.Empty;
    }

    private async Task AfterOtpChangedAsync()
    {
        authTwoFactorCode = string.Concat(otpDigits);
        UpdateWizardState();
        await InvokeAsync(StateHasChanged);

        if (!otpAutoSubmitted && authTwoFactorCode.Length == OtpLength && CanSubmitCurrentStep && !isAuthenticating)
        {
            otpAutoSubmitted = true;
            await SubmitCurrentStepAsync();
        }
    }

    private async Task FocusOtpDigitAsync(int index)
    {
        if (index >= 0 && index < otpInputRefs.Length)
        {
            try
            {
                await otpInputRefs[index].FocusAsync();
            }
            catch (Exception)
            {
                // Element may not be attached yet on the very first render — ignore.
            }
        }
    }

    private void ResetOtp()
    {
        Array.Clear(otpDigits, 0, otpDigits.Length);
        authTwoFactorCode = string.Empty;
        otpAutoSubmitted = false;
    }

    private async Task OnPhoneSelectionChanged()
    {
        UpdateWizardState();
        await RequestSmsForSelectedPhone();
    }

    private async Task RequestSmsForSelectedPhone()
    {
        if (selectedPhoneIndex >= 0 && twoFactorOptions?.TrustedPhoneNumbers.Count > selectedPhoneIndex)
        {
            var phone = twoFactorOptions.TrustedPhoneNumbers[selectedPhoneIndex];
            await AuthService.RequestSmsCodeAsync(phone);
        }
    }

    private async Task OpenAppleIdSite() =>
        await AppLauncher.OpenAsync(new Uri("https://appleid.apple.com"));

    private async Task OpenDeveloperSite() =>
        await AppLauncher.OpenAsync(new Uri("https://developer.apple.com/account"));

    private void UpdateWizardState()
    {
        var bridge = BridgeHolder.Current;
        if (bridge == null)
            return;

        bridge.PreventClose = isAuthenticating;
        bridge.PreventSubmitClose = true;
        bridge.SetWizardState(
            showBack: currentStep == AuthStep.TwoFactor,
            showNext: false,
            showSubmit: true,
            canProceed: CanSubmitCurrentStep,
            isSubmitting: isAuthenticating,
            submitText: currentStep switch
            {
                AuthStep.Credentials => "Sign In",
                AuthStep.TwoFactor => "Verify",
                _ => "Try Again"
            });
    }

    private Task OnBackRequested()
    {
        if (isAuthenticating || currentStep != AuthStep.TwoFactor)
            return Task.CompletedTask;

        currentStep = AuthStep.Credentials;
        ResetOtp();
        authError = null;
        UpdateWizardState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnSubmitRequested()
    {
        if (isAuthenticating)
            return;

        if (currentStep == AuthStep.AccountLocked)
        {
            // Nothing to submit yet — just take the user back to try signing in again.
            currentStep = AuthStep.Credentials;
            authError = null;
            UpdateWizardState();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var shouldClose = false;
        isAuthenticating = true;
        authError = null;
        UpdateWizardState();
        await InvokeAsync(StateHasChanged);

        try
        {
            if (currentStep == AuthStep.Credentials)
            {
                var result = await ViewModel.SignInAsync(authAppleId, authPassword);
                if (result.Success)
                {
                    shouldClose = true;
                    CompleteSuccess();
                    return;
                }

                if (result.RequiresTwoFactor)
                {
                    currentStep = AuthStep.TwoFactor;
                    twoFactorOptions = result.TwoFactorOptions;
                    ResetOtp();
                    shouldFocusFirstOtpDigit = true;
                    selectedPhoneIndex = twoFactorOptions is { CanUseTrustedDevice: false }
                        && twoFactorOptions.TrustedPhoneNumbers.Count > 0
                        ? 0
                        : -1;

                    // If SMS was auto-selected, request the code be sent
                    if (selectedPhoneIndex >= 0)
                        await RequestSmsForSelectedPhone();
                }
                else if (result.IsAccountLocked)
                {
                    lockedAppleId = authAppleId;
                    authError = result.ErrorMessage;
                    currentStep = AuthStep.AccountLocked;
                }
                else
                {
                    authError = result.ErrorMessage ?? "Authentication failed";
                }
            }
            else if (currentStep == AuthStep.TwoFactor)
            {
                TwoFactorMethod? method = null;
                if (selectedPhoneIndex >= 0 && twoFactorOptions?.TrustedPhoneNumbers.Count > selectedPhoneIndex)
                    method = twoFactorOptions.TrustedPhoneNumbers[selectedPhoneIndex];

                var result = await ViewModel.SubmitTwoFactorCodeAsync(authTwoFactorCode, method);
                if (result.Success)
                {
                    shouldClose = true;
                    CompleteSuccess();
                    return;
                }

                authError = result.ErrorMessage ?? "Verification failed";
                ResetOtp();
                shouldFocusFirstOtpDigit = true;
            }
        }
        catch (Exception ex)
        {
            authError = ex.Message;
        }
        finally
        {
            isAuthenticating = false;
            if (!shouldClose)
            {
                UpdateWizardState();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CompleteSuccess()
    {
        var bridge = BridgeHolder.Current;
        if (bridge == null)
            return;

        bridge.Result = true;
        bridge.RequestClose();
    }

    public void Dispose()
    {
        var bridge = BridgeHolder.Current;
        if (bridge == null)
            return;

        bridge.SubmitRequested -= OnSubmitRequested;
        bridge.BackRequested -= OnBackRequested;
    }
}

<style>
    .form-content {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0;
    }

    .step-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        padding: 12px 20px 16px;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        min-width: 90px;
    }

    .step-number {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 600;
        background: var(--bg-tertiary, #e2e8f0);
        color: var(--text-muted);
    }

    .step.active .step-number {
        background: var(--accent-primary);
        color: white;
    }

    .step.completed .step-number {
        background: var(--accent-success, #22c55e);
        color: white;
    }

    .step-label {
        font-size: 11px;
        color: var(--text-muted);
        text-align: center;
    }

    .step.active .step-label,
    .step.completed .step-label {
        color: var(--text-primary);
        font-weight: 600;
    }

    .step-line {
        flex: 0 1 56px;
        height: 2px;
        background: var(--border-color);
        margin: 0 8px;
    }

    .step-line.active {
        background: var(--accent-primary);
    }

    .wizard-body {
        flex: 1;
        overflow-y: auto;
        padding: 12px 12px 24px 20px;
    }

    .step-content h3 {
        margin: 0 0 8px 0;
        font-size: 16px;
        color: var(--text-primary);
    }

    .step-description {
        margin: 0 0 16px 0;
        color: var(--text-muted);
        font-size: 13px;
        line-height: 1.5;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 16px;
    }

    .form-group label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--input-border, #e2e8f0);
        border-radius: 6px;
        background: var(--input-bg, white);
        color: var(--text-primary);
        font-size: 14px;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.12);
    }

    .form-group input:disabled,
    .form-group select:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .otp-group {
        margin-bottom: 20px;
    }

    .otp-digits {
        display: flex;
        gap: 8px;
        justify-content: space-between;
    }

    .otp-digits .otp-digit {
        width: 42px;
        height: 52px;
        padding: 0;
        border: 1px solid var(--input-border, #e2e8f0);
        border-radius: 8px;
        background: var(--input-bg, white);
        color: var(--text-primary);
        font-size: 22px;
        font-weight: 600;
        font-family: var(--font-mono, ui-monospace, monospace);
        text-align: center;
        box-sizing: border-box;
        transition: border-color 0.12s ease, box-shadow 0.12s ease;
    }

    .otp-digits .otp-digit:focus {
        outline: none;
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.16);
    }

    .otp-digits .otp-digit:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .visually-hidden-submit {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        border: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

    .fastlane-import {
        margin-top: -4px;
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px dashed var(--border-color);
        background: var(--bg-tertiary, #f8fafc);
    }

    .fastlane-import-hint {
        margin: 0 0 10px 0;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.5;
    }

    .fastlane-import-button {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 12px;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .fastlane-import-button:last-child {
        margin-bottom: 0;
    }

    .auth-error {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 8px;
        padding: 12px 14px;
        border-radius: 10px;
        background: var(--status-error-bg);
        color: var(--status-error-text);
        font-size: 13px;
    }

    .account-locked {
        text-align: center;
    }

    .account-locked h3 {
        text-align: center;
    }

    .account-locked .step-description {
        text-align: left;
    }

    .locked-icon {
        width: 40px;
        height: 40px;
        margin: 0 auto 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        background: var(--status-warning-bg, rgba(245, 158, 11, 0.15));
        color: var(--status-warning-text, #b45309);
    }

    .apple-said {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin: 0 0 12px 0;
        padding: 8px 12px;
        border-radius: 8px;
        background: var(--bg-tertiary, #f8fafc);
        color: var(--text-secondary);
        font-size: 12px;
        font-style: italic;
        text-align: left;
    }

    .unlock-steps {
        list-style: none;
        counter-reset: unlock-step;
        margin: 0 0 12px 0;
        padding: 0;
        text-align: left;
    }

    .unlock-steps li {
        counter-increment: unlock-step;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .unlock-steps li:last-child {
        border-bottom: none;
    }

    .unlock-steps li::before {
        content: counter(unlock-step);
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        background: var(--accent-primary);
        color: white;
        margin-right: 10px;
    }

    .unlock-step-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .unlock-step-text strong {
        font-size: 13px;
        color: var(--text-primary);
    }

    .unlock-step-text span {
