@page "/modal/dotnetup-details"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Pages.Forms
@using MauiSherpa.Workloads.Models
@inject ModalParameterService ModalParams
@inject IFileSystemService FileSystem
@inject IAlertService AlertService
@inject IJSRuntime JS

@if (session is null)
{
    <div class="sherpa-form">
        <div class="sherpa-banner sherpa-banner-warning">
            <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i>
            <span>dotnetup details are unavailable.</span>
        </div>
    </div>
}
else
{
    <div class="sherpa-form tool-details">
        <div class="sherpa-banner @BannerClass tool-banner">
            <div class="tool-banner-copy">
                <i class="fa-solid @BannerIcon fa-fw" aria-hidden="true"></i>
                <div>
                    <strong>@StatusTitle</strong>
                    <span>@StatusDescription</span>
                </div>
            </div>
            <div class="tool-banner-actions">
                @if (!session.IsInstalled)
                {
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            @onclick="() => SelectAction(DotnetUpDetailsAction.Install)">
                        <i class="fa-solid fa-download fa-fw" aria-hidden="true"></i>
                        <span>Install</span>
                    </button>
                }
                else
                {
                    @if (UpdateAvailable)
                    {
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                @onclick="() => SelectAction(DotnetUpDetailsAction.Update)">
                            <i class="fa-solid fa-arrow-up fa-fw" aria-hidden="true"></i>
                            <span>Update</span>
                        </button>
                    }
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            @onclick="() => SelectAction(DotnetUpDetailsAction.Reinstall)">
                        <i class="fa-solid fa-rotate fa-fw" aria-hidden="true"></i>
                        <span>Reinstall</span>
                    </button>
                }
            </div>
        </div>

        <div class="sherpa-card tool-card">
            <div class="tool-facts-grid">
                <div class="tool-fact">
                    <span class="sherpa-meta-label">Installed version</span>
                    <span class="sherpa-meta-value mono">@ValueOrFallback(session.ToolInfo?.Version)</span>
                </div>
                @if (UpdateAvailable)
                {
                    <div class="tool-fact">
                        <span class="sherpa-meta-label">Available version</span>
                        <span class="tool-fact-inline">
                            <span class="sherpa-badge sherpa-badge-accent mono">@session.ToolUpdateInfo!.AvailableVersion</span>
                        </span>
                    </div>
                }
                <div class="tool-fact">
                    <span class="sherpa-meta-label">RID</span>
                    <span class="sherpa-meta-value mono">@ValueOrFallback(session.ToolInfo?.Rid)</span>
                </div>
                <div class="tool-fact">
                    <span class="sherpa-meta-label">Architecture</span>
                    <span class="sherpa-meta-value">@ValueOrFallback(session.ToolInfo?.Architecture)</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(session.ExecutablePath) || !string.IsNullOrWhiteSpace(session.ToolDirectory))
            {
                <div class="tool-paths">
                    @if (!string.IsNullOrWhiteSpace(session.ExecutablePath))
                    {
                        <div class="tool-path-row">
                            <div class="sherpa-row-stack">
                                <span class="sherpa-meta-label">Binary path</span>
                                <span class="sherpa-meta-value mono text-selectable tool-path-text" title="@session.ExecutablePath">@session.ExecutablePath</span>
                            </div>
                            <div class="sherpa-row-actions">
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Copy binary path" aria-label="Copy binary path" @onclick="() => CopyAsync(session.ExecutablePath!)">
                                    <i class="fa-regular fa-copy fa-fw" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Reveal in file manager" aria-label="Reveal binary in file manager" @onclick="() => FileSystem.RevealInFileManager(session.ExecutablePath!)">
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-fw" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(session.ToolDirectory))
                    {
                        <div class="tool-path-row">
                            <div class="sherpa-row-stack">
                                <span class="sherpa-meta-label">Tool directory</span>
                                <span class="sherpa-meta-value mono text-selectable tool-path-text" title="@session.ToolDirectory">@session.ToolDirectory</span>
                            </div>
                            <div class="sherpa-row-actions">
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Copy tool directory" aria-label="Copy tool directory" @onclick="() => CopyAsync(session.ToolDirectory!)">
                                    <i class="fa-regular fa-copy fa-fw" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Reveal in file manager" aria-label="Reveal tool directory in file manager" @onclick="() => FileSystem.RevealInFileManager(session.ToolDirectory!)">
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-fw" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @if (ManagedRoots.Count > 0)
        {
            <section class="sherpa-form-section">
                <div class="sherpa-form-section-title">
                    <span><i class="fa-solid fa-folder-tree fa-fw" aria-hidden="true"></i> Managed roots</span>
                    <span class="sherpa-badge sherpa-badge-neutral">@ManagedRoots.Count</span>
                </div>
                <div class="sherpa-list">
                    @foreach (var root in ManagedRoots)
                    {
                        <div class="sherpa-list-row">
                            <span class="sherpa-icon-well sherpa-icon-well-sm sherpa-icon-well-neutral">
                                <i class="fa-solid fa-folder fa-fw" aria-hidden="true"></i>
                            </span>
                            <div class="sherpa-row-stack">
                                <span class="sherpa-meta-value mono text-selectable tool-path-text" title="@root">@root</span>
                            </div>
                            <div class="sherpa-row-actions">
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Copy path" aria-label="Copy managed root path" @onclick="() => CopyAsync(root)">
                                    <i class="fa-regular fa-copy fa-fw" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Reveal in file manager" aria-label="Reveal managed root in file manager" @onclick="() => FileSystem.RevealInFileManager(root)">
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-fw" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
}

<style>
    .tool-banner {
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .tool-banner-copy {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        flex: 1 1 240px;
        min-width: 0;
    }

    .tool-banner-copy > i {
        margin-top: 2px;
        font-size: 15px;
    }

    .tool-banner-copy > div {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .tool-banner-copy strong {
        font-size: var(--font-size-md);
        font-weight: 650;
    }

    .tool-banner-copy span {
        font-size: var(--font-size-xs);
        opacity: 0.9;
        line-height: 1.4;
    }

    .tool-banner-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .tool-card {
        overflow: hidden;
    }

    .tool-facts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 16px;
        padding: 12px 14px;
    }

    .tool-fact {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

    .tool-fact-inline {
        display: inline-flex;
        align-items: center;
    }

    .tool-paths {
        border-top: 1px solid var(--border-hairline);
        background: var(--surface-well);
    }

    .tool-path-row {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 14px;
    }

    .tool-path-row + .tool-path-row::before {
        content: "";
        position: absolute;
        top: 0;
        left: 14px;
        right: 14px;
        height: 1px;
        background: var(--border-hairline);
    }

    .tool-path-text {
        overflow-wrap: anywhere;
        font-size: var(--font-size-xs);
    }

    @@media (max-width: 560px) {
        .tool-facts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private DotnetUpDetailsSession? session;

    private bool UpdateAvailable =>
        session?.IsInstalled == true &&
        session.ToolUpdateInfo?.UpdateAvailable == true;

    private string BannerClass => session?.IsInstalled != true
        ? "sherpa-banner-warning"
        : UpdateAvailable ? "sherpa-banner-info" : "sherpa-banner-success";

    private string BannerIcon => session?.IsInstalled != true
        ? "fa-triangle-exclamation"
        : UpdateAvailable ? "fa-circle-arrow-up" : "fa-circle-check";

    private string StatusTitle => session?.IsInstalled == true
        ? UpdateAvailable ? "Update available" : "dotnetup is ready"
        : "Not installed";

    private string StatusDescription
    {
        get
        {
            if (session?.IsInstalled != true)
                return "Install dotnetup to manage .NET SDKs and runtimes from Sherpa.";

            if (UpdateAvailable)
                return $"Version {session.ToolUpdateInfo!.AvailableVersion} is available (currently {session.ToolInfo?.Version ?? session.ToolUpdateInfo.InstalledVersion}).";

            return "Ready for SDK, runtime, and tracked-channel operations.";
        }
    }

    private IReadOnlyList<string> ManagedRoots =>
        session?.ManagedRoots
            .Where(root => !string.IsNullOrWhiteSpace(root))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    protected override void OnInitialized()
    {
        session = ModalParams.Get<DotnetUpDetailsSession>("Session");
    }

    private void SelectAction(DotnetUpDetailsAction action) =>
        session?.RequestAction(action);

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await AlertService.ShowToastAsync("Copied to clipboard");
        }
        catch { }
    }

    private static string ValueOrFallback(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Unknown" : value;
}
