@page "/modal/apple-identity"
@using MauiSherpa.Core.Interfaces
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject IDialogService DialogService
@inject IFileSystemService FileSystem

<div class="dialog-content">
    <div class="dialog-header">
        <h2><i class="fa-solid fa-id-badge"></i> @(isEditing ? "Edit" : "Add") Apple Identity</h2>
    </div>
    <div class="dialog-body sherpa-form sherpa-scroll">
        <div class="sherpa-form-grid-2">
            <div class="sherpa-field">
                <label class="sherpa-field-label">Name</label>
                <input type="text" class="sherpa-input" @bind="identityName" @bind:event="oninput" placeholder="My Team" />
                <div class="sherpa-field-help">A friendly name to identify this credential</div>
            </div>
            <div class="sherpa-field">
                <label class="sherpa-field-label">Key ID</label>
                <input type="text" class="sherpa-input mono" @bind="identityKeyId" @bind:event="oninput" placeholder="ABC123XYZ" />
                <div class="sherpa-field-help">The 10-character Key ID from App Store Connect</div>
            </div>
        </div>
        <div class="sherpa-field">
            <label class="sherpa-field-label">Issuer ID (Team ID)</label>
            <input type="text" class="sherpa-input mono" @bind="identityIssuerId" @bind:event="oninput" placeholder="12345678-1234-1234-1234-123456789012" />
            <div class="sherpa-field-help">Your Issuer ID (UUID format) from App Store Connect → Users and Access → Keys</div>
        </div>
        <div class="sherpa-field">
            <label class="sherpa-field-label">Private Key (.p8)</label>
            <SherpaSegmentedControl TValue="string"
                                    Value="@p8InputMode"
                                    ValueChanged="@((string? value) => p8InputMode = value ?? "file")"
                                    Options="P8InputOptions"
                                    AriaLabel="Private key input mode"
                                    Class="sherpa-segmented-full" />
            @if (p8InputMode == "file")
            {
                <div class="sherpa-input-group">
                    <input type="text" value="@identityP8Path" placeholder="Path to .p8 file" readonly />
                    <button type="button" class="sherpa-input-group-btn" @onclick="BrowseP8File">
                        <i class="fa-solid fa-folder-open" aria-hidden="true"></i> Browse...
                    </button>
                </div>
                <div class="sherpa-field-help">Select your AuthKey_XXXXXX.p8 file downloaded from App Store Connect</div>
            }
            else
            {
                <textarea @bind="identityP8Content"
                          @bind:event="oninput"
                          placeholder="-----BEGIN PRIVATE KEY-----&#10;...&#10;-----END PRIVATE KEY-----"
                          rows="6"
                          class="sherpa-textarea mono"></textarea>
                <div class="sherpa-field-help">Paste the contents of your .p8 file (including BEGIN/END lines)</div>
            }
        </div>
        @if (!string.IsNullOrEmpty(identityP8Content))
        {
            <div class="identity-status">
                <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                P8 key loaded (@identityP8Content.Length chars)
            </div>
        }
    </div>
    <div class="dialog-footer">
        <button class="btn btn-secondary" @onclick="Cancel">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i> Cancel
        </button>
        <button class="btn btn-primary" @onclick="Save"
                disabled="@(!CanSave)">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save
        </button>
    </div>
</div>

@code {
    private bool isEditing;
    private string editingId = "";
    private string identityName = "";
    private string identityKeyId = "";
    private string identityIssuerId = "";
    private string identityP8Path = "";
    private string identityP8Content = "";
    private string p8InputMode = "file";
    private static readonly IReadOnlyList<SherpaSegmentOption<string>> P8InputOptions =
    [
        new("file", "File", "fa-solid fa-folder-open"),
        new("text", "Text", "fa-solid fa-file-lines")
    ];

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(identityName) &&
        !string.IsNullOrWhiteSpace(identityKeyId) &&
        !string.IsNullOrWhiteSpace(identityIssuerId) &&
        !string.IsNullOrWhiteSpace(identityP8Content);

    protected override void OnInitialized()
    {
        var identity = ModalParams.Get<AppleIdentity>("Identity");
        if (identity != null)
        {
            isEditing = true;
            editingId = identity.Id;
            identityName = identity.Name;
            identityKeyId = identity.KeyId;
            identityIssuerId = identity.IssuerId;
            identityP8Path = identity.P8KeyPath ?? "";
            identityP8Content = identity.P8KeyContent ?? "";
            p8InputMode = string.IsNullOrEmpty(identity.P8KeyPath) && !string.IsNullOrEmpty(identity.P8KeyContent) ? "text" : "file";
        }
    }

    private void Cancel() => ModalParams.Cancel();

    private void Save()
    {
        var id = isEditing ? editingId : Guid.NewGuid().ToString();
        var identity = new AppleIdentity(
            Id: id,
            Name: identityName.Trim(),
            KeyId: identityKeyId.Trim(),
            IssuerId: identityIssuerId.Trim(),
            P8KeyPath: string.IsNullOrEmpty(identityP8Path) ? null : identityP8Path,
            P8KeyContent: identityP8Content);
        ModalParams.Complete(identity);
    }

    private async Task BrowseP8File()
    {
        var path = await DialogService.ShowFileDialogAsync(
            "Select P8 Key File",
            isSave: false,
            filters: new[] { "*.p8" });

        if (!string.IsNullOrEmpty(path))
        {
            identityP8Path = path;
            identityP8Content = await FileSystem.ReadFileAsync(path) ?? "";
            await InvokeAsync(StateHasChanged);
        }
    }
}

<style>
    .dialog-content { display: flex; flex-direction: column; width: 100%; height: 100%; }
    .dialog-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border-subtle); }
    .dialog-header h2 { margin: 0; font-size: 18px; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }
    .dialog-body { flex: 1; min-height: 0; }
    .dialog-footer { padding: 16px 24px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; gap: 12px; }
    .identity-status { display: inline-flex; align-items: center; gap: 6px; color: var(--status-success-fg); font-size: var(--font-size-xs); }
</style>
