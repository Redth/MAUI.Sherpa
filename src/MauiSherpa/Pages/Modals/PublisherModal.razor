@page "/modal/publisher"
@using MauiSherpa.Core.Interfaces
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject ISecretsPublisherFactory SecretsPublisherFactory
@inject ILauncher AppLauncher

<div class="dialog-content">
    <div class="dialog-header">
        <h2><i class="fa-solid fa-rocket"></i> @(isEditing ? "Edit" : "Add") CI/CD Publisher</h2>
    </div>
    <div class="dialog-body sherpa-form sherpa-scroll">
        <div class="sherpa-field">
            <label class="sherpa-field-label">Name</label>
            <input type="text" class="sherpa-input" @bind="publisherName" @bind:event="oninput" placeholder="My GitHub Account" />
            <div class="sherpa-field-help">A friendly name to identify this publisher</div>
        </div>
        <div class="sherpa-field">
            <label class="sherpa-field-label">Provider Type</label>
            @if (isEditing)
            {
                <input type="text" class="sherpa-input" value="@GetPublisherDisplayName(publisherProviderId)" disabled />
            }
            else
            {
                <div class="provider-type-selector">
                    @foreach (var (providerId, displayName, iconClass) in SecretsPublisherFactory.GetAvailableProviders())
                    {
                        <button type="button" class="provider-type-card sherpa-card @(publisherProviderId == providerId ? "selected" : "")"
                                aria-pressed="@((publisherProviderId == providerId).ToString().ToLowerInvariant())"
                                @onclick="@(() => publisherProviderId = providerId)">
                            <i class="@iconClass provider-icon" aria-hidden="true"></i>
                            <span class="provider-name">@displayName</span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="sherpa-form-grid-2">
            @foreach (var (key, label, type, required, placeholder) in SecretsPublisherFactory.GetRequiredSettings(publisherProviderId))
            {
                <div class="sherpa-field">
                    <label class="sherpa-field-label">@label @(required ? "*" : "")</label>
                    @if (type == "password")
                    {
                        <div class="sherpa-input-group">
                            <input type="@(IsSecretVisible(key) ? "text" : "password")"
                                   value="@(publisherSettings.GetValueOrDefault(key, ""))"
                                   @onchange="@(e => publisherSettings[key] = e.Value?.ToString() ?? "")"
                                   placeholder="@placeholder" />
                            <button type="button" class="sherpa-input-group-btn"
                                    title="@(IsSecretVisible(key) ? "Hide value" : "Show value")"
                                    aria-label="@(IsSecretVisible(key) ? $"Hide {label}" : $"Show {label}")"
                                    @onclick="() => ToggleSecretVisibility(key)">
                                <i class="fa-solid @(IsSecretVisible(key) ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                    else if (type == "url")
                    {
                        <input type="url"
                               class="sherpa-input"
                               value="@(publisherSettings.GetValueOrDefault(key, ""))"
                               @onchange="@(e => publisherSettings[key] = e.Value?.ToString() ?? "")"
                               placeholder="@placeholder" />
                    }
                    else
                    {
                        <input type="text"
                               class="sherpa-input"
                               value="@(publisherSettings.GetValueOrDefault(key, ""))"
                               @onchange="@(e => publisherSettings[key] = e.Value?.ToString() ?? "")"
                               placeholder="@placeholder" />
                    }
                    @if (key == "PersonalAccessToken" && publisherProviderId == "github")
                    {
                        <div class="sherpa-field-help">
                            Generate a PAT with <code>repo</code> scope at
                            <a href="#" @onclick:preventDefault @onclick='() => OpenUrl("https://github.com/settings/tokens/new?scopes=repo&description=MauiSherpa")'>GitHub Settings</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="dialog-footer">
        <button class="btn btn-secondary" @onclick="Cancel">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i> Cancel
        </button>
        <button class="btn btn-primary" @onclick="Save"
                disabled="@(!CanSave)">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save
        </button>
    </div>
</div>

@code {
    private bool isEditing;
    private string editingId = "";
    private string publisherName = "";
    private string publisherProviderId = "github";
    private Dictionary<string, string> publisherSettings = new();
    private readonly HashSet<string> visibleSecretSettings = new(StringComparer.Ordinal);

    private bool CanSave
    {
        get
        {
            if (string.IsNullOrWhiteSpace(publisherName)) return false;
            var (isValid, _) = SecretsPublisherFactory.ValidateConfig(publisherProviderId, publisherSettings);
            return isValid;
        }
    }

    protected override void OnInitialized()
    {
        var publisher = ModalParams.Get<SecretsPublisherConfig>("Publisher");
        if (publisher != null)
        {
            isEditing = true;
            editingId = publisher.Id;
            publisherName = publisher.Name;
            publisherProviderId = publisher.ProviderId;
            publisherSettings = new Dictionary<string, string>(publisher.Settings);
        }
    }

    private void Cancel() => ModalParams.Cancel();

    private void Save()
    {
        var config = new SecretsPublisherConfig(
            isEditing ? editingId : Guid.NewGuid().ToString("N"),
            publisherProviderId,
            publisherName,
            new Dictionary<string, string>(publisherSettings));
        ModalParams.Complete(config);
    }

    private async Task OpenUrl(string url)
    {
        await AppLauncher.OpenAsync(new Uri(url));
    }

    private bool IsSecretVisible(string key) => visibleSecretSettings.Contains(key);

    private void ToggleSecretVisibility(string key)
    {
        if (!visibleSecretSettings.Add(key))
            visibleSecretSettings.Remove(key);
    }

    private static string GetPublisherDisplayName(string providerId) => providerId switch
    {
        "github" => "GitHub Actions",
        "gitea" => "Gitea",
        "gitlab" => "GitLab CI/CD",
        "azuredevops" => "Azure DevOps",
        _ => providerId
    };
}

<style>
    .dialog-content { display: flex; flex-direction: column; width: 100%; height: 100%; }
    .dialog-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border-subtle); }
    .dialog-header h2 { margin: 0; font-size: 18px; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }
    .dialog-body { flex: 1; min-height: 0; }
    .dialog-footer { padding: 16px 24px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; gap: 12px; }
    .provider-type-selector { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-top: 0.5rem; }
    .provider-type-card { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 12px 10px; color: var(--text-primary); cursor: pointer; font: inherit; transition: background var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard); }
    .provider-type-card:hover { background: var(--surface-card-hover); }
    .provider-type-card.selected { border-color: var(--accent); background: var(--accent-soft); }
    .provider-type-card .provider-icon { font-size: 1.35rem; color: var(--text-secondary); }
    .provider-type-card.selected .provider-icon { color: var(--accent); }
    .provider-type-card .provider-name { font-size: var(--font-size-sm); font-weight: 550; text-align: center; }
    .sherpa-field-help a { color: var(--accent); }
</style>
