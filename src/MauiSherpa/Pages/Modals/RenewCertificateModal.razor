@page "/modal/renew-certificate"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Pages.Forms
@inject HybridFormBridgeHolder BridgeHolder
@implements IDisposable

@if (bridge is not null && certificate is not null)
{
    <div class="sherpa-form sherpa-scroll">
        <div class="sherpa-well renewal-summary">
            <div class="renewal-summary-item renewal-summary-name">
                <span>Name</span>
                <strong>@certificate.Name</strong>
            </div>
            <div class="renewal-summary-item">
                <span>Type</span>
                <strong>@typeLabel</strong>
            </div>
            <div class="renewal-summary-item">
                <span>Serial</span>
                <strong class="mono">@certificate.SerialNumber</strong>
            </div>
            <div class="renewal-summary-item">
                <span>Expiry</span>
                <strong>@certificate.ExpirationDate.ToString("MMM d, yyyy")</strong>
            </div>
        </div>

        <div class="sherpa-banner sherpa-banner-info">
            <i class="fa-solid fa-arrows-rotate fa-fw" aria-hidden="true"></i>
            <div>
                <strong>@ProfileSummary</strong>
                <div>
                    After you continue, Sherpa lets you choose which affected provisioning profiles
                    to migrate and whether to revoke the old certificate after renewal.
                </div>
            </div>
        </div>

        <div class="sherpa-field">
            <label class="sherpa-field-label">Replacement Certificate</label>
            <SherpaSelect TValue="string"
                          Value="@replacementId"
                          ValueChanged="OnReplacementChanged"
                          Options="ReplacementOptions"
                          AriaLabel="Replacement certificate"
                          Class="sherpa-select-full" />
            <div class="sherpa-field-help">
                @(candidates.Count == 0
                    ? "No newer certificate of this type exists, so a new one will be created."
                    : "Pick an existing newer certificate of the same type, or create a new one.")
            </div>
        </div>

        @if (CreatesNewCertificate)
        {
            <div class="sherpa-field">
                <label class="sherpa-field-label sherpa-checkbox-row">
                    <input type="checkbox"
                           @bind="saveToDisk"
                           @bind:after="OnFieldChanged"
                           disabled="@requireDiskExport" />
                    <span>Save a copy to disk</span>
                </label>
                <div class="sherpa-field-help">
                    @(requireDiskExport
                        ? "Required because this platform does not provide a supported certificate store."
                        : "The new certificate is installed in the platform certificate store and synced to default providers.")
                </div>
            </div>

            @if (saveToDisk)
            {
                <div class="sherpa-field">
                    <label class="sherpa-field-label" for="renew-passphrase">
                        P12 Passphrase <span class="sherpa-field-opt">(optional)</span>
                    </label>
                    <div class="sherpa-input-group">
                        <input id="renew-passphrase"
                               type="@(showPassphrase ? "text" : "password")"
                               @bind="passphrase"
                               @bind:event="oninput"
                               placeholder="Leave empty for an unprotected P12" />
                        <button type="button"
                                class="sherpa-input-group-btn"
                                title="@(showPassphrase ? "Hide passphrase" : "Show passphrase")"
                                aria-label="@(showPassphrase ? "Hide passphrase" : "Show passphrase")"
                                @onclick="TogglePassphrase">
                            <i class="fa-solid @(showPassphrase ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="sherpa-field-help">Only used for the copy saved to disk.</div>
                </div>
            }
        }
    </div>
}

@code {
    private const string NewCertificateId = "__new__";

    private HybridFormBridge? bridge;
    private AppleCertificate? certificate;
    private IReadOnlyList<AppleCertificate> candidates = Array.Empty<AppleCertificate>();
    private string typeLabel = "";
    private int affectedProfileCount;
    private bool requireDiskExport;
    private string replacementId = NewCertificateId;
    private bool saveToDisk;
    private bool showPassphrase;
    private string passphrase = "";

    private bool CreatesNewCertificate => replacementId == NewCertificateId;

    private string ProfileSummary => affectedProfileCount switch
    {
        0 => "No provisioning profiles use this certificate.",
        1 => "1 provisioning profile uses this certificate.",
        _ => $"{affectedProfileCount} provisioning profiles use this certificate."
    };

    private IReadOnlyList<SherpaSelectOption<string>> ReplacementOptions =>
        new[]
        {
            new SherpaSelectOption<string>(
                NewCertificateId,
                $"Create a new {typeLabel} certificate",
                "Issue a new certificate with Apple.",
                Icon: "fa-solid fa-plus")
        }
        .Concat(candidates.Select(candidate =>
            new SherpaSelectOption<string>(
                candidate.Id,
                $"Use existing: {candidate.Name}",
                $"Expires {candidate.ExpirationDate:MMM d, yyyy} · Serial …{Tail(candidate.SerialNumber)}",
                Icon: "fa-solid fa-certificate")))
        .ToArray();

    protected override void OnInitialized()
    {
        bridge = BridgeHolder.Current;
        if (bridge is null)
            return;

        certificate = bridge.Parameters.GetValueOrDefault("Certificate") as AppleCertificate;
        typeLabel = bridge.Parameters.GetValueOrDefault("TypeLabel") as string ?? "";
        candidates = bridge.Parameters.GetValueOrDefault("Candidates")
            as IReadOnlyList<AppleCertificate>
            ?? Array.Empty<AppleCertificate>();
        affectedProfileCount = bridge.Parameters.GetValueOrDefault("AffectedProfileCount") is int count
            ? count
            : 0;
        requireDiskExport = bridge.Parameters.GetValueOrDefault("RequireDiskExport") is true;
        saveToDisk = requireDiskExport;

        bridge.SubmitRequested += OnSubmitRequested;
        UpdateValidation();
    }

    private void OnReplacementChanged(string? value)
    {
        replacementId = value ?? NewCertificateId;
        UpdateValidation();
    }

    private void OnFieldChanged() => UpdateValidation();

    private void TogglePassphrase() => showPassphrase = !showPassphrase;

    private void UpdateValidation() =>
        bridge?.SetValid(
            replacementId == NewCertificateId ||
            candidates.Any(candidate => candidate.Id == replacementId));

    private Task OnSubmitRequested()
    {
        if (bridge is null)
            return Task.CompletedTask;

        if (CreatesNewCertificate)
        {
            bridge.Result = new RenewCertificateFormResult(
                null,
                saveToDisk,
                saveToDisk ? passphrase : null);
        }
        else
        {
            var candidate = candidates.First(candidate => candidate.Id == replacementId);
            bridge.Result = new RenewCertificateFormResult(candidate.Id, false, null);
        }

        return Task.CompletedTask;
    }

    private static string Tail(string? serial) =>
        string.IsNullOrEmpty(serial) ? "" : serial.Length <= 6 ? serial : serial[^6..];

    public void Dispose()
    {
        if (bridge is not null)
            bridge.SubmitRequested -= OnSubmitRequested;
    }
}

<style>
    .renewal-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 18px;
    }

    .renewal-summary-item {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 2px;
    }

    .renewal-summary-item > span {
        color: var(--text-muted);
        font-size: var(--font-size-xs);
    }

    .renewal-summary-item > strong {
        overflow: hidden;
        color: var(--text-primary);
        font-size: var(--font-size-sm);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sherpa-checkbox-row {
        cursor: pointer;
    }

    @@media (max-width: 560px) {
        .renewal-summary {
            grid-template-columns: 1fr;
        }
    }
</style>
