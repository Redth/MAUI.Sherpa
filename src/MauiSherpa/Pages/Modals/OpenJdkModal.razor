@page "/modal/openjdk"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Pages.Forms
@inject HybridFormBridgeHolder BridgeHolder
@inject IOpenJdkService Jdks
@inject IOpenJdkSettingsService Settings
@inject IDialogService Dialogs
@inject ILoggingService Logger
@implements IDisposable

<div class="jdk-dialog">
    <div class="jdk-header">
        <div class="jdk-mode" role="group" aria-label="OpenJDK action">
            <button type="button" class="@(!install ? "selected" : "")" aria-pressed="@(!install)" disabled="@loading" @onclick="() => SetModeAsync(false)">Installed</button>
            <button type="button" class="@(install ? "selected" : "")" aria-pressed="@install" disabled="@loading" @onclick="() => SetModeAsync(true)">Install New</button>
        </div>
        <button id="refresh-openjdk" type="button" class="jdk-refresh" title="Refresh OpenJDK" disabled="@loading" @onclick="() => LoadAsync(true)">
            <i class="fa-solid fa-rotate @(loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
    </div>
    <p class="jdk-help">@(install ? "Choose a Java major version. Sherpa installs Microsoft's latest release for your computer." : "Choose the JDK Sherpa uses for Android packages, emulators, and keystores, or remove versions Sherpa installed.")</p>
    @if (loading)
    {
        <p role="status"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Checking OpenJDK...</p>
    }
    else if (install)
    {
        <fieldset class="jdk-options">
            <legend>Java version</legend>
            <div class="jdk-option-list">
                @foreach (var release in releases.OrderBy(r => r.MajorVersion == OpenJdkService.RecommendedMajorVersion ? 0 : 1).ThenByDescending(r => r.MajorVersion))
                {
                    <label class="jdk-option @(major == release.MajorVersion ? "selected" : "")">
                        <input id="jdk-major-@release.MajorVersion" type="radio" name="jdk-major" checked="@(major == release.MajorVersion)" @onchange="() => SelectMajor(release.MajorVersion)" />
                        <span class="jdk-copy"><strong>OpenJDK @release.MajorVersion</strong><span>Latest release: @release.Version</span></span>
                        @if (release.MajorVersion == OpenJdkService.RecommendedMajorVersion)
                        {
                            <span class="jdk-status">Recommended for Android</span>
                        }
                    </label>
                }
            </div>
        </fieldset>
        @if (major != OpenJdkService.RecommendedMajorVersion)
        {
            <p class="jdk-help">Choose another major only if your Android tools or project require it. Newer Java majors are not always compatible with older build tools.</p>
        }
        <p class="jdk-help">Downloads are verified against Microsoft's SHA-256 checksum. Installs are side by side in Sherpa's application data folder; no administrator access is needed.</p>
    }
    else
    {
        <fieldset class="jdk-options">
            <legend>Installed JDKs</legend>
            @if (installations.Count == 0)
            {
                <p class="jdk-help">No working JDK found. Install Microsoft OpenJDK to continue.</p>
            }
            @if (installations.Count > 0)
            {
                <div class="jdk-option-list">
                    @foreach (var jdk in installations)
                    {
                        <label class="jdk-option @(path == jdk.Path ? "selected" : "")">
                            <input type="radio" name="jdk-home" checked="@(path == jdk.Path)" @onchange="() => SelectPath(jdk.Path)" />
                            <span class="jdk-copy"><strong>@(jdk.IsMicrosoft ? "Microsoft OpenJDK" : "OpenJDK") @jdk.Version</strong><span class="mono text-selectable">@jdk.Path</span></span>
                            @if (confirmRemove == jdk.Path)
                            {
                                <span class="jdk-row-confirm">
                                    <button type="button" class="jdk-row-btn" disabled="@removing" @onclick="() => confirmRemove = null" @onclick:preventDefault @onclick:stopPropagation>Cancel</button>
                                    <button type="button" class="jdk-row-btn is-danger" disabled="@removing" @onclick="() => RemoveAsync(jdk.Path)" @onclick:preventDefault @onclick:stopPropagation>
                                        @if (removing) { <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> <span>Removing...</span> } else { <span>Remove</span> }
                                    </button>
                                </span>
                            }
                            else
                            {
                                @if (jdk.IsActive) { <span class="jdk-status">Active</span> }
                                else if (Jdks.AvailableUpdates.Any(u => u.Installed.Path == jdk.Path)) { <span class="jdk-status">Update available</span> }
                                else if (!jdk.IsManaged) { <span class="jdk-status is-muted">Installed by another tool</span> }
                                @if (jdk.IsManaged && !jdk.IsActive)
                                {
                                    <button type="button" class="jdk-row-icon" title="Remove this JDK" aria-label="Remove OpenJDK @jdk.Version" disabled="@removing" @onclick="() => { confirmRemove = jdk.Path; error = null; }" @onclick:preventDefault @onclick:stopPropagation><i class="fa-regular fa-trash-can" aria-hidden="true"></i></button>
                                }
                            }
                        </label>
                    }
                </div>
            }
        </fieldset>
        @if (confirmRemove != null)
        {
            <p class="jdk-remove-warning" role="alert"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Removing deletes this JDK from Sherpa's application data folder.</p>
        }
        <label class="jdk-folder-label" for="jdk-home">JDK home folder</label>
        <div class="jdk-folder-row">
            <input id="jdk-home" class="mono" value="@path" @oninput="OnPathInput" placeholder="Absolute path to the JDK home" />
            <button type="button" class="btn btn-secondary btn-sm" @onclick="BrowseAsync">Browse...</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <p class="error-message" role="alert">@error</p>
    }
    <div class="jdk-footer">
        <p>Only Sherpa uses this selection. Shell settings, Android Studio, and project settings stay unchanged. Updates are offered, never installed automatically.</p>
    </div>
</div>

<style>
    .jdk-dialog { padding: 14px 24px 22px; color: var(--text-primary); font-size: 13px; }
    .jdk-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .jdk-refresh { display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 32px; padding: 0 10px; flex: none; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--text-secondary); font: inherit; font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap; }
    .jdk-refresh:hover:not(:disabled) { background: var(--surface-well); color: var(--text-primary); }
    .jdk-mode { display: inline-flex; gap: 2px; padding: 3px; border-radius: var(--radius-md); background: var(--surface-well); }
    .jdk-mode button { padding: 5px 14px; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--text-secondary); font: inherit; font-size: 12px; cursor: pointer; }
    .jdk-mode button.selected { background: var(--surface-control); color: var(--text-primary); }
    .jdk-dialog button:disabled { opacity: .55; cursor: default; }
    .jdk-help { color: var(--text-secondary); line-height: 1.5; margin: 12px 0 18px; }
    .jdk-options { border: 0; padding: 0; margin: 0; min-width: 0; }
    .jdk-options legend, .jdk-folder-label { font-weight: 600; margin-bottom: 8px; }
    .jdk-option-list { overflow: hidden; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
    .jdk-option { display: flex; align-items: center; gap: 12px; padding: 12px; background: var(--surface-well); cursor: pointer; }
    .jdk-option + .jdk-option { border-top: 1px solid var(--border-hairline); }
    .jdk-option:hover { background: var(--surface-card-hover); }
    .jdk-option.selected { background: var(--accent-soft); }
    .jdk-option input { appearance: auto; accent-color: var(--accent); flex: none; }
    .jdk-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4px; }
    .jdk-copy > span { font-size: 11.5px; color: var(--text-secondary); overflow-wrap: anywhere; }
    .jdk-status { font-size: 11.5px; color: var(--text-primary); text-align: right; }
    .jdk-status.is-muted { color: var(--text-muted); }
    .jdk-row-icon { display: grid; place-items: center; flex: none; width: 26px; height: 26px; padding: 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--text-muted); font-size: 12px; cursor: pointer; }
    .jdk-row-icon:hover:not(:disabled) { background: var(--status-error-bg); color: var(--status-error-fg); }
    .jdk-row-confirm { display: flex; flex: none; gap: 6px; }
    .jdk-row-btn { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 10px; border: 1px solid var(--border-control); border-radius: var(--radius-sm); background: var(--surface-control); color: var(--text-primary); font: inherit; font-size: 12px; font-weight: 500; cursor: pointer; }
    .jdk-row-btn.is-danger { border-color: transparent; background: var(--status-error-fg); color: var(--status-error-ink); }
    .jdk-row-btn.is-danger:hover:not(:disabled) { background: color-mix(in srgb, var(--status-error-fg) 84%, var(--surface-control)); }
    .jdk-remove-warning { display: flex; align-items: baseline; gap: 7px; margin: 10px 2px 0; color: var(--status-warning-fg); font-size: 11.5px; line-height: 1.45; }
    .jdk-folder-label { display: block; margin-top: 20px; }
    .jdk-folder-row { display: flex; gap: 8px; }
    .jdk-folder-row input { flex: 1; min-width: 0; border: 1px solid var(--border-control); border-radius: var(--radius-sm); background: var(--surface-control); color: var(--text-primary); padding: 5px 8px; font-size: 12px; }
    .jdk-footer { margin-top: 18px; }
    .jdk-footer p { margin: 0; color: var(--text-secondary); font-size: 11.5px; line-height: 1.5; }
    .jdk-dialog :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    @@media (max-width: 540px) { .jdk-status { max-width: 100px; } .jdk-header, .jdk-mode, .jdk-folder-row { flex-wrap: wrap; } }
</style>

@code {
    private HybridFormBridge? bridge;
    private IReadOnlyList<OpenJdkRelease> releases = [];
    private IReadOnlyList<OpenJdkInstallation> installations = [];
    private readonly CancellationTokenSource lifetime = new();
    private bool install, loading, removing;
    private string? confirmRemove;
    private int major = OpenJdkService.RecommendedMajorVersion;
    private string path = "";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        bridge = BridgeHolder.Current ?? throw new InvalidOperationException("OpenJDK dialog bridge is unavailable.");
        install = bridge.Parameters.TryGetValue("Install", out var value) && value is true;
        if (bridge.Parameters.TryGetValue("MajorVersion", out var preferred) && preferred is int version) major = version;
        bridge.PreventSubmitClose = true;
        bridge.SubmitRequested += SubmitAsync;
        path = await Settings.GetEffectiveJdkPathAsync() ?? "";
        await LoadAsync();
    }
    private async Task SetModeAsync(bool value) { install = value; await LoadAsync(); }
    private async Task LoadAsync(bool force = false)
    {
        loading = true;
        error = null;
        Validate();
        try
        {
            if (force)
            {
                await Jdks.GetReleasesAsync(true, lifetime.Token);
                await Jdks.CheckForUpdatesAsync(lifetime.Token);
            }
            if (install) releases = await Jdks.GetReleasesAsync(force, lifetime.Token);
            else installations = await Jdks.GetInstallationsAsync(lifetime.Token);
            if (install && !releases.Any(r => r.MajorVersion == major)) major = releases.First().MajorVersion;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
        catch (Exception ex) { error = ex.Message; Logger.LogError("Could not load OpenJDK choices.", ex); }
        finally { loading = false; }
        if (error == null) Validate();
        else bridge?.SetActionState(false);
    }
    private async Task RemoveAsync(string jdkPath)
    {
        removing = true;
        error = null;
        try
        {
            await Jdks.UninstallAsync(jdkPath, lifetime.Token);
            confirmRemove = null;
            if (path == jdkPath) path = await Settings.GetEffectiveJdkPathAsync() ?? "";
            installations = await Jdks.GetInstallationsAsync(lifetime.Token);
            Validate();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { error = ex.Message; Logger.LogError($"Could not remove OpenJDK at {jdkPath}.", ex); }
        finally { removing = false; }
    }
    private void SelectMajor(int value) { major = value; Validate(); }
    private void SelectPath(string value) { path = value; Validate(); }
    private void OnPathInput(ChangeEventArgs args) => SelectPath(args.Value?.ToString() ?? "");
    private void Validate()
    {
        error = null;
        try
        {
            if (loading) return;
            if (install)
            {
                if (!releases.Any(r => r.MajorVersion == major)) throw new InvalidOperationException("Refresh to load Microsoft's available releases.");
            }
            else if (MauiSherpa.Core.Screenshots.ScreenshotMode.Current.IsEnabled)
            {
                if (!installations.Any(i => i.Path == path)) throw new InvalidOperationException("Choose a fixture JDK.");
            }
            else OpenJdkService.Inspect(path);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        { error = ex.Message; }
        finally { bridge?.SetActionState(!loading && error == null, actionText: install ? $"Install OpenJDK {major}" : "Use This JDK"); }
    }
    private async Task BrowseAsync()
    {
        try { if (await Dialogs.PickFolderAsync("Choose JDK home folder") is { Length: > 0 } selected) SelectPath(selected); }
        catch (Exception ex) { error = ex.Message; Logger.LogError("Could not choose JDK folder.", ex); }
    }
    private Task SubmitAsync()
    {
        Validate();
        if (!loading && error == null)
        {
            bridge!.Result = install ? new OpenJdkSelection(null, major) : new OpenJdkSelection(path, null);
            bridge.RequestClose();
        }
        return Task.CompletedTask;
    }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); if (bridge != null) bridge.SubmitRequested -= SubmitAsync; }
}
