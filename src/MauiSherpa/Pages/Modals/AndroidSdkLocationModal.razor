@page "/modal/android-sdk-location"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Pages.Forms
@inject HybridFormBridgeHolder BridgeHolder
@inject IAndroidSdkSettingsService Settings
@inject IAndroidSdkService Sdk
@inject IDialogService Dialogs
@inject ILoggingService Logger
@implements IDisposable

<div class="sdk-location-dialog sherpa-form">
    <SherpaSegmentedControl TValue="bool"
                            Value="@install"
                            ValueChanged="@(value => SetMode(value == true))"
                            Options="ModeOptions"
                            AriaLabel="SDK action"
                            Class="sherpa-segmented-full" />
    <p class="sdk-location-help">@(install ? "Install Android command-line tools in a new location." : "Choose which Android SDK Sherpa uses for packages, devices, and emulators, or remove ones you no longer need.")</p>
    @if (loading)
    {
        <SherpaListSkeleton Rows="4" Label="Checking SDK locations..." />
    }
    else
    {
        @if (!install)
        {
        <div class="sherpa-field">
        <span class="sherpa-field-label" id="sdk-locations-label">SDK locations</span>
        <div class="sdk-location-list sherpa-list" role="radiogroup" aria-labelledby="sdk-locations-label">
            @foreach (var location in locations)
            {
                <label class="sdk-location-option sherpa-list-row sherpa-list-row-interactive @(selected == location.Path ? "selected" : "")">
                    <span class="sdk-location-glyph" aria-hidden="true"><i class="fa-solid @(location.Status == AndroidSdkLocationStatus.Installed ? "fa-box-open" : "fa-folder")"></i></span>
                    <span class="sdk-location-copy">
                        <strong>@location.Label</strong>
                        <span class="mono text-selectable">@location.Path</span>
                    </span>
                    @if (confirmDelete == location.Path)
                    {
                        <span class="sdk-row-confirm">
                            <button type="button" class="btn btn-secondary btn-sm sdk-row-btn" disabled="@deleting" @onclick="CancelDelete" @onclick:preventDefault @onclick:stopPropagation>Cancel</button>
                            <button type="button" class="btn btn-ghost-danger btn-sm sdk-row-btn is-danger" disabled="@deleting" @onclick="() => DeleteAsync(location.Path)" @onclick:preventDefault @onclick:stopPropagation>
                                @if (deleting) { <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> <span>Deleting...</span> } else { <span>Delete</span> }
                            </button>
                        </span>
                    }
                    else
                    {
                        <span class="sdk-location-status @(location.IsActive ? "is-active" : "")">@Status(location)</span>
                        @if (CanDelete(location))
                        {
                            <button type="button" class="sdk-row-icon" title="Delete this SDK" aria-label="Delete @location.Label" disabled="@(deleting || Sdk.IsBusy)" @onclick="() => AskDelete(location.Path)" @onclick:preventDefault @onclick:stopPropagation><i class="fa-regular fa-trash-can" aria-hidden="true"></i></button>
                        }
                    }
                    <input type="radio" name="sdk-location" checked="@(selected == location.Path)" @onchange="() => Select(location.Path)" aria-label="Select @location.Label" />
                </label>
            }
        </div>
        </div>
        @if (confirmDelete != null)
        {
            <p class="sdk-delete-warning" role="alert"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Deleting removes this folder and everything in it. Android Studio or other tools may also use this SDK.</p>
        }
        }
        else
        {
            <div class="sdk-install-location sherpa-field">
                <label class="sherpa-field-label" for="sdk-common-location">Install location</label>
                <SherpaSelect TValue="string"
                              Id="sdk-common-location"
                              Value="@PresetPath"
                              ValueChanged="OnPresetChanged"
                              Options="LocationOptions"
                              AriaLabel="Install location"
                              Class="sherpa-select-full" />
            </div>
        }
        <div class="sdk-custom-path sherpa-field">
            <label class="sherpa-field-label" for="sdk-custom-folder">@(install ? "Target folder" : "Use another location")</label>
            <div class="sdk-custom-row sherpa-input-group">
                <input id="sdk-custom-folder" class="mono" value="@selected" @oninput="OnPathInput" placeholder="Enter an absolute folder path" />
                <button type="button" class="sdk-browse sherpa-input-group-btn" @onclick="BrowseAsync"><i class="fa-solid fa-folder-open" aria-hidden="true"></i> Browse...</button>
            </div>
        </div>
        @if (install)
        {
            <label class="sdk-activate"><input type="checkbox" @bind="activate" /> Use this SDK after installation</label>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error-message" role="alert">@error</p>
        }
        <p class="sdk-footnote"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Only Sherpa uses this selection. Android Studio and project settings stay unchanged.</p>
    }
</div>

<style>
    .sdk-location-dialog { --sdk-accent: var(--accent); --sdk-accent-ink: var(--accent); color: var(--text-primary); font-size: 13px; }
    .theme-dark .sdk-location-dialog { --sdk-accent-ink: var(--accent); }
    .sdk-location-dialog button { font-family: inherit; line-height: 1.2; }
    .sdk-location-help { color: var(--text-secondary); line-height: 1.4; margin: -4px 0 2px; }
    .sdk-location-list { padding: 0; margin: 0; min-width: 0; max-height: 300px; overflow-y: auto; overscroll-behavior: contain; }
    .sdk-location-option { cursor: pointer; }
    .sdk-location-glyph { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: var(--radius-md); background: var(--surface-well); color: var(--text-secondary); font-size: 15px; }
    .sdk-location-option.selected .sdk-location-glyph { background: color-mix(in srgb, var(--sdk-accent) 16%, transparent); color: var(--sdk-accent-ink); }
    .sdk-location-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3px; }
    .sdk-location-copy strong { font-size: 13px; font-weight: 600; }
    .sdk-location-copy .mono { overflow-wrap: anywhere; color: var(--text-secondary); font-size: 11.5px; }
    .sdk-location-status { flex: none; font-size: 11.5px; color: var(--text-secondary); white-space: nowrap; }
    .sdk-location-status.is-active { color: var(--sdk-accent-ink); }
    .sdk-location-option input[type=radio] { appearance: auto; flex: none; width: 14px; height: 14px; margin: 0; accent-color: var(--sdk-accent); }
    .sdk-row-icon { display: grid; place-items: center; flex: none; width: 26px; height: 26px; padding: 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--text-muted); font-size: 12px; cursor: pointer; }
    .sdk-row-icon:hover:not(:disabled) { background: color-mix(in srgb, var(--accent-danger) 12%, transparent); color: var(--accent-danger); }
    .sdk-row-icon:disabled { opacity: .4; cursor: default; }
    .sdk-row-confirm { display: flex; flex: none; gap: 6px; }
    .sdk-row-btn { min-height: var(--control-height-sm); }
    .sdk-row-btn:disabled { opacity: .6; cursor: default; }
    .sdk-delete-warning { display: flex; align-items: baseline; gap: 7px; margin: 10px 2px 0; color: var(--status-warning-text); font-size: 11.5px; line-height: 1.45; }
    .sdk-custom-row { display: flex; }
    .sdk-custom-row input { font-family: var(--font-mono); font-size: 12px; }
    .sdk-browse { white-space: nowrap; }
    .sdk-browse:hover { border-color: var(--text-muted); }
    .sdk-browse i { margin-right: 4px; font-size: 11px; }
    .sdk-activate { display: flex; align-items: center; gap: 8px; margin-top: 16px; font-size: 12px; }
    .sdk-footnote { display: flex; align-items: baseline; gap: 7px; color: var(--text-secondary); font-size: 11.5px; line-height: 1.45; margin: 18px 2px 0; }
    .sdk-footnote i { flex: none; }
    .sdk-location-dialog :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; box-shadow: 0 0 0 4px var(--accent-ring); }
    @@media (max-width: 540px) { .sdk-location-option { flex-wrap: wrap; } .sdk-location-status { margin-left: 44px; } .sdk-custom-row { flex-wrap: wrap; } }
</style>

@code {
    private HybridFormBridge? bridge;
    private IReadOnlyList<AndroidSdkLocation> locations = [];
    private AndroidSdkLocation? selection;
    private string selected = "";
    private string existingPath = "", installPath = "";
    private string PresetPath => locations.Any(l => l.Path == selected) ? selected : "";
    private IReadOnlyList<SherpaSelectOption<string>> LocationOptions =>
        locations
            .Select(location => new SherpaSelectOption<string>(
                location.Path,
                $"{location.Label} — {Status(location)}",
                location.Path,
                "fa-solid fa-folder"))
            .Append(new SherpaSelectOption<string>("", "Custom location", Icon: "fa-solid fa-pen"))
            .ToArray();
    private IReadOnlyList<SherpaSegmentOption<bool>> ModeOptions =>
    [
        new(false, "Installed", "fa-solid fa-box-open", Disabled: loading || deleting),
        new(true, "Install New", "fa-solid fa-download", Disabled: loading || deleting)
    ];
    private string? error;
    private bool install, activate = true, loading = true, deleting;
    private string? confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        bridge = BridgeHolder.Current;
        if (bridge == null) throw new InvalidOperationException("Android SDK dialog bridge is unavailable.");
        install = bridge.Parameters.TryGetValue("Install", out var value) && value is true;
        bridge.PreventSubmitClose = true;
        bridge.SubmitRequested += SubmitAsync;
        Sdk.BusyChanged += OnBusyChanged;
        try
        {
            locations = await Settings.GetKnownLocationsAsync();
            existingPath = (locations.FirstOrDefault(l => l.IsActive) ??
                locations.FirstOrDefault(l => l.Status == AndroidSdkLocationStatus.Installed))?.Path ?? "";
            installPath = (locations.FirstOrDefault(l => l.Status == AndroidSdkLocationStatus.NotInstalled) ??
                locations.FirstOrDefault())?.Path ?? "";
            selected = install ? installPath : existingPath;
        }
        catch (Exception ex) { error = ex.Message; Logger.LogError("Could not discover Android SDK locations.", ex); }
        loading = false;
        Validate();
    }

    private void SetMode(bool value)
    {
        if (value == install) return;
        install = value;
        selected = install ? installPath : existingPath;
        Validate();
    }
    private void Select(string path)
    {
        selected = path;
        if (install) installPath = path; else existingPath = path;
        Validate();
    }
    private void OnPresetChanged(string? value) => Select(value ?? "");
    private void OnPathInput(ChangeEventArgs args) => Select(args.Value?.ToString() ?? "");
    private void OnBusyChanged() => _ = InvokeAsync(() => { Validate(); StateHasChanged(); });
    private void Validate()
    {
        selection = null;
        error = null;
        try
        {
            if (loading) return;
            if (Sdk.IsBusy) throw new InvalidOperationException("Wait for the current Android SDK operation to finish.");
            selection = AndroidSdkLocations.Inspect(selected);
            if (install)
            {
                AndroidSdkLocations.ValidateInstallTarget(selected);
            }
            else if (selection.Status != AndroidSdkLocationStatus.Installed)
            {
                throw new InvalidOperationException("Choose a folder containing Android command-line tools, or install an SDK.");
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException or UnauthorizedAccessException)
        { error = ex.Message; }
        finally
        {
            bridge?.SetActionState(!loading && selection != null && error == null,
                actionText: install ? "Install SDK" : "Use This SDK");
        }
    }

    private async Task BrowseAsync()
    {
        try { if (await Dialogs.PickFolderAsync("Choose Android SDK folder") is { Length: > 0 } path) Select(path); }
        catch (Exception ex) { error = ex.Message; Logger.LogError("Could not choose SDK folder.", ex); }
    }
    private Task SubmitAsync()
    {
        Validate();
        if (error == null && selection != null)
        {
            bridge!.Result = new AndroidSdkSelection(selection.Path, install, activate);
            bridge.RequestClose();
        }
        return Task.CompletedTask;
    }
    private static bool CanDelete(AndroidSdkLocation l) => !l.IsActive && l.Status == AndroidSdkLocationStatus.Installed;
    private void AskDelete(string path) { confirmDelete = path; error = null; }
    private void CancelDelete() => confirmDelete = null;
    private async Task DeleteAsync(string path)
    {
        deleting = true;
        try
        {
            await Settings.DeleteLocationAsync(path);
            confirmDelete = null;
            locations = await Settings.GetKnownLocationsAsync();
            if (existingPath == path || selected == path)
            {
                existingPath = locations.FirstOrDefault(l => l.IsActive)?.Path ?? "";
                if (!install) selected = existingPath;
            }
            Validate();
        }
        catch (Exception ex) { error = ex.Message; Logger.LogError($"Could not delete Android SDK at {path}.", ex); }
        finally { deleting = false; }
    }
    private static string Status(AndroidSdkLocation l) => l.IsActive ? "Active" : l.Status switch
    {
        AndroidSdkLocationStatus.Installed => "SDK found",
        AndroidSdkLocationStatus.NotInstalled => "Not installed",
        AndroidSdkLocationStatus.Incomplete => "Incomplete",
        AndroidSdkLocationStatus.Inaccessible => "Cannot access",
        _ => "Other files"
    };
    public void Dispose() { Sdk.BusyChanged -= OnBusyChanged; if (bridge != null) bridge.SubmitRequested -= SubmitAsync; }
}
