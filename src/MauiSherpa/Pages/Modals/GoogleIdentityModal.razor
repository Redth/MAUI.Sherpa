@page "/modal/google-identity"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject IDialogService DialogService
@inject IFileSystemService FileSystem
@inject ILauncher AppLauncher

<div class="dialog-content">
    <div class="dialog-header">
        <h2><i class="fa-brands fa-google"></i> @(isEditing ? "Edit" : "Add") Google Identity</h2>
    </div>
    <div class="dialog-body sherpa-form sherpa-scroll">
        <div class="sherpa-field">
            <label class="sherpa-field-label">Name</label>
            <input type="text" class="sherpa-input" @bind="googleIdentityName" @bind:event="oninput" placeholder="My Firebase Project" />
            <div class="sherpa-field-help">A friendly name to identify this credential</div>
        </div>
        <div class="sherpa-field">
            <label class="sherpa-field-label">Service Account JSON</label>
            <SherpaSegmentedControl TValue="string"
                                    Value="@saJsonInputMode"
                                    ValueChanged="@((string? value) => saJsonInputMode = value ?? "file")"
                                    Options="ServiceAccountInputOptions"
                                    AriaLabel="Service account input mode"
                                    Class="sherpa-segmented-full" />
            @if (saJsonInputMode == "file")
            {
                <div class="sherpa-input-group">
                    <input type="text" value="@googleIdentitySaJsonPath" placeholder="Path to service account JSON file" readonly />
                    <button type="button" class="sherpa-input-group-btn" @onclick="BrowseServiceAccountJsonFile">
                        <i class="fa-solid fa-folder-open" aria-hidden="true"></i> Browse...
                    </button>
                </div>
            }
            else
            {
                <SherpaJsonEditor @bind-Value="googleIdentitySaJsonContent"
                                  @bind-Value:after="ParseServiceAccountJson"
                                  FileName="service-account.json"
                                  Schema="google-service-account"
                                  Rows="10"
                                  Placeholder='{"type": "service_account", "project_id": "...", ...}' />
            }
            <div class="sherpa-field-help">
                Download from <a href="https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk" target="_blank" @onclick='() => OpenUrl("https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk")' @onclick:preventDefault>Firebase Console → Project Settings → Service Accounts</a> → Generate New Private Key
            </div>
        </div>
        @if (!string.IsNullOrEmpty(googleIdentitySaJsonContent))
        {
            @if (!string.IsNullOrEmpty(parsedProjectId))
            {
                <div class="identity-status">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <span>Service account loaded — Project: <strong>@parsedProjectId</strong>, Email: <strong>@parsedClientEmail</strong></span>
                </div>
            }
            else
            {
                <div class="sherpa-field-error">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    Invalid service account JSON format
                </div>
            }
        }
    </div>
    <div class="dialog-footer">
        <button class="btn btn-secondary" @onclick="Cancel">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i> Cancel
        </button>
        <button class="btn btn-primary" @onclick="Save"
                disabled="@(!CanSave)">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save
        </button>
    </div>
</div>

@code {
    private bool isEditing;
    private string editingId = "";
    private string googleIdentityName = "";
    private string googleIdentitySaJsonPath = "";
    private string googleIdentitySaJsonContent = "";
    private string saJsonInputMode = "file";
    private string parsedProjectId = "";
    private string parsedClientEmail = "";
    private static readonly IReadOnlyList<SherpaSegmentOption<string>> ServiceAccountInputOptions =
    [
        new("file", "File", "fa-solid fa-folder-open"),
        new("text", "Text", "fa-solid fa-file-lines")
    ];

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(googleIdentityName) &&
        !string.IsNullOrWhiteSpace(googleIdentitySaJsonContent) &&
        !string.IsNullOrEmpty(parsedProjectId);

    protected override void OnInitialized()
    {
        var identity = ModalParams.Get<GoogleIdentity>("Identity");
        if (identity != null)
        {
            isEditing = true;
            editingId = identity.Id;
            googleIdentityName = identity.Name;
            googleIdentitySaJsonPath = identity.ServiceAccountJsonPath ?? "";
            googleIdentitySaJsonContent = identity.ServiceAccountJson ?? "";
            saJsonInputMode = string.IsNullOrEmpty(identity.ServiceAccountJsonPath) && !string.IsNullOrEmpty(identity.ServiceAccountJson) ? "text" : "file";
            ParseServiceAccountJson();
        }
    }

    private void Cancel() => ModalParams.Cancel();

    private async Task OpenUrl(string url)
    {
        await AppLauncher.OpenAsync(new Uri(url));
    }

    private void Save()
    {
        ParseServiceAccountJson();
        var id = isEditing ? editingId : Guid.NewGuid().ToString();
        var identity = new GoogleIdentity(
            Id: id,
            Name: googleIdentityName.Trim(),
            ProjectId: parsedProjectId,
            ClientEmail: parsedClientEmail,
            ServiceAccountJsonPath: string.IsNullOrEmpty(googleIdentitySaJsonPath) ? null : googleIdentitySaJsonPath,
            ServiceAccountJson: googleIdentitySaJsonContent);
        ModalParams.Complete(identity);
    }

    private async Task BrowseServiceAccountJsonFile()
    {
        var path = await DialogService.ShowFileDialogAsync(
            "Select Service Account JSON File",
            isSave: false,
            filters: new[] { "*.json" });

        if (!string.IsNullOrEmpty(path))
        {
            googleIdentitySaJsonPath = path;
            googleIdentitySaJsonContent = await FileSystem.ReadFileAsync(path) ?? "";
            ParseServiceAccountJson();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ParseServiceAccountJson()
    {
        var (projectId, clientEmail) = GoogleIdentityService.ParseServiceAccountJson(googleIdentitySaJsonContent);
        parsedProjectId = projectId ?? "";
        parsedClientEmail = clientEmail ?? "";

        if (string.IsNullOrEmpty(googleIdentityName) && !string.IsNullOrEmpty(parsedProjectId))
        {
            googleIdentityName = parsedProjectId;
        }
    }
}

<style>
    .dialog-content { display: flex; flex-direction: column; width: 100%; height: 100%; }
    .dialog-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border-subtle); }
    .dialog-header h2 { margin: 0; font-size: 18px; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }
    .dialog-body { flex: 1; min-height: 0; }
    .dialog-footer { padding: 16px 24px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; gap: 12px; }
    .sherpa-field-help a { color: var(--accent); }
    .identity-status { display: inline-flex; align-items: center; gap: 6px; color: var(--status-success-fg); font-size: var(--font-size-xs); }
</style>
