@page "/modal/create-keystore"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Pages.Forms
@inject HybridFormBridgeHolder BridgeHolder
@inject IDialogService DialogService
@implements IDisposable

@if (bridge != null)
{
    <div class="sherpa-form">
        <div class="sherpa-form-grid-2">
            <div class="sherpa-field">
                <label class="sherpa-field-label" for="keystore-alias">Key Alias</label>
                <input id="keystore-alias"
                       type="text"
                       class="sherpa-input mono"
                       value="@alias"
                       @oninput="OnAliasChanged"
                       placeholder="mykey"
                       autocomplete="off"
                       spellcheck="false" />
            </div>
            <div class="sherpa-field">
                <label class="sherpa-field-label">Key Algorithm</label>
                <SherpaSegmentedControl TValue="string"
                                        Value="@keyAlgorithm"
                                        ValueChanged="OnAlgorithmChanged"
                                        Options="AlgorithmOptions"
                                        AriaLabel="Key algorithm"
                                        Class="sherpa-segmented-full" />
            </div>
        </div>

        <div class="sherpa-field">
            <div class="sherpa-field-header">
                <label class="sherpa-field-label" for="keystore-password">Keystore Password</label>
                <button type="button" class="sherpa-field-link" @onclick="GeneratePassword">
                    <i class="fa-solid fa-wand-magic-sparkles fa-fw" aria-hidden="true"></i>
                    Generate strong
                </button>
            </div>
            <div class="sherpa-input-group">
                <input id="keystore-password"
                       type="@(showKeystorePassword ? "text" : "password")"
                       class="mono"
                       value="@keystorePassword"
                       @oninput="OnKeystorePasswordChanged"
                       placeholder="Minimum 6 characters"
                       autocomplete="new-password" />
                <button type="button"
                        class="sherpa-input-group-btn"
                        title="@(showKeystorePassword ? "Hide password" : "Show password")"
                        aria-label="@(showKeystorePassword ? "Hide keystore password" : "Show keystore password")"
                        @onclick="ToggleKeystorePasswordVisibility">
                    <i class="fa-solid @(showKeystorePassword ? "fa-eye-slash" : "fa-eye") fa-fw" aria-hidden="true"></i>
                </button>
                <button type="button"
                        class="sherpa-input-group-btn"
                        title="Copy password"
                        aria-label="Copy keystore password"
                        disabled="@string.IsNullOrEmpty(keystorePassword)"
                        @onclick="() => CopyPasswordAsync(keystorePassword)">
                    <i class="fa-regular fa-copy fa-fw" aria-hidden="true"></i>
                </button>
            </div>
            <span class="@(HasShortKeystorePassword ? "sherpa-field-error" : "sherpa-field-help")">
                @if (HasShortKeystorePassword)
                {
                    <i class="fa-solid fa-circle-exclamation fa-fw" aria-hidden="true"></i>
                }
                Minimum 6 characters
            </span>
        </div>

        <div class="sherpa-field">
            <div class="sherpa-field-header">
                <span class="sherpa-field-label">Key Password</span>
                <label class="sherpa-checkbox-row">
                    <input type="checkbox"
                           checked="@useSamePassword"
                           @onchange="OnUseSamePasswordChanged" />
                    <span>Use same password for key</span>
                </label>
            </div>
            @if (!useSamePassword)
            {
                <div class="sherpa-input-group">
                    <input type="@(showKeyPassword ? "text" : "password")"
                           class="mono"
                           value="@keyPassword"
                           @oninput="OnKeyPasswordChanged"
                           placeholder="Minimum 6 characters"
                           autocomplete="new-password"
                           aria-label="Key password" />
                    <button type="button"
                            class="sherpa-input-group-btn"
                            title="@(showKeyPassword ? "Hide password" : "Show password")"
                            aria-label="@(showKeyPassword ? "Hide key password" : "Show key password")"
                            @onclick="ToggleKeyPasswordVisibility">
                        <i class="fa-solid @(showKeyPassword ? "fa-eye-slash" : "fa-eye") fa-fw" aria-hidden="true"></i>
                    </button>
                    <button type="button"
                            class="sherpa-input-group-btn"
                            title="Copy password"
                            aria-label="Copy key password"
                            disabled="@string.IsNullOrEmpty(keyPassword)"
                            @onclick="() => CopyPasswordAsync(keyPassword)">
                        <i class="fa-regular fa-copy fa-fw" aria-hidden="true"></i>
                    </button>
                </div>
                <span class="@(HasShortKeyPassword ? "sherpa-field-error" : "sherpa-field-help")">
                    @if (HasShortKeyPassword)
                    {
                        <i class="fa-solid fa-circle-exclamation fa-fw" aria-hidden="true"></i>
                    }
                    Minimum 6 characters
                </span>
            }
        </div>

        <div class="sherpa-disclosure @(certificateExpanded ? "open" : null)">
            <button type="button"
                    class="sherpa-disclosure-head"
                    aria-expanded="@certificateExpanded.ToString().ToLowerInvariant()"
                    @onclick="ToggleCertificate">
                <span class="sherpa-disclosure-lead">
                    <i class="fa-solid fa-chevron-right fa-fw sherpa-disclosure-chev" aria-hidden="true"></i>
                    <i class="fa-solid fa-id-card fa-fw" aria-hidden="true"></i>
                    <span>Certificate Subject (DN)</span>
                </span>
                <span class="sherpa-badge @(HasCertificateSubject ? "sherpa-badge-accent" : "sherpa-badge-neutral")">
                    @(HasCertificateSubject ? "Filled" : "Optional")
                </span>
            </button>
            @if (certificateExpanded)
            {
                <div class="sherpa-disclosure-body">
                    <div class="sherpa-form-grid-2">
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="cert-cn">Common Name (CN)</label>
                            <input id="cert-cn" type="text" class="sherpa-input" value="@cn"
                                   @oninput="(ChangeEventArgs args) => SetText(args, value => cn = value)" placeholder="Your Name" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="cert-org">Organization (O)</label>
                            <input id="cert-org" type="text" class="sherpa-input" value="@organization"
                                   @oninput="(ChangeEventArgs args) => SetText(args, value => organization = value)" placeholder="Company" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="cert-ou">Org Unit (OU)</label>
                            <input id="cert-ou" type="text" class="sherpa-input" value="@ou"
                                   @oninput="(ChangeEventArgs args) => SetText(args, value => ou = value)" placeholder="Development" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="cert-city">City (L)</label>
                            <input id="cert-city" type="text" class="sherpa-input" value="@city"
                                   @oninput="(ChangeEventArgs args) => SetText(args, value => city = value)" placeholder="City" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="cert-state">State (ST)</label>
                            <input id="cert-state" type="text" class="sherpa-input" value="@state"
                                   @oninput="(ChangeEventArgs args) => SetText(args, value => state = value)" placeholder="State" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="cert-country">Country (C)</label>
                            <input id="cert-country" type="text" class="sherpa-input mono" value="@country"
                                   @oninput="(ChangeEventArgs args) => SetText(args, value => country = value)" placeholder="US"
                                   maxlength="2" autocomplete="country" />
                            <span class="sherpa-field-help">2-letter code</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="sherpa-disclosure @(keySettingsExpanded ? "open" : null)">
            <button type="button"
                    class="sherpa-disclosure-head"
                    aria-expanded="@keySettingsExpanded.ToString().ToLowerInvariant()"
                    @onclick="ToggleKeySettings">
                <span class="sherpa-disclosure-lead">
                    <i class="fa-solid fa-chevron-right fa-fw sherpa-disclosure-chev" aria-hidden="true"></i>
                    <i class="fa-solid fa-key fa-fw" aria-hidden="true"></i>
                    <span>Key Settings</span>
                </span>
                <span class="sherpa-badge sherpa-badge-neutral">@KeySettingsBadge</span>
            </button>
            @if (keySettingsExpanded)
            {
                <div class="sherpa-disclosure-body">
                    <div class="sherpa-form-grid-2">
                        <div class="sherpa-field">
                            <label class="sherpa-field-label">Key Size</label>
                            <SherpaSegmentedControl TValue="int"
                                                    Value="@keySize"
                                                    ValueChanged="OnKeySizeChanged"
                                                    Options="KeySizeOptions"
                                                    AriaLabel="Key size"
                                                    Class="sherpa-segmented-full" />
                        </div>
                        <div class="sherpa-field">
                            <label class="sherpa-field-label" for="validity-days">Validity Days</label>
                            <input id="validity-days"
                                   type="number"
                                   class="sherpa-input mono"
                                   value="@validityDaysText"
                                   @oninput="OnValidityChanged"
                                   min="1"
                                   step="1"
                                   inputmode="numeric" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private HybridFormBridge? bridge;
    private string alias = "";
    private string keystorePassword = "";
    private string keyPassword = "";
    private bool useSamePassword = true;
    private bool showKeystorePassword;
    private bool showKeyPassword;
    private string cn = "";
    private string ou = "";
    private string organization = "";
    private string city = "";
    private string state = "";
    private string country = "";
    private string validityDaysText = "10000";
    private string keyAlgorithm = "RSA";
    private int keySize = 2048;
    private bool certificateExpanded;
    private bool keySettingsExpanded;

    private static readonly IReadOnlyList<SherpaSegmentOption<string>> AlgorithmOptions =
    [
        new("RSA", "RSA"),
        new("EC", "EC"),
        new("DSA", "DSA")
    ];

    private static readonly IReadOnlyList<SherpaSegmentOption<int>> KeySizeOptions =
    [
        new(2048, "2048"),
        new(3072, "3072"),
        new(4096, "4096")
    ];

    private string EffectiveKeyPassword => useSamePassword ? keystorePassword : keyPassword;
    private bool HasShortKeystorePassword => keystorePassword.Length > 0 && keystorePassword.Length < 6;
    private bool HasShortKeyPassword => !useSamePassword && keyPassword.Length > 0 && keyPassword.Length < 6;
    private bool HasCertificateSubject =>
        !string.IsNullOrWhiteSpace(cn) ||
        !string.IsNullOrWhiteSpace(ou) ||
        !string.IsNullOrWhiteSpace(organization) ||
        !string.IsNullOrWhiteSpace(city) ||
        !string.IsNullOrWhiteSpace(state) ||
        !string.IsNullOrWhiteSpace(country);
    private int ValidityDays =>
        int.TryParse(validityDaysText, out var value) && value > 0 ? value : 10000;
    private string KeySettingsBadge => $"{keyAlgorithm} · {keySize} · {ValidityDays}d";
    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(alias) &&
        keystorePassword.Length >= 6 &&
        EffectiveKeyPassword.Length >= 6;

    protected override void OnInitialized()
    {
        bridge = BridgeHolder.Current;
        if (bridge == null)
            return;

        bridge.SubmitRequested += OnSubmitRequested;
        UpdateValidity();
    }

    private void OnAliasChanged(ChangeEventArgs args)
    {
        alias = args.Value?.ToString() ?? "";
        UpdateValidity();
    }

    private void OnKeystorePasswordChanged(ChangeEventArgs args)
    {
        keystorePassword = args.Value?.ToString() ?? "";
        UpdateValidity();
    }

    private void OnKeyPasswordChanged(ChangeEventArgs args)
    {
        keyPassword = args.Value?.ToString() ?? "";
        UpdateValidity();
    }

    private void OnUseSamePasswordChanged(ChangeEventArgs args)
    {
        useSamePassword = args.Value is true;
        if (!useSamePassword && string.IsNullOrEmpty(keyPassword))
            keyPassword = keystorePassword;
        UpdateValidity();
    }

    private void OnAlgorithmChanged(string? value)
    {
        keyAlgorithm = value ?? "RSA";
        UpdateValidity();
    }

    private void OnKeySizeChanged(int value)
    {
        keySize = value;
        UpdateValidity();
    }

    private void OnValidityChanged(ChangeEventArgs args)
    {
        validityDaysText = args.Value?.ToString() ?? "";
        UpdateValidity();
    }

    private void SetText(ChangeEventArgs args, Action<string> setter)
    {
        setter(args.Value?.ToString() ?? "");
        UpdateValidity();
    }

    private void GeneratePassword()
    {
        const string alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%";
        var bytes = System.Security.Cryptography.RandomNumberGenerator.GetBytes(20);
        var characters = new char[bytes.Length];
        for (var index = 0; index < bytes.Length; index++)
            characters[index] = alphabet[bytes[index] % alphabet.Length];

        keystorePassword = new string(characters);
        if (useSamePassword)
            keyPassword = "";
        showKeystorePassword = true;
        UpdateValidity();
    }

    private Task CopyPasswordAsync(string password) =>
        DialogService.CopyToClipboardAsync(password);

    private void ToggleKeystorePasswordVisibility() =>
        showKeystorePassword = !showKeystorePassword;

    private void ToggleKeyPasswordVisibility() =>
        showKeyPassword = !showKeyPassword;

    private void ToggleCertificate() =>
        certificateExpanded = !certificateExpanded;

    private void ToggleKeySettings() =>
        keySettingsExpanded = !keySettingsExpanded;

    private void UpdateValidity() => bridge?.SetValid(CanSubmit);

    private Task OnSubmitRequested()
    {
        if (bridge == null)
            return Task.CompletedTask;

        bridge.Result = new KeystoreCreateResult(
            Alias: alias.Trim(),
            KeystorePassword: keystorePassword,
            KeyPassword: EffectiveKeyPassword,
            CN: cn.Trim(),
            OU: ou.Trim(),
            Organization: organization.Trim(),
            City: city.Trim(),
            State: state.Trim(),
            Country: country.Trim(),
            ValidityDays: ValidityDays,
            KeyAlgorithm: keyAlgorithm,
            KeySize: keySize);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        if (bridge != null)
            bridge.SubmitRequested -= OnSubmitRequested;
    }
}

<style>
    .sherpa-checkbox-row {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        color: var(--text-primary);
        font-size: var(--font-size-sm);
        font-weight: 500;
        cursor: pointer;
    }
</style>
