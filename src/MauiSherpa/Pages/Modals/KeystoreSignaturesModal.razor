@page "/modal/keystore-signatures"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Services
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject IKeystoreService KeystoreService
@inject IAlertService AlertService
@inject IJSRuntime JS
@inject BlazorToastService ToastService

<div class="form-content">
    @if (sigLoading)
        {
            <div class="loading-card sherpa-card"><i class="fa-solid fa-spinner fa-spin"></i> Computing signatures...</div>
        }
        else if (sigError != null)
        {
            <div class="alert alert-danger sherpa-banner sherpa-banner-danger">@sigError</div>
            <div class="form-group sherpa-field">
                <label class="sherpa-field-label">Keystore Password</label>
                <input type="password" class="sherpa-input" @bind="password" @bind:event="oninput" />
                <button class="btn btn-primary btn-sm mt-2" @onclick="RetrySignatures">Retry</button>
            </div>
        }
        else if (signatures != null)
        {
            <table class="sig-table">
                <thead>
                    <tr>
                        <th>Format</th>
                        <th>Value</th>
                        <th>Used By</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (signatures.SHA1Hex != null)
                    {
                        <tr>
                            <td><strong>SHA-1</strong> <span class="badge sherpa-badge sherpa-badge-neutral">Hex</span></td>
                            <td class="mono text-selectable"><span class="mono-value">@signatures.SHA1Hex</span></td>
                            <td><span class="service-tag google sherpa-badge"><i class="fa-brands fa-google-play"></i>Google Play</span> <span class="service-tag firebase sherpa-badge"><i class="fa-solid fa-fire"></i>Firebase</span></td>
                            <td><button class="btn-copy" @onclick="@(() => CopyToClipboard(signatures.SHA1Hex))"><i class="fa-solid fa-copy"></i></button></td>
                        </tr>
                    }
                    @if (signatures.SHA256Hex != null)
                    {
                        <tr>
                            <td><strong>SHA-256</strong> <span class="badge sherpa-badge sherpa-badge-neutral">Hex</span></td>
                            <td class="mono text-selectable"><span class="mono-value">@signatures.SHA256Hex</span></td>
                            <td><span class="service-tag google sherpa-badge"><i class="fa-brands fa-google-play"></i>Google Play</span> <span class="service-tag firebase sherpa-badge"><i class="fa-solid fa-fire"></i>Firebase</span></td>
                            <td><button class="btn-copy" @onclick="@(() => CopyToClipboard(signatures.SHA256Hex))"><i class="fa-solid fa-copy"></i></button></td>
                        </tr>
                    }
                    @if (signatures.SHA1Base64 != null)
                    {
                        <tr>
                            <td><strong>SHA-1</strong> <span class="badge sherpa-badge sherpa-badge-neutral">Base64</span></td>
                            <td class="mono text-selectable"><span class="mono-value">@signatures.SHA1Base64</span></td>
                            <td><span class="service-tag facebook sherpa-badge"><i class="fa-brands fa-facebook"></i>Facebook SDK</span></td>
                            <td><button class="btn-copy" @onclick="@(() => CopyToClipboard(signatures.SHA1Base64))"><i class="fa-solid fa-copy"></i></button></td>
                        </tr>
                    }
                    @if (signatures.SHA256Base64 != null)
                    {
                        <tr>
                            <td><strong>SHA-256</strong> <span class="badge sherpa-badge sherpa-badge-neutral">Base64</span></td>
                            <td class="mono text-selectable"><span class="mono-value">@signatures.SHA256Base64</span></td>
                            <td><span class="service-tag sherpa-badge sherpa-badge-neutral"><i class="fa-solid fa-plug"></i>Other</span></td>
                            <td><button class="btn-copy" @onclick="@(() => CopyToClipboard(signatures.SHA256Base64))"><i class="fa-solid fa-copy"></i></button></td>
                        </tr>
                    }
                    @if (signatures.MD5Hex != null)
                    {
                        <tr>
                            <td><strong>MD5</strong> <span class="badge sherpa-badge sherpa-badge-neutral">Hex</span></td>
                            <td class="mono text-selectable"><span class="mono-value">@signatures.MD5Hex</span></td>
                            <td><span class="service-tag muted sherpa-badge"><i class="fa-solid fa-history"></i>Legacy</span></td>
                            <td><button class="btn-copy" @onclick="@(() => CopyToClipboard(signatures.MD5Hex))"><i class="fa-solid fa-copy"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

@code {
    private string alias = "";
    private string password = "";
    private string keystoreId = "";
    private bool sigLoading;
    private string? sigError;
    private KeystoreSignatureInfo? signatures;

    protected override async Task OnInitializedAsync()
    {
        alias = ModalParams.Get<string>("Alias") ?? "";
        keystoreId = ModalParams.Get<string>("KeystoreId") ?? "";

        var storedPwd = await KeystoreService.GetKeystorePasswordAsync(keystoreId);
        if (!string.IsNullOrEmpty(storedPwd))
        {
            password = storedPwd;
            await LoadSignatures();
        }
        else
        {
            sigError = "Enter the keystore password to view signatures.";
        }
    }

    private async Task RetrySignatures()
    {
        if (!string.IsNullOrEmpty(password))
            await LoadSignatures();
    }

    private async Task LoadSignatures()
    {
        sigLoading = true;
        sigError = null;
        StateHasChanged();
        try
        {
            await using var file = await KeystoreService.OpenKeystoreFileAsync(keystoreId);
            signatures = await KeystoreService.GetSignatureHashesAsync(file.Path, alias, password);
        }
        catch (Exception ex)
        {
            sigError = ex.Message;
        }
        finally
        {
            sigLoading = false;
            StateHasChanged();
        }
    }

    private async Task CopyToClipboard(string value)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
        ToastService.ShowSuccess("Copied to clipboard!");
    }
}

<style>
    .form-content { padding: 1rem 1.25rem; }

    .loading-card { text-align: center; padding: 40px; color: var(--text-muted); }
    .alert { padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }

    .form-group { margin-bottom: 12px; }
    .mt-2 { margin-top: 8px; }

    .sig-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .sig-table th { text-align: left; padding: 6px 8px; border-bottom: 2px solid var(--border-subtle); color: var(--text-secondary); font-size: 12px; text-transform: uppercase; }
    .sig-table td { padding: 4px 8px; border-bottom: 1px solid var(--border-subtle); color: var(--text-primary); vertical-align: middle; }
    .sig-table td.mono { font-family: 'Consolas', 'Monaco', monospace; font-size: 11px; word-break: break-all; }
    .sig-table td.mono .mono-value { background: var(--surface-well); border-radius: var(--radius-xs); padding: 0 6px; display: inline-block; margin: 4px 0; line-height: 1.2; }

    .btn-copy { background: none; border: none; color: var(--accent); cursor: pointer; padding: 4px 8px; border-radius: var(--radius-xs); }
    .btn-copy:hover { background: var(--surface-well); }

    .service-tag { font-size: 10px; margin-right: 4px; }
    .service-tag i { margin-right: 3px; font-size: 9px; }
    .service-tag.google { background: var(--status-success-bg); color: var(--status-success-fg); }
    .service-tag.firebase { background: var(--status-warning-bg); color: var(--status-warning-fg); }
    .service-tag.facebook { background: var(--status-info-bg); color: var(--status-info-fg); }
    .service-tag.muted { background: var(--surface-well); color: var(--text-muted); }

</style>
