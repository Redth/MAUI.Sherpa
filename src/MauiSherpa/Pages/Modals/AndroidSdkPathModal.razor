@page "/modal/android-sdk-path"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Pages.Forms
@inject IAndroidSdkPathService PathService
@inject IAndroidSdkService Sdk
@inject HybridFormBridgeHolder BridgeHolder
@inject IAlertService Alerts
@inject IDialogService Dialogs
@inject ILoggingService Logger
@inject IJSRuntime JS
@implements IDisposable

<section class="sdk-path-dialog" aria-label="Android SDK PATH configuration">
    <p class="sdk-path-intro">Make Android tools from the active SDK available in your terminal. Review the destination and proposed changes before applying.</p>
    <div class="sdk-path-controls">
        @if (!OperatingSystem.IsWindows())
        {
            <label>Shell
                <SherpaSelect TValue="AndroidPathShell"
                              Value="@shell"
                              ValueChanged="ShellChangedAsync"
                              Options="ShellOptions"
                              AriaLabel="Shell"
                              Disabled="@busy"
                              Class="sherpa-select-full" />
            </label>
        }
        <label>Update scope
            <SherpaSelect TValue="AndroidPathScope"
                          Value="@scope"
                          ValueChanged="ScopeChangedAsync"
                          Options="ScopeOptions"
                          AriaLabel="Update scope"
                          Disabled="@busy"
                          Class="sherpa-select-full" />
        </label>
        <button type="button" class="sdk-path-button btn btn-secondary btn-sm" @onclick="CheckAsync" disabled="@busy"><i class="fa-solid fa-rotate @(busy ? "fa-spin" : "")" aria-hidden="true"></i> Check Again</button>
    </div>
    <label class="sdk-path-build-tools"><input type="checkbox" checked="@includeBuildTools" @onchange="BuildToolsChangedAsync" disabled="@busy" /> Include build tools (aapt, aapt2, apksigner, zipalign)</label>
    @if (busy && plan == null)
    {
        <SherpaListSkeleton Rows="4" Label="Inspecting Android tools and shell PATH..." />
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <p class="sdk-path-error sherpa-banner sherpa-banner-danger" role="alert">@error</p>
    }
    @if (!string.IsNullOrEmpty(notice))
    {
        <p class="sdk-path-notice sherpa-banner sherpa-banner-success" role="status">@notice</p>
    }
    @if (plan is { } current)
    {
        <h3>Android Tools @(!string.IsNullOrEmpty(notice) ? "(last PATH check)" : "")</h3>
        <div class="sdk-path-tools sherpa-list">
            @foreach (var tool in current.Tools)
            {
                <div class="sdk-path-tool sherpa-list-row">
                    <span class="sdk-path-icon" aria-hidden="true"><i class="fa-solid @(IsCorrect(tool) ? "fa-check" : "fa-terminal")"></i></span>
                    <div>
                        <strong class="mono">@tool.Name</strong>
                        <span class="mono text-selectable">@(tool.ResolvedExecutable ?? "Not found on PATH")</span>
                        @if (tool.SdkExecutable != null && !IsCorrect(tool))
                        {
                            <span class="mono text-selectable">SDK: @tool.SdkExecutable</span>
                        }
                    </div>
                    <span class="sdk-path-status">@(tool.SdkExecutable == null ? "Not installed" : IsCorrect(tool) ? "Active SDK" : tool.ResolvedExecutable == null ? "Missing from PATH" : "Different location")</span>
                </div>
            }
        </div>
        <div class="sdk-path-target">
            <h3>Configuration destination</h3>
            <span class="mono text-selectable">@current.Target</span>
            <p>@(current.Options.Scope == AndroidPathScope.Machine ? "Applies to all users. Administrator approval is required." : "Applies only to your account.") Existing configuration is preserved and backed up.</p>
        </div>
        @if (current.Warning != null)
        {
            <p class="sdk-path-warning sherpa-banner sherpa-banner-warning" role="status"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> @current.Warning</p>
        }
        <details class="sdk-path-preview">
            <summary>Proposed PATH update @(current.NeedsUpdate ? "" : "(already configured)")</summary>
            <pre class="text-selectable"><code @key="(current.Preview, current.Options.Shell)" id="@previewId" class="@(current.Options.Shell == AndroidPathShell.Windows ? "language-diff" : "language-bash")">@(current.Options.Shell == AndroidPathShell.Windows ? $"- {current.OriginalContent}\n+ {current.UpdatedContent}" : current.Preview)</code></pre>
            @if (highlightError != null)
            {
                <p class="sdk-path-error sherpa-banner sherpa-banner-danger" role="alert">@highlightError</p>
            }
            <button type="button" class="sdk-path-button btn btn-secondary btn-sm" @onclick="CopyPreviewAsync"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy Preview</button>
        </details>
        <p class="sdk-path-footnote">Open a new terminal after applying. Existing terminals and running apps keep their previous environment. SDK switching does not silently update shell configuration; use this dialog again after switching.</p>
    }
</section>

<style>
    .sdk-path-dialog { padding: 16px 24px; font-size: 13px; color: var(--text-primary); }
    .sdk-path-dialog h3 { margin: 18px 2px 7px; font-size: 13px; font-weight: 600; }
    .sdk-path-intro { margin: 0 0 16px; color: var(--text-secondary); line-height: 1.45; }
    .sdk-path-controls { display: flex; flex-wrap: wrap; align-items: end; gap: 10px; }
    .sdk-path-controls label { display: flex; flex: 1; min-width: 130px; flex-direction: column; gap: 6px; font-size: var(--font-size-xs); font-weight: 600; color: var(--text-primary); }
    .sdk-path-button { min-height: var(--control-height-sm); font-size: 12px; }
    .sdk-path-button { cursor: pointer; white-space: nowrap; }
    .sdk-path-button i { margin-right: 4px; }
    .sdk-path-button:hover:not(:disabled) { border-color: var(--text-muted); }
    .sdk-path-dialog :disabled { opacity: .5; cursor: default; }
    .sdk-path-dialog :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; box-shadow: 0 0 0 4px var(--accent-ring); }
    .sdk-path-build-tools { display: flex; align-items: center; gap: 7px; font-size: 12px; margin: 14px 0; }
    .sdk-path-tools { overflow: hidden; }
    .sdk-path-tool { padding: 10px 12px; }
    .sdk-path-icon { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: var(--radius-md); color: var(--text-secondary); background: var(--bg-tertiary); }
    .sdk-path-tool > div { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3px; }
    .sdk-path-tool > div span { color: var(--text-secondary); font-size: 11.5px; overflow-wrap: anywhere; }
    .sdk-path-status { flex: none; color: var(--text-secondary); font-size: 11.5px; }
    .sdk-path-target > span { display: block; overflow-wrap: anywhere; font-size: 12px; }
    .sdk-path-target p, .sdk-path-footnote { font-size: 11.5px; line-height: 1.45; color: var(--text-secondary); margin: 7px 0 14px; }
    .sdk-path-preview summary { cursor: pointer; font-size: 12px; font-weight: 500; }
    .sdk-path-preview pre { font-size: 11px; padding: 12px; border-radius: var(--radius-md); background: var(--card-bg); white-space: pre-wrap; overflow-wrap: anywhere; }
    .sdk-path-preview code.hljs { padding: 0; background: transparent; color: var(--text-primary); }
    .sdk-path-preview .hljs-keyword, .sdk-path-preview .hljs-variable, .sdk-path-preview .hljs-attr, .sdk-path-preview .hljs-meta { color: var(--status-info-text); }
    .sdk-path-preview .hljs-string, .sdk-path-preview .hljs-regexp { color: var(--status-success-text); }
    .sdk-path-preview .hljs-built_in, .sdk-path-preview .hljs-number, .sdk-path-preview .hljs-literal, .sdk-path-preview .hljs-title { color: var(--status-warning-text); }
    .sdk-path-preview .hljs-comment { color: var(--text-secondary); }
    .sdk-path-preview .hljs-subst { color: var(--text-primary); }
    .sdk-path-preview .hljs-addition { color: var(--status-success-text); background: var(--status-success-bg); }
    .sdk-path-preview .hljs-deletion { color: var(--status-error-text); background: var(--status-error-bg); }
    .sdk-path-warning, .sdk-path-error, .sdk-path-notice { font-size: 12px; overflow-wrap: anywhere; }
    .sdk-path-footnote { margin-top: 18px; }
    @@media (max-width: 560px) { .sdk-path-tool { flex-wrap: wrap; } .sdk-path-status { margin-left: 40px; } }
</style>

@code {
    private HybridFormBridge? bridge;
    private AndroidPathPlan? plan;
    private AndroidPathShell shell;
    private AndroidPathScope scope;
    private bool includeBuildTools, busy, disposed, canConfigureMachine, applying;
    private string? error, notice;
    private string? highlightError;
    private readonly string previewId = $"sdk-path-preview-{Guid.NewGuid():N}";
    private (string Preview, AndroidPathShell Shell)? highlightedPreview;
    private readonly CancellationTokenSource lifetime = new();
    private static readonly IReadOnlyList<SherpaSelectOption<AndroidPathShell>> ShellOptions =
    [
        new(AndroidPathShell.Zsh, "Zsh"),
        new(AndroidPathShell.Bash, "Bash — interactive"),
        new(AndroidPathShell.BashLogin, "Bash — login"),
        new(AndroidPathShell.Sh, "POSIX sh — login"),
        new(AndroidPathShell.Fish, "Fish")
    ];
    private IReadOnlyList<SherpaSelectOption<AndroidPathScope>> ScopeOptions =>
        canConfigureMachine
            ?
            [
                new(AndroidPathScope.User, "Current user"),
                new(AndroidPathScope.Machine, "All users (administrator)")
            ]
            :
            [
                new(AndroidPathScope.User, "Current user")
            ];

    protected override async Task OnInitializedAsync()
    {
        bridge = BridgeHolder.Current ?? throw new InvalidOperationException("Android SDK PATH dialog bridge is unavailable.");
        bridge.PreventSubmitClose = true;
        bridge.SubmitRequested += ApplyAsync;
        shell = PathService.DefaultShell;
        await CheckAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || plan is not { } current || highlightedPreview == (current.Preview, current.Options.Shell)) return;
        highlightedPreview = (current.Preview, current.Options.Shell);
        try { await JS.InvokeVoidAsync("highlightCode", previewId); }
        catch (JSException ex)
        {
            highlightError = "Syntax highlighting could not be loaded. The proposed update is shown as plain text.";
            Logger.LogError("Could not highlight Android SDK PATH preview.", ex);
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }
    private async Task ShellChangedAsync(AndroidPathShell value)
    {
        shell = value;
        await CheckAsync();
    }
    private async Task ScopeChangedAsync(AndroidPathScope value)
    {
        scope = value;
        await CheckAsync();
    }
    private async Task BuildToolsChangedAsync(ChangeEventArgs args) { includeBuildTools = args.Value is true; await CheckAsync(); }
    private async Task CheckAsync()
    {
        if (busy) return;
        busy = true;
        error = notice = null;
        plan = null;
        highlightedPreview = null;
        highlightError = null;
        UpdateActions();
        try
        {
            canConfigureMachine = PathService.CanConfigureMachinePath;
            if (!canConfigureMachine) scope = AndroidPathScope.User;
            plan = await PathService.CheckAsync(new(shell, scope, includeBuildTools), lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { error = ex.Message; Logger.LogError("Could not check Android SDK PATH.", ex); }
        finally { busy = false; if (!disposed) UpdateActions(); }
    }
    private async Task ApplyAsync()
    {
        if (busy || plan is not { NeedsUpdate: true } current) return;
        busy = true;
        applying = true;
        error = notice = null;
        bridge!.PreventClose = true;
        UpdateActions();
        await InvokeAsync(StateHasChanged);
        try
        {
            if (!await Alerts.ShowConfirmAsync("Apply Android SDK PATH Update",
                $"Update {current.Target} to use tools from {current.SdkPath}? Existing configuration will be backed up. " +
                (current.Options.Scope == AndroidPathScope.Machine ? "This affects all users and requires administrator approval." : "This affects only your account."))) return;
            await PathService.ApplyAsync(current, lifetime.Token);
            plan = current with { OriginalContent = current.UpdatedContent };
            notice = "PATH configuration saved. Open a new terminal to use the Android tools.";
            bridge.Result = true;
        }
        catch (Exception ex) { error = ex.Message; Logger.LogError("Could not apply Android SDK PATH.", ex); }
        finally
        {
            busy = applying = false;
            bridge.PreventClose = false;
            if (!disposed) { UpdateActions(); await InvokeAsync(StateHasChanged); }
        }
    }
    private void UpdateActions() => bridge?.SetActionState(!busy && plan is { NeedsUpdate: true } && error == null,
        busy: busy, actionText: applying ? "Applying..." : busy ? "Checking..." : "Apply PATH Update", secondaryActionText: "Close");
    private static bool IsCorrect(AndroidPathTool tool) => tool.SdkExecutable != null && tool.ResolvedExecutable != null &&
        string.Equals(tool.SdkExecutable, tool.ResolvedExecutable, OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);
    private async Task CopyPreviewAsync()
    {
        try { if (plan != null) await Dialogs.CopyToClipboardAsync(plan.Preview); }
        catch (Exception ex) { error = ex.Message; Logger.LogError("Could not copy PATH preview.", ex); }
    }
    public void Dispose()
    {
        disposed = true;
        lifetime.Cancel();
        if (bridge != null) bridge.SubmitRequested -= ApplyAsync;
        lifetime.Dispose();
    }
}
