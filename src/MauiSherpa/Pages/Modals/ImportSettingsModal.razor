@page "/modal/import-settings"
@using MauiSherpa.Core.Interfaces
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject IBackupService BackupService
@inject IDialogService DialogService

<div class="dialog-content">
    <div class="dialog-header">
        <h2><i class="fa-solid fa-file-import"></i> Import Settings</h2>
    </div>
    <div class="dialog-body sherpa-form">
        <div class="form-group sherpa-field">
            <label class="sherpa-field-label">Backup File</label>
            <div class="file-input-group sherpa-input-group">
                <input type="text" value="@importFilePath" placeholder="Select backup file" readonly />
                <button class="sherpa-input-group-btn" @onclick="BrowseImportFile">
                    <i class="fa-solid fa-folder-open"></i> Browse
                </button>
            </div>
        </div>
        <div class="form-group sherpa-field">
            <label class="sherpa-field-label">Password</label>
            <input type="password" class="sherpa-input" @bind="importPassword" @bind:event="oninput" placeholder="Enter backup password" />
        </div>
        @if (!string.IsNullOrEmpty(importError))
        {
            <div class="error-message sherpa-banner sherpa-banner-danger">@importError</div>
        }
    </div>
    <div class="dialog-footer">
        <button class="btn btn-secondary" @onclick="Cancel" disabled="@isImporting">Cancel</button>
        <button class="btn btn-primary" @onclick="ImportSettings"
                disabled="@(string.IsNullOrEmpty(importFilePath) || string.IsNullOrEmpty(importPassword) || isImporting)">
            <i class="fa-solid @(isImporting ? "fa-spinner fa-spin" : "fa-upload")"></i> @(isImporting ? "Importing..." : "Import")
        </button>
    </div>
</div>

@code {
    private string importFilePath = "";
    private string importPassword = "";
    private string importError = "";
    private bool isImporting;

    private void Cancel() => ModalParams.Cancel();

    private async Task BrowseImportFile()
    {
        var path = await DialogService.PickOpenFileAsync("Select Backup File", new[] { "mss" });
        if (!string.IsNullOrEmpty(path))
        {
            importFilePath = path;
            StateHasChanged();
        }
    }

    private async Task ImportSettings()
    {
        if (string.IsNullOrEmpty(importFilePath) || !File.Exists(importFilePath))
        {
            importError = "Please select a valid backup file";
            return;
        }

        isImporting = true;
        importError = "";
        StateHasChanged();

        try
        {
            var encrypted = await File.ReadAllBytesAsync(importFilePath);

            if (!await BackupService.ValidateBackupAsync(encrypted))
            {
                importError = "Invalid backup file format";
                isImporting = false;
                StateHasChanged();
                return;
            }

            var importResult = await BackupService.ImportBackupAsync(encrypted, importPassword);
            ModalParams.Complete(importResult);
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            importError = "Incorrect password";
        }
        catch (Exception ex)
        {
            importError = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }
}

<style>
    .dialog-content { display: flex; flex-direction: column; width: 100%; height: 100%; }
    .dialog-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border-subtle); }
    .dialog-header h2 { margin: 0; font-size: 18px; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }
    .dialog-body { padding: 24px; flex: 1; overflow-y: auto; overscroll-behavior: contain; }
    .dialog-footer { padding: 16px 24px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; gap: 12px; }

    .form-group { margin-bottom: 1.25rem; }
    .error-message { font-size: 0.8125rem; }
</style>
