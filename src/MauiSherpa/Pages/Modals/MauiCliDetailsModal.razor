@page "/modal/maui-cli-details"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Models.Profiling
@using MauiSherpa.Pages.Forms
@inject ModalParameterService ModalParams
@inject IFileSystemService FileSystem
@inject IAlertService AlertService
@inject IJSRuntime JS

@if (session is null)
{
    <div class="sherpa-form">
        <div class="sherpa-banner sherpa-banner-warning">
            <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i>
            <span>MAUI CLI details are unavailable.</span>
        </div>
    </div>
}
else
{
    <div class="sherpa-form tool-details">
        <div class="sherpa-banner @BannerClass tool-banner">
            <div class="tool-banner-copy">
                <i class="fa-solid @StatusIcon fa-fw" aria-hidden="true"></i>
                <div>
                    <strong>@StatusTitle</strong>
                    <span>@StatusDescription</span>
                </div>
            </div>
            <div class="tool-banner-actions">
                @if (session.Status.State == MauiCliToolState.Missing)
                {
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            @onclick="() => SelectAction(MauiCliDetailsAction.Install)">
                        <i class="fa-solid fa-download fa-fw" aria-hidden="true"></i>
                        <span>Install</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-sm @(UpdateAvailable || session.Status.State == MauiCliToolState.UpdateRequired ? "btn-primary" : "btn-secondary")"
                            @onclick="() => SelectAction(MauiCliDetailsAction.Update)">
                        <i class="fa-solid fa-arrow-up fa-fw" aria-hidden="true"></i>
                        <span>@(UpdateAvailable ? "Update" : "Update anyway")</span>
                    </button>
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            @onclick="() => SelectAction(MauiCliDetailsAction.Recheck)">
                        <i class="fa-solid fa-rotate fa-fw" aria-hidden="true"></i>
                        <span>Check again</span>
                    </button>
                }
            </div>
        </div>

        <div class="sherpa-card tool-card">
            <div class="tool-facts-grid">
                <div class="tool-fact">
                    <span class="sherpa-meta-label">Installed version</span>
                    <span class="sherpa-meta-value mono">@ValueOrFallback(InstalledVersion)</span>
                </div>
                <div class="tool-fact">
                    <span class="sherpa-meta-label">Latest available</span>
                    @if (UpdateAvailable && !string.IsNullOrWhiteSpace(session.UpdateInfo?.LatestVersion))
                    {
                        <span class="tool-fact-inline">
                            <span class="sherpa-badge sherpa-badge-accent mono">@session.UpdateInfo!.LatestVersion</span>
                        </span>
                    }
                    else
                    {
                        <span class="sherpa-meta-value mono">@ValueOrFallback(session.UpdateInfo?.LatestVersion)</span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(session.Status.ExecutablePath))
            {
                <div class="tool-paths">
                    <div class="tool-path-row">
                        <div class="sherpa-row-stack">
                            <span class="sherpa-meta-label">Binary path</span>
                            <span class="sherpa-meta-value mono text-selectable tool-path-text" title="@session.Status.ExecutablePath">@session.Status.ExecutablePath</span>
                        </div>
                        <div class="sherpa-row-actions">
                            <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Copy binary path" aria-label="Copy binary path" @onclick="() => CopyAsync(session.Status.ExecutablePath!)">
                                <i class="fa-regular fa-copy fa-fw" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Reveal in file manager" aria-label="Reveal binary in file manager" @onclick="() => FileSystem.RevealInFileManager(session.Status.ExecutablePath!)">
                                <i class="fa-solid fa-arrow-up-right-from-square fa-fw" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(session.UpdateInfo?.Message) && !UpdateAvailable)
        {
            <p class="sherpa-field-help" style="margin:0;">@session.UpdateInfo!.Message</p>
        }
    </div>
}

<style>
    .tool-banner {
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .tool-banner-copy {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        flex: 1 1 220px;
        min-width: 0;
    }

    .tool-banner-copy > i {
        margin-top: 2px;
        font-size: 15px;
    }

    .tool-banner-copy > div {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .tool-banner-copy strong {
        font-size: var(--font-size-md);
        font-weight: 650;
    }

    .tool-banner-copy span {
        font-size: var(--font-size-xs);
        opacity: 0.9;
        line-height: 1.4;
    }

    .tool-banner-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .tool-card {
        overflow: hidden;
    }

    .tool-facts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 16px;
        padding: 12px 14px;
    }

    .tool-fact {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

    .tool-fact-inline {
        display: inline-flex;
        align-items: center;
    }

    .tool-paths {
        border-top: 1px solid var(--border-hairline);
        background: var(--surface-well);
    }

    .tool-path-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 14px;
    }

    .tool-path-row > .sherpa-row-stack {
        flex: 1 1 0%;
        min-width: 0;
    }

    .tool-path-text {
        display: block;
        width: 100%;
        overflow-wrap: anywhere;
        font-size: var(--font-size-xs);
        line-height: 1.4;
    }

    @@media (max-width: 560px) {
        .tool-facts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private MauiCliDetailsSession? session;

    private bool UpdateAvailable => session?.UpdateInfo?.UpdateAvailable == true;

    private string? InstalledVersion =>
        session?.UpdateInfo?.InstalledVersion ?? session?.Status.Version;

    private string BannerClass => session?.Status.State switch
    {
        MauiCliToolState.Missing => "sherpa-banner-warning",
        MauiCliToolState.UpdateRequired => "sherpa-banner-warning",
        _ => UpdateAvailable ? "sherpa-banner-info" : "sherpa-banner-success"
    };

    private string StatusIcon => session?.Status.State switch
    {
        MauiCliToolState.Missing => "fa-triangle-exclamation",
        MauiCliToolState.UpdateRequired => "fa-triangle-exclamation",
        _ => UpdateAvailable ? "fa-circle-arrow-up" : "fa-circle-check"
    };

    private string StatusTitle => session?.Status.State switch
    {
        MauiCliToolState.Missing => "Not installed",
        MauiCliToolState.UpdateRequired => "Update required",
        _ => UpdateAvailable ? "Update available" : "MAUI CLI is ready"
    };

    private string StatusDescription
    {
        get
        {
            if (session is null)
                return string.Empty;

            return session.Status.State switch
            {
                MauiCliToolState.Missing =>
                    "Sherpa uses the Microsoft.Maui.Cli global tool to build, launch, and profile your app.",
                MauiCliToolState.UpdateRequired =>
                    session.Status.Message ?? "Update Microsoft.Maui.Cli to a version that supports profiling.",
                _ when UpdateAvailable =>
                    $"Version {session.UpdateInfo!.LatestVersion} is available with the latest profiling fixes.",
                _ => "Ready to capture and analyze app profiles."
            };
        }
    }

    protected override void OnInitialized()
    {
        session = ModalParams.Get<MauiCliDetailsSession>("Session");
    }

    private void SelectAction(MauiCliDetailsAction action) =>
        session?.RequestAction(action);

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await AlertService.ShowToastAsync("Copied to clipboard");
        }
        catch { }
    }

    private static string ValueOrFallback(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Unknown" : value;
}
