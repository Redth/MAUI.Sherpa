@page "/modal/cloud-provider"
@using MauiSherpa.Core.Interfaces
@inject MauiSherpa.Pages.Forms.ModalParameterService ModalParams
@inject ICloudSecretsProviderFactory CloudSecretsProviderFactory

<div class="dialog-content">
    <div class="dialog-header">
        <h2><i class="fa-solid fa-vault"></i> @(isEditing ? "Edit" : "Add") Secrets Provider</h2>
    </div>
    <div class="dialog-body sherpa-form sherpa-scroll">
        <div class="sherpa-field">
            <label class="sherpa-field-label">Name</label>
            <input type="text" class="sherpa-input" @bind="providerName" @bind:event="oninput" placeholder="My Team Vault" />
            <div class="sherpa-field-help">A friendly name to identify this provider</div>
        </div>
        <div class="sherpa-field">
            <label class="sherpa-field-label">Provider Type</label>
            @if (isEditing)
            {
                <input type="text" class="sherpa-input" value="@CloudSecretsProviderFactory.GetProviderDisplayName(providerType)" disabled />
            }
            else
            {
                <div class="provider-type-selector">
                    @foreach (var type in AddableProviderTypes)
                    {
                        <button type="button" class="provider-type-card sherpa-card @(providerType == type ? "selected" : "")"
                                aria-pressed="@((providerType == type).ToString().ToLowerInvariant())"
                                @onclick="@(() => OnProviderTypeChanged(type))">
                            <i class="@GetProviderIcon(type) provider-icon" aria-hidden="true"></i>
                            <span class="provider-name">@CloudSecretsProviderFactory.GetProviderDisplayName(type)</span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="sherpa-form-grid-2">
            @foreach (var setting in CloudSecretsProviderFactory.GetProviderSettings(providerType))
            {
                if (setting.DependsOn != null && providerSettings.GetValueOrDefault(setting.DependsOn) != setting.DependsOnValue)
                    continue;

                <div class="sherpa-field @(setting.Key == "CredentialsJson" ? "provider-field-wide" : null)">
                    <label class="sherpa-field-label">@setting.DisplayName @(setting.IsRequired ? "*" : "")</label>
                    @if (setting.Options?.Length > 0)
                    {
                        <SherpaSelect TValue="string"
                                      Value="@(providerSettings.GetValueOrDefault(setting.Key, setting.DefaultValue ?? ""))"
                                      ValueChanged="@((string? value) => OnSettingChanged(setting.Key, value))"
                                      Options="GetSettingOptions(setting.Options!)"
                                      AriaLabel="@setting.DisplayName"
                                      Class="sherpa-select-full" />
                    }
                    else if (setting.IsSecret)
                    {
                        <div class="sherpa-input-group">
                            <input type="@(IsSecretVisible(setting.Key) ? "text" : "password")"
                                   value="@(providerSettings.GetValueOrDefault(setting.Key, ""))"
                                   @oninput="@(e => providerSettings[setting.Key] = e.Value?.ToString() ?? "")"
                                   placeholder="@setting.Placeholder" />
                            <button type="button" class="sherpa-input-group-btn"
                                    title="@(IsSecretVisible(setting.Key) ? "Hide value" : "Show value")"
                                    aria-label="@(IsSecretVisible(setting.Key) ? $"Hide {setting.DisplayName}" : $"Show {setting.DisplayName}")"
                                    @onclick="() => ToggleSecretVisibility(setting.Key)">
                                <i class="fa-solid @(IsSecretVisible(setting.Key) ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                    else if (setting.Key == "CredentialsJson")
                    {
                        <SherpaJsonEditor Value="@(providerSettings.GetValueOrDefault(setting.Key, ""))"
                                          ValueChanged="@(val => providerSettings[setting.Key] = val)"
                                          FileName="credentials.json"
                                          Schema="google-service-account"
                                          Rows="8"
                                          Placeholder="@setting.Placeholder" />
                    }
                    else
                    {
                        <input type="text"
                               class="sherpa-input"
                               value="@(providerSettings.GetValueOrDefault(setting.Key, setting.DefaultValue ?? ""))"
                               @oninput="@(e => providerSettings[setting.Key] = e.Value?.ToString() ?? "")"
                               placeholder="@setting.Placeholder" />
                    }
                    <div class="sherpa-field-help">@setting.Description</div>
                </div>
            }
        </div>
    </div>
    <div class="dialog-footer">
        <button class="btn btn-secondary" @onclick="Cancel">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i> Cancel
        </button>
        <button class="btn btn-primary" @onclick="Save"
                disabled="@(!CanSave)">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save
        </button>
    </div>
</div>

@code {
    private bool isEditing;
    private string editingId = "";
    private string providerName = "";
    private CloudSecretsProviderType providerType = CloudSecretsProviderType.Local;
    private Dictionary<string, string> providerSettings = new();
    private List<SecretItemKind> defaultItemKinds = SecretItemKinds.All.ToList();
    private readonly HashSet<string> visibleSecretSettings = new(StringComparer.Ordinal);
    private IEnumerable<CloudSecretsProviderType> AddableProviderTypes =>
        CloudSecretsProviderFactory.SupportedProviders.Where(type => type != CloudSecretsProviderType.Local);

    private bool CanSave
    {
        get
        {
            if (string.IsNullOrWhiteSpace(providerName)) return false;
            var settings = CloudSecretsProviderFactory.GetProviderSettings(providerType);
            var requiredSettings = settings.Where(s => s.IsRequired &&
                (s.DependsOn == null || providerSettings.GetValueOrDefault(s.DependsOn) == s.DependsOnValue));
            return requiredSettings.All(s => !string.IsNullOrWhiteSpace(providerSettings.GetValueOrDefault(s.Key)));
        }
    }

    protected override void OnInitialized()
    {
        var provider = ModalParams.Get<CloudSecretsProviderConfig>("Provider");
        if (provider != null)
        {
            isEditing = true;
            editingId = provider.Id;
            providerName = provider.Name;
            providerType = provider.ProviderType;
            providerSettings = new Dictionary<string, string>(provider.Settings);
            defaultItemKinds = provider.EffectiveDefaultItemKinds.ToList();
        }
        else
        {
            providerType = AddableProviderTypes.FirstOrDefault();
            InitializeDefaultSettings();
        }
    }

    private void OnProviderTypeChanged(CloudSecretsProviderType type)
    {
        providerType = type;
        providerSettings = new Dictionary<string, string>();
        InitializeDefaultSettings();
    }

    private void InitializeDefaultSettings()
    {
        foreach (var setting in CloudSecretsProviderFactory.GetProviderSettings(providerType))
        {
            if (!string.IsNullOrEmpty(setting.DefaultValue))
                providerSettings[setting.Key] = setting.DefaultValue;
        }
    }

    private static IReadOnlyList<SherpaSelectOption<string>> GetSettingOptions(
        IEnumerable<string> options) =>
        options.Select(option =>
        {
            var parts = option.Split('|', 2);
            return new SherpaSelectOption<string>(
                parts[0],
                parts.Length > 1 ? parts[1] : parts[0]);
        }).ToArray();

    private void OnSettingChanged(string key, string? value)
    {
        providerSettings[key] = value ?? string.Empty;
        StateHasChanged();
    }

    private bool IsSecretVisible(string key) => visibleSecretSettings.Contains(key);

    private void ToggleSecretVisibility(string key)
    {
        if (!visibleSecretSettings.Add(key))
            visibleSecretSettings.Remove(key);
    }

    private void Cancel() => ModalParams.Cancel();

    private void Save()
    {
        var config = new CloudSecretsProviderConfig(
            isEditing ? editingId : Guid.NewGuid().ToString("N"),
            providerName,
            providerType,
            new Dictionary<string, string>(providerSettings),
            defaultItemKinds);
        ModalParams.Complete(config);
    }

    private static string GetProviderIcon(CloudSecretsProviderType type) => type switch
    {
        CloudSecretsProviderType.Local => "fa-solid fa-database",
        CloudSecretsProviderType.Infisical => "fa-solid fa-shield-alt",
        CloudSecretsProviderType.AzureKeyVault => "fa-solid fa-key",
        CloudSecretsProviderType.AwsSecretsManager => "fa-brands fa-aws",
        CloudSecretsProviderType.GoogleSecretManager => "fa-brands fa-google",
        CloudSecretsProviderType.OnePassword => "fa-solid fa-lock",
        CloudSecretsProviderType.Vaultwarden => "fa-solid fa-vault",
        CloudSecretsProviderType.AzureDevOps => "fa-brands fa-microsoft",
        _ => "fa-solid fa-lock"
    };
}

<style>
    .dialog-content { display: flex; flex-direction: column; width: 100%; height: 100%; }
    .dialog-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border-subtle); }
    .dialog-header h2 { margin: 0; font-size: 18px; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }
    .dialog-body { flex: 1; min-height: 0; }
    .dialog-footer { padding: 16px 24px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; gap: 12px; }
    .provider-type-selector { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
    .provider-type-card { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 10px 12px; color: var(--text-primary); cursor: pointer; font: inherit; text-align: left; transition: background var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard); }
    .provider-type-card:hover { background: var(--surface-card-hover); }
    .provider-type-card.selected { background: var(--accent-soft); border-color: var(--accent); }
    .provider-type-card .provider-icon { display: grid; flex: 0 0 30px; place-items: center; width: 30px; height: 30px; border-radius: var(--radius-sm); color: var(--text-secondary); background: var(--surface-well); }
    .provider-type-card.selected .provider-icon { color: var(--accent); }
    .provider-type-card .provider-name { min-width: 0; font-size: var(--font-size-sm); font-weight: 550; }
    .provider-field-wide { grid-column: 1 / -1; }
</style>
