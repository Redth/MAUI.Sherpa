    }

    .output-line.assistant { color: var(--accent); }
    .output-line.tool { color: var(--status-warning-fg); }
    .output-line.error { color: var(--status-danger-fg); }
    .output-line.system { color: var(--text-muted); font-style: italic; }

    .modal-footer {
