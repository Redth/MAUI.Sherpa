    .timestamp { text-align: right; font-size: 0.75rem; color: var(--text-muted); margin-top: 1.25rem; }

    .loading-state { 
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 3.75rem 2.5rem; 
        text-align: center; 
        user-select: none;
    }
    .loading-spinner { 
