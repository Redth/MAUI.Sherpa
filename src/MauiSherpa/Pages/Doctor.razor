    .dep-item + .dep-item { border-top: 1px solid var(--border-hairline); }
    .dep-item.status-ok { background: var(--status-success-bg); color: var(--status-success-fg); }
    .dep-item.status-info { background: var(--status-info-bg); color: var(--status-info-fg); }
