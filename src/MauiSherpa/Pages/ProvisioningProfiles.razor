@page "/profiles"
@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Requests.Apple
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@using Shiny.Mediator
@inject IMediator Mediator
@inject IAppleConnectService AppleService
@inject IAppleIdentityStateService IdentityState
@inject IAlertService AlertService
@inject IDialogService DialogService
@inject IFileSystemService FileSystem
@inject OperationModalService OperationModal
@inject IFormModalService FormModalService
@inject MauiSherpa.Pages.Forms.HybridFormBridgeHolder BridgeHolder
@inject BlazorToastService ToastService
@inject IEncryptedSettingsService SettingsService
@inject IToolbarService ToolbarService
@inject IPlatformService PlatformInfo
@inject ILocalVaultAccessService LocalVaultAccess
@inject ISecretSyncCoordinator SecretSyncCoordinator
@inject ICloudSecretsService CloudSecretsService
@implements IDisposable

<h1><i class="fa-solid fa-id-card"></i> Provisioning Profiles</h1>

<AppleIdentityPicker />

@if (IdentityState.SelectedIdentity != null && !LocalVaultAccess.GetState().RequiresUserAction)
{
    @if (!PlatformInfo.HasNativeToolbar)
    {
    <div class="toolbar">
        @if (isSelectionMode)
        {
        <button data-screenshot-external class="btn btn-primary" @onclick="BackUpSelectedAsync" disabled="@(selectedProfileIds.Count == 0)">
            <i class="fa-solid fa-cloud-arrow-up"></i> Back Up
        </button>
        <button data-screenshot-external class="btn btn-secondary" @onclick="InstallSelectedAsync" disabled="@(selectedProfileIds.Count == 0)">
            <i class="fa-solid fa-download"></i> Install
        </button>
        <button data-screenshot-external class="btn btn-secondary" @onclick="ExportSelectedAsync" disabled="@(selectedProfileIds.Count == 0)">
            <i class="fa-solid fa-file-export"></i> Export
        </button>
        <button class="btn btn-secondary" @onclick="CancelSelectionMode">
            <i class="fa-solid fa-times"></i> Cancel
        </button>
        }
        else
        {
        <button data-screenshot-external class="btn btn-purple" @onclick="ShowCreateDialog" disabled="@isLoading">
            <i class="fa-solid fa-plus"></i> Create Profile
        </button>
        <button class="btn btn-primary" @onclick="@(() => RefreshData(forceRefresh: true))" disabled="@isLoading">
            <i class="fa-solid @(isLoading ? "fa-spinner fa-spin" : "fa-sync-alt")"></i> Refresh
        </button>
        <button data-screenshot-external class="btn btn-secondary" @onclick="RevealProfilesFolder" disabled="@isLoading">
            <i class="fa-solid fa-folder-open"></i> Profiles Folder
        </button>
        <button data-screenshot-external class="btn btn-secondary" @onclick="ShowCleanupDialog" disabled="@isLoading">
            <i class="fa-solid fa-broom"></i> Clean Up
        </button>
        @if (GetInstallableProfiles().Any())
        {
            <button data-screenshot-external class="btn btn-success" @onclick="InstallAllProfiles" disabled="@isLoading">
                <i class="fa-solid fa-download"></i> Install All (@GetInstallableProfiles().Count())
            </button>
        }
        <button class="btn btn-secondary" @onclick="BeginSelectionMode" disabled="@isLoading">
            <i class="fa-solid fa-check-square"></i> Select
        </button>
        }
        <div class="toolbar-spacer"></div>
    </div>
    }

    <!-- Filter Section -->
    @if (!PlatformInfo.HasNativeToolbar)
    {
    <div class="filter-section">
        <div class="search-box">
            <span class="search-icon"><i class="fa-solid fa-search"></i></span>
            <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search profiles..." />
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <button class="clear-btn" @onclick="@(() => searchQuery = "")" aria-label="Clear profile search">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            }
        </div>
        <div class="filter-chips">
            <SherpaSelect TValue="string"
                          Value="@filterState"
                          ValueChanged="@(value => filterState = value ?? "")"
                          Options="StateFilterOptions"
                          LeadingIcon="fa-solid fa-circle-dot"
                          AriaLabel="Filter by profile state"
                          Compact="true"
                          Class="filter-select" />
            <SherpaSelect TValue="string"
                          Value="@filterType"
                          ValueChanged="@(value => filterType = value ?? "")"
                          Options="ProfileTypeFilterOptions"
                          LeadingIcon="fa-solid fa-id-card"
                          AriaLabel="Filter by profile type"
                          Compact="true"
                          Class="filter-select" />
            <SherpaSelect TValue="string"
                          Value="@filterPlatform"
                          ValueChanged="@(value => filterPlatform = value ?? "")"
                          Options="PlatformFilterOptions"
                          LeadingIcon="fa-brands fa-apple"
                          AriaLabel="Filter by platform"
                          Compact="true"
                          Class="filter-select" />
        </div>
        @if (HasActiveFilters)
        {
            <button class="clear-filters-btn" @onclick="ClearFilters">Clear Filters</button>
        }
    </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-bar">@errorMessage</div>
    }

    <div class="results-info">
        Showing @FilteredProfiles.Count() of @profiles.Count profiles
    </div>

    @if (isSelectionMode)
    {
        <div class="sherpa-selection-bar">
            <label class="select-all-checkbox">
                <input type="checkbox"
                       checked="@AllVisibleSelected"
                       @onchange="ToggleAllVisible" />
                <span>Select all profiles shown</span>
            </label>
            <span class="selection-count sherpa-badge sherpa-badge-accent">@selectedProfileIds.Count selected</span>
        </div>
    }

    <div class="profile-list sherpa-list">
        @if (isLoading && profiles.Count == 0)
        {
            <div class="loading-state">
                <div class="loading-spinner">
                    <i class="fa-solid fa-id-card"></i>
                </div>
                <div class="loading-title">Loading Profiles</div>
                <div class="loading-description">Fetching provisioning profiles from App Store Connect...</div>
            </div>
        }
        else if (!FilteredProfiles.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid @(profiles.Count == 0 ? "fa-file-alt" : "fa-search")"></i></div>
                <div class="empty-title">@(profiles.Count == 0 ? "No provisioning profiles found" : "No matching profiles")</div>
                <div class="empty-description">
                    @if (profiles.Count == 0)
                    {
                        <span>Create a new profile to get started</span>
                        <button data-screenshot-external class="btn btn-purple btn-empty-cta" @onclick="ShowCreateDialog">
                            <i class="fa-solid fa-plus"></i> Create Profile
                        </button>
                    }
                    else
                    {
                        <span>No profiles match your search or filters. Try adjusting your criteria.</span>
                    }
                </div>
            </div>
        }
        else
        {
            @foreach (var profile in FilteredProfiles)
            {
                var isExpired = profile.ExpirationDate < AppClock.UtcNow;
                var isExpiringSoon = !isExpired && profile.ExpirationDate < AppClock.UtcNow.AddDays(30);
                var isInvalid = profile.State != "ACTIVE";
                
                <div class="profile-card sherpa-list-row @(isExpired || isInvalid ? "invalid" : isExpiringSoon ? "expiring" : "") @(selectedProfileIds.Contains(profile.Id) ? "selected" : "") @(isSelectionMode ? "selectable sherpa-list-row-interactive" : "")"
                     @onclick="@(() => { if (isSelectionMode) ToggleProfileSelection(profile.Id, !selectedProfileIds.Contains(profile.Id)); })">
                    @if (isSelectionMode)
                    {
                        <label class="profile-select" @onclick:stopPropagation="true">
                            <input type="checkbox"
                                   aria-label="@($"Select {profile.Name}")"
                                   checked="@selectedProfileIds.Contains(profile.Id)"
                                   @onchange="@(e => ToggleProfileSelection(profile.Id, e.Value is bool selected && selected))" />
                        </label>
                    }
                    <div class="profile-icon sherpa-icon-well sherpa-icon-well-apple">
                        <i class="fa-solid fa-id-card"></i>
                        <span class="sherpa-brand-badge"><i class="fa-brands fa-apple"></i></span>
                    </div>
                    <div class="profile-details sherpa-row-stack">
                        <div class="profile-name sherpa-row-title">
                            <span>@profile.Name</span>
                            <span class="sherpa-badge sherpa-badge-neutral">@FormatProfileType(profile.ProfileType)</span>
                            @if (!string.IsNullOrEmpty(GetProfilePlatform(profile)))
                            {
                                <span class="sherpa-badge sherpa-badge-neutral">@AppleProfileTypes.GetPlatformLabel(GetProfilePlatform(profile))</span>
                            }
                            @if (isInvalid)
                            {
                                <span class="sherpa-badge sherpa-badge-danger"><span class="sherpa-dot sherpa-dot-danger"></span> @profile.State</span>
                            }
                            else if (isExpired)
                            {
                                <span class="sherpa-badge sherpa-badge-danger"><span class="sherpa-dot sherpa-dot-danger"></span> Expired</span>
                            }
                            else if (isExpiringSoon)
                            {
                                <span class="sherpa-badge sherpa-badge-warning"><span class="sherpa-dot sherpa-dot-warning"></span> Expiring Soon</span>
                            }
                            else
                            {
                                <span class="sherpa-badge sherpa-badge-success"><span class="sherpa-dot sherpa-dot-success"></span> Active</span>
                            }
                        </div>
                        <div class="profile-uuid sherpa-row-sub mono">
                            <span class="@(demoMode ? "demo-blur" : "")">@profile.Uuid</span>
                            <button class="btn btn-ghost btn-icon btn-sm btn-copy" @onclick:stopPropagation="true" @onclick="@(() => CopyToClipboard(profile.Uuid))" title="Copy UUID" aria-label="@($"Copy UUID for {profile.Name}")">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                            @if (!string.IsNullOrEmpty(profile.BundleId))
                            {
                                <span>· @profile.BundleId</span>
                            }
                            <span>· Expires @profile.ExpirationDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                    @if (!isSelectionMode)
                    {
                    <div class="profile-actions sherpa-row-actions">
                        <MauiSherpa.Components.SecretProviderPickerHost
                            @key="@($"profile-sync-{profile.Id}")"
                            Item="@(new SecretItemRef(SecretItemKind.ProvisioningProfile, profile.Id, profile.Name) { AppleIdentityId = profilesIdentityId })" />
                        <button data-screenshot-external class="btn btn-secondary btn-icon btn-sm" @onclick="@(() => ShowEditDialog(profile))" disabled="@isLoading" title="Edit">
                            <i class="fa-solid fa-edit"></i>
                        </button>
                        <button data-screenshot-external class="btn btn-secondary btn-icon btn-sm" @onclick="@(() => DownloadProfile(profile))" disabled="@isLoading" title="Download">
                            <i class="fa-solid fa-download"></i>
                        </button>
                        <div class="prof-dropdown">
                            <button class="btn btn-ghost btn-icon btn-sm prof-dropdown-toggle" @onclick="@(() => ToggleDropdown(profile.Id))" @onclick:stopPropagation="true" title="More actions">
                                <i class="fa-solid fa-ellipsis-v"></i>
                            </button>
                            @if (openDropdown == profile.Id)
                            {
                                <div class="prof-dropdown-menu">
                                    <button data-screenshot-external class="prof-dropdown-item" @onclick="@(() => { openDropdown = null; DownloadProfileTo(profile); })">
                                        <i class="fa-solid fa-folder-open"></i> Download to...
                                    </button>
                                    <button data-screenshot-external class="prof-dropdown-item" @onclick="@(() => { openDropdown = null; InstallProfile(profile); })">
                                        <i class="fa-solid fa-folder-plus"></i> Install to System
                                    </button>
                                    <button data-screenshot-external class="prof-dropdown-item" @onclick="@(() => RevealInstalledProfile(profile))">
                                        <i class="fa-solid fa-magnifying-glass"></i> @RevealProfileLabel
                                    </button>
                                    <div class="prof-dropdown-divider"></div>
                                    <button data-screenshot-external class="prof-dropdown-item danger" @onclick="@(() => { openDropdown = null; DeleteProfile(profile); })" disabled="@isLoading">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    }
                </div>
            }
        }
    </div>
}

<style>
    .toolbar { margin-bottom: 1rem; display: flex; gap: 0.75rem; align-items: center; }
    .toolbar-spacer { flex: 1; }
    .error-bar { background: var(--status-error-bg); color: var(--status-error-text); padding: 0.75rem 1rem; border: 1px solid var(--status-error-border); border-radius: var(--radius-lg); margin-bottom: 1rem; }

    .btn-purple { background: var(--accent); color: var(--text-inverse); }
    .btn-purple:hover:not(:disabled) { background: var(--accent-hover); }

    /* Filter Section Styles */
    .filter-section {
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 10px 14px;
        margin-bottom: 1rem;
        box-shadow: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }

    .filter-section .search-box {
        flex: 1;
        min-width: 200px;
        margin: 0 !important;
    }

    .filter-section .search-box input {
        width: 100%;
        padding: 0;
        border: 0;
        box-sizing: border-box;
        background: transparent;
        color: var(--text-primary);
    }

    .filter-section .search-box input:focus {
        outline: none;
        box-shadow: none;
    }

    .search-icon {
        display: flex;
        align-items: center;
        font-size: 0.875rem;
        opacity: 0.5;
        color: var(--text-muted);
        pointer-events: none;
    }

    .search-icon i {
        position: static !important;
        left: auto !important;
        top: auto !important;
        transform: none !important;
    }

    .clear-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        padding: 0;
        background: transparent;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        cursor: pointer;
        color: var(--text-muted);
    }

    .clear-btn:hover { background: var(--surface-card-hover); }

    .filter-chips {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .filter-select { min-width: 120px; }

    .clear-filters-btn {
        padding: 0.5rem 0.75rem;
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        color: var(--text-muted);
        cursor: pointer;
    }

    .clear-filters-btn:hover {
        background: var(--bg-tertiary);
        color: var(--text-secondary);
    }

    .results-info {
        font-size: var(--font-size-xs);
        color: var(--text-muted);
        margin: 0 0 8px;
    }

    /* ── Dropdown ── */
    .prof-dropdown { position: relative; }
    .prof-dropdown-menu {
        position: absolute; right: 0; top: 100%; margin-top: 0.25rem;
        min-width: 160px; background: var(--card-bg);
        border-radius: var(--card-radius);
        box-shadow: 0 0.25rem 1rem rgba(0,0,0,0.15); z-index: 100; padding: 0.25rem 0;
    }
    .prof-dropdown-item {
        display: flex; align-items: center; gap: 0.5rem;
        width: 100%; padding: 7px 0.875rem;
        border: none; background: none;
        color: var(--text-primary); font-size: 0.8125rem;
        cursor: pointer; text-align: left; transition: background 0.1s;
    }
    .prof-dropdown-item:hover:not(:disabled) { background: var(--bg-tertiary); }
    .prof-dropdown-item:disabled { opacity: 0.4; cursor: not-allowed; }
    .prof-dropdown-item i { font-size: 0.75rem; width: 0.875rem; text-align: center; color: var(--text-secondary); }
    .prof-dropdown-item.danger { color: var(--accent-danger); }
    .prof-dropdown-item.danger i { color: var(--accent-danger); }
    .prof-dropdown-divider { height: 1px; background: var(--border-color); margin: 0.25rem 0; }

    .profile-list { margin-bottom: 1.25rem; }

    .profile-card {
        align-items: center;
        background: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .profile-card.invalid { opacity: 0.7; }
    .profile-card.selectable { cursor: pointer; }
    .profile-card.selectable:hover { background: var(--surface-card-hover); }
    .profile-card.selected { background: color-mix(in srgb, var(--accent-soft) 55%, var(--surface-card)); }

    .profile-select {
        display: flex;
        align-items: center;
        align-self: center;
        cursor: pointer;
    }
    .profile-select input {
        width: 18px;
        height: 18px;
        accent-color: var(--accent-primary);
    }

    .select-all-checkbox {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        cursor: pointer;
        font-size: 0.875rem;
    }
    .select-all-checkbox input { accent-color: var(--accent-primary); }
    .selection-count {
        color: var(--text-muted);
        font-size: 0.8125rem;
        white-space: nowrap;
    }
    .profile-details { min-width: 0; }
    .profile-name {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .profile-uuid { display: flex; align-items: center; gap: 6px; }

    .btn-copy {
        width: 20px;
        min-width: 20px;
        height: 20px;
        min-height: 20px;
        flex-shrink: 0;
    }

    .badge { padding: 2px 0.625rem; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 500; }
    .badge-type { background: var(--accent-soft); color: var(--accent); }
    .badge-platform { background: var(--status-info-bg); color: var(--status-info-text); }
    .badge-valid { background: var(--status-success-bg); color: var(--status-success-text); }
    .badge-expiring { background: var(--status-warning-bg); color: var(--status-warning-text); }
    .badge-expired { background: var(--status-error-bg); color: var(--status-error-text); }
    .badge-invalid { background: var(--status-error-bg); color: var(--status-error-text); }

    .empty-state { background: var(--card-bg); border-radius: var(--card-radius); padding: 3.75rem 2.5rem; text-align: center; }
    .empty-icon { font-size: 48px; margin-bottom: 1rem; color: var(--text-muted); }
    .empty-icon i { font-size: 48px; }
    .empty-title { font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
    .empty-description { color: var(--text-muted); font-size: 0.875rem; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
    .btn-empty-cta { margin-top: 0.5rem; }
</style>

@code {
    private List<AppleProfile> profiles = new();
    private string? profilesIdentityId;
    private int identitySelectionVersion;
    private bool isLoading = true;
    private bool demoMode = false;
    private string errorMessage = "";
    private string? openDropdown = null;
    private bool isSelectionMode;
    private readonly HashSet<string> selectedProfileIds = new(StringComparer.Ordinal);
    // Filter state
    private string searchQuery = "";
    private string filterState = "";
    private string filterType = "";
    private string filterPlatform = "";
    private static readonly IReadOnlyList<SherpaSelectOption<string>> StateFilterOptions =
    [
        new("", "All States"),
        new("ACTIVE", "Active", DotCssClass: "sherpa-dot-success"),
        new("INVALID", "Invalid", DotCssClass: "sherpa-dot-danger")
    ];
    private static readonly IReadOnlyList<SherpaSelectOption<string>> ProfileTypeFilterOptions =
    [
        new("", "All Types"),
        new("DEVELOPMENT", "Development"),
        new("ADHOC", "Ad Hoc"),
        new("APPSTORE", "App Store")
    ];
    private static readonly IReadOnlyList<SherpaSelectOption<string>> PlatformFilterOptions =
    [
        new("", "All Platforms"),
        new("IOS", "iOS", Icon: "fa-brands fa-apple"),
        new("TVOS", "tvOS", Icon: "fa-brands fa-apple"),
        new("MAC_OS", "macOS", Icon: "fa-brands fa-apple")
    ];

    private bool HasActiveFilters => !string.IsNullOrEmpty(searchQuery) || 
                                      !string.IsNullOrEmpty(filterState) || 
                                      !string.IsNullOrEmpty(filterType) || 
                                      !string.IsNullOrEmpty(filterPlatform);
    private string RevealProfileLabel => PlatformInfo.IsWindows ? "Reveal in File Explorer" : "Reveal in Finder";

    // Get profiles that can be installed (active, not expired, matching current filters)
    private List<AppleProfile> GetInstallableProfiles() => FilteredProfiles
        .Where(p => p.State?.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase) ?? false)
        .Where(p => p.ExpirationDate > AppClock.UtcNow)
        .ToList();

    private void ToggleDropdown(string id)
    {
        openDropdown = openDropdown == id ? null : id;
    }

    private async Task ShowCreateDialog()
    {
        var identityId = IdentityState.SelectedIdentity?.Id;
        if (string.IsNullOrWhiteSpace(identityId))
        {
            await AlertService.ShowAlertAsync("Create Profile", "Select an Apple identity first.");
            return;
        }

        var identityVersion = Volatile.Read(ref identitySelectionVersion);
        var page = new MauiSherpa.Pages.Modals.CreateProfilePage(BridgeHolder);
        var result = await FormModalService.ShowAsync<AppleProfile>(page);
        if (result != null)
        {
            if (identityVersion == Volatile.Read(ref identitySelectionVersion))
            {
                await SecretSyncCoordinator.SetDefaultProvidersAsync(
                    new SecretItemRef(
                        SecretItemKind.ProvisioningProfile,
                        result.Id,
                        result.Name) { AppleIdentityId = identityId });
            }
            else
            {
                await AlertService.ShowAlertAsync(
                    "Profile Backup Not Started",
                    "The Apple identity changed while the profile was being created. Select the identity used to create it and back up the profile manually.");
            }

            await RefreshData(forceRefresh: true);
        }
    }

    private async Task ShowEditDialog(AppleProfile profile)
    {
        var page = new MauiSherpa.Pages.Modals.EditProfilePage(BridgeHolder, profile);
        var result = await FormModalService.ShowAsync<AppleProfile>(page);
        if (result != null)
            await RefreshData(forceRefresh: true);
    }

    private IEnumerable<AppleProfile> FilteredProfiles => profiles
        .Where(p => string.IsNullOrEmpty(searchQuery) || 
                    p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Uuid.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(filterState) || (p.State?.Equals(filterState, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(p => string.IsNullOrEmpty(filterType) || (p.ProfileType?.Replace("_", "").Contains(filterType, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(p => string.IsNullOrEmpty(filterPlatform) || GetProfilePlatform(p).Equals(filterPlatform, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => p.State?.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase) ?? false) // Active first
        .ThenByDescending(p => p.ExpirationDate > AppClock.UtcNow) // Non-expired next
        .ThenBy(p => p.Name);

    private void ClearFilters()
    {
        searchQuery = "";
        filterState = "";
        filterType = "";
        filterPlatform = "";
    }

    protected override async Task OnInitializedAsync()
    {
        ConfigureToolbarItems();
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        ToolbarService.SearchTextChanged += OnSearchTextChanged;
        ToolbarService.FilterChanged += OnFilterChanged;

        try { var settings = await SettingsService.GetSettingsAsync(); demoMode = settings.Preferences.DemoMode; } catch { }
        IdentityState.OnSelectionChanged += OnIdentityChanged;
        LocalVaultAccess.StateChanged += OnLocalVaultStateChanged;
        if (IdentityState.SelectedIdentity != null)
            await RefreshData();
    }

    private void OnIdentityChanged()
    {
        Interlocked.Increment(ref identitySelectionVersion);
        InvokeAsync(async () =>
        {
            profiles.Clear();
            profilesIdentityId = null;
            isLoading = false;
            if (isSelectionMode)
                CancelSelectionMode();
            else
                UpdateToolbarItemStates();

            StateHasChanged();
            await RefreshData();
            StateHasChanged();
        });
    }

    private void OnLocalVaultStateChanged() => OnIdentityChanged();

    private void OnSearchTextChanged(string text)
    {
        InvokeAsync(() => { searchQuery = text; StateHasChanged(); });
    }

    private void OnFilterChanged(string filterId, int selectedIndex)
    {
        InvokeAsync(() =>
        {
            switch (filterId)
            {
                case "state":
                    filterState = selectedIndex switch { 1 => "ACTIVE", 2 => "INVALID", _ => "" };
                    break;
                case "type":
                    filterType = selectedIndex switch { 1 => "DEVELOPMENT", 2 => "ADHOC", 3 => "APPSTORE", _ => "" };
                    break;
                case "platform":
                    filterPlatform = selectedIndex switch { 1 => "IOS", 2 => "TVOS", 3 => "MAC_OS", _ => "" };
                    break;
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
        ToolbarService.SearchTextChanged -= OnSearchTextChanged;
        ToolbarService.FilterChanged -= OnFilterChanged;
        IdentityState.OnSelectionChanged -= OnIdentityChanged;
        LocalVaultAccess.StateChanged -= OnLocalVaultStateChanged;
    }

    private void OnToolbarItemClicked(string actionId)
    {
        InvokeAsync(async () =>
        {
            switch (actionId)
            {
                case "refresh": await RefreshData(forceRefresh: true); break;
                case "create": await ShowCreateDialog(); break;
                case "profiles-folder": await RevealProfilesFolder(); break;
                case "cleanup": await ShowCleanupDialog(); break;
                case "select": BeginSelectionMode(); break;
                case "backup-selected": await BackUpSelectedAsync(); break;
                case "install-selected": await InstallSelectedAsync(); break;
                case "export-selected": await ExportSelectedAsync(); break;
                case "cancel-selection": CancelSelectionMode(); break;
            }
            StateHasChanged();
        });
    }

    private async Task RefreshData(bool forceRefresh = false)
    {
        var identityId = IdentityState.SelectedIdentity?.Id;
        if (string.IsNullOrWhiteSpace(identityId) || LocalVaultAccess.GetState().RequiresUserAction)
        {
            UpdateToolbarItemStates();
            return;
        }

        var identityVersion = Volatile.Read(ref identitySelectionVersion);
        isLoading = true;
        UpdateToolbarItemStates();
        errorMessage = "";
        
        ToastMessage? toast = null;
        if (forceRefresh)
        {
            toast = ToastService.Show("Refreshing profiles...", ToastType.Info);
        }
        
        try
        {
            // If force refresh, invalidate the cache first
            if (forceRefresh)
            {
                await Mediator.FlushStores($"apple:profiles:{identityId}");
            }
            
            var request = new GetProfilesRequest(identityId);
            var (_, result) = await Mediator.Request(request);
            if (!IsCurrentIdentity(identityId, identityVersion))
                return;

            profiles = result.ToList();
            profilesIdentityId = identityId;
            selectedProfileIds.IntersectWith(profiles.Select(profile => profile.Id));
            if (isSelectionMode)
                UpdateToolbarItemStates();
        }
        catch (Exception ex)
        {
            if (IsCurrentIdentity(identityId, identityVersion))
                errorMessage = $"Failed to load profiles: {ex.Message}";
        }
        finally
        {
            if (IsCurrentIdentity(identityId, identityVersion))
            {
                isLoading = false;
                UpdateToolbarItemStates();
            }
            if (toast != null) ToastService.Dismiss(toast);
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsCurrentIdentity(string identityId, int identityVersion) =>
        identityVersion == Volatile.Read(ref identitySelectionVersion) &&
        string.Equals(IdentityState.SelectedIdentity?.Id, identityId, StringComparison.Ordinal);

    private static string GetProfilePlatform(AppleProfile profile) =>
        AppleProfileTypes.GetPlatform(profile.ProfileType, profile.Platform);

    private string FormatProfileType(string profileType)
    {
        return profileType.Replace("_", " ") switch
        {
            var t when t.Contains("DEVELOPMENT") => "Development",
            var t when t.Contains("AD HOC") || t.Contains("ADHOC") => "Ad Hoc",
            var t when t.Contains("APP STORE") || t.Contains("APPSTORE") => "App Store",
            _ => profileType.Replace("_", " ")
        };
    }

    private async Task DownloadProfile(AppleProfile profile)
    {
        openDropdown = null;
        isLoading = true;
        UpdateToolbarItemStates();
        try
        {
            // Save to Downloads folder by default
            var downloadsFolder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            await SaveDownloadedProfileAsync(profile, downloadsFolder, "Downloads");
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to download profile: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            UpdateToolbarItemStates();
        }
    }
    
    private async Task DownloadProfileTo(AppleProfile profile)
    {
        openDropdown = null;
        isLoading = true;
        UpdateToolbarItemStates();
        try
        {
            var folder = await DialogService.PickFolderAsync("Select Download Location");
            if (string.IsNullOrEmpty(folder)) return;

            await SaveDownloadedProfileAsync(profile, folder);
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to download profile: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            UpdateToolbarItemStates();
        }
    }
    
    private static string SanitizeFileName(string fileName)
    {
        var invalid = Path.GetInvalidFileNameChars();
        return string.Join("_", fileName.Split(invalid, StringSplitOptions.RemoveEmptyEntries));
    }

    private async Task<string?> SaveDownloadedProfileAsync(
        AppleProfile profile,
        string folder,
        string? locationName = null)
    {
        var content = await AppleService.DownloadProfileAsync(profile.Id);
        var extension = profile.Platform?.ToUpperInvariant() switch
        {
            "MACOS" or "MAC_OS" or "OSX" => ".provisionprofile",
            _ => ".mobileprovision"
        };
        var fileName = SanitizeFileName($"{profile.Name}{extension}");
        var plan = await ProvisioningProfileDownloadManager.PlanAsync(
            folder,
            fileName,
            profile,
            content);

        var replaceConfirmedConflicts = false;
        if (plan.RequiresConfirmation)
        {
            var message = plan.Conflict == ProvisioningProfileDownloadConflict.NewerProfile
                ? $"A newer local copy of '{profile.Name}' already exists. Replace it with the downloaded profile?"
                : $"A file named '{fileName}' already exists and could not be verified as an older copy of this profile. Replace it?";
            replaceConfirmedConflicts = await AlertService.ShowConfirmAsync(
                "Replace Existing Profile?",
                message,
                "Replace",
                "Cancel");
            if (!replaceConfirmedConflicts)
                return null;
        }

        var replacementCount = plan.AutomaticReplacementPaths.Count +
                               (replaceConfirmedConflicts ? plan.ConfirmedReplacementPaths.Count : 0);
        await ProvisioningProfileDownloadManager.SaveAsync(
            plan,
            content,
            replaceConfirmedConflicts);

        var location = locationName is null
            ? Path.GetFileName(plan.TargetPath)
            : $"{locationName}: {Path.GetFileName(plan.TargetPath)}";
        var messagePrefix = replacementCount > 0
            ? $"Replaced {replacementCount} older downloaded {(replacementCount == 1 ? "copy" : "copies")}"
            : "Profile saved";
        await AlertService.ShowToastAsync($"{messagePrefix} to {location}");
        return plan.TargetPath;
    }

    private async Task RevealProfilesFolder()
    {
        try
        {
            var directories = await AppleService.GetProvisioningProfilesDirectoriesAsync();
            foreach (var directory in directories)
            {
                Directory.CreateDirectory(directory);
                FileSystem.RevealInFileManager(directory);
            }
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Profiles Folder", $"Unable to open the profiles folder: {ex.Message}");
        }
    }

    private async Task ShowCleanupDialog()
    {
        var page = new MauiSherpa.Pages.Modals.ProvisioningProfileCleanupPage(BridgeHolder);
        var deleted = await FormModalService.ShowAsync<int>(page);
        if (deleted > 0)
            await AlertService.ShowToastAsync($"Deleted {deleted} provisioning {(deleted == 1 ? "profile" : "profiles")}");
    }

    private async Task RevealInstalledProfile(AppleProfile profile)
    {
        openDropdown = null;
        try
        {
            var paths = await AppleService.FindInstalledProfilePathsAsync(profile.Uuid);
            if (paths.Count == 0)
            {
                await AlertService.ShowToastAsync($"'{profile.Name}' is not installed locally");
                return;
            }

            foreach (var path in paths)
                FileSystem.RevealInFileManager(path);
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Reveal Profile", $"Unable to reveal the profile: {ex.Message}");
        }
    }

    private async Task InstallProfile(AppleProfile profile)
    {
        openDropdown = null;
        
        var result = await OperationModal.RunAsync(
            "Install Profile",
            $"Installing '{profile.Name}' to system...",
            async ctx =>
            {
                ctx.SetStatus("Downloading profile...");
                ctx.LogInfo($"Installing profile: {profile.Name}");
                
                var path = await AppleService.InstallProfileAsync(profile.Id);
                ctx.LogSuccess($"Profile installed: {Path.GetFileName(path)}");
                return true;
            });
    }

    private async Task InstallAllProfiles()
    {
        var installable = GetInstallableProfiles();
        if (!installable.Any())
        {
            await AlertService.ShowToastAsync("No active profiles to install");
            return;
        }

        await InstallProfilesAsync(installable, "Install All Profiles");
    }

    private async Task<bool> InstallProfilesAsync(IReadOnlyList<AppleProfile> installable, string title)
    {
        var result = await OperationModal.RunAsync(
            title,
            $"Installing {installable.Count} profile(s) to system...",
            async ctx =>
            {
                ctx.SetStatus("Starting batch installation...");
                ctx.LogInfo($"Installing {installable.Count} profiles");

                var installed = 0;
                foreach (var profile in installable)
                {
                    ctx.CancellationToken.ThrowIfCancellationRequested();
                    ctx.SetStatus($"Installing {profile.Name}...");
                    ctx.SetProgress((installed * 100) / installable.Count);
                    
                    try
                    {
                        var path = await AppleService.InstallProfileAsync(profile.Id);
                        ctx.LogSuccess($"Installed: {profile.Name}");
                        installed++;
                    }
                    catch (Exception ex)
                    {
                        ctx.LogError($"Failed to install {profile.Name}: {ex.Message}");
                    }
                }

                ctx.SetProgress(100);
                ctx.LogInfo($"Installed {installed} of {installable.Count} profile(s)");
                return installed == installable.Count;
            });
        return result.Success;
    }

    private void ConfigureToolbarItems()
    {
        if (isSelectionMode)
        {
            ToolbarService.SetItems(
                new ToolbarAction("backup-selected", "Back Up", "icloud.and.arrow.up"),
                new ToolbarAction("install-selected", "Install", "square.and.arrow.down"),
                new ToolbarAction("export-selected", "Export", "square.and.arrow.up"),
                new ToolbarAction("cancel-selection", "Cancel", "xmark", IsPrimary: false));
        }
        else
        {
            ToolbarService.SetItems(
                new ToolbarAction("refresh", "Refresh", "arrow.clockwise"),
                new ToolbarAction("create", "Create Profile", "plus"),
                new ToolbarAction("profiles-folder", "Profiles Folder", "folder"),
                new ToolbarAction("cleanup", "Clean Up", "trash"),
                new ToolbarAction("select", "Select", "checkmark.circle"));
        }
        UpdateToolbarItemStates();

        // SetItems resets the native search field and filters; put them back with the
        // page's current values so switching modes doesn't strand active filters.
        ToolbarService.SetSearch("Search profiles...");
        if (!string.IsNullOrEmpty(searchQuery))
            ToolbarService.NotifySearchTextChanged(searchQuery);
        ToolbarService.SetFilters(
            new ToolbarFilter("state", "State", ["All States", "Active", "Invalid"],
                filterState switch { "ACTIVE" => 1, "INVALID" => 2, _ => 0 }),
            new ToolbarFilter("type", "Type", ["All Types", "Development", "Ad Hoc", "App Store"],
                filterType switch { "DEVELOPMENT" => 1, "ADHOC" => 2, "APPSTORE" => 3, _ => 0 }),
            new ToolbarFilter("platform", "Platform", ["All Platforms", "iOS", "tvOS", "macOS"],
                filterPlatform switch { "IOS" => 1, "TVOS" => 2, "MAC_OS" => 3, _ => 0 }));
    }

    private bool AllVisibleSelected
    {
        get
        {
            var visibleIds = FilteredProfiles.Select(profile => profile.Id).ToList();
            return visibleIds.Count > 0 && visibleIds.All(selectedProfileIds.Contains);
        }
    }

    private void BeginSelectionMode()
    {
        openDropdown = null;
        isSelectionMode = true;
        selectedProfileIds.Clear();
        ConfigureToolbarItems();
    }

    private void CancelSelectionMode()
    {
        isSelectionMode = false;
        selectedProfileIds.Clear();
        ConfigureToolbarItems();
    }

    private void ToggleProfileSelection(string profileId, bool selected)
    {
        if (selected)
            selectedProfileIds.Add(profileId);
        else
            selectedProfileIds.Remove(profileId);
        UpdateToolbarItemStates();
    }

    private void ToggleAllVisible(ChangeEventArgs args)
    {
        var visibleIds = FilteredProfiles.Select(profile => profile.Id).ToList();
        if (args.Value is bool selected && selected)
            selectedProfileIds.UnionWith(visibleIds);
        else
            selectedProfileIds.ExceptWith(visibleIds);
        UpdateToolbarItemStates();
    }

    private void UpdateToolbarItemStates()
    {
        var ready = IdentityState.SelectedIdentity != null &&
            !LocalVaultAccess.GetState().RequiresUserAction &&
            !isLoading;

        if (isSelectionMode)
        {
            var hasSelection = ready && selectedProfileIds.Count > 0;
            ToolbarService.SetItemEnabled("backup-selected", hasSelection);
            ToolbarService.SetItemEnabled("install-selected", hasSelection);
            ToolbarService.SetItemEnabled("export-selected", hasSelection);
        }
        else
        {
            ToolbarService.SetItemEnabled("refresh", ready);
            ToolbarService.SetItemEnabled("create", ready);
            ToolbarService.SetItemEnabled("cleanup", ready && profiles.Count > 0);
            ToolbarService.SetItemEnabled("select", ready && profiles.Count > 0);
        }
    }

    private List<AppleProfile> GetSelectedProfiles() => profiles
        .Where(profile => selectedProfileIds.Contains(profile.Id))
        .ToList();

    private async Task BackUpSelectedAsync()
    {
        var selected = GetSelectedProfiles();
        if (selected.Count == 0)
            return;

        var identityId = profilesIdentityId;
        if (string.IsNullOrWhiteSpace(identityId) ||
            !string.Equals(IdentityState.SelectedIdentity?.Id, identityId, StringComparison.Ordinal))
        {
            await AlertService.ShowAlertAsync(
                "Back Up Profiles",
                "The Apple identity changed. Wait for the profiles to reload and select them again.");
            return;
        }

        var items = selected.Select(profile =>
            new SecretItemRef(SecretItemKind.ProvisioningProfile, profile.Id, profile.Name)
            {
                AppleIdentityId = identityId
            }).ToArray();
        var provider = await SecretBackupActions.PickProviderAsync(
            CloudSecretsService,
            AlertService,
            $"Back up {selected.Count} profile(s) to");
        if (provider is null)
            return;

        var queued = await SecretBackupActions.QueueBackupAsync(
            SecretSyncCoordinator,
            items,
            provider.Id);

        await AlertService.ShowToastAsync($"Backing up {queued} profile(s) to {provider.Name}");
        CancelSelectionMode();
    }

    private async Task InstallSelectedAsync()
    {
        var selected = GetSelectedProfiles();
        if (selected.Count == 0)
            return;

        if (await InstallProfilesAsync(selected, "Install Profiles"))
            CancelSelectionMode();
    }

    private async Task ExportSelectedAsync()
    {
        var selected = GetSelectedProfiles();
        if (selected.Count == 0)
            return;

        var identityId = profilesIdentityId;
        if (string.IsNullOrWhiteSpace(identityId) ||
            !string.Equals(IdentityState.SelectedIdentity?.Id, identityId, StringComparison.Ordinal))
        {
            await AlertService.ShowAlertAsync(
                "Export Profiles",
                "The Apple identity changed. Wait for the profiles to reload and select them again.");
            return;
        }

        var folder = await DialogService.PickFolderAsync($"Export {selected.Count} Profile(s) To");
        if (string.IsNullOrEmpty(folder))
            return;

        isLoading = true;
        UpdateToolbarItemStates();
        var saved = 0;
        var failures = new List<string>();
        try
        {
            foreach (var profile in selected)
            {
                try
                {
                    var content = await AppleService.DownloadProfileForIdentityAsync(profile.Id, identityId);
                    await ProvisioningProfileExportService.SaveAsync(folder, profile, content);
                    saved++;
                }
                catch (Exception ex)
                {
                    failures.Add($"{profile.Name}: {ex.Message}");
                }
            }
        }
        finally
        {
            isLoading = false;
            UpdateToolbarItemStates();
        }

        if (failures.Count > 0)
        {
            await AlertService.ShowAlertAsync(
                "Export Incomplete",
                $"Exported {saved} of {selected.Count} profile(s). These failed:\n\n{string.Join("\n", failures)}");
        }
        else
        {
            await AlertService.ShowToastAsync($"Exported {saved} profile(s) to {Path.GetFileName(folder)}");
            CancelSelectionMode();
        }
    }

    private async Task DeleteProfile(AppleProfile profile)
    {
        var confirm = await AlertService.ShowConfirmAsync(
            "Delete Profile",
            $"Are you sure you want to delete '{profile.Name}'?");

        if (!confirm) return;

        var result = await OperationModal.RunAsync(
            "Delete Profile",
            $"Deleting '{profile.Name}'...",
            async ctx =>
            {
                ctx.SetStatus("Deleting profile...");
                await AppleService.DeleteProfileAsync(profile.Id);
                ctx.LogSuccess("Profile deleted");
                return true;
            },
            canCancel: false);

        if (result.Success)
        {
            // Immediately remove from list for responsive UI
            profiles.Remove(profile);
            StateHasChanged();
            
            await RefreshData(forceRefresh: true);
        }
    }

    private async Task CopyToClipboard(string text)
    {
        await DialogService.CopyToClipboardAsync(text);
        await AlertService.ShowToastAsync("Copied to clipboard");
    }
}
