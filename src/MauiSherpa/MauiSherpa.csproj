<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Razor" />

  <PropertyGroup>
    <!-- Windows-only head. macOS is served by src/MauiSherpa.MacOS (net10.0-macos AppKit head),
         which is what CI publishes; the Mac Catalyst head has been retired. -->
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>MauiSherpa</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SherpaMsixBuild Condition="'$(SherpaMsixBuild)' == ''">false</SherpaMsixBuild>
    <WindowsPackageType Condition="'$(SherpaMsixBuild)' != 'true'">None</WindowsPackageType>
    
    <ApplicationTitle>MAUI Sherpa</ApplicationTitle>
    <ApplicationId>codes.redth.mauisherpa</ApplicationId>
    <ApplicationDisplayVersion>$(AppVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SherpaMsixBuild)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <SherpaReleaseRepository Condition="'$(SherpaReleaseRepository)' == ''">Redth/MAUI.Sherpa</SherpaReleaseRepository>
  </PropertyGroup>

  <!-- Workaround for WindowsAppSDK Issue #3337 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != '' and '$(SherpaMsixBuild)' != 'true'">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent" />
    <PackageReference Include="AathifMahir.Maui.MauiIcons.FontAwesome.Brand" />
    <PackageReference Include="Blazorise.Icons.FontAwesome" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.Maui.DevFlow.Blazor" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Sentry.Maui" />
    <PackageReference Include="Shiny.Mediator.Caching.MicrosoftMemoryCache" />
    <PackageReference Include="Shiny.Mediator.Blazor" />
    <PackageReference Include="Shiny.Mediator.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MauiSherpa.AppInspector\MauiSherpa.AppInspector.csproj" />
    <ProjectReference Include="..\MauiSherpa.Core\MauiSherpa.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources/Images/*" />
    <MauiImage Update="Resources/Images/dotnet_bot.svg" BaseSize="168,208" />
    <MauiFont Include="Resources/Fonts/*" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\..\build\BundleUnxip.targets" />

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Razor" />

  <ItemGroup Condition="'$(SherpaMsixBuild)' == 'true'">
    <AppxManifest Remove="@(AppxManifest)" />
    <AppxManifest Include="$(SherpaMsixManifest)" />
    <Content Include="$(SherpaAppInstaller)" Link="install.appinstaller"
             TargetPath="install.appinstaller" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <AssemblyMetadata Include="SherpaReleaseRepository" Value="$(SherpaReleaseRepository)" />
  </ItemGroup>

  <Target Name="ValidateSherpaMsixInputs" BeforeTargets="PrepareForBuild"
          Condition="'$(SherpaMsixBuild)' == 'true'">
    <Error Condition="!$([MSBuild]::IsOSPlatform('windows'))"
           Text="MSIX packaging requires Windows. Use build/windows/Build-Msix.ps1 on a Windows machine." />
    <Error Condition="'$(SherpaMsixManifest)' == '' or !Exists('$(SherpaMsixManifest)')"
           Text="Generate the MSIX manifest with build/windows/Build-Msix.ps1." />
    <Error Condition="'$(SherpaAppInstaller)' == '' or !Exists('$(SherpaAppInstaller)')"
           Text="Generate the App Installer metadata with build/windows/Build-Msix.ps1." />
    <Error Condition="'$(PublishSingleFile)' == 'true' or '$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'"
           Text="Sherpa MSIX builds must not enable single-file publishing, NativeAOT, or trimming." />
  </Target>

  <!-- Keep the Windows head as a no-op elsewhere without replacing the real SDK targets on
       Windows. A conditional import prevents the no-op target declarations from being evaluated. -->
  <Import Project="..\..\build\SkipWindowsHeadOnNonWindows.targets"
          Condition="!$([MSBuild]::IsOSPlatform('windows'))" />

</Project>
