@using MauiSherpa.Core.Interfaces
@using Microsoft.AspNetCore.Components
@inject IGoogleIdentityService IdentityService
@inject IGoogleIdentityStateService IdentityState
@inject IPlatformService PlatformInfo
@inject NavigationManager Navigation
@inject ILocalVaultAccessService LocalVaultAccess
@implements IDisposable

@if (RequiresLocalVaultAccess)
{
    <div class="vault-access-card">
        <div class="vault-access-content">
            <span class="sherpa-icon-well sherpa-icon-well-accent"><i class="fa-solid fa-key fa-fw"></i></span>
            <div>
                <strong>Unlock Local Vault to use Google services</strong>
                <p>Google service account credentials are stored in the Local Vault. Grant access to continue.</p>
            </div>
        </div>
        <button class="btn btn-primary" @onclick="UnlockLocalVaultAsync" disabled="@isUnlocking">
            <i class="fa-solid fa-fw @(isUnlocking ? "fa-spinner fa-spin" : "fa-unlock")"></i> Unlock Local Vault
        </button>
    </div>
}
else if (PlatformInfo.HasNativeToolbar)
{
    @* Identity picker is in the native toolbar (macOS/Linux/Windows) *@
}
else if (identities.Count == 0)
{
    <div class="no-identity-container">
        <div class="no-identity-icon">
            <i class="fa-brands fa-google" aria-hidden="true"></i>
        </div>
        <h2>No Google Service Account</h2>
        <p>Configure your Google Cloud / Firebase service account credentials to send push notifications and manage your projects.</p>
        <button class="btn btn-primary" @onclick="GoToSettings">
            <i class="fa-solid fa-gear fa-fw"></i> Configure in Settings
        </button>
    </div>
}
else
{
    <div class="identity-picker">
        <label><i class="fa-brands fa-google fa-fw"></i> Google Identity:</label>
        <SherpaSelect TValue="string"
                      Value="@selectedIdentityId"
                      ValueChanged="OnIdentitySelected"
                      Options="@IdentityOptions"
                      LeadingIcon="fa-brands fa-google"
                      AriaLabel="Google identity"
                      Class="identity-select" />
    </div>
}

<style>
    .identity-picker {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: var(--surface-well);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-md);
        margin-bottom: 1.25rem;
    }

    .identity-picker label {
        font-weight: 500;
        color: var(--text-secondary);
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .identity-picker .identity-select {
        flex: 1;
        max-width: 300px;
    }

    .no-identity-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3.75rem 2.5rem;
        background: var(--surface-card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-subtle);
        text-align: center;
        margin: 1.25rem 0;
    }

    .no-identity-icon {
        width: 56px;
        height: 56px;
        border-radius: var(--radius-lg);
        background: var(--accent-soft);
        border: 1px solid var(--accent-border);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .no-identity-icon i {
        font-size: 1.75rem;
        color: var(--accent);
    }

    .no-identity-container h2 {
        margin: 0 0 0.75rem 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .no-identity-container p {
        margin: 0 0 1.5rem 0;
        font-size: 0.9375rem;
        color: var(--text-muted);
        max-width: 400px;
        line-height: 1.6;
    }

    .no-identity-container .btn-primary {
        padding: 0.75rem 1.5rem;
        font-size: 0.9375rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .vault-access-card { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem; margin: 1rem 0; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
    .vault-access-content { display: flex; align-items: flex-start; gap: 0.875rem; color: var(--text-secondary); }
    .vault-access-content > i { color: var(--accent); margin-top: 0.125rem; }
    .vault-access-content strong { display: block; color: var(--text-primary); margin-bottom: 0.25rem; }
    .vault-access-content p { margin: 0; color: var(--text-muted); font-size: 0.875rem; }
</style>

@code {
    private List<GoogleIdentity> identities = new();
    private string selectedIdentityId = "";
    private bool isUnlocking;

    private bool RequiresLocalVaultAccess => LocalVaultAccess.GetState().RequiresUserAction;
    private IReadOnlyList<SherpaSelectOption<string>> IdentityOptions =>
        identities.Select(identity => new SherpaSelectOption<string>(
            identity.Id,
            $"{identity.Name} ({identity.ProjectId})",
            identity.ClientEmail,
            "fa-brands fa-google")).ToArray();

    protected override async Task OnInitializedAsync()
    {
        LocalVaultAccess.StateChanged += HandleLocalVaultStateChanged;
        IdentityState.OnSelectionChanged += HandleExternalSelectionChange;
        if (RequiresLocalVaultAccess)
        {
            IdentityState.SetSelectedIdentity(null);
            return;
        }

        await LoadIdentitiesAsync();
    }

    private async Task LoadIdentitiesAsync()
    {
        try
        {
            identities = (await IdentityService.GetIdentitiesAsync()).ToList();
        }
        catch (LocalVaultUnavailableException)
        {
            identities = new();
            selectedIdentityId = "";
            IdentityState.SetSelectedIdentity(null);
            return;
        }

        var preferredIdentityId = IdentityState.SelectedIdentity?.Id ?? IdentityState.LastSelectedIdentityId;
        if (!string.IsNullOrWhiteSpace(preferredIdentityId))
        {
            var selected = identities.FirstOrDefault(i => i.Id == preferredIdentityId);
            if (selected != null)
            {
                selectedIdentityId = selected.Id;
                IdentityState.SetSelectedIdentity(selected);
            }
            else if (identities.Count > 0)
            {
                selectedIdentityId = identities[0].Id;
                IdentityState.SetSelectedIdentity(identities[0]);
            }
            else
            {
                selectedIdentityId = "";
                IdentityState.SetSelectedIdentity(null);
            }
        }
        else if (identities.Count > 0)
        {
            selectedIdentityId = identities[0].Id;
            IdentityState.SetSelectedIdentity(identities[0]);
        }

    }

    private void HandleLocalVaultStateChanged()
    {
        InvokeAsync(async () =>
        {
            if (RequiresLocalVaultAccess)
                IdentityState.SetSelectedIdentity(null);
            else
                await LoadIdentitiesAsync();
            StateHasChanged();
        });
    }

    private async Task UnlockLocalVaultAsync()
    {
        isUnlocking = true;
        try
        {
            var state = await LocalVaultAccess.RequestAccessAsync();
            if (!state.RequiresUserAction)
                await LoadIdentitiesAsync();
        }
        finally
        {
            isUnlocking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSelectionChanged()
    {
        var identity = identities.FirstOrDefault(i => i.Id == selectedIdentityId);
        IdentityState.SetSelectedIdentity(identity);
    }

    private void OnIdentitySelected(string? identityId)
    {
        selectedIdentityId = identityId ?? "";
        OnSelectionChanged();
    }

    private void HandleExternalSelectionChange()
    {
        if (IdentityState.SelectedIdentity?.Id != selectedIdentityId)
        {
            selectedIdentityId = IdentityState.SelectedIdentity?.Id ?? "";
            InvokeAsync(StateHasChanged);
        }
    }

    private void GoToSettings()
    {
        Navigation.NavigateTo("settings");
    }

    public void Dispose()
    {
        IdentityState.OnSelectionChanged -= HandleExternalSelectionChange;
        LocalVaultAccess.StateChanged -= HandleLocalVaultStateChanged;
    }
}
