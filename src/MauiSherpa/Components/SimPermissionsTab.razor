@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Services
@inject ISimulatorService SimulatorService
@inject SimInspectorService Inspector
@inject IAlertService AlertService

<div class="sim-permissions-tab">
    @if (isLoading)
    {
        <div class="empty-state">
            <span class="sherpa-icon-well sherpa-icon-well-apple"><i class="fa-solid fa-spinner fa-spin fa-fw" aria-hidden="true"></i></span>
            <div class="empty-title">Loading permissions</div>
            <div class="empty-description">Reading privacy settings from the selected simulator.</div>
        </div>
    }
    else
    {
        <!-- Per-app permissions -->
        @if (appGroups.Count == 0 && !showQuickActions)
        {
            <div class="empty-state">
                <span class="sherpa-icon-well sherpa-icon-well-apple"><i class="fa-solid fa-shield-halved fa-fw" aria-hidden="true"></i></span>
                <div class="empty-title">No permissions set</div>
                <div class="empty-description">Use Quick Grant below, or permissions will appear after apps request them.</div>
            </div>
        }

        @foreach (var group in filteredGroups)
        {
            <div class="perm-app-section sherpa-list">
                <button class="perm-app-header" @onclick="() => ToggleApp(group.BundleId)">
                    <span class="sherpa-icon-well sherpa-icon-well-sm sherpa-icon-well-apple">
                        <i class="fa-solid fa-shield-halved fa-fw" aria-hidden="true"></i>
                    </span>
                    <span class="perm-app-id">@group.BundleId</span>
                    <span class="sherpa-badge sherpa-badge-neutral">@group.Permissions.Count</span>
                    <i class="fa-solid @(expandedApps.Contains(group.BundleId) ? "fa-chevron-down" : "fa-chevron-right") fa-fw perm-chevron" aria-hidden="true"></i>
                </button>
                @if (expandedApps.Contains(group.BundleId))
                {
                    <div class="perm-table">
                        @foreach (var perm in group.Permissions)
                        {
                            <div class="perm-row sherpa-list-row">
                                <div class="perm-info">
                                    <span class="sherpa-icon-well sherpa-icon-well-sm sherpa-icon-well-neutral">
                                        <i class="fa-solid @perm.Permission.Icon fa-fw perm-icon" aria-hidden="true"></i>
                                    </span>
                                    <span class="perm-name">@perm.Permission.DisplayName</span>
                                    @if (perm.HasPlistKey == true)
                                    {
                                        <i class="fa-solid fa-file-circle-check fa-fw perm-plist-ok" title="@($"{perm.Permission.PlistKey}: \"{perm.UsageDescription}\"")"></i>
                                    }
                                    else if (perm.HasPlistKey == false)
                                    {
                                        <i class="fa-solid fa-triangle-exclamation fa-fw perm-plist-missing" title="@($"Missing {perm.Permission.PlistKey} in Info.plist — required for App Store submission")"></i>
                                    }
                                </div>
                                <div class="perm-status">
                                    <span class="sherpa-badge @GetStatusBadgeClass(perm.Status)">
                                        @StatusIcon(perm.Status) @perm.Status
                                    </span>
                                </div>
                                <div class="perm-actions">
                                    @if (perm.Permission.CanModify)
                                    {
                                        @if (perm.Status != PermissionStatus.Allowed)
                                        {
                                            <button class="btn btn-sm btn-success" disabled="@isBusy"
                                                    @onclick="() => GrantAsync(perm)">
                                                <i class="fa-solid fa-check fa-fw" aria-hidden="true"></i> Grant
                                            </button>
                                        }
                                        @if (perm.Status == PermissionStatus.Allowed || perm.Status == PermissionStatus.Limited)
                                        {
                                            <button class="btn btn-sm btn-ghost-danger btn-icon" disabled="@isBusy"
                                                    @onclick="() => RevokeAsync(perm)" title="Revoke" aria-label="Revoke @perm.Permission.DisplayName">
                                                <i class="fa-solid fa-ban fa-fw" aria-hidden="true"></i>
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-ghost-danger btn-icon" disabled="@isBusy"
                                                @onclick="() => ResetAsync(perm)" title="Reset to 'not determined' — app will prompt again"
                                                aria-label="Reset @perm.Permission.DisplayName">
                                            <i class="fa-solid fa-rotate-left fa-fw" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="perm-readonly" title="This permission can't be modified via simctl">read-only</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Quick Actions -->
        <div class="perm-app-section sherpa-list">
            <button class="perm-app-header perm-quick-header" @onclick="() => showQuickActions = !showQuickActions">
                <span class="sherpa-icon-well sherpa-icon-well-sm sherpa-icon-well-accent">
                    <i class="fa-solid fa-bolt fa-fw" aria-hidden="true"></i>
                </span>
                <span class="perm-app-id">Quick Grant / Revoke</span>
                <i class="fa-solid @(showQuickActions ? "fa-chevron-down" : "fa-chevron-right") fa-fw perm-chevron" aria-hidden="true"></i>
            </button>
            @if (showQuickActions)
            {
                <div class="tool-body">
                    <div class="tool-row combobox-container">
                        <label class="sherpa-meta-label">Bundle ID</label>
                        <input type="text" class="tool-input" value="@quickBundleId"
                               @oninput="OnQuickBundleIdInput"
                               @onfocus="() => showBundleDropdown = true"
                               @onblur="OnBundleInputBlur"
                               placeholder="Type or select a bundle ID..." />
                        @if (showBundleDropdown && filteredBundleIds.Any())
                        {
                            <div class="combobox-dropdown">
                                @foreach (var id in filteredBundleIds)
                                {
                                    <button class="combobox-option" @onmousedown="() => SelectBundleId(id)"
                                            @onmousedown:preventDefault>
                                        @id
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="tool-row">
                        <label class="sherpa-meta-label">Permission</label>
                        <SherpaSelect TValue="string"
                                      Value="@quickService"
                                      ValueChanged="@((string? value) => quickService = value ?? string.Empty)"
                                      Options="PermissionOptions"
                                      AriaLabel="Permission"
                                      Compact="true"
                                      Searchable="true"
                                      Class="sherpa-select-full" />
                    </div>
                    <div class="tool-actions">
                        <button class="btn btn-sm btn-success" disabled="@(!CanQuickAction || isBusy)" @onclick="QuickGrantAsync">
                            <i class="fa-solid fa-check fa-fw" aria-hidden="true"></i> Grant
                        </button>
                        <button class="btn btn-sm btn-ghost-danger" disabled="@(!CanQuickAction || isBusy)" @onclick="QuickRevokeAsync">
                            <i class="fa-solid fa-ban fa-fw" aria-hidden="true"></i> Revoke
                        </button>
                        <button class="btn btn-sm btn-ghost-danger" disabled="@(!CanQuickAction || isBusy)" @onclick="QuickResetAsync">
                            <i class="fa-solid fa-rotate-left fa-fw" aria-hidden="true"></i> Reset
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Reset All -->
        <div class="perm-reset-all">
            <button class="btn btn-sm btn-danger-soft" disabled="@isBusy" @onclick="ResetAllAsync">
                <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i> Reset All Permissions
            </button>
        </div>
    }
</div>

<style>
    .sim-permissions-tab {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: var(--space-2);
        gap: var(--space-2);
    }

    .perm-app-section {
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        overflow: hidden;
        flex-shrink: 0;
    }

    .perm-app-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        width: 100%;
        padding: var(--row-padding-y) var(--row-padding-x);
        color: var(--text-primary);
        background: transparent;
        border: 0;
        cursor: pointer;
        font: inherit;
        font-size: var(--font-size-sm);
        font-weight: 600;
        text-align: left;
    }
    .perm-app-header:hover { background: var(--surface-card-hover); }
    .perm-chevron { margin-inline-start: auto; color: var(--text-muted); font-size: 0.625rem; }
    .perm-app-id { min-width: 0; overflow: hidden; font-family: var(--font-mono); font-size: var(--font-size-xs); text-overflow: ellipsis; white-space: nowrap; }

    .perm-table {
        display: flex;
        flex-direction: column;
        background: var(--surface-well);
        border-top: 1px solid var(--border-hairline);
    }
    .perm-row {
        gap: var(--space-2);
        background: transparent;
    }
    .perm-info {
        display: flex;
        flex: 1 1 auto;
        align-items: center;
        gap: var(--space-2);
        min-width: 0;
    }
    .perm-icon { color: var(--text-muted); }
    .perm-name { overflow: hidden; color: var(--text-primary); font-size: var(--font-size-sm); text-overflow: ellipsis; white-space: nowrap; }
    .perm-plist-ok { color: var(--status-success-fg); cursor: help; }
    .perm-plist-missing { color: var(--status-warning-fg); cursor: help; }

    .perm-status { min-width: 96px; }
    .perm-actions { margin-left: auto; display: flex; gap: var(--space-1); align-items: center; }
    .perm-readonly { font-size: var(--font-size-xs); color: var(--text-muted); font-style: italic; }

    .perm-quick-header .perm-app-id { font-family: var(--font-sans); font-size: var(--font-size-sm); }

    .perm-reset-all {
        display: flex;
        justify-content: center;
        padding: var(--space-2) 0;
    }

    .tool-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-3);
        background: var(--surface-well);
        border-top: 1px solid var(--border-hairline);
    }
    .tool-row { display: flex; flex-direction: column; gap: var(--space-1); }
    .tool-input {
        width: 100%;
        min-height: var(--control-height-md);
        box-sizing: border-box;
        padding: 0 var(--control-padding-x);
        color: var(--text-primary);
        background: var(--surface-control);
        border: 1px solid var(--border-control);
        border-bottom-color: var(--border-control-bottom);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-control);
        outline: none;
        font: inherit;
        font-size: var(--font-size-sm);
    }
    .tool-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-ring);
    }
    .tool-actions { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1); }

    .combobox-container { position: relative; }
    .combobox-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 10;
        max-height: 160px;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: var(--space-1);
        background: var(--surface-popover);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-popover);
    }
    .combobox-option {
        display: block;
        width: 100%;
        padding: var(--space-2);
        color: var(--text-primary);
        background: transparent;
        border: 0;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        text-align: left;
    }
    .combobox-option:hover { color: var(--text-primary); background: var(--surface-card-hover); }

    @@media (max-width: 720px) {
        .perm-row { align-items: flex-start; flex-wrap: wrap; }
        .perm-status { min-width: 0; }
        .perm-actions { width: 100%; padding-inline-start: 40px; }
    }
</style>

@code {
    [Parameter] public string Udid { get; set; } = "";

    private bool isLoading = true;
    private bool isBusy;
    private bool showQuickActions;

    private List<AppPermissionGroup> appGroups = new();
    private HashSet<string> expandedApps = new();

    // Quick actions
    private string quickBundleId = "";
    private string quickService = "";
    private static readonly IReadOnlyList<SherpaSelectOption<string>> PermissionOptions =
        new[] { new SherpaSelectOption<string>("", "Select...") }
            .Concat(SimulatorPermissions.All
                .Where(permission => permission.CanModify && !string.IsNullOrEmpty(permission.SimctlService))
                .Select(permission => new SherpaSelectOption<string>(
                    permission.SimctlService!,
                    permission.DisplayName)))
            .ToArray();
    private bool showBundleDropdown;
    private List<string> installedBundleIds = new();
    private bool CanQuickAction => !string.IsNullOrWhiteSpace(quickBundleId) && !string.IsNullOrWhiteSpace(quickService);

    private IEnumerable<string> filteredBundleIds =>
        string.IsNullOrWhiteSpace(quickBundleId)
            ? installedBundleIds
            : installedBundleIds.Where(id => id.Contains(quickBundleId, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<AppPermissionGroup> filteredGroups => appGroups;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionsAsync();
    }

    private async Task LoadPermissionsAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var permissions = await SimulatorService.GetPermissionsAsync(Udid);
            appGroups = permissions
                .GroupBy(p => p.BundleId)
                .Select(g => new AppPermissionGroup(g.Key, g.OrderBy(p => p.Permission.DisplayName).ToList()))
                .OrderBy(g => g.BundleId)
                .ToList();

            // Load installed apps for the combobox
            var apps = await SimulatorService.GetInstalledAppsAsync(Udid);
            installedBundleIds = apps
                .Where(a => a.ApplicationType != "System")
                .Select(a => a.BundleId)
                .OrderBy(id => id)
                .ToList();

            // Auto-expand if few apps
            if (appGroups.Count <= 3)
            {
                foreach (var g in appGroups)
                    expandedApps.Add(g.BundleId);
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleApp(string bundleId)
    {
        if (!expandedApps.Remove(bundleId))
            expandedApps.Add(bundleId);
    }

    private void OnQuickBundleIdInput(ChangeEventArgs e)
    {
        quickBundleId = e.Value?.ToString() ?? "";
        showBundleDropdown = true;
    }

    private void SelectBundleId(string bundleId)
    {
        quickBundleId = bundleId;
        showBundleDropdown = false;
    }

    private async Task OnBundleInputBlur()
    {
        // Small delay to allow mousedown on dropdown option to fire first
        await Task.Delay(150);
        showBundleDropdown = false;
        StateHasChanged();
    }

    private static string StatusIcon(PermissionStatus status) => status switch
    {
        PermissionStatus.Allowed => "●",
        PermissionStatus.Denied => "●",
        PermissionStatus.Limited => "◐",
        _ => "○",
    };

    private static string GetStatusBadgeClass(PermissionStatus status) => status switch
    {
        PermissionStatus.Allowed => "sherpa-badge-success",
        PermissionStatus.Denied => "sherpa-badge-danger",
        PermissionStatus.Limited => "sherpa-badge-neutral",
        _ => "sherpa-badge-neutral",
    };

    private async Task GrantAsync(AppPermission perm)
    {
        if (perm.Permission.SimctlService is null) return;
        isBusy = true;
        StateHasChanged();

        try
        {
            var ok = await SimulatorService.GrantPermissionAsync(Udid, perm.BundleId, perm.Permission.SimctlService);
            if (!ok)
                await AlertService.ShowAlertAsync("Error", $"Failed to grant {perm.Permission.DisplayName}.");
            await LoadPermissionsAsync();
        }
        finally { isBusy = false; }
    }

    private async Task RevokeAsync(AppPermission perm)
    {
        if (perm.Permission.SimctlService is null) return;
        isBusy = true;
        StateHasChanged();

        try
        {
            var ok = await SimulatorService.RevokePermissionAsync(Udid, perm.BundleId, perm.Permission.SimctlService);
            if (!ok)
                await AlertService.ShowAlertAsync("Error", $"Failed to revoke {perm.Permission.DisplayName}.");
            await LoadPermissionsAsync();
        }
        finally { isBusy = false; }
    }

    private async Task ResetAsync(AppPermission perm)
    {
        if (perm.Permission.SimctlService is null) return;
        isBusy = true;
        StateHasChanged();

        try
        {
            var ok = await SimulatorService.ResetPermissionAsync(Udid, perm.BundleId, perm.Permission.SimctlService);
            if (!ok)
                await AlertService.ShowAlertAsync("Error", $"Failed to reset {perm.Permission.DisplayName}.");
            await LoadPermissionsAsync();
        }
        finally { isBusy = false; }
    }

    private async Task QuickGrantAsync()
    {
        if (!CanQuickAction) return;
        isBusy = true;
        StateHasChanged();

        try
        {
            var ok = await SimulatorService.GrantPermissionAsync(Udid, quickBundleId, quickService!);
            if (!ok)
                await AlertService.ShowAlertAsync("Error", "Failed to grant permission.");
            await LoadPermissionsAsync();
        }
        finally { isBusy = false; }
    }

    private async Task QuickRevokeAsync()
    {
        if (!CanQuickAction) return;
        isBusy = true;
        StateHasChanged();

        try
        {
            var ok = await SimulatorService.RevokePermissionAsync(Udid, quickBundleId, quickService!);
            if (!ok)
                await AlertService.ShowAlertAsync("Error", "Failed to revoke permission.");
            await LoadPermissionsAsync();
        }
        finally { isBusy = false; }
    }

    private async Task QuickResetAsync()
    {
        if (!CanQuickAction) return;
        isBusy = true;
        StateHasChanged();

        try
        {
            var ok = await SimulatorService.ResetPermissionAsync(Udid, quickBundleId, quickService!);
            if (!ok)
                await AlertService.ShowAlertAsync("Error", "Failed to reset permission.");
            await LoadPermissionsAsync();
        }
        finally { isBusy = false; }
    }

    private async Task ResetAllAsync()
    {
        var confirmed = await AlertService.ShowConfirmAsync(
            "Reset All Permissions",
            "This will reset all privacy permissions for every app on this simulator. Apps will prompt for permission again on next use. Continue?");
        if (!confirmed) return;

        isBusy = true;
        StateHasChanged();

        try
        {
            var ok = await SimulatorService.ResetAllPermissionsAsync(Udid);
            if (!ok)
                await AlertService.ShowAlertAsync("Error", "Failed to reset all permissions.");
            await LoadPermissionsAsync();
        }
        finally { isBusy = false; }
    }

    private record AppPermissionGroup(string BundleId, List<AppPermission> Permissions);
}
