@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Pages.Forms
@using MauiSherpa.Pages.Modals
@using MauiSherpa.Services
@inject IPushProjectService ProjectService
@inject IToolbarService ToolbarService
@inject IFormModalService FormModal
@inject HybridFormBridgeHolder BridgeHolder
@inject IAlertService AlertService
@inject ILoggingService Logger
@inject BlazorToastService ToastService
@implements IDisposable

@if (isLoading)
{
    <div class="loading-inline"><i class="fas fa-spinner fa-spin"></i> Loading projects...</div>
}
else if (ActiveProject == null)
{
    <div class="push-project-empty">
        <div class="empty-icon"><i class="fas fa-paper-plane"></i></div>
        <h2>@(projects.Count == 0 ? "No Push Projects" : "Select a Push Project")</h2>
        <p>@(projects.Count == 0
            ? "Create a project to configure credentials and start sending test notifications."
            : "Open a recent project below, or select a project from the toolbar.")</p>
        @if (projects.Count > 0)
        {
            <ul class="push-recent-projects" aria-label="Recent projects">
                @foreach (var project in projects.Take(5))
                {
                    <li>
                        <button type="button" class="push-project-link" @onclick="@(() => RunAction($"push-project:{project.Id}"))"
                                disabled="@(isActing || IsBusy)" title="@project.Name">
                            <i class="fas fa-folder-open" aria-hidden="true"></i>
                            <span>@project.Name</span>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </button>
                    </li>
                }
                <li class="push-create-link">
                    <button type="button" class="push-project-link" @onclick="CreateProject" disabled="@(isActing || IsBusy)">
                        <i class="fas fa-plus" aria-hidden="true"></i> Create Project
                    </button>
                </li>
            </ul>
        }
        else
        {
            <button class="btn btn-primary" @onclick="CreateProject" disabled="@(isActing || IsBusy)">
                <i class="fas fa-plus"></i> Create Project
            </button>
        }
    </div>
}

<style>
    .push-project-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3.75rem 2.5rem; text-align: center; background: var(--card-bg); border-radius: var(--card-radius); }
    .push-project-empty .empty-icon { font-size: 3rem; color: var(--text-muted); opacity: 0.3; margin-bottom: 1rem; }
    .push-project-empty h2 { margin: 0 0 0.5rem; font-size: 1.25rem; color: var(--text-primary); }
    .push-project-empty p { margin: 0 0 1.5rem; font-size: 0.875rem; color: var(--text-muted); max-width: 400px; }
    .push-recent-projects { list-style: none; padding: 0; margin: 0; width: 100%; max-width: 360px; }
    .push-project-link { display: flex; align-items: center; gap: 0.75rem; width: 100%; padding: 0.625rem 0.75rem; border: 0; border-radius: 0.375rem; background: transparent; color: var(--accent-primary); font-size: 0.875rem; text-align: left; cursor: pointer; }
    .push-project-link span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .push-project-link .fa-arrow-right { font-size: 0.75rem; }
    .push-project-link:hover:not(:disabled) { background: var(--bg-hover); }
    .push-project-link:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }
    .push-project-link:disabled { opacity: 0.5; cursor: default; }
    .push-create-link { border-top: 1px solid var(--border-color); margin-top: 0.375rem; padding-top: 0.375rem; }
</style>

@code {
    [Parameter] public PushProjectPlatform Platform { get; set; }
    [Parameter] public PushProject? ActiveProject { get; set; }
    [Parameter] public EventCallback<PushProject?> ActiveProjectChanged { get; set; }
    [Parameter] public EventCallback OnSaveRequested { get; set; }
    [Parameter] public Func<PushProject>? GetCurrentProject { get; set; }
    [Parameter] public bool IsDirty { get; set; }
    [Parameter] public bool IsBusy { get; set; }

    List<PushProject> projects = [];
    bool isLoading = true;
    bool isActing;
    string? toolbarProjectId;
    string? toolbarProjectName;
    string? toolbarProjectList;

    protected override async Task OnInitializedAsync()
    {
        ProjectService.OnProjectsChanged += OnProjectsChanged;
        ToolbarService.ToolbarItemClicked += OnToolbarItemClicked;
        await LoadProjects();
        isLoading = false;
        UpdateToolbar();
    }

    protected override void OnParametersSet()
    {
        if (!isLoading)
            UpdateToolbar();
    }

    async Task LoadProjects()
    {
        projects = (await ProjectService.GetProjectsAsync(Platform)).ToList();
    }

    void UpdateToolbar()
    {
        var projectList = string.Join("\n", projects.Select(p => $"{p.Id}:{p.Name}"));
        if (toolbarProjectId != ActiveProject?.Id || toolbarProjectName != ActiveProject?.Name || toolbarProjectList != projectList)
        {
            toolbarProjectId = ActiveProject?.Id;
            toolbarProjectName = ActiveProject?.Name;
            toolbarProjectList = projectList;
            var actions = new List<ToolbarAction>();
            if (projects.Count == 0)
                actions.Add(new("push-create", "Create Project", "plus"));
            else
            {
                var menu = projects.Select(p => new ToolbarAction($"push-project:{p.Id}", p.Name, "folder")).ToList();
                menu.Add(new("push-project-separator", "", "", IsSeparator: true));
                menu.Add(new("push-create", "+ Create Project", "plus"));
                actions.Add(new("push-projects", ActiveProject?.Name ?? "Select project...", "folder", MenuActions: menu));
            }
            if (ActiveProject != null)
            {
                actions.Add(new("push-edit", "Edit", "pencil", ToolTip: "Edit selected project"));
                actions.Add(new("push-copy", "Copy", "doc.on.doc", ToolTip: "Duplicate selected project"));
                actions.Add(new("push-delete", "Delete", "trash", ToolTip: "Delete selected project"));
                actions.Add(new("push-save", "Save", "square.and.arrow.down", ToolTip: "Save notification changes"));
            }
            ToolbarService.SetItems(actions.ToArray());
        }
        foreach (var action in ToolbarService.CurrentItems)
        {
            ToolbarService.SetItemEnabled(action.Id, !isActing && !IsBusy && (action.Id != "push-save" || IsDirty));
            foreach (var child in action.MenuActions ?? [])
                ToolbarService.SetItemEnabled(child.Id, !isActing && !IsBusy && !child.IsSeparator);
        }
    }

    void OnToolbarItemClicked(string id) => InvokeAsync(() => RunAction(id));

    Task CreateProject() => RunAction("push-create");

    async Task RunAction(string id)
    {
        if (isActing || IsBusy) return;
        isActing = true;
        UpdateToolbar();
        try
        {
            if (id.StartsWith("push-project:", StringComparison.Ordinal))
            {
                var project = projects.FirstOrDefault(p => p.Id == id["push-project:".Length..]);
                if (project != null && project.Id != ActiveProject?.Id && await ConfirmDiscard())
                    await ActiveProjectChanged.InvokeAsync(project);
            }
            else if (id == "push-save")
                await OnSaveRequested.InvokeAsync();
            else if (id == "push-create" || id == "push-edit")
            {
                if (id == "push-create" && !await ConfirmDiscard()) return;
                var project = id == "push-edit" ? GetCurrentProject?.Invoke() ?? ActiveProject : null;
                if (id == "push-edit" && project == null) return;
                var page = new PushProjectPage(BridgeHolder, project ?? new PushProject { Platform = Platform }, id == "push-create");
                var saved = await FormModal.ShowAsync(page);
                if (saved != null)
                {
                    await ProjectService.SaveProjectAsync(saved);
                    await LoadProjects();
                    await ActiveProjectChanged.InvokeAsync(saved);
                    ToastService.Show("Project saved.", ToastType.Success);
                }
            }
            else if (id == "push-copy" && ActiveProject != null && await ConfirmDiscard())
            {
                var copy = await ProjectService.DuplicateProjectAsync(ActiveProject.Id);
                await LoadProjects();
                await ActiveProjectChanged.InvokeAsync(copy);
                ToastService.Show("Project copied.", ToastType.Success);
            }
            else if (id == "push-delete" && ActiveProject != null)
            {
                if (!await AlertService.ShowConfirmAsync("Delete Project",
                    $"Delete \"{ActiveProject.Name}\" and its send history? This cannot be undone.", "Delete", "Cancel")) return;
                await ProjectService.DeleteProjectAsync(ActiveProject.Id);
                await LoadProjects();
                await ActiveProjectChanged.InvokeAsync(null);
                ToastService.Show("Project deleted.", ToastType.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError($"Push project action failed: {ex.Message}", ex);
            ToastService.Show($"Project action failed: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isActing = false;
            UpdateToolbar();
            StateHasChanged();
        }
    }

    Task<bool> ConfirmDiscard() => !IsDirty
        ? Task.FromResult(true)
        : AlertService.ShowConfirmAsync("Unsaved Changes", "Discard your unsaved notification changes?", "Discard", "Cancel");

    void OnProjectsChanged() => InvokeAsync(async () =>
    {
        await LoadProjects();
        UpdateToolbar();
        StateHasChanged();
    });

    public void Dispose()
    {
        ProjectService.OnProjectsChanged -= OnProjectsChanged;
        ToolbarService.ToolbarItemClicked -= OnToolbarItemClicked;
    }
}
