@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@using MauiSherpa.Pages.Forms
@using Microsoft.Maui.Controls
@inject ProcessModalService ModalService
@inject IProcessExecutionService ProcessService
@inject ICopilotContextService CopilotContext
@inject IJSRuntime JS
@inject ProgressBridgeHolder BridgeHolder
@inject IPlatformService PlatformInfo
@implements IDisposable

@if (IsVisible)
{
    <div class="process-modal-host @(PlatformInfo.IsLinux ? "process-modal-host-linux" : null)">
    <div class="process-content" id="process-modal" role="dialog" aria-modal="true">
        @if (PlatformInfo.IsLinux)
        {
            <h2 class="process-modal-title">@GetTitle()</h2>
        }
        @if (CurrentView == ModalView.Confirmation)
        {
            <div class="confirmation-view sherpa-scroll">
                @if (!string.IsNullOrEmpty(Request?.Description))
                {
                    <p class="description">@Request.Description</p>
                }

                @if (!string.IsNullOrEmpty(Request?.ConfirmationDetails))
                {
                    <div class="confirmation-details">
                        <pre>@Request.ConfirmationDetails</pre>
                    </div>
                }

                <div class="command-preview">
                    <label>Command to execute:</label>
                    <div class="command-box">
                        <code>@Request?.CommandLine</code>
                    </div>
                </div>

                @if (Request?.RequiresElevation == true)
                {
                    <div class="elevation-warning">
                        <i class="fa-solid fa-fw fa-exclamation-triangle warning-icon" aria-hidden="true"></i>
                        <span>@(Request.ElevationPrompt ??
                            "This command requires administrator privileges. You may be prompted for your password.")</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Request?.WorkingDirectory))
                {
                    <div class="working-dir">
                        <label>Working directory:</label>
                        <code>@Request.WorkingDirectory</code>
                    </div>
                }
            </div>
        }
        else if (CurrentView == ModalView.Running)
        {
            <div class="running-view">
                <div class="terminal-wrapper sherpa-console">
                    <div class="terminal-container" id="process-terminal"></div>
                </div>
                <div class="process-status-bar">
                    <div class="process-status-info">
                        <i class="fa-solid fa-fw fa-spinner fa-spin" aria-hidden="true"></i>
                        <span class="process-status-text">Running... @ElapsedTime</span>
                    </div>
                    <div class="process-controls">
                        <button class="btn btn-warning btn-sm" @onclick="HandleCancel" disabled="@(!CanCancel)">
                            Cancel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="HandleKill" disabled="@(!CanKill)">
                            Force Kill
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (CurrentView == ModalView.Completed)
        {
            <div class="completed-view">
                <div class="terminal-wrapper completed sherpa-console">
                    <div class="terminal-header sherpa-console-header">
                        <span>Output</span>
                        <button class="btn-icon" @onclick="CopyOutput" title="Copy output"><i class="fa-solid fa-fw fa-copy" aria-hidden="true"></i></button>
                    </div>
                    <div class="terminal-container" id="process-terminal"></div>
                </div>
                <div class="result-status @GetResultClass()">
                    <i class="fa-solid fa-fw @GetResultIcon() result-icon" aria-hidden="true"></i>
                    <span class="result-text">@GetResultText()</span>
                </div>
                <div class="result-details">
                    <div class="detail-item">
                        <label>Exit code:</label>
                        <span class="@(Result?.ExitCode == 0 ? "success" : "error")">@Result?.ExitCode</span>
                    </div>
                    <div class="detail-item">
                        <label>Duration:</label>
                        <span>@Result?.Duration.ToString(@"mm\:ss\.fff")</span>
                    </div>
                </div>
            </div>
        }
        @if (PlatformInfo.IsLinux)
        {
            <div class="process-modal-actions">
                @if (CurrentView == ModalView.Confirmation)
                {
                    <button class="btn btn-secondary" @onclick="HandleCancelBeforeExecution">Cancel</button>
                    <button class="btn btn-primary" @onclick="HandleExecute">
                        @(Request?.ConfirmationButtonText ?? "Execute")
                    </button>
                }
                else if (CurrentView == ModalView.Completed)
                {
                    @if (Result != null && !Result.Success && !Result.WasCancelled && !Result.WasKilled)
                    {
                        <button class="btn btn-secondary" @onclick="HandleTryWithCopilot">Try with Copilot</button>
                    }
                    <button class="btn btn-primary" @onclick="HandleClose">Close</button>
                }
            </div>
        }
    </div>
    </div>
}

<style>
    .process-modal-host { display: contents; }

    .process-modal-host-linux {
        position: fixed;
        inset: 0;
        z-index: 10001;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: var(--modal-overlay);
    }

    .process-modal-host-linux .process-content {
        width: min(1000px, 100%);
        height: min(500px, calc(100vh - 2rem));
        background: var(--surface-popover);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-popover);
    }

    .process-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-shrink: 0;
        padding-top: 0.75rem;
    }

    .process-modal-title { margin: 0 0 1rem; font-size: 1.125rem; color: var(--text-primary); }

    .process-content {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 1rem 1.25rem;
        overflow: hidden;
    }

    /* Confirmation View */
    .confirmation-view {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .confirmation-view .description {
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }

    .confirmation-details {
        margin-bottom: 1rem;
        padding: 0.8rem 0.95rem;
        background: var(--surface-well);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-md);
    }

    .confirmation-details pre {
        margin: 0;
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .command-preview {
        margin-bottom: 1rem;
    }

    .command-preview label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--text-muted);
        font-size: 0.8125rem;
        font-weight: 500;
    }

    .command-box {
        padding: 1rem;
        overflow-x: auto;
        overscroll-behavior: contain;
        background: var(--surface-console);
        border: 1px solid var(--border-console);
        border-radius: var(--radius-lg);
    }

    .command-box code {
        color: var(--console-cmd);
        background: transparent;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        white-space: pre-wrap;
        word-break: break-all;
    }

    .elevation-warning {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.75rem 1rem;
        margin-bottom: 1rem;
        color: var(--status-warning-fg);
        background: var(--status-warning-bg);
        border: 1px solid var(--status-warning-border);
        border-radius: var(--radius-lg);
    }

    .elevation-warning .warning-icon { font-size: 1.125rem; }
    .elevation-warning span { color: inherit; font-size: 0.875rem; }

    .working-dir {
        color: var(--text-muted);
        font-size: 0.8125rem;
    }

    .working-dir label {
        font-weight: 500;
        margin-right: 0.5rem;
    }

    .working-dir code {
        padding: 2px 0.375rem;
        color: var(--text-secondary);
        background: var(--surface-well);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
    }

    /* Running View */
    .running-view {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .process-status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.625rem 0.875rem;
        margin-top: 0.75rem;
        background: var(--surface-well);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-md);
    }

    .process-status-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .process-status-text { color: var(--text-primary); font-weight: 500; }

    .process-controls { display: flex; gap: 0.5rem; }

    .terminal-wrapper {
        flex: 1;
        min-height: 0;
        position: relative;
    }

    .terminal-wrapper.completed {
        flex: 1;
        min-height: 0;
    }

    .terminal-header {
        flex-shrink: 0;
    }

    .terminal-container {
        flex: 1;
        min-height: 0;
        height: auto;
        padding: 0.5rem;
        overflow: hidden;
        background: var(--surface-console);
    }

    .terminal-wrapper:not(.completed) .terminal-container {
        height: auto;
    }

    .terminal-container .xterm {
        padding: 12px;
    }

    /* Completed View */
    .completed-view { display: flex; flex-direction: column; gap: 1rem; overflow: hidden; flex: 1; min-height: 0; }

    .result-status {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
    }

    .result-status.success {
        color: var(--status-success-fg);
        background: var(--status-success-bg);
        border-color: var(--status-success-border);
    }

    .result-status.error {
        color: var(--status-error-fg);
        background: var(--status-error-bg);
        border-color: var(--status-error-border);
    }

    .result-status.cancelled {
        color: var(--status-warning-fg);
        background: var(--status-warning-bg);
        border-color: var(--status-warning-border);
    }

    .result-icon { font-size: 1.5rem; }
    .result-text { font-weight: 600; font-size: 1rem; }

    .result-status .result-text { color: inherit; }

    .result-details {
        display: flex;
        flex-shrink: 0;
        gap: 1.5rem;
        color: var(--text-secondary);
    }

    .detail-item label {
        margin-right: 0.375rem;
        color: var(--text-muted);
        font-size: 0.8125rem;
    }

    .detail-item span { font-weight: 500; }
    .detail-item span.success { color: var(--status-success-fg); }
    .detail-item span.error { color: var(--status-error-fg); }
</style>

@code {
    private enum ModalView { Confirmation, Running, Completed }

    private ModalView CurrentView { get; set; } = ModalView.Confirmation;
    private ProcessRequest? Request => ModalService.CurrentRequest;
    private bool IsVisible => ModalService.IsVisible;
    private ProcessResult? Result { get; set; }
    private string ElapsedTime { get; set; } = "00:00";
    private System.Timers.Timer? _elapsedTimer;
    private DateTime _startTime;
    private bool _terminalInitialized;
    private bool _needsCompletedTerminal;
    private bool _startAfterRender;
    private bool _keyboardInitialized;
    private bool _disposed;
    private CancellationTokenSource? _cts;
    private DotNetObjectReference<ProcessExecutionModal>? _dotNetRef;
    private ProgressBridge? _progressBridge;

    private bool CanCancel => ProcessService.CurrentState == ProcessState.Running;
    private bool CanKill => ProcessService.CurrentState == ProcessState.Running || 
                           ProcessService.CurrentState == ProcessState.Cancelled;
    private bool CanAcceptInput =>
        Request is { AcceptsStandardInput: true, RequiresElevation: false };

    protected override void OnInitialized()
    {
        ModalService.OnShowRequested += HandleShowRequested;
        ProcessService.OutputReceived += HandleOutputReceived;
        ProcessService.StateChanged += HandleStateChanged;
        _dotNetRef = DotNetObjectReference.Create(this);

        // Subscribe to native button clicks via bridge
        _progressBridge = PlatformInfo.IsLinux ? null : BridgeHolder.Current;
        if (_progressBridge != null)
        {
            _progressBridge.ButtonClicked += OnBridgeButtonClicked;
        }

        // If already visible (timing: service fires before Blazor subscribes), catch up
        if (IsVisible && Request != null)
        {
            HandleShowRequested(Request);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PlatformInfo.IsLinux && !_keyboardInitialized)
        {
            await JS.InvokeVoidAsync("modalInterop.initialize", "process-modal", _dotNetRef);
            _keyboardInitialized = true;
        }

        if (_startAfterRender)
        {
            _startAfterRender = false;
            await ExecuteProcessAsync();
        }

        if (_needsCompletedTerminal && Result != null)
        {
            _needsCompletedTerminal = false;
            await JS.InvokeVoidAsync(
                "terminalInterop.initialize",
                "process-terminal",
                new { disableStdin = true, cursorBlink = false },
                null);
            _terminalInitialized = true;

            // Replay stdout
            if (!string.IsNullOrEmpty(Result.Output))
            {
                if (Request?.UsePseudoTerminal == true)
                    await JS.InvokeVoidAsync("terminalInterop.writeRaw", "process-terminal", Result.Output);
                else
                    foreach (var line in Result.Output.Split('\n', StringSplitOptions.None))
                        await JS.InvokeVoidAsync("terminalInterop.write", "process-terminal", line);
            }

            // Replay stderr
            if (!string.IsNullOrEmpty(Result.Error))
            {
                if (Request?.UsePseudoTerminal == true)
                    await JS.InvokeVoidAsync("terminalInterop.writeRaw", "process-terminal", Result.Error);
                else
                    foreach (var line in Result.Error.Split('\n', StringSplitOptions.None))
                        await JS.InvokeVoidAsync("terminalInterop.writeError", "process-terminal", line);
            }

            // Write final status line
            if (Result.Success)
                await JS.InvokeVoidAsync("terminalInterop.writeSuccess", "process-terminal", $"\n[OK] Process completed successfully (exit code {Result.ExitCode})");
            else if (Result.WasCancelled)
                await JS.InvokeVoidAsync("terminalInterop.writeWarning", "process-terminal", $"\n[CANCELLED] Process was cancelled");
            else if (Result.WasKilled)
                await JS.InvokeVoidAsync("terminalInterop.writeWarning", "process-terminal", $"\n[KILLED] Process was killed");
            else
                await JS.InvokeVoidAsync("terminalInterop.writeError", "process-terminal", $"\n[FAILED] Process failed (exit code {Result.ExitCode})");
        }
    }

    [JSInvokable]
    public void OnEscapePressed()
    {
        if (CurrentView == ModalView.Confirmation)
            HandleCancelBeforeExecution();
        else if (CurrentView == ModalView.Completed)
            HandleClose();
    }

    [JSInvokable]
    public async Task OnProcessInput(string data)
    {
        if (!CanAcceptInput || string.IsNullOrEmpty(data))
            return;

        await ProcessService.SendInputAsync(data);
    }

    private void HandleShowRequested(ProcessRequest request)
    {
        _ = InvokeAsync(() =>
        {
            CurrentView = ModalService.RequiresConfirmation ? ModalView.Confirmation : ModalView.Running;
            Result = null;
            _terminalInitialized = false;
            _startAfterRender = !ModalService.RequiresConfirmation;
            UpdateBridgeButtons();
            StateHasChanged();
        });
    }

    private async void HandleOutputReceived(object? sender, ProcessOutputEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            if (_terminalInitialized)
            {
                if (e.IsRaw)
                    await JS.InvokeVoidAsync("terminalInterop.writeRaw", "process-terminal", e.Data);
                else if (e.IsError)
                    await JS.InvokeVoidAsync("terminalInterop.writeError", "process-terminal", e.Data);
                else
                    await JS.InvokeVoidAsync("terminalInterop.write", "process-terminal", e.Data);
            }
        });
    }

    private async void HandleStateChanged(object? sender, ProcessStateChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleExecute()
    {
        CurrentView = ModalView.Running;
        UpdateBridgeButtons();
        StateHasChanged();

        // Wait a tick for the terminal container to render
        await Task.Delay(50);

        await ExecuteProcessAsync();
    }

    private async Task ExecuteProcessAsync()
    {
        if (Request == null) return;

        // Initialize terminal
        await JS.InvokeVoidAsync(
            "terminalInterop.initialize",
            "process-terminal",
            new
            {
                disableStdin = !CanAcceptInput,
                cursorBlink = CanAcceptInput
            },
            CanAcceptInput ? _dotNetRef : null);
        _terminalInitialized = true;

        // Start elapsed timer
        _startTime = DateTime.Now;
        _elapsedTimer = new System.Timers.Timer(1000);
        _elapsedTimer.Elapsed += (_, _) =>
        {
            var elapsed = DateTime.Now - _startTime;
            ElapsedTime = elapsed.ToString(@"mm\:ss");
            InvokeAsync(StateHasChanged);
        };
        _elapsedTimer.Start();

        // Execute
        _cts = new CancellationTokenSource();
        try
        {
            if (Request.BeforeExecuteAsync != null)
                await Request.BeforeExecuteAsync(_cts.Token);

            Result = await ProcessService.ExecuteAsync(Request, _cts.Token);
        }
        catch (Exception ex)
        {
            Result = new ProcessResult(-1, "", ex.Message, DateTime.Now - _startTime, ProcessState.Failed);
        }
        finally
        {
            _elapsedTimer?.Stop();
            _elapsedTimer?.Dispose();
            _elapsedTimer = null;
        }

        if (_disposed)
            return;

        if (_terminalInitialized)
        {
            await JS.InvokeVoidAsync("terminalInterop.dispose", "process-terminal");
            _terminalInitialized = false;
        }

        // Transition to completed view — terminal will be re-initialized in OnAfterRenderAsync
        _needsCompletedTerminal = true;
        CurrentView = ModalView.Completed;
        ModalService.CompleteWithResult(Result);
        UpdateBridgeButtons();
        StateHasChanged();
    }

    private void HandleCancelBeforeExecution()
    {
        ModalService.CancelBeforeExecution();
    }

    private void HandleCancel()
    {
        ProcessService.Cancel();
    }

    private void HandleKill()
    {
        ProcessService.Kill();
    }

    private void HandleClose()
    {
        if (_terminalInitialized)
        {
            _ = JS.InvokeVoidAsync("terminalInterop.dispose", "process-terminal");
        }
        ModalService.Close();
        if (!PlatformInfo.IsLinux)
            _progressBridge?.RequestClose();
    }

    private void UpdateBridgeButtons()
    {
        var bridge = _progressBridge;
        if (bridge == null) return;

        switch (CurrentView)
        {
            case ModalView.Confirmation:
                bridge.SetTitle(Request?.Title ?? "Confirm Execution");
                var executeLabel = Request?.ConfirmationButtonText ?? "Execute";
                bridge.SetButtons(
                    new ProgressButton("cancel", "Cancel", ProgressButtonStyle.Secondary),
                    new ProgressButton(
                        "execute",
                        Request?.RequiresElevation == true ? $"🔐 {executeLabel}" : executeLabel,
                        ProgressButtonStyle.Primary));
                break;
            case ModalView.Running:
                bridge.SetTitle(Request?.Title ?? "Running Process");
                bridge.SetButtons(); // No footer buttons during running — controls are inline
                break;
            case ModalView.Completed:
                bridge.SetTitle("Process Complete");
                var buttons = new List<ProgressButton>();
                if (Result != null && !Result.Success && !Result.WasCancelled && !Result.WasKilled)
                    buttons.Add(new ProgressButton("copilot", "Try with Copilot", ProgressButtonStyle.Copilot, "fa-solid fa-fw fa-robot"));
                buttons.Add(new ProgressButton("close", "Close", ProgressButtonStyle.Primary));
                bridge.SetButtons(buttons.ToArray());
                break;
        }
    }

    private async Task OnBridgeButtonClicked(string buttonId)
    {
        await InvokeAsync(async () =>
        {
            switch (buttonId)
            {
                case "cancel":
                    HandleCancelBeforeExecution();
                    break;
                case "execute":
                    await HandleExecute();
                    break;
                case "copilot":
                    await HandleTryWithCopilot();
                    break;
                case "close":
                    HandleClose();
                    break;
            }
        });
    }

    private async Task HandleTryWithCopilot()
    {
        var output = "";
        if (_terminalInitialized)
        {
            try
            {
                output = await JS.InvokeAsync<string>("terminalInterop.getContent", "process-terminal");
            }
            catch { }
        }
        
        // Build context
        var context = CopilotContextService.BuildProcessFailureContext(
            Request?.CommandLine ?? "Unknown command",
            Result?.ExitCode ?? -1,
            output
        );
        
        // Close the modal FIRST, then open Copilot after the pop completes
        HandleClose();
        
        // Defer Copilot open to avoid racing PushModal vs PopModal
        _ = Task.Run(async () =>
        {
            await Task.Delay(300);
            Application.Current?.Dispatcher.Dispatch(() => CopilotContext.OpenWithContext(context));
        });
    }

    private async Task CopyOutput()
    {
        if (_terminalInitialized)
        {
            var content = await JS.InvokeAsync<string>("terminalInterop.getContent", "process-terminal");
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", content);
        }
    }

    private string GetTitle()
    {
        return Request?.Title ?? CurrentView switch
        {
            ModalView.Confirmation => "Confirm Execution",
            ModalView.Running => "Running Process",
            ModalView.Completed => "Process Complete",
            _ => "Process Execution"
        };
    }

    private string GetResultClass()
    {
        if (Result == null) return "";
        if (Result.Success) return "success";
        if (Result.WasCancelled || Result.WasKilled) return "cancelled";
        return "error";
    }

    private string GetResultIcon()
    {
        if (Result == null) return "";
        if (Result.Success) return "fa-check-circle";
        if (Result.WasCancelled || Result.WasKilled) return "fa-ban";
        return "fa-times-circle";
    }

    private string GetResultText()
    {
        if (Result == null) return "";
        if (Result.Success) return "Process completed successfully";
        if (Result.WasCancelled) return "Process was cancelled";
        if (Result.WasKilled) return "Process was killed";
        return "Process failed";
    }

    public void Dispose()
    {
        _disposed = true;
        if (_keyboardInitialized)
            _ = JS.InvokeVoidAsync("modalInterop.dispose", "process-modal");
        ModalService.OnShowRequested -= HandleShowRequested;
        ProcessService.OutputReceived -= HandleOutputReceived;
        ProcessService.StateChanged -= HandleStateChanged;
        _elapsedTimer?.Dispose();
        if (PlatformInfo.IsLinux && _cts != null)
        {
            if (ProcessService.CurrentState == ProcessState.Running && ProcessService.ProcessId != null)
                ProcessService.Cancel();
            else if (ProcessService.ProcessId == null)
                _cts.Cancel();
        }
        _cts?.Dispose();
        if (_progressBridge != null)
            _progressBridge.ButtonClicked -= OnBridgeButtonClicked;
        _dotNetRef?.Dispose();
    }
}
