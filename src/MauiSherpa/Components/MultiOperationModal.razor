@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@using MauiSherpa.Pages.Forms
@using Microsoft.Maui.Controls
@inject MultiOperationModalService ModalService
@inject ICopilotContextService CopilotContext
@inject IJSRuntime JS
@inject ProgressBridgeHolder BridgeHolder
@inject IPlatformService PlatformInfo
@implements IDisposable

@if (ModalService.IsVisible)
{
    <div class="multi-op-host @(PlatformInfo.IsLinux ? "multi-op-host-linux" : null)">
    <div class="multi-op-content" id="multi-op-modal" role="dialog" aria-modal="true">
        @if (PlatformInfo.IsLinux)
        {
            <h2 class="multi-op-title">@ModalService.Title</h2>
        }
        <p class="description">@ModalService.Description</p>

        <div class="operations-list @(isExecutionView ? "operations-list-connected" : "") sherpa-scroll" id="multi-op-operations">
            @foreach (var op in ModalService.Operations)
            {
                var isExpanded = IsOperationExpanded(op);
                var canToggle = !ModalService.IsRunning && op.CanDisable && ModalService.IsConfirming;
                var hasExpandableContent = op.Log.Any() ||
                    (!string.IsNullOrEmpty(op.ErrorMessage) && op.State == OperationItemState.Failed);
                var showSecondary = op.SecondaryOptions.Count > 0
                    && ModalService.IsConfirming && !ModalService.IsRunning;
                var isCompactRow = isExecutionView && !isExpanded && op.State is OperationItemState.Completed or OperationItemState.Pending or OperationItemState.Skipped;

                <div class="operation-card @GetOperationCardClass(op) @(isExpanded ? "expanded" : "") @(isCompactRow ? "compact" : "")">
                    <div class="operation-header @(hasExpandableContent || canToggle ? "clickable" : "")"
                         role="@(hasExpandableContent || canToggle ? "button" : null)"
                         tabindex="@(hasExpandableContent || canToggle ? 0 : null)"
                         aria-expanded="@(hasExpandableContent ? isExpanded.ToString().ToLowerInvariant() : null)"
                         @onclick="@(() => HandleHeaderClick(op, hasExpandableContent, canToggle))"
                         @onkeydown="@(e => HandleRowKeyDown(e, op, hasExpandableContent, canToggle))">
                        <div class="operation-left">
                            @if (ModalService.IsConfirming && !ModalService.IsRunning)
                            {
                                <input type="checkbox" 
                                       checked="@op.IsEnabled" 
                                       disabled="@(!canToggle)"
                                       @onclick:stopPropagation="true"
                                       @onchange="@(e => HandleToggle(op.Id, (bool)(e.Value ?? false)))" />
                            }
                            else
                            {
                                <span class="state-icon">
                                    @switch (op.State)
                                    {
                                        case OperationItemState.Pending:
                                            <i class="fa-regular fa-fw fa-circle text-muted" aria-hidden="true"></i>
                                            break;
                                        case OperationItemState.Running:
                                            <i class="fa-solid fa-fw fa-spinner fa-spin text-primary" aria-hidden="true"></i>
                                            break;
                                        case OperationItemState.Completed:
                                            <i class="fa-solid fa-fw fa-circle-check text-success" aria-hidden="true"></i>
                                            break;
                                        case OperationItemState.Failed:
                                            <i class="fa-solid fa-fw fa-circle-xmark text-error" aria-hidden="true"></i>
                                            break;
                                        case OperationItemState.Skipped:
                                            <i class="fa-solid fa-fw fa-forward text-muted" aria-hidden="true"></i>
                                            break;
                                    }
                                </span>
                            }
                            <div class="operation-info">
                                <span class="operation-name">@op.Name</span>
                                @if (!isCompactRow && !string.IsNullOrWhiteSpace(op.Description))
                                {
                                    <span class="operation-desc">@op.Description</span>
                                }
                            </div>
                        </div>
                        <div class="operation-right">
                            @if (isExecutionView)
                            {
                                <span class="sherpa-badge @GetStatusBadgeClass(op.State)">@GetStatusLabel(op.State)</span>
                            }
                            @if (op.Duration.HasValue)
                            {
                                <span class="duration mono">@op.Duration.Value.ToString(@"mm\:ss\.f")</span>
                            }
                            @if (hasExpandableContent)
                            {
                                <i class="fa-solid fa-fw fa-chevron-right expand-icon @(isExpanded ? "expanded" : "")" aria-hidden="true"></i>
                            }
                        </div>
                    </div>

                    @if (showSecondary)
                    {
                        <div class="operation-secondary-list" @onclick:stopPropagation="true">
                            @if (op.SecondaryOptions.Count > 1)
                            {
                                <div class="secondary-bulk">
                                    <button type="button" class="link-btn" @onclick="@(() => SetAllSecondary(op.Id, true))">Select all</button>
                                    <span class="secondary-bulk-sep">·</span>
                                    <button type="button" class="link-btn" @onclick="@(() => SetAllSecondary(op.Id, false))">Deselect all</button>
                                </div>
                            }
                            @foreach (var opt in op.SecondaryOptions)
                            {
                                <label class="operation-secondary">
                                    <input type="checkbox"
                                           checked="@opt.Enabled"
                                           disabled="@(!op.IsEnabled)"
                                           @onchange="@(e => HandleSecondaryToggle(op.Id, opt.Id, (bool)(e.Value ?? false)))" />
                                    <span>@opt.Label</span>
                                </label>
                            }
                        </div>
                    }

                    @if (isExpanded && op.Log.Any())
                    {
                        <div class="operation-console">
                            <div class="operation-console-bar">
                                <span class="operation-console-meta">
                                    <i class="fa-solid fa-fw fa-terminal" aria-hidden="true"></i>
                                    <span>@(op.State == OperationItemState.Running ? "Live output" : $"{op.Log.Count} log {(op.Log.Count == 1 ? "line" : "lines")}")</span>
                                </span>
                                <button type="button"
                                        class="btn btn-icon btn-sm operation-copy-btn"
                                        title="Copy step log"
                                        aria-label="Copy log for @op.Name"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => CopyOperationLogAsync(op))">
                                    <i class="fa-regular fa-copy fa-fw" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="operation-log" data-op-log="@op.Id">
                                @foreach (var entry in op.Log)
                                {
                                    <div class="log-entry @GetLogLevelClass(entry.Level)">
                                        <span class="log-time">@entry.Timestamp.ToString("HH:mm:ss")</span>
                                        <i class="fa-solid fa-fw @GetLogLevelIcon(entry.Level)" aria-hidden="true"></i>
                                        <span class="log-message">@entry.Message</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (isExpanded && !string.IsNullOrEmpty(op.ErrorMessage) && op.State == OperationItemState.Failed)
                    {
                        <div class="operation-error">
                            <i class="fa-solid fa-fw fa-triangle-exclamation" aria-hidden="true"></i>
                            @op.ErrorMessage
                        </div>
                    }
                </div>
            }
        </div>

        @if (HasResult)
        {
            <div class="result-summary @GetOverallResultClass()">
                <div class="summary-stats">
                    <span class="stat"><i class="fa-solid fa-fw fa-check-circle" aria-hidden="true"></i> @CompletedCount completed</span>
                    @if (FailedCount > 0)
                    {
                        <span class="stat error"><i class="fa-solid fa-fw fa-times-circle" aria-hidden="true"></i> @FailedCount failed</span>
                    }
                    @if (SkippedCount > 0)
                    {
                        <span class="stat skipped"><i class="fa-solid fa-fw fa-forward" aria-hidden="true"></i> @SkippedCount skipped</span>
                    }
                </div>
                <span class="duration"><i class="fa-solid fa-fw fa-clock" aria-hidden="true"></i> @ElapsedTime</span>
            </div>
        }
        else if (ModalService.IsRunning)
        {
            <div class="progress-summary">
                <div class="progress-bar-container sherpa-progress-track">
                    <div class="progress-bar sherpa-progress-fill" style="width: @ProgressPercent%"></div>
                </div>
                <span class="progress-text">@CurrentProgress / @TotalEnabled</span>
            </div>
        }
        @if (PlatformInfo.IsLinux)
        {
            <div class="multi-op-actions">
                @if (ModalService.IsConfirming)
                {
                    <button class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
                    <button class="btn btn-primary" @onclick="HandleStart" disabled="@(EnabledCount == 0)">
                        Run @EnabledCount Operation@(EnabledCount != 1 ? "s" : "")
                    </button>
                }
                else if (ModalService.IsRunning)
                {
                    <button class="btn btn-secondary" @onclick="HandleRequestCancel">Stop</button>
                }
                else
                {
                    @if (FailedCount > 0)
                    {
                        <button class="btn btn-secondary" @onclick="HandleTryWithCopilot">Try with Copilot</button>
                    }
                    <button class="btn btn-primary" @onclick="HandleClose">Close</button>
                }
            </div>
        }
    </div>
    </div>
}

<style>
    .multi-op-host { display: contents; }

    .multi-op-host-linux {
        position: fixed;
        inset: 0;
        z-index: 10001;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: var(--modal-overlay);
    }

    .multi-op-host-linux .multi-op-content {
        width: min(700px, 100%);
        height: min(500px, calc(100vh - 2rem));
        background: var(--surface-popover);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-popover);
    }

    .multi-op-title { margin: 0; font-size: 1.125rem; color: var(--text-primary); }

    .multi-op-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: auto;
        flex-shrink: 0;
    }

    .multi-op-content {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 1rem 1.25rem;
        overflow: hidden;
        gap: 1rem;
    }

    .description {
        flex-shrink: 0;
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin: 0;
    }

    .result-summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        flex-shrink: 0;
        color: var(--text-secondary);
        background: var(--surface-well);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-lg);
    }

    .result-summary.text-success {
        color: var(--status-success-fg);
        background: var(--status-success-bg);
        border-color: var(--status-success-border);
    }

    .result-summary.text-error {
        color: var(--status-error-fg);
        background: var(--status-error-bg);
        border-color: var(--status-error-border);
    }

    .summary-stats {
        display: flex;
        gap: 1rem;
    }

    .summary-stats .stat {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.875rem;
        color: var(--status-success-fg);
    }

    .summary-stats .stat.error { color: var(--status-error-fg); }
    .summary-stats .stat.skipped { color: var(--text-muted); }

    .duration {
        font-size: 0.8125rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .progress-summary {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.75rem;
    }

    .progress-bar-container {
        flex: 1;
    }

    .progress-text {
        font-size: 0.8125rem;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .operations-list {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-height: 0;
        gap: 0.5rem;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .operations-list-connected {
        gap: 0;
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
    }

    .operation-card {
        flex-shrink: 0;
        overflow: hidden;
        background: var(--surface-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        transition: background var(--motion-normal) var(--ease-standard), border-color var(--motion-normal) var(--ease-standard);
    }

    .operations-list-connected .operation-card {
        border: none;
        border-radius: 0;
        border-bottom: 1px solid var(--border-hairline);
        background: transparent;
    }

    .operations-list-connected .operation-card:last-child {
        border-bottom: none;
    }

    .operation-card.running {
        background: var(--accent-soft);
        border-color: var(--accent-border);
    }

    .operations-list-connected .operation-card.running {
        background: color-mix(in srgb, var(--accent-soft) 55%, var(--surface-card));
    }

    .operation-card.skipped { opacity: 0.65; }

    .operation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        cursor: default;
        background: transparent;
        transition: background var(--motion-fast) var(--ease-standard);
    }

    .operation-card.compact .operation-header {
        padding: 0.5rem 0.875rem;
    }

    .operation-header.clickable { cursor: pointer; }
    .operation-header.clickable:hover { background: var(--surface-card-hover); }

    .operation-card.running .operation-header { background: transparent; }

    .operation-left {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        min-width: 0;
        flex: 1;
    }

    .operation-left input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .state-icon {
        width: 1.125rem;
        text-align: center;
        flex-shrink: 0;
    }

    .state-icon .text-muted { color: var(--text-muted); }
    .state-icon .text-primary { color: var(--accent); }
    .state-icon .text-success { color: var(--status-success-fg); }
    .state-icon .text-error { color: var(--status-error-fg); }

    .operation-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .operation-name {
        font-weight: 500;
        color: var(--text-primary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .operation-card.running .operation-name { font-weight: 600; }

    .operation-desc {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .operation-secondary-list {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0 1rem 0.75rem calc(1rem + 18px + 0.75rem);
    }

    .operation-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        color: var(--text-secondary);
        cursor: pointer;
        user-select: none;
    }

    .operation-secondary input[type="checkbox"] {
        width: 14px;
        height: 14px;
        cursor: pointer;
    }

    .operation-secondary input[type="checkbox"]:disabled { cursor: not-allowed; }
    .operation-secondary:has(input:disabled) { opacity: 0.5; cursor: not-allowed; }

    .secondary-bulk {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        color: var(--text-secondary);
        margin: 0 0 0.1rem 0;
    }

    .secondary-bulk-sep { opacity: 0.5; }

    .secondary-bulk .link-btn {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.75rem;
        color: var(--accent);
        cursor: pointer;
        text-decoration: none;
    }

    .secondary-bulk .link-btn:hover { text-decoration: underline; }

    .operation-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .expand-icon {
        color: var(--text-muted);
        font-size: 0.7rem;
        transition: transform var(--motion-normal) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
    }

    .expand-icon.expanded {
        transform: rotate(90deg);
        color: var(--text-primary);
    }

    .operation-console {
        background: var(--surface-console);
        border-top: 1px solid var(--border-console);
    }

    .operation-console-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 4px 0.75rem;
        background: var(--surface-console-header);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--console-muted);
    }

    .operation-console-meta {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .operation-copy-btn {
        background: transparent;
        border: none;
        color: var(--console-muted);
        height: 22px;
        width: 22px;
        padding: 0;
    }

    .operation-copy-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--console-text);
    }

    .operation-log {
        max-height: 200px;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 0.5rem 0.75rem;
        color: var(--console-text);
        background: var(--surface-console);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        line-height: 1.5;
    }

    .log-entry {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 3px 0.375rem;
        border-radius: var(--radius-sm);
    }

    .log-entry:hover { background: var(--surface-console-row-hover); }

    .log-time {
        flex-shrink: 0;
        color: var(--console-muted);
    }

    .log-entry i {
        flex-shrink: 0;
        width: 0.75rem;
        text-align: center;
    }

    .log-message {
        color: var(--console-text);
        word-break: break-word;
    }

    .log-entry.info i { color: var(--console-info); }
    .log-entry.success i,
    .log-entry.success .log-message { color: var(--console-success); }
    .log-entry.warning i,
    .log-entry.warning .log-message { color: var(--console-warning); }
    .log-entry.error i,
    .log-entry.error .log-message { color: var(--console-error); }

    .operation-error {
        padding: 0.625rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--status-error-fg);
        background: var(--status-error-bg);
        border-top: 1px solid var(--status-error-border);
        font-size: 0.8125rem;
    }
</style>

@code {
    private readonly HashSet<string> expandedOperations = new();
    private readonly HashSet<string> manuallyToggledOperations = new();
    private System.Timers.Timer? _elapsedTimer;
    private DateTime _startTime;
    private DotNetObjectReference<MultiOperationModal>? _dotNetRef;
    private ProgressBridge? _progressBridge;
    private bool _keyboardInitialized;
    private string ElapsedTime { get; set; } = "00:00";

    private bool isExecutionView => ModalService.IsRunning || HasResult;
    private int EnabledCount => ModalService.Operations.Count(o => o.IsEnabled);
    private int TotalEnabled => ModalService.Operations.Count(o => o.IsEnabled);
    private int CurrentProgress => ModalService.Operations.Count(o => 
        o.State == OperationItemState.Completed || 
        o.State == OperationItemState.Failed || 
        o.State == OperationItemState.Skipped);
    private int ProgressPercent => TotalEnabled > 0 ? (CurrentProgress * 100) / TotalEnabled : 0;

    private int CompletedCount => ModalService.Operations.Count(o => o.State == OperationItemState.Completed);
    private int FailedCount => ModalService.Operations.Count(o => o.State == OperationItemState.Failed);
    private int SkippedCount => ModalService.Operations.Count(o => o.State == OperationItemState.Skipped);
    private bool HasResult => !ModalService.IsConfirming && !ModalService.IsRunning;

    private bool IsOperationExpanded(OperationItemStatus op)
    {
        if (manuallyToggledOperations.Contains(op.Id))
            return expandedOperations.Contains(op.Id);

        if (expandedOperations.Contains(op.Id))
            return true;

        return ModalService.IsRunning &&
               ModalService.CurrentOperationIndex >= 0 &&
               ModalService.CurrentOperationIndex < ModalService.Operations.Count &&
               ModalService.Operations[ModalService.CurrentOperationIndex].Id == op.Id;
    }

    private static string GetStatusLabel(OperationItemState state) => state switch
    {
        OperationItemState.Running => "Running",
        OperationItemState.Completed => "Completed",
        OperationItemState.Failed => "Failed",
        OperationItemState.Skipped => "Skipped",
        _ => "Queued"
    };

    private static string GetStatusBadgeClass(OperationItemState state) => state switch
    {
        OperationItemState.Running => "sherpa-badge-accent",
        OperationItemState.Completed => "sherpa-badge-success",
        OperationItemState.Failed => "sherpa-badge-danger",
        _ => "sherpa-badge-neutral"
    };

    private void HandleHeaderClick(OperationItemStatus op, bool hasExpandableContent, bool canToggle)
    {
        if (canToggle)
            HandleToggle(op.Id, !op.IsEnabled);
        else if (hasExpandableContent)
            ToggleExpanded(op.Id);
    }

    private void HandleRowKeyDown(KeyboardEventArgs e, OperationItemStatus op, bool hasExpandableContent, bool canToggle)
    {
        if ((hasExpandableContent || canToggle) && e.Key is "Enter" or " ")
            HandleHeaderClick(op, hasExpandableContent, canToggle);
    }

    private async Task CopyOperationLogAsync(OperationItemStatus op)
    {
        var text = string.Join(
            Environment.NewLine,
            op.Log.Select(entry => $"[{entry.Timestamp:HH:mm:ss}] {entry.Message}"));
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch { }
    }

    protected override void OnInitialized()
    {
        ModalService.OnShowRequested += HandleShowRequested;
        ModalService.OnOperationStateChanged += HandleOperationStateChanged;
        ModalService.OnLogEntry += HandleLogEntry;
        ModalService.OnExecutionStarted += HandleExecutionStarted;
        ModalService.OnExecutionCompleted += HandleExecutionCompleted;
        _dotNetRef = DotNetObjectReference.Create(this);

        _progressBridge = PlatformInfo.IsLinux ? null : BridgeHolder.Current;
        if (_progressBridge != null)
            _progressBridge.ButtonClicked += OnBridgeButtonClicked;

        // Catch up if already visible
        if (ModalService.IsVisible)
        {
            HandleShowRequested(ModalService.Title ?? "", ModalService.Description ?? "");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PlatformInfo.IsLinux && !_keyboardInitialized)
        {
            await JS.InvokeVoidAsync("modalInterop.initialize", "multi-op-modal", _dotNetRef);
            _keyboardInitialized = true;
        }

        if (ModalService.IsRunning)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", @"
                    const active = document.querySelector('.operation-card.running .operation-log');
                    if (active) active.scrollTop = active.scrollHeight;
                ");
            }
            catch { /* component may be disposed */ }
        }
    }

    [JSInvokable]
    public void OnEscapePressed()
    {
        if (ModalService.IsConfirming)
            HandleCancel();
        else if (!ModalService.IsRunning)
            HandleClose();
    }

    private void HandleShowRequested(string title, string description)
    {
        _ = InvokeAsync(() =>
        {
            expandedOperations.Clear();
            manuallyToggledOperations.Clear();
            UpdateBridgeButtons();
            StateHasChanged();
        });
    }

    private void HandleOperationStateChanged(OperationItemStatus status)
    {
        _ = InvokeAsync(() =>
        {
            if (!manuallyToggledOperations.Contains(status.Id))
            {
                if (status.State is OperationItemState.Running or OperationItemState.Failed)
                    expandedOperations.Add(status.Id);
                else if (status.State is OperationItemState.Completed or OperationItemState.Skipped)
                    expandedOperations.Remove(status.Id);
            }
            UpdateBridgeButtons();
            StateHasChanged();
        });
    }

    private void HandleLogEntry(string operationId, OperationLogEntry entry)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleExecutionStarted()
    {
        _ = InvokeAsync(() =>
        {
            _startTime = DateTime.Now;
            _elapsedTimer?.Dispose();
            _elapsedTimer = new System.Timers.Timer(1000);
            _elapsedTimer.Elapsed += (_, _) => _ = InvokeAsync(() =>
            {
                ElapsedTime = (DateTime.Now - _startTime).ToString(@"mm\:ss");
                StateHasChanged();
            });
            _elapsedTimer.Start();
            UpdateBridgeButtons();
            StateHasChanged();
        });
    }

    private void HandleExecutionCompleted()
    {
        _ = InvokeAsync(() =>
        {
            _elapsedTimer?.Stop();
            _elapsedTimer?.Dispose();
            _elapsedTimer = null;
            ElapsedTime = (DateTime.Now - _startTime).ToString(@"mm\:ss\.f");
            UpdateBridgeButtons();
            StateHasChanged();
        });
    }

    private void ToggleExpanded(string operationId)
    {
        var op = ModalService.Operations.FirstOrDefault(o => o.Id == operationId);
        var currentlyExpanded = op != null ? IsOperationExpanded(op) : expandedOperations.Contains(operationId);
        manuallyToggledOperations.Add(operationId);
        if (currentlyExpanded)
            expandedOperations.Remove(operationId);
        else
            expandedOperations.Add(operationId);
    }

    private void HandleToggle(string operationId, bool enabled)
    {
        ModalService.ToggleOperation(operationId, enabled);
        StateHasChanged();
    }

    private void HandleSecondaryToggle(string operationId, string optionId, bool enabled)
    {
        ModalService.ToggleSecondaryOption(operationId, optionId, enabled);
        StateHasChanged();
    }

    private void SetAllSecondary(string operationId, bool enabled)
    {
        ModalService.SetAllSecondaryOptions(operationId, enabled);
        StateHasChanged();
    }

    private async Task HandleStart()
    {
        await ModalService.StartExecutionAsync();
    }

    private void HandleCancel()
    {
        ModalService.CancelBeforeExecution();
    }

    private void HandleRequestCancel()
    {
        ModalService.RequestCancellation();
    }

    private void HandleClose()
    {
        ModalService.Close();
        if (!PlatformInfo.IsLinux)
            _progressBridge?.RequestClose();
    }

    private void UpdateBridgeButtons()
    {
        if (PlatformInfo.IsLinux) return;
        var bridge = _progressBridge;
        if (bridge == null) return;

        if (ModalService.IsConfirming && !ModalService.IsRunning)
        {
            bridge.SetButtons(
                new ProgressButton("cancel", "Cancel", ProgressButtonStyle.Secondary),
                new ProgressButton("start", $"Run {EnabledCount} Operation{(EnabledCount != 1 ? "s" : "")}", ProgressButtonStyle.Primary, Enabled: EnabledCount > 0));
        }
        else if (ModalService.IsRunning)
        {
            bridge.SetButtons(new ProgressButton("stop", "Stop", ProgressButtonStyle.Warning));
        }
        else
        {
            var buttons = new List<ProgressButton>();
            if (FailedCount > 0)
                buttons.Add(new ProgressButton("copilot", "Try with Copilot", ProgressButtonStyle.Copilot, "fa-solid fa-fw fa-robot"));
            buttons.Add(new ProgressButton("close", "Close", ProgressButtonStyle.Primary));
            bridge.SetButtons(buttons.ToArray());
        }
    }

    private async Task OnBridgeButtonClicked(string buttonId)
    {
        await InvokeAsync(async () =>
        {
            switch (buttonId)
            {
                case "cancel":
                    HandleCancel();
                    break;
                case "start":
                    await HandleStart();
                    break;
                case "stop":
                    HandleRequestCancel();
                    break;
                case "copilot":
                    HandleTryWithCopilot();
                    break;
                case "close":
                    HandleClose();
                    break;
            }
        });
    }
    
    private void HandleTryWithCopilot()
    {
        // Collect failed operations
        var failedOps = ModalService.Operations
            .Where(op => op.State == OperationItemState.Failed)
            .ToList();
        
        var details = new System.Text.StringBuilder();
        details.AppendLine($"Batch operation: {ModalService.Title}");
        details.AppendLine($"Total: {ModalService.Operations.Count}, Failed: {FailedCount}, Completed: {CompletedCount}");
        details.AppendLine();
        details.AppendLine("Failed operations:");
        
        foreach (var op in failedOps)
        {
            details.AppendLine($"- {op.Name}: {op.ErrorMessage ?? "Unknown error"}");
        }
        
        var context = CopilotContextService.BuildOperationFailureContext(
            ModalService.Title ?? "Batch operation",
            $"{FailedCount} operation(s) failed",
            details.ToString()
        );
        
        // Close the modal FIRST, then open Copilot after the pop completes
        HandleClose();
        
        // Defer Copilot open to avoid racing PushModal vs PopModal
        _ = Task.Run(async () =>
        {
            await Task.Delay(300);
            Application.Current?.Dispatcher.Dispatch(() => CopilotContext.OpenWithContext(context));
        });
    }

    private string GetOperationCardClass(OperationItemStatus op) => op.State switch
    {
        OperationItemState.Running => "running",
        OperationItemState.Completed => "completed",
        OperationItemState.Failed => "failed",
        OperationItemState.Skipped => "skipped",
        _ => ""
    };

    private string GetOverallResultClass()
    {
        if (FailedCount > 0) return "text-error";
        if (CompletedCount > 0) return "text-success";
        return "text-muted";
    }

    private string GetOverallResultIcon()
    {
        if (FailedCount > 0) return "fa-exclamation-circle";
        if (CompletedCount > 0) return "fa-check-circle";
        return "fa-circle";
    }

    private string GetLogLevelClass(OperationLogLevel level) => level switch
    {
        OperationLogLevel.Debug => "debug",
        OperationLogLevel.Info => "info",
        OperationLogLevel.Warning => "warning",
        OperationLogLevel.Error => "error",
        OperationLogLevel.Success => "success",
        _ => "info"
    };

    private string GetLogLevelIcon(OperationLogLevel level) => level switch
    {
        OperationLogLevel.Debug => "fa-bug",
        OperationLogLevel.Info => "fa-info-circle",
        OperationLogLevel.Warning => "fa-exclamation-triangle",
        OperationLogLevel.Error => "fa-times-circle",
        OperationLogLevel.Success => "fa-check-circle",
        _ => "fa-info-circle"
    };

    public void Dispose()
    {
        if (_keyboardInitialized)
            _ = JS.InvokeVoidAsync("modalInterop.dispose", "multi-op-modal");
        ModalService.OnShowRequested -= HandleShowRequested;
        ModalService.OnOperationStateChanged -= HandleOperationStateChanged;
        ModalService.OnLogEntry -= HandleLogEntry;
        ModalService.OnExecutionStarted -= HandleExecutionStarted;
        ModalService.OnExecutionCompleted -= HandleExecutionCompleted;
        _elapsedTimer?.Dispose();
        if (_progressBridge != null)
            _progressBridge.ButtonClicked -= OnBridgeButtonClicked;
        _dotNetRef?.Dispose();
    }
}
