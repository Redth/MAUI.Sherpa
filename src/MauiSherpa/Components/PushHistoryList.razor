@using MauiSherpa.Core.Interfaces

<section>
    <SherpaSectionHeader Title="Send History" Icon="fa-solid fa-clock-rotate-left" Count="History.Count"
                         Caption="Recent sends for this project, newest first.">
        <Actions>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="OnClear">
                <i class="fa-solid fa-fw fa-eraser" aria-hidden="true"></i> Clear
            </button>
        </Actions>
    </SherpaSectionHeader>

    <div class="sherpa-list push-history">
        @foreach (var entry in History)
        {
            <div class="sherpa-list-row push-history-row" @key="entry.Id">
                <span class="sherpa-icon-well sherpa-icon-well-sm push-history-status @(entry.Success ? "success" : "error")">
                    <i class="fa-solid fa-fw @(entry.Success ? "fa-check" : "fa-xmark")" aria-hidden="true"></i>
                </span>
                <div class="sherpa-row-stack push-history-body">
                    <div class="push-history-headline">
                        <span class="sherpa-row-title">@(entry.Success ? "Delivered" : "Failed")</span>
                        @if (entry.StatusCode.HasValue)
                        {
                            <span class="sherpa-badge @(entry.Success ? "sherpa-badge-success" : "sherpa-badge-danger") mono">@entry.StatusCode</span>
                        }
                    </div>
                    <div class="sherpa-row-sub push-history-meta">
                        @if (!string.IsNullOrEmpty(entry.Target))
                        {
                            <span class="mono"><i class="fa-solid fa-fw @TargetIcon(entry.Target)" aria-hidden="true"></i> @entry.Target</span>
                        }
                        @if (entry.Success && !string.IsNullOrEmpty(entry.MessageId))
                        {
                            <span class="mono push-history-id" title="@entry.MessageId"><i class="fa-solid fa-fw fa-fingerprint" aria-hidden="true"></i> @entry.MessageId</span>
                        }
                    </div>
                    @if (!entry.Success && (!string.IsNullOrEmpty(entry.ErrorReason) || !string.IsNullOrEmpty(entry.ErrorDescription)))
                    {
                        <div class="sherpa-banner sherpa-banner-danger push-history-error text-selectable">
                            @if (!string.IsNullOrEmpty(entry.ErrorReason))
                            {
                                <div class="push-history-reason">@entry.ErrorReason</div>
                            }
                            @if (!string.IsNullOrEmpty(entry.ErrorDescription))
                            {
                                <div class="push-history-description">@entry.ErrorDescription</div>
                            }
                        </div>
                    }
                </div>
                <span class="push-history-time mono" title="@entry.Timestamp.ToLocalTime().ToString("F")">@FormatTime(entry.Timestamp)</span>
            </div>
        }
    </div>
</section>

<style>
    .push-history-row {
        align-items: flex-start;
    }

    .push-history-status.success { color: var(--status-success-fg); background: var(--status-success-bg); }
    .push-history-status.error { color: var(--status-error-fg); background: var(--status-error-bg); }

    .push-history-body {
        flex: 1;
        min-width: 0;
    }

    .push-history-headline {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .push-history-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 2px var(--space-4);
    }

    .push-history-meta span {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        min-width: 0;
    }

    .push-history-id {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .push-history-error {
        display: block;
        padding: var(--space-2) var(--space-3);
        max-height: 5.5rem;
        margin-top: var(--space-2);
        overflow-y: auto;
        overscroll-behavior: contain;
        font-size: var(--font-size-xs);
        line-height: 1.4;
        word-break: break-word;
    }

    .push-history-reason {
        font-weight: 600;
    }

    .push-history-description {
        margin-top: 2px;
        color: var(--text-secondary);
    }

    .push-history-time {
        flex-shrink: 0;
        padding-top: 2px;
        color: var(--text-muted);
        font-size: var(--font-size-xs);
        white-space: nowrap;
    }
</style>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PushSendHistoryEntry> History { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }

    static string TargetIcon(string target) => target switch
    {
        "raw-json" => "fa-code",
        _ when target.StartsWith('#') => "fa-hashtag",
        _ => "fa-mobile-screen"
    };

    static string FormatTime(DateTime timestamp)
    {
        var local = timestamp.ToLocalTime();
        return local.Date == DateTime.Today
            ? local.ToString("HH:mm:ss")
            : local.ToString("MMM d, HH:mm");
    }
}
