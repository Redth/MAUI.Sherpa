@inherits LayoutComponentBase
@using MauiSherpa.Core.Interfaces
@inject IThemeService ThemeService
@inject IJSRuntime JS
@inject IPlatformService PlatformInfo
@implements IDisposable

<div class="copilot-modal-layout @ThemeClass @PlatformClass">
    @Body
</div>

@code {
    private string ThemeClass => ThemeService.IsDarkMode ? "theme-dark" : "theme-light";
    private string PlatformClass => PlatformInfo.IsMacOS ? "platform-macos" : PlatformInfo.IsWindows ? "platform-windows" : "platform-linux";
    private string CanvasColor => ThemeService.IsDarkMode
        ? PlatformInfo.IsWindows ? "#202020" : PlatformInfo.IsLinux ? "#242424" : "#1e1e1e"
        : PlatformInfo.IsWindows ? "#f3f3f3" : "#ffffff";

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Always sync — the same page instance is reused across modal open/close
        _ = SyncBodyThemeAsync();
        _ = SyncFontScaleAsync();
    }

    private async void OnThemeChanged()
    {
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncBodyThemeAsync();
            await SyncFontScaleAsync();
        });
    }

    private async Task SyncBodyThemeAsync()
    {
        try
        {
            var cls = ThemeService.IsDarkMode ? "theme-dark" : "theme-light";
            await JS.InvokeVoidAsync("eval", $@"
                document.body.className = '{cls} {PlatformClass}';
                document.documentElement.style.backgroundColor = '{CanvasColor}';
                document.body.style.backgroundColor = '{CanvasColor}';
                document.getElementById('app')?.style.setProperty('background-color', '{CanvasColor}');");
        }
        catch { }
    }

    private async Task SyncFontScaleAsync()
    {
        try
        {
            var sizePx = 16.0 * ThemeService.FontScale;
            await JS.InvokeVoidAsync("eval", $"document.documentElement.style.fontSize = '{sizePx:F1}px'");
        }
        catch { }
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
    }
}

<style>
    .copilot-modal-layout {
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        background-color: var(--surface-canvas);
        color: var(--text-primary);
        overflow: hidden;
        /* Negate safe-area insets that macOS WebView may add */
        padding: 0 !important;
        margin: 0 !important;
    }

    /* Override html/body to fill viewport without safe-area gaps */
    html, body {
        padding: 0 !important;
        margin: 0 !important;
        height: 100% !important;
        overflow: hidden !important;
    }

    /* macOS system font */
    .platform-macos .copilot-modal-layout {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", system-ui, sans-serif;
        font-size: 13px;
        -webkit-font-smoothing: antialiased;
        /* Compensate for WKWebView title bar inset on macOS AppKit */
        padding-top: 28px !important;
    }
</style>
