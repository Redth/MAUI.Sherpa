@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@using MauiSherpa.Services
@using MauiSherpa.Pages.Forms
@using Microsoft.Maui.Controls
@inject OperationModalService ModalService
@inject ICopilotContextService CopilotContext
@inject IJSRuntime JS
@inject ProgressBridgeHolder BridgeHolder
@inject IPlatformService PlatformInfo
@implements IDisposable

@if (ModalService.IsVisible)
{
    <div class="operation-modal-host @(PlatformInfo.IsLinux ? "operation-modal-host-linux" : null)">
    <div class="operation-content" id="operation-modal" role="dialog" aria-modal="true">
        @if (PlatformInfo.IsLinux)
        {
            <h2 class="operation-title">@ModalService.Title</h2>
        }
        <div class="description">@ModalService.Description</div>

        <div class="log-section sherpa-console">
            <div class="log-header sherpa-console-header">
                <span><i class="fa-solid fa-fw fa-list" aria-hidden="true"></i> Activity Log</span>
                <button class="btn-icon" @onclick="CopyLog" title="Copy log">
                    <i class="fa-solid fa-fw fa-copy" aria-hidden="true"></i>
                </button>
            </div>
            <div class="log-container sherpa-console-body" @ref="_logContainer">
                @foreach (var entry in ModalService.LogEntries)
                {
                    <div class="log-entry @GetLogLevelClass(entry.Level)">
                        <span class="log-time">@entry.Timestamp.ToString("HH:mm:ss")</span>
                        <i class="fa-solid fa-fw @GetLogLevelIcon(entry.Level)" aria-hidden="true"></i>
                        <span class="log-message">@entry.Message</span>
                    </div>
                }
            </div>
        </div>

        @if (ModalService.IsRunning)
        {
            <div class="progress-section">
                @if (!string.IsNullOrEmpty(ModalService.CurrentStatus))
                {
                    <div class="status-text">@ModalService.CurrentStatus</div>
                }
                <div class="progress-bar-container sherpa-progress-track">
                    @if (ModalService.CurrentProgress.HasValue)
                    {
                        <div class="progress-bar sherpa-progress-fill" style="width: @(ModalService.CurrentProgress)%"></div>
                        <span class="progress-text">@(ModalService.CurrentProgress)%</span>
                    }
                    else
                    {
                        <div class="progress-bar sherpa-progress-fill indeterminate"></div>
                    }
                </div>
                <div class="elapsed-time">
                    <i class="fa-solid fa-fw fa-clock" aria-hidden="true"></i> @ElapsedTime
                </div>
            </div>
        }
        else
        {
            <div class="result-section">
                <div class="result-status @GetResultClass()">
                    <i class="fa-solid fa-fw @GetResultIcon()" aria-hidden="true"></i>
                    <span>@GetResultText()</span>
                </div>
                <div class="result-details">
                    <span><i class="fa-solid fa-fw fa-clock" aria-hidden="true"></i> Duration: @Duration</span>
                </div>
            </div>
        }

        @if (PlatformInfo.IsLinux)
        {
            <div class="operation-actions">
                @if (ModalService.IsRunning)
                {
                    @if (ModalService.CanCancel)
                    {
                        <button class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
                    }
                }
                else
                {
                    @if (ModalService.CurrentState == OperationState.Failed)
                    {
                        <button class="btn btn-secondary" @onclick="HandleTryWithCopilot">
                            <i class="fa-solid fa-fw fa-robot" aria-hidden="true"></i> Try with Copilot
                        </button>
                    }
                    <button class="btn btn-primary" @onclick="HandleClose">Close</button>
                }
            </div>
        }
    </div>
    </div>
}

<style>
    .operation-modal-host { display: contents; }

    .operation-modal-host-linux {
        position: fixed;
        inset: 0;
        z-index: 10001;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: var(--modal-overlay);
    }

    .operation-modal-host-linux .operation-content {
        width: min(600px, 100%);
        height: min(550px, calc(100vh - 2rem));
        background: var(--surface-popover);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-popover);
    }

    .operation-actions {
        display: flex;
        flex-shrink: 0;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .operation-title { margin: 0; font-size: 1.125rem; color: var(--text-primary); }

    .operation-content {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 1rem 1.25rem;
        overflow: hidden;
        gap: 1rem;
    }

    .description {
        flex-shrink: 0;
        color: var(--text-secondary);
        font-size: 0.875rem;
    }

    .progress-section {
        display: flex;
        flex-shrink: 0;
        flex-direction: column;
        gap: 0.75rem;
    }

    .status-text {
        font-size: 0.875rem;
        color: var(--text-primary);
        font-weight: 500;
    }

    .progress-bar-container {
        position: relative;
    }

    .progress-text {
        position: absolute;
        right: 0;
        top: -20px;
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .elapsed-time {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        color: var(--text-muted);
        font-size: 0.8125rem;
    }

    .result-section {
        display: flex;
        flex-shrink: 0;
        flex-direction: column;
        gap: 0.75rem;
    }

    .result-status {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.875rem 1rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        font-weight: 600;
    }

    .result-status.success {
        color: var(--status-success-fg);
        background: var(--status-success-bg);
        border-color: var(--status-success-border);
    }

    .result-status.error {
        color: var(--status-error-fg);
        background: var(--status-error-bg);
        border-color: var(--status-error-border);
    }

    .result-status.cancelled {
        color: var(--status-warning-fg);
        background: var(--status-warning-bg);
        border-color: var(--status-warning-border);
    }

    .result-details {
        display: flex;
        gap: 1rem;
        color: var(--text-muted);
        font-size: 0.8125rem;
    }

    .result-details span {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .log-section {
        flex: 1;
        min-height: 0;
    }

    .log-header {
        display: flex;
        align-items: center;
    }

    .log-header span {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .log-entry {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.25rem 0.5rem;
        border-radius: var(--radius-sm);
    }

    .log-entry:hover { background: var(--surface-console-row-hover); }

    .log-time {
        flex-shrink: 0;
        color: var(--console-muted);
    }

    .log-entry i {
        flex-shrink: 0;
        width: 0.875rem;
        text-align: center;
    }

    .log-message {
        color: var(--console-text);
        word-break: break-word;
    }

    .log-entry.info i { color: var(--console-info); }
    .log-entry.success i,
    .log-entry.success .log-message { color: var(--console-success); }
    .log-entry.warning i,
    .log-entry.warning .log-message { color: var(--console-warning); }
    .log-entry.error i,
    .log-entry.error .log-message { color: var(--console-error); }
    .log-entry.debug i { color: var(--console-muted); }
</style>

@code {
    private ElementReference _logContainer;
    private System.Timers.Timer? _elapsedTimer;
    private DateTime _startTime;
    private DotNetObjectReference<OperationModal>? _dotNetRef;
    private ProgressBridge? _progressBridge;
    private bool _keyboardInitialized;
    private string ElapsedTime { get; set; } = "00:00";
    private string Duration { get; set; } = "00:00";

    protected override void OnInitialized()
    {
        ModalService.OnShowRequested += HandleShowRequested;
        ModalService.OnLogEntry += HandleLogEntry;
        ModalService.OnStateChanged += HandleStateChanged;
        ModalService.OnStatusChanged += HandleStatusChanged;
        ModalService.OnProgressChanged += HandleProgressChanged;
        _dotNetRef = DotNetObjectReference.Create(this);

        _progressBridge = PlatformInfo.IsLinux ? null : BridgeHolder.Current;
        if (_progressBridge != null)
            _progressBridge.ButtonClicked += OnBridgeButtonClicked;

        // Catch up if already visible
        if (ModalService.IsVisible)
        {
            HandleShowRequested(ModalService.Title ?? "", ModalService.Description ?? "", ModalService.CanCancel);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PlatformInfo.IsLinux && !_keyboardInitialized)
        {
            await JS.InvokeVoidAsync("modalInterop.initialize", "operation-modal", _dotNetRef);
            _keyboardInitialized = true;
        }
    }

    [JSInvokable]
    public void OnEscapePressed()
    {
        if (!ModalService.IsRunning)
            HandleClose();
    }

    private void HandleShowRequested(string title, string description, bool canCancel)
    {
        _ = InvokeAsync(() =>
        {
            _startTime = DateTime.Now;
            ElapsedTime = "00:00";

            _elapsedTimer?.Dispose();
            if (ModalService.IsRunning)
            {
                _elapsedTimer = new System.Timers.Timer(1000);
                _elapsedTimer.Elapsed += (_, _) => _ = InvokeAsync(() =>
                {
                    ElapsedTime = (DateTime.Now - _startTime).ToString(@"mm\:ss");
                    StateHasChanged();
                });
                _elapsedTimer.Start();
            }

            UpdateBridgeButtons();
            StateHasChanged();
        });
    }

    private void HandleLogEntry(OperationLogEntry entry)
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Delay(50);
            // Auto-scroll to bottom
            await ScrollToBottom();
        });
    }

    private void HandleStateChanged(OperationState state)
    {
        _ = InvokeAsync(() =>
        {
            if (state != OperationState.Running)
            {
                _elapsedTimer?.Stop();
                _elapsedTimer?.Dispose();
                _elapsedTimer = null;
                Duration = (DateTime.Now - _startTime).ToString(@"mm\:ss\.fff");
            }
            UpdateBridgeButtons();
            StateHasChanged();
        });
    }

    private void HandleStatusChanged(string status)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleProgressChanged(int? progress)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            // Scroll log container to bottom
            await Task.CompletedTask; // JS interop would go here if needed
        }
        catch { }
    }

    private void HandleCancel()
    {
        ModalService.RequestCancellation();
    }

    private void HandleClose()
    {
        ModalService.Close();
        if (!PlatformInfo.IsLinux)
            _progressBridge?.RequestClose();
    }

    private void UpdateBridgeButtons()
    {
        var bridge = _progressBridge;
        if (bridge == null) return;

        if (ModalService.IsRunning)
        {
            if (ModalService.CanCancel)
                bridge.SetButtons(new ProgressButton("cancel", "Cancel", ProgressButtonStyle.Warning));
            else
                bridge.SetButtons();
        }
        else
        {
            var buttons = new List<ProgressButton>();
            if (ModalService.CurrentState == OperationState.Failed)
                buttons.Add(new ProgressButton("copilot", "Try with Copilot", ProgressButtonStyle.Copilot, "fa-solid fa-fw fa-robot"));
            buttons.Add(new ProgressButton("close", "Close", ProgressButtonStyle.Primary));
            bridge.SetButtons(buttons.ToArray());
        }
    }

    private async Task OnBridgeButtonClicked(string buttonId)
    {
        await InvokeAsync(() =>
        {
            switch (buttonId)
            {
                case "cancel":
                    HandleCancel();
                    break;
                case "copilot":
                    HandleTryWithCopilot();
                    break;
                case "close":
                    HandleClose();
                    break;
            }
            return Task.CompletedTask;
        });
    }

    private void HandleTryWithCopilot()
    {
        // Get error details from log
        var errorLogs = ModalService.LogEntries
            .Where(e => e.Level == OperationLogLevel.Error)
            .Select(e => e.Message)
            .ToList();
        
        var lastError = errorLogs.LastOrDefault() ?? "Operation failed";
        var allLogs = string.Join("\n", ModalService.LogEntries.Select(e => $"[{e.Level}] {e.Message}"));
        
        // Build context
        var context = CopilotContextService.BuildOperationFailureContext(
            ModalService.Title ?? "Unknown operation",
            lastError,
            allLogs.Length > 2000 ? allLogs.Substring(0, 2000) + "..." : allLogs
        );
        
        // Close the modal FIRST, then open Copilot after the pop completes
        HandleClose();
        
        // Defer Copilot open to avoid racing PushModal vs PopModal
        _ = Task.Run(async () =>
        {
            await Task.Delay(300);
            Application.Current?.Dispatcher.Dispatch(() => CopilotContext.OpenWithContext(context));
        });
    }

    private async Task CopyLog()
    {
        var logText = string.Join("\n", ModalService.LogEntries.Select(e => 
            $"[{e.Timestamp:HH:mm:ss}] [{e.Level}] {e.Message}"));
        // Would use JS interop to copy to clipboard
        await Task.CompletedTask;
    }

    private string GetResultClass() => ModalService.CurrentState switch
    {
        OperationState.Completed => "success",
        OperationState.Failed => "error",
        OperationState.Cancelled => "cancelled",
        _ => ""
    };

    private string GetResultIcon() => ModalService.CurrentState switch
    {
        OperationState.Completed => "fa-check-circle",
        OperationState.Failed => "fa-times-circle",
        OperationState.Cancelled => "fa-ban",
        _ => "fa-circle"
    };

    private string GetResultText() => ModalService.CurrentState switch
    {
        OperationState.Completed => "Operation completed successfully",
        OperationState.Failed => "Operation failed",
        OperationState.Cancelled => "Operation was cancelled",
        _ => ""
    };

    private string GetLogLevelClass(OperationLogLevel level) => level switch
    {
        OperationLogLevel.Debug => "debug",
        OperationLogLevel.Info => "info",
        OperationLogLevel.Warning => "warning",
        OperationLogLevel.Error => "error",
        OperationLogLevel.Success => "success",
        _ => "info"
    };

    private string GetLogLevelIcon(OperationLogLevel level) => level switch
    {
        OperationLogLevel.Debug => "fa-bug",
        OperationLogLevel.Info => "fa-info-circle",
        OperationLogLevel.Warning => "fa-exclamation-triangle",
        OperationLogLevel.Error => "fa-times-circle",
        OperationLogLevel.Success => "fa-check-circle",
        _ => "fa-info-circle"
    };

    public void Dispose()
    {
        if (_keyboardInitialized)
            _ = JS.InvokeVoidAsync("modalInterop.dispose", "operation-modal");
        ModalService.OnShowRequested -= HandleShowRequested;
        ModalService.OnLogEntry -= HandleLogEntry;
        ModalService.OnStateChanged -= HandleStateChanged;
        ModalService.OnStatusChanged -= HandleStatusChanged;
        ModalService.OnProgressChanged -= HandleProgressChanged;
        _elapsedTimer?.Dispose();
        if (_progressBridge != null)
            _progressBridge.ButtonClicked -= OnBridgeButtonClicked;
        _dotNetRef?.Dispose();
    }
}
