@using MauiSherpa.Core.Interfaces
@using Microsoft.JSInterop
@inject IAppleDevicePairingService PairingService
@inject ILoggingService Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="apple-pairing-overlay">
        <div class="apple-pairing-dialog" id="@modalId" role="dialog" aria-modal="true"
             aria-labelledby="@(modalId + "-title")" aria-describedby="@(modalId + "-description")">
            <header>
                <h2 id="@(modalId + "-title")"><i class="fa-solid fa-link" aria-hidden="true"></i> Pair Apple Device</h2>
                <button class="btn btn-secondary btn-icon" @onclick="CloseAsync" disabled="@closing" aria-label="Close pairing dialog">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </header>
            <div class="apple-pairing-body">
                <p id="@(modalId + "-description")" class="apple-pairing-muted">
                    Pair with this Mac without opening Xcode. Complete all trust, passcode, and Mac authorization prompts yourself.
                    Existing pairings are never removed.
                </p>
                <div class="apple-pairing-tabs" role="group" aria-label="Connection method">
                    <button class="btn @(!wireless ? "btn-primary" : "btn-secondary")" aria-pressed="@(!wireless)"
                            disabled="@busy" @onclick="() => SetMode(false)">
                        <i class="fa-brands fa-usb" aria-hidden="true"></i> USB
                    </button>
                    <button class="btn @(wireless ? "btn-primary" : "btn-secondary")" aria-pressed="@wireless"
                            disabled="@busy" @onclick="() => SetMode(true)">
                        <i class="fa-solid fa-wifi" aria-hidden="true"></i> Wi-Fi (Experimental)
                    </button>
                </div>

                @if (wireless)
                {
                    <div class="apple-pairing-warning">
                        <strong>Uses a private Apple API.</strong> Apple can change or remove this feature.
                        Tested on macOS 27.2 with iOS 27.2; other versions and Apple device families are not verified.
                        Use USB if Wi-Fi pairing is unavailable.
                    </div>
                    <ol class="apple-pairing-steps">
                        <li>Put the Mac and iPhone or iPad on the same local network.</li>
                        <li>On iOS/iPadOS 27 or later, enable Developer Mode, then open <strong>Settings &gt; Developer &gt; Paired Macs</strong>.</li>
                        <li>Start below, then select this Mac under <strong>Other Devices</strong>. Enter the code shown here on your device.</li>
                    </ol>
                    <p class="apple-pairing-muted">Don't remove an existing pairing to make the Mac appear. A saved pairing can be checked from the USB tab.</p>
                    <label class="apple-pairing-consent">
                        <input type="checkbox" @bind="wirelessAcknowledged" disabled="@busy" />
                        <span>I understand this uses an experimental, private Apple feature.</span>
                    </label>
                    @if (!PairingService.IsWirelessSupported)
                    {
                        <p class="apple-pairing-error" role="alert">The native Wi-Fi helper or Apple's private framework is unavailable. Use USB pairing on this installation.</p>
                    }
                    @if (pairingCode != null)
                    {
                        <div class="apple-pairing-code-panel">
                            <span>Enter this code on the device that selected this Mac</span>
                            <div class="apple-pairing-code" role="status" aria-label="Pairing code">@pairingCode</div>
                            <small>This code is temporary and is not saved to logs.</small>
                        </div>
                    }
                }
                else
                {
                    <p>Connect and unlock your device with a USB cable. Choose <strong>Trust</strong> on the device and finish its passcode prompt when asked.</p>
                    <div class="apple-pairing-selection">
                        <label for="@(modalId + "-device")">USB devices and saved pairings</label>
                        <div class="apple-pairing-select-row">
                            <select id="@(modalId + "-device")" @bind="selectedIdentifier" disabled="@(busy || loading)">
                                <option value="">Select a device</option>
                                @foreach (var device in devices)
                                {
                                    <option value="@device.Identifier">@device.Name - @device.Model (@device.TransportType, @PairingLabel(device))</option>
                                }
                            </select>
                            <button class="btn btn-secondary" @onclick="RefreshDevicesAsync" disabled="@(busy || loading)">
                                <i class="fa-solid @(loading ? "fa-spinner fa-spin" : "fa-rotate")" aria-hidden="true"></i> Refresh
                            </button>
                        </div>
                    </div>
                    @if (SelectedDevice is { } selected)
                    {
                        <dl class="apple-pairing-device">
                            <dt>Device</dt><dd>@selected.Platform @selected.OsVersion - @selected.Model</dd>
                            <dt>CoreDevice ID</dt><dd class="mono">@selected.Identifier</dd>
                            <dt>Pairing</dt><dd>@PairingLabel(selected)</dd>
                            <dt>Connection</dt><dd>@selected.ConnectionState (@selected.TransportType)</dd>
                            <dt>Developer Mode</dt><dd>@selected.DeveloperModeStatus</dd>
                        </dl>
                        @if (selected.IsPaired)
                        {
                            <p class="apple-pairing-muted">This device already has a pairing. Only its live connection will be checked; it will not be paired again.</p>
                        }
                        else if (!selected.IsWired)
                        {
                            <p class="apple-pairing-muted">Connect this unpaired device with a cable, or use the experimental Wi-Fi flow.</p>
                        }
                    }
                    else if (!loading && devices.Count == 0 && loadError == null)
                    {
                        <p class="apple-pairing-muted">No physical devices found. Check the cable, unlock the device, and refresh. Xcode command-line tools must be installed.</p>
                    }
                }

                @if (loadError != null)
                {
                    <p class="apple-pairing-error" role="alert">@loadError</p>
                }
                @if (busy)
                {
                    <p class="apple-pairing-status" role="status"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> @status</p>
                }
                @if (result != null)
                {
                    <div class="apple-pairing-result @(result.IsLiveVerified ? "verified" : "")" role="status">
                        <strong>@ResultTitle(result)</strong>
                        <p>@result.Message</p>
                    </div>
                }
            </div>
            <footer>
                <small class="apple-pairing-muted">Stopping does not undo trust you already approved. Wi-Fi discovery stops after at most three minutes.</small>
                <div class="apple-pairing-footer-actions">
                    @if (busy)
                    {
                        <button class="btn btn-warning" @onclick="StopAsync" disabled="@stopping">@(stopping ? "Stopping..." : "Stop")</button>
                    }
                    <button class="btn btn-secondary" @onclick="CloseAsync" disabled="@closing">Close</button>
                    @if (!busy)
                    {
                        @if (wireless)
                        {
                            <button class="btn btn-primary" @onclick="StartWirelessAsync"
                                    disabled="@(!wirelessAcknowledged || !PairingService.IsWirelessSupported || loading)">
                                Start Wi-Fi Pairing
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="StartUsbAsync"
                                    disabled="@(loading || SelectedDevice == null || (!SelectedDevice.IsPaired && !SelectedDevice.IsWired))">
                                @(SelectedDevice?.IsPaired == true ? "Check Connection" : "Pair via USB")
                            </button>
                        }
                    }
                </div>
            </footer>
        </div>
    </div>
}

<style>
    .apple-pairing-overlay { position: fixed; inset: 0; z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 1.5rem; background: var(--modal-overlay); }
    .apple-pairing-dialog { display: flex; flex-direction: column; width: min(100%, 42rem); max-height: 90vh; background: var(--card-bg); color: var(--text-primary); border: 1px solid var(--border-color); border-radius: 0.75rem; box-shadow: var(--card-shadow-lg); }
    .apple-pairing-dialog header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-color); }
    .apple-pairing-dialog h2 { font-size: 1.2rem; margin: 0; }
    .apple-pairing-body { padding: 1.25rem; overflow-y: auto; }
    .apple-pairing-body p { line-height: 1.55; margin: 0 0 1rem; }
    .apple-pairing-muted { color: var(--text-secondary); }
    .apple-pairing-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
    .apple-pairing-warning { padding: 0.875rem; border: 1px solid var(--accent-warning); border-radius: 0.5rem; background: var(--status-warning-bg); margin-bottom: 1rem; line-height: 1.5; }
    .apple-pairing-steps { padding-left: 1.5rem; margin-bottom: 1rem; }
    .apple-pairing-steps li { padding-left: 0.25rem; margin-bottom: 0.65rem; line-height: 1.5; }
    .apple-pairing-consent { display: flex; align-items: flex-start; gap: 0.625rem; line-height: 1.5; margin: 1rem 0; cursor: pointer; }
    .apple-pairing-consent input { margin-top: 0.25rem; flex-shrink: 0; }
    .apple-pairing-selection label { display: block; font-weight: 600; margin-bottom: 0.5rem; }
    .apple-pairing-select-row { display: flex; align-items: stretch; gap: 0.5rem; }
    .apple-pairing-select-row select { flex: 1; min-width: 0; padding: 0.625rem; color: var(--text-primary); background: var(--input-bg); border: 1px solid var(--border-color); border-radius: 0.375rem; }
    .apple-pairing-device { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1rem; padding: 1rem; margin: 1rem 0; background: var(--bg-tertiary); border-radius: 0.5rem; font-size: 0.875rem; }
    .apple-pairing-device dt { color: var(--text-secondary); }
    .apple-pairing-device dd { margin: 0; overflow-wrap: anywhere; }
    .apple-pairing-code-panel { padding: 1.25rem; margin: 1rem 0; text-align: center; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 0.5rem; }
    .apple-pairing-code { font-family: var(--font-mono, monospace); font-size: clamp(1.5rem, 5vw, 2.5rem); font-variant-numeric: tabular-nums; white-space: pre-wrap; overflow-wrap: anywhere; padding: 0.75rem 0; user-select: none; }
    .apple-pairing-code-panel small { color: var(--text-secondary); }
    .apple-pairing-error { color: var(--accent-danger); margin-top: 1rem !important; overflow-wrap: anywhere; }
    .apple-pairing-status { color: var(--text-secondary); margin-top: 1rem !important; }
    .apple-pairing-result { padding: 1rem; margin-top: 1rem; border: 1px solid var(--border-color); background: var(--bg-tertiary); border-radius: 0.5rem; }
    .apple-pairing-result.verified { border-color: var(--accent-success); background: var(--status-success-bg); }
    .apple-pairing-result p { margin: 0.5rem 0 0; overflow-wrap: anywhere; }
    .apple-pairing-dialog footer { display: flex; flex-direction: column; gap: 0.875rem; padding: 1rem 1.25rem; border-top: 1px solid var(--border-color); }
    .apple-pairing-footer-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 0.5rem; }
    .apple-pairing-dialog :is(button, input, select):focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 3px; }
    @@media (max-width: 520px) { .apple-pairing-overlay { padding: 0.5rem; } .apple-pairing-select-row { flex-direction: column; } .apple-pairing-device { grid-template-columns: 1fr; gap: 0.25rem; } .apple-pairing-device dd { margin-bottom: 0.5rem; } }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? InitialDeviceIdentifier { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDevicesMayHaveChanged { get; set; }

    private readonly string modalId = $"apple-pairing-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource lifetime = new();
    private DotNetObjectReference<AppleDevicePairingDialog>? dotNetRef;
    private CancellationTokenSource? openCts;
    private CancellationTokenSource? operationCts;
    private Task? operationTask;
    private IReadOnlyList<PhysicalDevice> devices = [];
    private string selectedIdentifier = "";
    private string? pairingCode;
    private string? loadError;
    private string status = "";
    private ApplePairingResult? result;
    private bool opened, initialized, wireless, wirelessAcknowledged, busy, loading, closing, stopping, disposed;
    private long generation;
    private PhysicalDevice? SelectedDevice => devices.FirstOrDefault(d => d.Identifier == selectedIdentifier);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !opened)
        {
            opened = true;
            openCts = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
            wireless = false;
            wirelessAcknowledged = false;
            result = null;
            selectedIdentifier = InitialDeviceIdentifier ?? "";
            await RefreshDevicesAsync();
        }
        else if (!IsOpen && opened)
        {
            if (openCts != null) await openCts.CancelAsync();
            await CancelOperationAsync();
            await DisposeInteropAsync();
            openCts?.Dispose();
            openCts = null;
            opened = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !initialized)
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("modalInterop.initialize", modalId, dotNetRef);
            initialized = true;
        }
    }

    private async Task RefreshDevicesAsync()
    {
        loading = true;
        loadError = null;
        var ct = openCts?.Token ?? lifetime.Token;
        try
        {
            devices = await PairingService.GetDevicesAsync(ct);
            if (!devices.Any(d => d.Identifier == selectedIdentifier))
                selectedIdentifier = devices.FirstOrDefault(d => d.IsWired)?.Identifier ??
                    devices.FirstOrDefault()?.Identifier ?? "";
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            devices = [];
            selectedIdentifier = "";
            loadError = $"Could not refresh Apple devices. {ex.Message}";
            Logger.LogWarning("Apple pairing device discovery failed.");
        }
        finally
        {
            loading = false;
            if (!disposed) StateHasChanged();
        }
    }

    private void SetMode(bool useWireless)
    {
        if (busy) return;
        wireless = useWireless;
        pairingCode = null;
        result = null;
    }

    private Task StartUsbAsync()
    {
        var selected = SelectedDevice;
        if (selected == null || busy) return Task.CompletedTask;
        return RunAsync(ct => selected.IsPaired
            ? PairingService.VerifyAsync(selected.Identifier, ct)
            : PairingService.PairUsbAsync(selected.Identifier, ct),
            selected.IsPaired ? "Checking Apple's live connection..." :
                "Waiting for Apple's trust prompts. Unlock your device and complete its passcode prompt.");
    }

    private Task StartWirelessAsync()
    {
        if (!wirelessAcknowledged || !PairingService.IsWirelessSupported || busy) return Task.CompletedTask;
        return RunAsync(ct =>
        {
            var current = generation;
            var progress = new Progress<ApplePairingProgress>(update =>
            {
                if (disposed || !busy || operationCts?.IsCancellationRequested != false || current != generation)
                    return;
                pairingCode = update.Stage == ApplePairingStage.Code ? update.PairingCode : null;
                status = update.Stage switch
                {
                    ApplePairingStage.Advertising => "This Mac is discoverable. Select it in Paired Macs on your device.",
                    ApplePairingStage.Code => "Code ready. Enter it on your device; finish any Apple prompts yourself.",
                    _ => "Apple completed the exchange. Checking for a uniquely paired device and live access..."
                };
                StateHasChanged();
            });
            return PairingService.PairWirelessAsync(progress, ct);
        }, "Starting Apple's private Wi-Fi discovery...");
    }

    private Task RunAsync(Func<CancellationToken, Task<ApplePairingResult>> action, string initialStatus)
    {
        busy = true;
        stopping = false;
        result = null;
        pairingCode = null;
        status = initialStatus;
        generation++;
        operationCts = CancellationTokenSource.CreateLinkedTokenSource(openCts?.Token ?? lifetime.Token);
        operationTask = PerformAsync(action, operationCts);
        return operationTask;
    }

    private async Task PerformAsync(Func<CancellationToken, Task<ApplePairingResult>> action, CancellationTokenSource source)
    {
        try
        {
            result = await action(source.Token);
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
            result = new(ApplePairingState.Failed, "Stopped. Trust you already approved may still be saved; check the refreshed device list before retrying.");
        }
        catch (Exception ex)
        {
            Logger.LogError($"Apple pairing dialog operation failed ({ex.GetType().Name}).");
            result = new(ApplePairingState.Failed, "Pairing could not finish. Refresh devices and check Apple's prompts before retrying.");
        }
        finally
        {
            generation++;
            pairingCode = null;
            try
            {
                if (!disposed && IsOpen && !closing && openCts?.IsCancellationRequested == false)
                {
                    await RefreshDevicesAsync();
                    if (!disposed && IsOpen && !closing && openCts?.IsCancellationRequested == false)
                        await OnDevicesMayHaveChanged.InvokeAsync();
                }
            }
            finally
            {
                source.Dispose();
                operationCts = null;
                busy = false;
                stopping = false;
                if (!disposed) StateHasChanged();
            }
        }
    }

    private async Task CancelOperationAsync()
    {
        generation++;
        pairingCode = null;
        if (operationCts != null)
            await operationCts.CancelAsync();
        if (operationTask != null)
            await operationTask;
    }

    private async Task StopAsync()
    {
        stopping = true;
        status = "Stopping discovery and waiting for Apple's tools to exit...";
        await CancelOperationAsync();
    }

    private async Task CloseAsync()
    {
        if (closing) return;
        closing = true;
        try
        {
            if (openCts != null) await openCts.CancelAsync();
            await CancelOperationAsync();
            await DisposeInteropAsync();
            result = null;
            await OnClose.InvokeAsync();
        }
        finally { closing = false; }
    }

    [JSInvokable] public Task OnEscapePressed() => CloseAsync();

    private async Task DisposeInteropAsync()
    {
        if (!initialized) return;
        try { await JS.InvokeVoidAsync("modalInterop.dispose", modalId); }
        catch (JSDisconnectedException) { }
        initialized = false;
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        pairingCode = null;
        await lifetime.CancelAsync();
        await CancelOperationAsync();
        await DisposeInteropAsync();
        dotNetRef?.Dispose();
        openCts?.Dispose();
        lifetime.Dispose();
    }

    private static string PairingLabel(PhysicalDevice device) => device.PairingState switch
    {
        "paired" => "Paired",
        "unpaired" => "Not paired",
        "pairingInProgress" => "Pairing in progress",
        _ => "Pairing state unknown"
    };

    private static string ResultTitle(ApplePairingResult value) => value.State switch
    {
        ApplePairingState.Connected => "Paired and responding",
        ApplePairingState.Paired => "Pairing saved; live access not verified",
        ApplePairingState.CompletedUnverified => "Apple completed pairing; device verification needed",
        _ => "Pairing not confirmed"
    };
}
