@using MauiSherpa.Core.Interfaces
@using MauiSherpa.Core.Services
@inject IAndroidWirelessPairingService PairingService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="wireless-overlay" @onclick="CloseAsync">
        <div class="wireless-dialog" id="android-wireless-dialog" role="dialog" aria-modal="true"
             aria-labelledby="android-wireless-title" aria-describedby="android-wireless-description"
             @onclick:stopPropagation="true">
            <header class="wireless-header">
                <h2 id="android-wireless-title"><i class="fas fa-wifi" aria-hidden="true"></i> Pair an Android device</h2>
                <button class="wireless-close" @onclick="CloseAsync" aria-label="Close wireless pairing" title="Close">
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                </button>
            </header>
            <div class="wireless-body">
                <p id="android-wireless-description">
                    Connect your device and computer to the same Wi-Fi network. On the device, open
                    <strong>Developer options &gt; Wireless debugging</strong> and turn it on.
                    Available on Android 11+ phones and Android 13+ TV and Wear OS devices.
                </p>

                <div class="wireless-discovery">
                    <button class="btn btn-secondary" @onclick="DiscoverAsync" disabled="@busy">
                        <i class="fas @(activeOperation == "discover" ? "fa-spinner fa-spin" : "fa-search")" aria-hidden="true"></i>
                        @(activeOperation == "discover" ? "Finding devices..." : "Find nearby devices")
                    </button>
                    <p>Discovery can be blocked by guest Wi-Fi, a VPN, or network isolation. You can always enter an address manually.</p>
                    @if (discoveryMessage != null)
                    {
                        <p class="wireless-notice" role="status">@discoveryMessage</p>
                    }
                </div>

                <section class="wireless-section" aria-labelledby="wireless-qr-title">
                    <h3 id="wireless-qr-title">Pair with a QR code</h3>
                    <p>Choose <strong>Pair device with QR code</strong> in Wireless debugging on your device,
                        then scan the code shown here. Use that scanner, not the regular camera app.</p>
                    @if (qrSession != null)
                    {
                        <img class="wireless-qr-image" src="@qrSession.ImageDataUrl"
                             alt="Android wireless pairing QR code. Scan it with the device's Wireless debugging scanner." />
                        <p role="status"><i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Waiting for the scanned device to pair...</p>
                        <p class="wireless-help">This code lasts up to 3 minutes. Keep Sherpa open and do not share the code.</p>
                        <button class="btn btn-secondary" @onclick="StopQrPairing" @ref="qrActionButton">
                            <i class="fas fa-stop" aria-hidden="true"></i> Stop QR pairing
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="PairQrAsync" disabled="@busy" @ref="qrActionButton">
                            <i class="fas fa-qrcode" aria-hidden="true"></i> Show QR code
                        </button>
                        <p class="wireless-help">QR pairing requires network discovery. Pair by code below if your device has no QR scanner or discovery is blocked.</p>
                    }
                    @if (qrStopped)
                    {
                        <p class="wireless-notice" role="status">QR pairing stopped. Show a new code or pair by code below.</p>
                    }
                    @if (qrResult != null)
                    {
                        <div class="wireless-result @(qrResult.Success ? "wireless-success" : "wireless-error")"
                             role="@(qrResult.Success ? "status" : "alert")">
                            <strong>@(qrResult.Success ? "Paired" : "Could not pair with QR code")</strong>
                            <span>@qrResult.Message</span>
                        </div>
                    }
                </section>

                <form @onsubmit="PairAsync" @onsubmit:preventDefault="true">
                    <fieldset disabled="@busy" class="wireless-section">
                        <legend>Pair with a code</legend>
                        <p>Choose <strong>Pair device with pairing code</strong> on your device. Keep that screen open until pairing finishes.</p>
                        @if (discoveredServices.Any(s => s.IsPairing))
                        {
                            <label for="wireless-pairing-discovery">Nearby pairing addresses</label>
                            <select id="wireless-pairing-discovery" value="" @onchange="SelectPairingAddress" disabled="@busy">
                                <option value="">Choose a pairing address</option>
                                @foreach (var service in discoveredServices.Where(s => s.IsPairing))
                                {
                                    <option value="@service.Endpoint">@service.Endpoint (@service.Name)</option>
                                }
                            </select>
                        }
                        <label for="wireless-pairing-address">Pairing IP address and port</label>
                        <input id="wireless-pairing-address" type="text" @bind="pairingAddress" @bind:event="oninput"
                               disabled="@busy"
                               @bind:after="ClearPairingResult"
                               placeholder="192.168.1.20:37123" autocomplete="off" spellcheck="false"
                               aria-describedby="wireless-pairing-address-help" />
                        <p class="wireless-help" id="wireless-pairing-address-help">Use the address from the pairing-code screen, not the main Wireless debugging screen.</p>
                        <label for="wireless-pairing-code">Six-digit pairing code</label>
                        <input id="wireless-pairing-code" class="wireless-code" type="password" inputmode="numeric"
                               disabled="@busy"
                               maxlength="6" autocomplete="off" @bind="pairingCode" @bind:event="oninput"
                               @bind:after="ClearPairingResult"
                               aria-describedby="wireless-code-help" />
                        <p class="wireless-help" id="wireless-code-help">The code is only used for this pairing attempt and is never saved or logged.</p>
                        <button class="btn btn-primary" type="submit" disabled="@(!CanPair || busy)">
                            <i class="fas @(activeOperation == "pair" ? "fa-spinner fa-spin" : "fa-link")" aria-hidden="true"></i>
                            @(activeOperation == "pair" ? "Pairing..." : "Pair device")
                        </button>
                    </fieldset>
                </form>

                @if (pairingResult != null)
                {
                    <div class="wireless-result @(pairingResult.Success ? "wireless-success" : "wireless-error")"
                         role="@(pairingResult.Success ? "status" : "alert")">
                        <strong>@(pairingResult.Success ? "Paired" : "Could not pair")</strong>
                        <span>@pairingResult.Message</span>
                    </div>
                }

                <form @onsubmit="ConnectAsync" @onsubmit:preventDefault="true">
                    <fieldset disabled="@busy" class="wireless-section">
                        <legend>Connect for debugging</legend>
                        <p>Android may connect automatically after pairing. If it does not, close the pairing-code screen and use
                            <strong>IP address &amp; port</strong> from the main Wireless debugging screen.
                            You can also reconnect a device that is already paired.</p>
                        @if (discoveredServices.Any(s => !s.IsPairing))
                        {
                            <label for="wireless-connection-discovery">Nearby debugging addresses</label>
                            <select id="wireless-connection-discovery" value="" @onchange="SelectConnectionAddress" disabled="@busy">
                                <option value="">Choose a debugging address</option>
                                @foreach (var service in discoveredServices.Where(s => !s.IsPairing))
                                {
                                    <option value="@service.Endpoint">@service.Endpoint (@service.Name)</option>
                                }
                            </select>
                        }
                        <label for="wireless-connection-address">Debugging IP address and port</label>
                        <input id="wireless-connection-address" type="text" @bind="connectionAddress" @bind:event="oninput"
                               disabled="@busy"
                               @bind:after="ClearConnectionResult"
                               placeholder="192.168.1.20:40555" autocomplete="off" spellcheck="false"
                               aria-describedby="wireless-connection-address-help" />
                        <p class="wireless-help" id="wireless-connection-address-help">The debugging port is usually different from the pairing port, and can change when Wireless debugging restarts.</p>
                        <button class="btn btn-primary" type="submit" disabled="@(!CanConnect || busy)">
                            <i class="fas @(activeOperation == "connect" ? "fa-spinner fa-spin" : "fa-wifi")" aria-hidden="true"></i>
                            @(activeOperation == "connect" ? "Connecting..." : "Connect device")
                        </button>
                    </fieldset>
                </form>

                @if (connectionResult != null)
                {
                    <div class="wireless-result @(connectionResult.Success ? "wireless-success" : connectionResult.State == AndroidWirelessOperationState.ConnectionPending ? "wireless-notice" : "wireless-error")"
                         role="@(connectionResult.State == AndroidWirelessOperationState.Failed ? "alert" : "status")">
                        <strong>@(connectionResult.Success ? "Connected" : connectionResult.State == AndroidWirelessOperationState.ConnectionPending ? "Not online yet" : "Could not connect")</strong>
                        <span>@connectionResult.Message</span>
                    </div>
                }
            </div>
            <footer class="wireless-footer">
                <button class="btn btn-secondary" @onclick="CloseAsync">@(busy ? "Cancel and close" : "Close")</button>
            </footer>
        </div>
    </div>
}

<style>
    .wireless-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: var(--modal-overlay);
    }
    .wireless-dialog {
        width: min(640px, 100%);
        max-height: calc(100dvh - 3rem);
        display: flex;
        flex-direction: column;
        background: var(--card-bg);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        overflow: hidden;
    }
    .wireless-header, .wireless-footer {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        flex-shrink: 0;
    }
    .wireless-header { justify-content: space-between; border-bottom: 1px solid var(--border-color); }
    .wireless-header h2 { margin: 0; font-size: 1.125rem; }
    .wireless-header h2 i { margin-right: 0.375rem; }
    .wireless-close {
        background: none;
        border: none;
        color: var(--text-secondary);
        padding: 0.5rem;
        cursor: pointer;
        border-radius: 0.375rem;
    }
    .wireless-close:hover { background: var(--bg-hover); color: var(--text-primary); }
    .wireless-body { padding: 1.25rem; overflow-y: auto; }
    .wireless-body p { color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin: 0 0 0.75rem; }
    .wireless-body strong { color: var(--text-primary); }
    .wireless-discovery { margin-bottom: 1.5rem; }
    .wireless-discovery > p { margin-top: 0.625rem; }
    .wireless-section { border: none; padding: 0; margin: 0 0 1.5rem; min-width: 0; }
    .wireless-section legend { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; }
    .wireless-section h3 { font-size: 1rem; font-weight: 600; margin: 0 0 0.5rem; }
    .wireless-qr-image { display: block; width: 256px; max-width: 100%; height: auto; image-rendering: pixelated; margin: 0.875rem 0; }
    .wireless-section > .wireless-help { margin-top: 0.625rem; }
    .wireless-section label { display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.375rem; }
    .wireless-section input, .wireless-section select {
        width: 100%;
        box-sizing: border-box;
        padding: 0.625rem 0.75rem;
        border: 1px solid var(--input-border);
        border-radius: 0.375rem;
        background: var(--input-bg);
        color: var(--text-primary);
        font: inherit;
        font-size: 0.875rem;
    }
    .wireless-section input::placeholder { color: var(--text-secondary); opacity: 1; }
    .wireless-section select { margin-bottom: 0.875rem; }
    .wireless-section .wireless-code { max-width: 12rem; }
    .wireless-section .wireless-help { font-size: 0.8125rem; margin: 0.375rem 0 0.875rem; }
    .wireless-dialog :is(button, input, select):focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }
    .wireless-dialog :is(button, input, select):disabled { opacity: 0.6; cursor: not-allowed; }
    .wireless-result { display: flex; flex-direction: column; gap: 0.375rem; padding: 0.875rem; margin-bottom: 1.5rem; border-radius: 0.375rem; font-size: 0.875rem; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
    .wireless-success { background: var(--status-success-bg); color: var(--status-success-text); }
    .wireless-error { background: var(--status-error-bg); color: var(--status-error-text); }
    .wireless-notice { color: var(--text-secondary); }
    .wireless-result strong { color: inherit; }
    .wireless-footer { justify-content: flex-end; border-top: 1px solid var(--border-color); }
    @@media (max-width: 480px) {
        .wireless-overlay { padding: 0.5rem; }
        .wireless-dialog { max-height: calc(100dvh - 1rem); }
        .wireless-header, .wireless-body, .wireless-footer { padding: 1rem; }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDevicesMayHaveChanged { get; set; }

    private string pairingAddress = "";
    private string pairingCode = "";
    private string connectionAddress = "";
    private string? activeOperation;
    private string? discoveryMessage;
    private bool wasOpen;
    private bool initializeFocus;
    private bool focusInitialized;
    private bool disposed;
    private bool busy => activeOperation != null;
    private IReadOnlyList<AndroidWirelessService> discoveredServices = [];
    private AndroidWirelessOperationResult? pairingResult;
    private AndroidWirelessOperationResult? connectionResult;
    private AndroidWirelessQrSession? qrSession;
    private AndroidWirelessOperationResult? qrResult;
    private bool qrStopped;
    private bool focusQrAction;
    private ElementReference qrActionButton;
    private CancellationTokenSource? operationCts;
    private DotNetObjectReference<AndroidWirelessPairingDialog>? dotNetReference;
    private bool CanPair => AndroidWirelessPairingService.TryNormalizeEndpoint(pairingAddress, out _) &&
        pairingCode.Length == 6 && pairingCode.All(c => c is >= '0' and <= '9');
    private bool CanConnect => AndroidWirelessPairingService.TryNormalizeEndpoint(connectionAddress, out _);

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            pairingAddress = pairingCode = connectionAddress = "";
            pairingResult = connectionResult = null;
            discoveredServices = [];
            discoveryMessage = null;
            qrSession = null;
            qrResult = null;
            qrStopped = false;
            focusQrAction = false;
            dotNetReference ??= DotNetObjectReference.Create(this);
            initializeFocus = true;
        }
        if (!IsOpen)
        {
            operationCts?.Cancel();
            pairingCode = "";
            qrSession = null;
        }
        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (initializeFocus && IsOpen)
        {
            initializeFocus = false;
            await JS.InvokeVoidAsync("modalInterop.initialize", "android-wireless-dialog", dotNetReference);
            focusInitialized = true;
        }
        if (focusQrAction && IsOpen)
        {
            focusQrAction = false;
            await qrActionButton.FocusAsync();
        }
    }

    private Task PairAsync() => RunAsync("pair", async ct =>
    {
        pairingResult = null;
        var code = pairingCode;
        pairingCode = "";
        var result = await PairingService.PairAsync(pairingAddress, code, ct);
        ct.ThrowIfCancellationRequested();
        pairingResult = result;
        if (pairingResult.Success && IsOpen && !disposed)
            await OnDevicesMayHaveChanged.InvokeAsync();
    });

    private Task PairQrAsync() => RunAsync("qr", async ct =>
    {
        qrResult = null;
        qrStopped = false;
        pairingCode = "";
        var session = PairingService.CreateQrPairingSession();
        qrSession = session;
        focusQrAction = true;
        var result = await PairingService.PairQrAsync(session, ct);
        ct.ThrowIfCancellationRequested();
        qrResult = result;
        if (result.Success && IsOpen && !disposed)
            await OnDevicesMayHaveChanged.InvokeAsync();
    });

    private void StopQrPairing()
    {
        operationCts?.Cancel();
        qrSession = null;
        qrStopped = true;
    }

    private Task ConnectAsync() => RunAsync("connect", async ct =>
    {
        connectionResult = null;
        var result = await PairingService.ConnectAsync(connectionAddress, ct);
        ct.ThrowIfCancellationRequested();
        connectionResult = result;
        if ((connectionResult.State is AndroidWirelessOperationState.Connected or AndroidWirelessOperationState.ConnectionPending) &&
            IsOpen && !disposed)
            await OnDevicesMayHaveChanged.InvokeAsync();
    });

    private Task DiscoverAsync() => RunAsync("discover", async ct =>
    {
        discoveredServices = [];
        discoveryMessage = null;
        var result = await PairingService.DiscoverAsync(ct);
        ct.ThrowIfCancellationRequested();
        discoveredServices = result.Services;
        discoveryMessage = result.Success
            ? result.Services.Count == 0
                ? "No nearby addresses found. Open the pairing-code screen on your device, try again, or enter its address manually."
                : $"Found {result.Services.Count} address(es). Choose a pairing or debugging address below."
            : result.Message;
    });

    private async Task RunAsync(string operation, Func<CancellationToken, Task> action)
    {
        if (busy || !IsOpen)
            return;
        using var cts = new CancellationTokenSource();
        operationCts = cts;
        activeOperation = operation;
        try
        {
            await action(cts.Token);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Closing the dialog cancels only the ADB command owned by this operation.
        }
        finally
        {
            if (operation == "qr")
            {
                qrSession = null;
                focusQrAction = IsOpen && !disposed;
            }
            operationCts = null;
            activeOperation = null;
        }
    }

    private void ClearPairingResult() => pairingResult = null;
    private void ClearConnectionResult() => connectionResult = null;

    private void SelectPairingAddress(ChangeEventArgs args)
    {
        pairingAddress = args.Value?.ToString() ?? "";
        ClearPairingResult();
    }

    private void SelectConnectionAddress(ChangeEventArgs args)
    {
        connectionAddress = args.Value?.ToString() ?? "";
        ClearConnectionResult();
    }

    [JSInvokable("OnEscapePressed")]
    public async Task CloseAsync()
    {
        operationCts?.Cancel();
        pairingCode = "";
        qrSession = null;
        if (focusInitialized)
        {
            await JS.InvokeVoidAsync("modalInterop.dispose", "android-wireless-dialog");
            focusInitialized = false;
        }
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        operationCts?.Cancel();
        pairingCode = "";
        qrSession = null;
        if (focusInitialized)
        {
            try { await JS.InvokeVoidAsync("modalInterop.dispose", "android-wireless-dialog"); }
            catch (JSDisconnectedException) { }
        }
        dotNetReference?.Dispose();
    }
}
