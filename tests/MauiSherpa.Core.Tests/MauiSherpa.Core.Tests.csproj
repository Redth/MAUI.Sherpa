<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Maui.Essentials" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/MauiSherpa.Core/MauiSherpa.Core.csproj" />
    <Compile Include="../../src/MauiSherpa/Services/SecretBackupActions.cs"
             Link="LinkedSources/SecretBackupActions.cs" />
    <Compile Include="../../src/MauiSherpa/Pages/Forms/HybridFormBridge.cs"
             Link="LinkedSources/HybridFormBridge.cs" />
    <Compile Include="../../src/MauiSherpa/Services/LinuxModalOverlayHosts.cs"
             Link="LinkedSources/LinuxModalOverlayHosts.cs" />
    <Compile Include="../../src/MauiSherpa/Services/ProcessExecutionService.cs"
             Link="LinkedSources/ProcessExecutionService.cs" />
    <Compile Include="../../src/MauiSherpa.LinuxGtk/Services/LinuxSecureStorage.cs"
             Link="LinkedSources/LinuxSecureStorage.cs" />
    <Compile Include="../../src/MauiSherpa.LinuxGtk/Services/LibSecretStore.cs"
             Link="LinkedSources/LibSecretStore.cs" />
    <Compile Include="../../src/MauiSherpa.LinuxGtk/Services/LibSecretInterop.cs"
             Link="LinkedSources/LibSecretInterop.cs" />
    <Compile Include="../../src/MauiSherpa/Services/SecureStorageService.cs"
             Link="LinkedSources/SecureStorageService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="../Fixtures/SqlCipher522/Data/*"
          Link="Fixtures/SqlCipher522/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>